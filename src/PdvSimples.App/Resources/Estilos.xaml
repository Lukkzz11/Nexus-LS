<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores num lugar só: para mudar o visual do programa, basta mexer aqui. -->
    <SolidColorBrush x:Key="CorFundo" Color="#F3F4F6" />
    <SolidColorBrush x:Key="CorPainel" Color="White" />
    <SolidColorBrush x:Key="CorMenu" Color="#111827" />
    <SolidColorBrush x:Key="CorPrimaria" Color="#2563EB" />
    <SolidColorBrush x:Key="CorTexto" Color="#111827" />
    <SolidColorBrush x:Key="CorTextoSuave" Color="#6B7280" />
    <SolidColorBrush x:Key="CorBorda" Color="#D1D5DB" />
    <SolidColorBrush x:Key="CorPerigo" Color="#DC2626" />
    <SolidColorBrush x:Key="CorSucesso" Color="#15803D" />
    <SolidColorBrush x:Key="CorAlerta" Color="#FEF3C7" />
    <SolidColorBrush x:Key="CorSelecao" Color="#DBEAFE" />

    <!-- Estilo base dos botões: cantos arredondados, realce ao passar o mouse e ao focar pelo teclado. -->
    <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borda"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borda" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource CorTexto}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="borda" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource CorPrimaria}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
    </Style>

    <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource CorPerigo}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorPerigo}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="BotaoMenu" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Margin" Value="8,2" />
    </Style>

    <!-- Estilo "implícito": sem x:Key, vale para TODOS os TextBox do programa. -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="Painel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CorPainel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="TituloTela" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
    </Style>
</ResourceDictionary>
