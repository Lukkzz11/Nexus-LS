<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NexusLS.Core\NexusLS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="nexus.ico" />
    <Resource Include="Assets\emblema.png" />
    <Resource Include="Assets\emblema-branco.png" />
  </ItemGroup>

  <!-- Pacote do Alinhavo (alinhavo.exe + assets\manequim + versao.txt), gerado por publicar-alinhavo.ps1.
       Entra DENTRO do Nexus-Setup.exe, então o outro PC não precisa de Rust nem de internet para ele. -->
  <ItemGroup>
    <EmbeddedResource Include="Pacotes\Alinhavo.zip" LogicalName="Alinhavo.zip" Condition="Exists('Pacotes\Alinhavo.zip')" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Nexus-Setup</AssemblyName>
    <ApplicationIcon>nexus.ico</ApplicationIcon>
    <Version>1.2.3</Version>
    <Product>Instalador do Nexus</Product>
    <AssemblyTitle>Instalador do Nexus</AssemblyTitle>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
