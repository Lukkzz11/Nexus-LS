<Window x:Class="NexusLS.Setup.JanelaSetup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus — Assistente de Instalação e Ativação"
        Icon="nexus.ico"
        Height="640" Width="860" MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icones.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Sombra Suave -->
            <DropShadowEffect x:Key="SombraSuave" BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.05" />

            <!-- Estilo Card Padrão -->
            <Style x:Key="CardBranco" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Effect" Value="{StaticResource SombraSuave}" />
            </Style>

            <!-- Botão Base -->
            <Style x:Key="BotaoBase" TargetType="Button">
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botão Primário Azul -->
            <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="BorderBrush" Value="#2563EB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1D4ED8" />
                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Botão Secundário Cinza -->
            <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#334155" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Setter Property="BorderBrush" Value="#94A3B8" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Caixa de Texto -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#0F172A" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB" />
                                    <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Cabeçalho com Stepper -->
            <RowDefinition Height="Auto" />
            <!-- 1: Conteúdo Central do Passo -->
            <RowDefinition Height="*" />
            <!-- 2: Rodapé de Navegação -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. CABEÇALHO SUPERIOR ==================== -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Marca Nexus -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                            CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/Assets/emblema.png" Width="22" Height="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NEXUS" FontWeight="Bold" FontSize="16" Foreground="#0F172A" />
                            <TextBlock Text=" SETUP" FontWeight="Black" FontSize="16" Foreground="#2563EB" Margin="3,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Assistente de Instalação e Ativação" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Stepper de Etapas -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Etapa 1 -->
                    <Border x:Name="BadgeStep1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="14" Padding="10,4" Margin="3,0">
                        <TextBlock x:Name="TxtStep1" Text="1. Licença" FontSize="11" FontWeight="Bold" Foreground="#2563EB" />
                    </Border>
                    <!-- Etapa 2 -->
                    <Border x:Name="BadgeStep2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="10,4" Margin="3,0">
                        <TextBlock x:Name="TxtStep2" Text="2. Termos" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </Border>
                    <!-- Etapa 3 -->
                    <Border x:Name="BadgeStep3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="10,4" Margin="3,0">
                        <TextBlock x:Name="TxtStep3" Text="3. Pasta" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </Border>
                    <!-- Etapa 4 -->
                    <Border x:Name="BadgeStep4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="10,4" Margin="3,0">
                        <TextBlock x:Name="TxtStep4" Text="4. Aplicativos" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </Border>
                    <!-- Etapa 5 -->
                    <Border x:Name="BadgeStep5" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="10,4" Margin="3,0">
                        <TextBlock x:Name="TxtStep5" Text="5. Instalação" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1. CONTEÚDO DOS PASSOS ==================== -->
        <Grid Grid.Row="1" Margin="36,24,36,16">

            <!-- PASSO 1: LICENÇA COMERCIAL -->
            <Grid x:Name="PanelPasso1" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" MaxWidth="720">
                    <TextBlock Text="Ativação da Licença Comercial" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Informe a chave de ativação fornecida para seu estabelecimento. O assistente consultará o servidor central para autorizar este computador e carregar os dados contratados."
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,20" TextWrapping="Wrap" LineHeight="20" />

                    <!-- Campo da Chave -->
                    <Border Style="{StaticResource CardBranco}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Chave de Ativação:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtChave" FontFamily="Consolas, Segoe UI" FontSize="15" FontWeight="Bold"
                                         CharacterCasing="Upper" Padding="12,9" TextChanged="TxtChave_TextChanged" />

                                <Button Grid.Column="2" x:Name="BtnColarChave" Style="{StaticResource BotaoSecundario}"
                                        Padding="14,8" Click="BtnColarChave_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeColar}" Width="14" Height="14" Fill="#475569" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Colar" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="4" x:Name="BtnValidarChave" Style="{StaticResource BotaoPrimario}"
                                        Padding="18,8" Click="BtnValidarChave_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeChave}" Width="14" Height="14" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Validar Chave" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Card de Status da Licença -->
                            <Border x:Name="CardStatusLicenca" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStatusLicenca"
                                               Text="Insira a chave da licença comercial acima e clique em 'Validar Chave' para prosseguir."
                                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtDetalhesLicenca" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"
                                               Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- PASSO 2: TERMOS DE USO -->
            <Grid x:Name="PanelPasso2" Visibility="Collapsed">
                <StackPanel MaxWidth="720" VerticalAlignment="Center">
                    <TextBlock Text="Termos de Uso e Licenciamento" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Leia atentamente o contrato de licenciamento de uso do software Nexus antes de continuar com a instalação."
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,16" TextWrapping="Wrap" />

                    <Border Style="{StaticResource CardBranco}" Padding="16" Height="260" Margin="0,0,0,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtTermosConteudo" FontSize="12" Foreground="#334155" TextWrapping="Wrap" LineHeight="19" />
                        </ScrollViewer>
                    </Border>

                    <CheckBox x:Name="ChkAceitoTermos" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                              Checked="ChkAceitoTermos_CheckedChanged" Unchecked="ChkAceitoTermos_CheckedChanged"
                              Content="Li e concordo com os Termos de Uso e com a Política de Licenciamento do Nexus" />
                </StackPanel>
            </Grid>

            <!-- PASSO 3: PASTA DE DESTINO -->
            <Grid x:Name="PanelPasso3" Visibility="Collapsed">
                <StackPanel MaxWidth="720" VerticalAlignment="Center">
                    <TextBlock Text="Local de Instalação" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="O assistente instalará os aplicativos selecionados na pasta indicada abaixo."
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,20" TextWrapping="Wrap" />

                    <Border Style="{StaticResource CardBranco}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Pasta de Instalação:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCaminhoPasta" TextChanged="TxtCaminhoPasta_TextChanged" />
                                <Button Grid.Column="2" x:Name="BtnProcurarPasta" Content="Procurar..." Style="{StaticResource BotaoSecundario}"
                                        Padding="16,8" Click="BtnProcurarPasta_Click" />
                            </Grid>

                            <!-- Informação de Espaço em Disco -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconePasta}" Width="16" Height="16" Fill="#64748B" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="TxtInfoDisco" Text="Espaço livre: Verificando..." FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Espaço necessário: ~500 MB" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- PASSO 4: SELEÇÃO DE APLICATIVOS -->
            <Grid x:Name="PanelPasso4" Visibility="Collapsed">
                <StackPanel MaxWidth="720" VerticalAlignment="Center">
                    <TextBlock Text="Seleção de Aplicativos" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Escolha quais componentes do ecossistema Nexus você deseja instalar e configurar neste computador."
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,16" TextWrapping="Wrap" />

                    <!-- Card App 1: Nexus LS ERP -->
                    <Border Style="{StaticResource CardBranco}" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkNexus" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ChkApp_Changed" Unchecked="ChkApp_Changed" />
                            <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                                    CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                                <Image Source="pack://application:,,,/Assets/emblema.png" Width="26" Height="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Nexus LS — ERP e Frente de Caixa" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                    <Border Background="#EFF6FF" CornerRadius="10" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="Principal" FontSize="10" FontWeight="Bold" Foreground="#2563EB" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Sistema completo de gestão comercial, fechamento de caixa, emissão de vendas e controle de estoque."
                                           FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card App 2: Nexus BarTender -->
                    <Border Style="{StaticResource CardBranco}" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkBarTender" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ChkApp_Changed" Unchecked="ChkApp_Changed" />
                            <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1"
                                    CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                                <Path Data="{StaticResource IconeEtiqueta}" Width="22" Height="22" Fill="#16A34A" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Nexus BarTender — Gerador de Etiquetas" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                    <Border Background="#F0FDF4" CornerRadius="10" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="Módulo" FontSize="10" FontWeight="Bold" Foreground="#16A34A" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Criação, diagramação e impressão de etiquetas térmicas e código de barras para gôndolas e produtos."
                                           FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card App 3: Nexus Hub -->
                    <Border Style="{StaticResource CardBranco}" Padding="16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkAtualizador" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ChkApp_Changed" Unchecked="ChkApp_Changed" />
                            <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                                    CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0">
                                <Path Data="{StaticResource IconeHub}" Width="22" Height="22" Fill="#2563EB" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Nexus Hub — Central de Aplicativos e Atualizador" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                    <Border Background="#EFF6FF" CornerRadius="10" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="Recomendado" FontSize="10" FontWeight="Bold" Foreground="#2563EB" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Central de lançamento dos programas, sincronização de updates oficiais e diagnóstico do ambiente."
                                           FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <CheckBox x:Name="ChkAtalhos" IsChecked="True" FontSize="12" Foreground="#475569"
                              Content="Criar atalhos dos aplicativos selecionados na Área de Trabalho e no Menu Iniciar" />
                </StackPanel>
            </Grid>

            <!-- PASSO 5: PROGRESSO DA INSTALAÇÃO -->
            <Grid x:Name="PanelPasso5" Visibility="Collapsed">
                <StackPanel MaxWidth="600" VerticalAlignment="Center">
                    <TextBlock Text="Instalando o Nexus..." FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                    <TextBlock Text="Aguarde enquanto os arquivos oficiais são baixados, verificados com assinatura digital e configurados no sistema."
                               FontSize="13" Foreground="#64748B" Margin="0,0,0,24" TextWrapping="Wrap" />

                    <Border Style="{StaticResource CardBranco}" Padding="24">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="TxtMensagemProgresso" Text="Preparando instalação..." FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock x:Name="TxtPercentualProgresso" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" />
                            </Grid>

                            <ProgressBar x:Name="BarraProgresso" Height="10" Background="#F1F5F9" Foreground="#2563EB" BorderThickness="0" Margin="0,0,0,12" />

                            <TextBlock x:Name="TxtDetalhesProgresso" Text="Conectando aos servidores de distribuição..." FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- PASSO 6: CONCLUSÃO -->
            <Grid x:Name="PanelPasso6" Visibility="Collapsed">
                <StackPanel MaxWidth="600" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Ícone de Sucesso -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="2" CornerRadius="40"
                            Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Path Data="{StaticResource IconeCheck}" Width="36" Height="36" Stroke="#16A34A" StrokeThickness="3.5"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Instalação Concluída com Sucesso!" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtConclusaoInfo"
                               Text="Os aplicativos selecionados foram instalados e ativados. O Nexus Hub está pronto para ser utilizado como sua central de programas."
                               FontSize="13" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,24" LineHeight="20" />

                    <Button x:Name="BtnConcluirAbrirHub" Style="{StaticResource BotaoPrimario}" Padding="24,12"
                            HorizontalAlignment="Center" Click="BtnConcluirAbrirHub_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconePlay}" Width="14" Height="14" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="ABRIR NEXUS HUB AGORA" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- ==================== 2. RODAPÉ DE NAVEGAÇÃO ==================== -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="28,14">
            <Grid>
                <!-- HWID no rodapé esquerdo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HWID:" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtHwidRodape" Text="Carregando..." FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                    <Button x:Name="BtnCopiarHwidRodape" Style="{StaticResource BotaoSecundario}" Padding="6,2" Margin="8,0,0,0" FontSize="10" Click="BtnCopiarHwidRodape_Click">
                        <TextBlock Text="Copiar" />
                    </Button>
                </StackPanel>

                <!-- Botões de Navegação no rodapé direito -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0" Click="BtnCancelar_Click" />
                    <Button x:Name="BtnVoltar" Content="&lt; Voltar" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0" Click="BtnVoltar_Click" />
                    <Button x:Name="BtnAvancar" Content="Avançar &gt;" Style="{StaticResource BotaoPrimario}" Click="BtnAvancar_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
