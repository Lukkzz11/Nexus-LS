<Window x:Class="NexusLS.Setup.JanelaSetup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistente de Instalação do Nexus"
        Height="620" Width="880" MinHeight="580" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF" Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icones.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Botão Base Padrão Windows Moderno -->
            <Style x:Key="BotaoBase" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botão Primário Azul Institucional -->
            <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
                <Setter Property="Background" Value="#0284C7" />
                <Setter Property="BorderBrush" Value="#0284C7" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#0369A1" />
                        <Setter Property="BorderBrush" Value="#0369A1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Botão Secundário Neutro -->
            <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#334155" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F8FAFC" />
                        <Setter Property="BorderBrush" Value="#94A3B8" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Campo de Texto Padrão Windows -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#0F172A" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#0284C7" />
                                    <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <!-- 0: BRAND SIDEBAR ESQUERDA (ESTILO WINDOWS ENTERPRISE) -->
            <ColumnDefinition Width="260" />
            <!-- 1: ÁREA DE TRABALHO DIREITA -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== COLUNA LATERAL ESQUERDA ==================== -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid Margin="24,28,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho da Sidebar -->
                <StackPanel Grid.Row="0" Margin="0,0,0,32">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <Border Background="#0284C7" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <Image Source="pack://application:,,,/Assets/emblema.png" Width="22" Height="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NEXUS" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="SETUP COMERCIAL" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Assistente de Instalação e Ativação do Ecossistema" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="16" />
                </StackPanel>

                <!-- Passos Verticais (Timeline Corporativa) -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <!-- Passo 1 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BadgeStep1" Width="24" Height="24" CornerRadius="12" Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1">
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtStep1" Text="Licença Comercial" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Chave e validação nuvem" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </Grid>

                    <!-- Passo 2 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BadgeStep2" Width="24" Height="24" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtStep2" Text="Termos de Uso" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" />
                            <TextBlock Text="Contrato de adesão" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </Grid>

                    <!-- Passo 3 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BadgeStep3" Width="24" Height="24" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtStep3" Text="Pasta de Destino" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" />
                            <TextBlock Text="Diretório e espaço livre" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </Grid>

                    <!-- Passo 4 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BadgeStep4" Width="24" Height="24" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock Text="4" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtStep4" Text="Componentes" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" />
                            <TextBlock Text="Nexus LS, BarTender e Hub" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </Grid>

                    <!-- Passo 5 -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BadgeStep5" Width="24" Height="24" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock Text="5" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtStep5" Text="Instalação" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" />
                            <TextBlock Text="Extração e atalhos" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Rodapé da Sidebar (HWID e Suporte) -->
                <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="IDENTIFICADOR (HWID):" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" />
                        <Grid>
                            <TextBlock x:Name="TxtHwidRodape" Text="CARREGANDO..." FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <Button x:Name="BtnCopiarHwidRodape" Content="Copiar" HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"
                                    Cursor="Hand" Click="BtnCopiarHwidRodape_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== ÁREA DE TRABALHO DIREITA ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- 0: Conteúdo da Etapa -->
                <RowDefinition Height="*" />
                <!-- 1: Rodapé de Ações Fixo -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- CONTEÚDO DOS PASSOS -->
            <Grid Grid.Row="0" Margin="32,28,32,20">

                <!-- PASSO 1: LICENÇA COMERCIAL -->
                <Grid x:Name="PanelPasso1" Visibility="Visible">
                    <StackPanel>
                        <TextBlock Text="Identificação e Licença Comercial" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                        <TextBlock Text="Informe a chave fornecida pela administração. O instalador validará o plano e autorizará este terminal."
                                   FontSize="13" Foreground="#475569" Margin="0,0,0,24" TextWrapping="Wrap" />

                        <TextBlock Text="Chave de Ativação:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtChave" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Height="40"
                                     CharacterCasing="Upper" VerticalContentAlignment="Center" Padding="12,0" />
                            <Button Grid.Column="2" x:Name="BtnColarChave" Content="Colar" Style="{StaticResource BotaoSecundario}" Height="40" Click="BtnColarChave_Click" />
                            <Button Grid.Column="4" x:Name="BtnValidarChave" Content="Validar Licença" Style="{StaticResource BotaoPrimario}" Height="40" Click="BtnValidarChave_Click" />
                        </Grid>

                        <!-- Box de Status da Licença -->
                        <Border x:Name="CardStatusLicenca" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtStatusLicenca" Text="Aguardando validação da chave comercial..." FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtDetalhesLicenca" Text="Insira a chave acima e clique em 'Validar Licença' para autorizar este computador." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <TextBlock Text="Nota: Este terminal será vinculado ao HWID registrado. Para transferências, consulte o suporte." FontSize="11" Foreground="#475569" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- PASSO 2: TERMOS DE USO -->
                <Grid x:Name="PanelPasso2" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Contrato de Licença de Uso" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <TextBlock Text="Leia atentamente os termos contratuais para prosseguir com a instalação do sistema." FontSize="13" Foreground="#475569" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtTermosConteudo" FontSize="12" Foreground="#334155" TextWrapping="Wrap" LineHeight="19" />
                            </ScrollViewer>
                        </Border>

                        <CheckBox Grid.Row="2" x:Name="ChkAceitoTermos" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                  Content="Li e concordo com os termos do contrato de licença comercial do software Nexus."
                                  Checked="ChkAceitoTermos_CheckedChanged" Unchecked="ChkAceitoTermos_CheckedChanged" />
                    </Grid>
                </Grid>

                <!-- PASSO 3: PASTA DE DESTINO -->
                <Grid x:Name="PanelPasso3" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Diretório de Instalação" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                        <TextBlock Text="O assistente instalará os arquivos do Nexus na pasta indicada abaixo." FontSize="13" Foreground="#475569" Margin="0,0,0,24" />

                        <TextBlock Text="Pasta de Destino:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCaminhoPasta" Height="38" TextChanged="TxtCaminhoPasta_TextChanged" />
                            <Button Grid.Column="2" x:Name="BtnProcurarPasta" Content="Procurar..." Style="{StaticResource BotaoSecundario}" Height="38" Click="BtnProcurarPasta_Click" />
                        </Grid>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconePasta}" Width="20" Height="20" Fill="#0284C7" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtInfoDisco" Text="Espaço livre em disco: Verificando..." FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                    <TextBlock Text="Espaço necessário aproximado: 350 MB" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- PASSO 4: COMPONENTES A INSTALAR -->
                <Grid x:Name="PanelPasso4" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Seleção de Aplicativos e Módulos" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                        <TextBlock Text="Marque os componentes que deseja configurar nesta estação de trabalho." FontSize="13" Foreground="#475569" Margin="0,0,0,20" />

                        <!-- Módulo Nexus LS -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkNexus" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ChkApp_Changed" Unchecked="ChkApp_Changed" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nexus LS (Sistema ERP &amp; Frente de Caixa PDV)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="Módulo completo com PDV, controle de vendas, estoque, produtos e financeiro." FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Módulo BarTender -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkBarTender" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ChkApp_Changed" Unchecked="ChkApp_Changed" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nexus BarTender (Impressão Térmica de Etiquetas)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="Impressão de gôndola, etiquetas de produtos e integração direta com o ERP." FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Módulo Atualizador Hub -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkAtualizador" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ChkApp_Changed" Unchecked="ChkApp_Changed" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nexus Hub (Central de Aplicativos e Atualizações)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="Lançador unificado, atualização segura automática e monitoramento de licença." FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <CheckBox x:Name="ChkAtalhos" IsChecked="True" FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                  Content="Criar atalhos de acesso direto na Área de Trabalho e no Menu Iniciar." />
                    </StackPanel>
                </Grid>

                <!-- PASSO 5: PROGRESSO DA INSTALAÇÃO -->
                <Grid x:Name="PanelPasso5" Visibility="Collapsed">
                    <Grid VerticalAlignment="Center" Margin="20,0">
                        <StackPanel>
                            <TextBlock Text="Instalando o Ecossistema Nexus..." FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <TextBlock Text="Aguarde enquanto os componentes selecionados são instalados e configurados." FontSize="13" Foreground="#475569" Margin="0,0,0,24" />

                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="TxtMensagemProgresso" Text="Preparando instalação..." FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock x:Name="TxtPercentualProgresso" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right" />
                            </Grid>

                            <ProgressBar x:Name="BarraProgresso" Height="8" Background="#F1F5F9" Foreground="#0284C7" BorderThickness="0" Margin="0,0,0,12" />
                            <TextBlock x:Name="TxtDetalhesProgresso" Text="Conectando aos servidores de distribuição..." FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- PASSO 6: CONCLUSÃO -->
                <Grid x:Name="PanelPasso6" Visibility="Collapsed">
                    <Grid VerticalAlignment="Center" Margin="20,0">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="30" Width="60" Height="60" Margin="0,0,0,16" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconeCheck}" Width="26" Height="26" Fill="#16A34A" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Instalação Concluída com Sucesso!" FontSize="20" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock x:Name="TxtConclusaoInfo" Text="O Nexus foi instalado com êxito neste computador. Você pode iniciar os programas diretamente através do Nexus Hub."
                                       FontSize="13" Foreground="#475569" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="19" />

                            <Button x:Name="BtnConcluirAbrirHub" Content="Concluir e Abrir o Nexus Hub" Style="{StaticResource BotaoPrimario}" Height="42"
                                    HorizontalAlignment="Center" Padding="28,0" Click="BtnConcluirAbrirHub_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ==================== RODAPÉ FIXO DE NAVEGAÇÃO ==================== -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <TextBlock Text="Nexus Comercial • Todos os direitos reservados" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" Click="BtnCancelar_Click" />
                        <Button x:Name="BtnVoltar" Content="&lt; Voltar" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" Click="BtnVoltar_Click" />
                        <Button x:Name="BtnAvancar" Content="Avançar &gt;" Style="{StaticResource BotaoPrimario}" Click="BtnAvancar_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>