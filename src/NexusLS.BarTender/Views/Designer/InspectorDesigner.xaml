<UserControl x:Class="NexusLS.BarTender.Views.Designer.InspectorDesigner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:NexusLS.BarTender.ViewModels"
             xmlns:models="clr-namespace:NexusLS.BarTender.Models.Designer"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DesignerViewModel}">

    <UserControl.Resources>
        <Style x:Key="SubsecaoCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CorCabecalho}" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RaioMedio}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <!-- ==================== DIREITA: PAINEL INSPECTOR CONTEXTUAL & CAMADAS ==================== -->
    <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1,0,0,0" Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Abas Seletoras: Propriedades / Camadas -->
                <RowDefinition Height="Auto" />
                <!-- 1: Conteúdo da Aba Ativa -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- SELETOR DE ABAS DO INSPECTOR (PROPRIEDADES vs CAMADAS) -->
            <Border Grid.Row="0" Background="{StaticResource CorSuperficieSubtil}" CornerRadius="{StaticResource RaioPequeno}" Padding="3" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Aba 1: Propriedades -->
                    <Button Grid.Column="0" Command="{Binding MudarAbaInspetorCommand}" CommandParameter="Propriedades" Padding="8,6" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="{StaticResource TamPequeno}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RaioPequeno}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AbaInspetorAtiva}" Value="Propriedades">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Propriedades" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Aba 2: Camadas -->
                    <Button Grid.Column="1" Command="{Binding MudarAbaInspetorCommand}" CommandParameter="Camadas" Padding="8,6" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="{StaticResource TamPequeno}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RaioPequeno}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AbaInspetorAtiva}" Value="Camadas">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Layer24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Camadas" VerticalAlignment="Center" />
                            <Border Background="{StaticResource CorSelecao}" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalCamadas}" Foreground="{StaticResource CorDestaqueTexto}" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTEÚDO DAS ABAS -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- ==================== ABA 1: PROPRIEDADES CONTEXTUAIS ==================== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AbaInspetorAtiva}" Value="Propriedades">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- CONTEXTO A: PROPRIEDADES DA FOLHA (quando nenhum objeto está selecionado) -->
                        <StackPanel Visibility="{Binding ElementoSelecionado, Converter={StaticResource NullParaColapsadoConverter}, ConverterParameter=invert}">
                            <Border Background="{StaticResource CorSuperficieSuave}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="DocumentPageBottomCenter24" FontSize="18" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Propriedades da Folha" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CorTexto}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Dimensões físicas reais e orientação da etiqueta em milímetros:" Style="{StaticResource TextoApoio}" Margin="0,0,0,12" />

                                    <!-- Largura e Altura da Folha -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Largura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding FolhaLarguraMm, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" KeyDown="FolhaTextBox_KeyDown" FontWeight="Bold" FontSize="13" Padding="6,4" TextAlignment="Center" ToolTip="Pressione Enter para aplicar" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Altura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding FolhaAlturaMm, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" KeyDown="FolhaTextBox_KeyDown" FontWeight="Bold" FontSize="13" Padding="6,4" TextAlignment="Center" ToolTip="Pressione Enter para aplicar" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Botão Inverter Orientação -->
                                    <Button Command="{Binding AlternarOrientacaoFolhaCommand}" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Stretch" Margin="0,0,0,14" Padding="10,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Girar Folha (Paisagem / Retrato)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Predefinições Rápidas de Tamanho -->
                                    <TextBlock Text="MEDIDAS PRONTAS DA FOLHA (MM)" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamMicro}" FontWeight="Bold" Margin="0,0,0,6" />
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="35x60" Style="{StaticResource BotaoSecundario}" Margin="0,0,3,4" Padding="4,5" Content="35 × 60 mm (Tag)" FontSize="11" />
                                        <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="50x30" Style="{StaticResource BotaoSecundario}" Margin="3,0,0,4" Padding="4,5" Content="50 × 30 mm" FontSize="11" />
                                        <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="40x25" Style="{StaticResource BotaoSecundario}" Margin="0,0,3,4" Padding="4,5" Content="40 × 25 mm" FontSize="11" />
                                        <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="60x40" Style="{StaticResource BotaoSecundario}" Margin="3,0,0,4" Padding="4,5" Content="60 × 40 mm" FontSize="11" />
                                        <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="100x50" Style="{StaticResource BotaoSecundario}" Margin="0,0,3,0" Padding="4,5" Content="100 × 50 mm" FontSize="11" />
                                        <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="30x20" Style="{StaticResource BotaoSecundario}" Margin="3,0,0,0" Padding="4,5" Content="30 × 20 mm (Joias)" FontSize="11" />
                                    </UniformGrid>

                                </StackPanel>
                            </Border>

                            <!-- Opções de Guias e Grade da Prancheta -->
                            <Border Style="{StaticResource SubsecaoCard}">
                                <StackPanel>
                                    <TextBlock Text="AJUDAS NA TELA" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" Margin="0,0,0,8" />
                                    <CheckBox Content="Grade de 5 mm" IsChecked="{Binding MostrarGrade, Mode=TwoWay}" Margin="0,0,0,6" />
                                    <CheckBox Content="Ímã e guias de alinhamento" IsChecked="{Binding SnapGrade, Mode=TwoWay}" Margin="0,0,0,6" />
                                    <CheckBox Content="Mostrar dados reais" IsChecked="{Binding MostrarDadosReais, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- CONTEXTO B: PROPRIEDADES DO OBJETO SELECIONADO -->
                        <StackPanel Visibility="{Binding ElementoSelecionado, Converter={StaticResource NullParaColapsadoConverter}}">
                            <!-- Cabeçalho Contextual do Objeto -->
                            <Border Background="{StaticResource CorSuperficieSuave}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="{Binding ElementoSelecionado.Tipo}" Foreground="{StaticResource CorPrimaria}" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Botões Rápidos: Travar Proporção & Travar Objeto -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding AlternarProporcaoSelecionadoCommand}" Width="26" Height="26" Padding="0" Margin="0,0,4,0"
                                                    ToolTip="Travar / Destravar proporções ao redimensionar" AutomationProperties.Name="Travar proporção">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementoSelecionado.ManterProporcao}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource CorSelecao}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                                <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ui:SymbolIcon Symbol="Link24" FontSize="13" />
                                            </Button>

                                            <Button Command="{Binding AlternarBloqueioSelecionadoCommand}" Width="26" Height="26" Padding="0"
                                                    ToolTip="Travar / Destravar posição e edição deste objeto" AutomationProperties.Name="Travar objeto">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementoSelecionado.Bloqueado}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource CorAvisoFundo}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource CorAvisoBorda}" />
                                                                <Setter Property="Foreground" Value="{StaticResource CorAvisoTexto}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Nome da Camada" Style="{StaticResource Rotulo}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding ElementoSelecionado.Nome, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <!-- Geometria e Posicionamento em Milímetros -->
                            <Border Style="{StaticResource SubsecaoCard}">
                                <StackPanel>
                                    <TextBlock Text="GEOMETRIA &amp; POSIÇÃO (MM)" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,8" />

                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Posição X (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding ElementoSelecionado.X, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="Posição Y (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding ElementoSelecionado.Y, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Largura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding ElementoSelecionado.Largura, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="Altura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding ElementoSelecionado.Altura, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="Rotação (°)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                    <UniformGrid Columns="4">
                                        <Button Command="{Binding DefinirRotacaoCommand}" CommandParameter="0" Style="{StaticResource BotaoSecundario}" Padding="4,4" Margin="0,0,2,0" Content="0°" FontSize="11" />
                                        <Button Command="{Binding DefinirRotacaoCommand}" CommandParameter="90" Style="{StaticResource BotaoSecundario}" Padding="4,4" Margin="2,0,2,0" Content="90°" FontSize="11" />
                                        <Button Command="{Binding DefinirRotacaoCommand}" CommandParameter="180" Style="{StaticResource BotaoSecundario}" Padding="4,4" Margin="2,0,2,0" Content="180°" FontSize="11" />
                                        <Button Command="{Binding DefinirRotacaoCommand}" CommandParameter="270" Style="{StaticResource BotaoSecundario}" Padding="4,4" Margin="2,0,0,0" Content="270°" FontSize="11" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- 1. PAINEL CONTEXTUAL DE TEXTO -->
                            <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=Texto}">
                                <Border Style="{StaticResource SubsecaoCard}">
                                    <StackPanel>
                                        <TextBlock Text="TIPOGRAFIA &amp; CONTEÚDO" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="11.5" Margin="0,0,0,8" />

                                        <TextBlock Text="Campo Vinculado do Produto" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding VariaveisDisponiveis}"
                                                  SelectedItem="{Binding ElementoSelecionado.Variavel, Mode=TwoWay}"
                                                  Margin="0,0,0,8" />

                                        <TextBlock Text="Texto / Máscara ({Nome}, {Preco})" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ElementoSelecionado.Texto, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="44" Margin="0,0,0,4" />

                                        <TextBlock Text="Inserir Variável Rápida:" Style="{StaticResource TextoApoio}" FontSize="10" Margin="0,2,0,4" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Nome}" Style="{StaticResource BotaoSecundario}" Content="+ {Nome}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                            <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="R$ {Preco}" Style="{StaticResource BotaoSecundario}" Content="+ R$ {Preco}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                            <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Ref}" Style="{StaticResource BotaoSecundario}" Content="+ {Ref}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                            <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Tamanho}" Style="{StaticResource BotaoSecundario}" Content="+ {Tamanho}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                            <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Codigo}" Style="{StaticResource BotaoSecundario}" Content="+ {Codigo}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                            <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Loja}" Style="{StaticResource BotaoSecundario}" Content="+ {Loja}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                        </WrapPanel>

                                        <TextBlock Text="Família da Fonte" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding FontesDisponiveis}" SelectedItem="{Binding ElementoSelecionado.Fonte, Mode=TwoWay}"
                                                  IsEditable="True" MaxDropDownHeight="280" Margin="0,0,0,8">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12.5" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tamanho (pt)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ElementoSelecionado.TamanhoFonte, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Espaçamento Letras" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ElementoSelecionado.EspacamentoLetras, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" ToolTip="0 = Normal, 1 = Médio, 2 = Largo" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Alinhamento do Texto" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <UniformGrid Columns="3" Margin="0,0,0,8">
                                            <Button Command="{Binding DefinirAlinhamentoTextoCommand}" CommandParameter="Left" Style="{StaticResource BotaoSecundario}" Padding="4,5" Margin="0,0,2,0" ToolTip="Alinhar à Esquerda">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="AlignLeft24" FontSize="13" Margin="0,0,4,0" />
                                                    <TextBlock Text="Esq" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DefinirAlinhamentoTextoCommand}" CommandParameter="Center" Style="{StaticResource BotaoSecundario}" Padding="4,5" Margin="2,0,2,0" ToolTip="Centralizar Texto">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="AlignCenterHorizontal24" FontSize="13" Margin="0,0,4,0" />
                                                    <TextBlock Text="Centro" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DefinirAlinhamentoTextoCommand}" CommandParameter="Right" Style="{StaticResource BotaoSecundario}" Padding="4,5" Margin="2,0,0,0" ToolTip="Alinhar à Direita">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="AlignRight24" FontSize="13" Margin="0,0,4,0" />
                                                    <TextBlock Text="Dir" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>

                                        <TextBlock Text="Peso e Estilo" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <CheckBox Content="Negrito" IsChecked="{Binding ElementoSelecionado.Negrito, Mode=TwoWay}" Margin="0,0,10,0" />
                                            <CheckBox Content="Itálico" IsChecked="{Binding ElementoSelecionado.Italico, Mode=TwoWay}" Margin="0,0,10,0" />
                                            <CheckBox Content="Riscado" IsChecked="{Binding ElementoSelecionado.Riscado, Mode=TwoWay}" />
                                        </StackPanel>

                                        <TextBlock Text="Cor do Texto" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#000000" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Preto">
                                                <Ellipse Width="14" Height="14" Fill="#000000" Stroke="#94A3B8" StrokeThickness="1" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#FFFFFF" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Branco">
                                                <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#94A3B8" StrokeThickness="1" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#DC2626" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Vermelho">
                                                <Ellipse Width="14" Height="14" Fill="#DC2626" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#2563EB" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Azul">
                                                <Ellipse Width="14" Height="14" Fill="#2563EB" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#16A34A" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,8,0" ToolTip="Verde">
                                                <Ellipse Width="14" Height="14" Fill="#16A34A" />
                                            </Button>
                                            <TextBox Text="{Binding ElementoSelecionado.CorTexto, UpdateSourceTrigger=PropertyChanged}" Width="75" FontSize="11" Padding="4,2" VerticalAlignment="Center" ToolTip="Código Hexadecimal da cor" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 2. PAINEL CONTEXTUAL DE CÓDIGO DE BARRAS & QR CODE -->
                            <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=CodigoBarras}">
                                <Border Style="{StaticResource SubsecaoCard}">
                                    <StackPanel>
                                        <TextBlock Text="CÓDIGO DE BARRAS &amp; QR CODE" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="11.5" Margin="0,0,0,8" />

                                        <TextBlock Text="Simbologia / Tipo" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding TiposCodigoDisponiveis}"
                                                  SelectedItem="{Binding ElementoSelecionado.TipoCodigo, Mode=TwoWay}"
                                                  Margin="0,0,0,8" />

                                        <TextBlock Text="Origem dos Dados (Vínculo)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding VariaveisDisponiveis}"
                                                  SelectedItem="{Binding ElementoSelecionado.Variavel, Mode=TwoWay}"
                                                  Margin="0,0,0,8" />

                                        <TextBlock Text="Conteúdo / Valor Fixo (URL, Pix ou Código)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ElementoSelecionado.ValorCodigo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                        <CheckBox Content="Mostrar Numeração Legível Abaixo das Barras"
                                                  IsChecked="{Binding ElementoSelecionado.MostrarTextoLegivel, Mode=TwoWay}"
                                                  Margin="0,2,0,10" />

                                        <Border Background="{StaticResource CorDestaqueFundo}" BorderBrush="{StaticResource CorDestaqueBorda}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                            <TextBlock Text="💡 Vinculado ao produto: gera automaticamente Referência + Ordem do Tamanho (ex: 14021 para Tam 42, 14022 para Tam 44)." FontSize="10" Foreground="{StaticResource CorPrimariaPressionada}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 3. PAINEL CONTEXTUAL DE IMAGEM / LOGOTIPO -->
                            <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=Imagem}">
                                <Border Style="{StaticResource SubsecaoCard}">
                                    <StackPanel>
                                        <TextBlock Text="LOGOTIPO &amp; IMAGEM" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="11.5" Margin="0,0,0,8" />

                                        <Button Command="{Binding TrocarImagemElementoCommand}" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Stretch" Padding="10,7" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Substituir Imagem (PNG / JPG)..." FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <CheckBox Content="Manter Proporção Original (Sem Distorcer)" IsChecked="{Binding ElementoSelecionado.ManterProporcao, Mode=TwoWay}" Margin="0,0,0,6" />
                                        <CheckBox Content="Alto Contraste Monocromático (Térmica)" IsChecked="{Binding ElementoSelecionado.Monocromatico, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 4. PAINEL CONTEXTUAL DE FORMAS (RETÂNGULO / LINHA) -->
                            <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=Forma}">
                                <Border Style="{StaticResource SubsecaoCard}">
                                    <StackPanel>
                                        <TextBlock Text="BORDA &amp; PREENCHIMENTO" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="11.5" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Espessura Borda (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ElementoSelecionado.EspessuraBorda, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Raio dos Cantos (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ElementoSelecionado.RaioCanto, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Cor do Traço / Borda" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#000000" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Preto">
                                                <Ellipse Width="14" Height="14" Fill="#000000" Stroke="#94A3B8" StrokeThickness="1" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#64748B" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Cinza">
                                                <Ellipse Width="14" Height="14" Fill="#64748B" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#DC2626" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Vermelho">
                                                <Ellipse Width="14" Height="14" Fill="#DC2626" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#2563EB" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,8,0" ToolTip="Azul">
                                                <Ellipse Width="14" Height="14" Fill="#2563EB" />
                                            </Button>
                                            <TextBox Text="{Binding ElementoSelecionado.CorTexto, UpdateSourceTrigger=PropertyChanged}" Width="75" FontSize="11" Padding="4,2" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <CheckBox Content="Preencher Fundo da Forma" IsChecked="{Binding ElementoSelecionado.Preenchido, Mode=TwoWay}" Margin="0,0,0,6" />

                                        <StackPanel Orientation="Horizontal" Visibility="{Binding ElementoSelecionado.Preenchido, Converter={StaticResource BoolParaVisibilidadeConverter}}">
                                            <Button Command="{Binding DefinirCorFundoCommand}" CommandParameter="#000000" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Fundo Preto">
                                                <Ellipse Width="14" Height="14" Fill="#000000" Stroke="#94A3B8" StrokeThickness="1" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorFundoCommand}" CommandParameter="#F1F5F9" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Fundo Cinza Claro">
                                                <Ellipse Width="14" Height="14" Fill="#F1F5F9" Stroke="#94A3B8" StrokeThickness="1" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorFundoCommand}" CommandParameter="#FEF3C7" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Fundo Amarelo Suave">
                                                <Ellipse Width="14" Height="14" Fill="#FEF3C7" Stroke="#94A3B8" StrokeThickness="1" />
                                            </Button>
                                            <Button Command="{Binding DefinirCorFundoCommand}" CommandParameter="#DCFCE7" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,8,0" ToolTip="Fundo Verde Suave">
                                                <Ellipse Width="14" Height="14" Fill="#DCFCE7" Stroke="#94A3B8" StrokeThickness="1" />
                                            </Button>
                                            <TextBox Text="{Binding ElementoSelecionado.CorFundo, UpdateSourceTrigger=PropertyChanged}" Width="75" FontSize="11" Padding="4,2" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==================== ABA 2: GERENCIADOR DE CAMADAS APRIMORADO ==================== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AbaInspetorAtiva}" Value="Camadas">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Gerenciador de Camadas" Style="{StaticResource TituloSecao}" Margin="0,0,0,2" />
                        <TextBlock Text="Renomeie, oculte, bloqueie ou reordene os elementos" Style="{StaticResource TextoApoio}" Margin="0,0,0,10" />

                        <!-- Barra de Ferramentas das Camadas -->
                        <Border Background="{StaticResource CorSuperficieSuave}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="6,4" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding SubirCamadaCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Subir camada / Avançar (Ctrl + ])" AutomationProperties.Name="Subir camada">
                                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="13" />
                                    </Button>
                                    <Button Command="{Binding DescerCamadaCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,6,0" ToolTip="Descer camada / Recuar (Ctrl + [)" AutomationProperties.Name="Descer camada">
                                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="13" />
                                    </Button>
                                    <Button Command="{Binding AgruparCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Agrupar selecionados (Ctrl + G)" AutomationProperties.Name="Agrupar selecionados">
                                        <ui:SymbolIcon Symbol="Group24" FontSize="13" />
                                    </Button>
                                    <Button Command="{Binding DesagruparCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,6,0" ToolTip="Desagrupar objetos (Ctrl + Shift + G)" AutomationProperties.Name="Desagrupar objetos">
                                        <ui:SymbolIcon Symbol="GroupDismiss24" FontSize="13" />
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding DuplicarSelecionadoCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Duplicar camada selecionada (Ctrl + D)" AutomationProperties.Name="Duplicar camada">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" />
                                    </Button>
                                    <Button Command="{Binding ExcluirSelecionadoCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" ToolTip="Excluir camada (Del)" AutomationProperties.Name="Excluir camada">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="{StaticResource CorPerigo}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Lista de Camadas (Topo da lista = Frente da prancheta) -->
                        <Border Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}">
                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CamadasOrdenadas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ElementoDesign}">
                                            <Border BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="8,6" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelecionarElementoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource CorDestaqueFundo}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource CorSuperficieSuave}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Botão de Visibilidade (Olho) -->
                                                    <Button Grid.Column="0"
                                                            Command="{Binding DataContext.AlternarVisibilidadeCamadaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="24" Height="24" Padding="0" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Ocultar / Mostrar na prancheta" AutomationProperties.Name="Alternar visibilidade da camada">
                                                        <ui:SymbolIcon Symbol="Eye24" FontSize="14">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Visivel}" Value="False">
                                                                            <Setter Property="Foreground" Value="#CBD5E1" />
                                                                            <Setter Property="Symbol" Value="EyeOff24" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </Button>

                                                    <!-- Botão de Bloqueio (Cadeado) -->
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.AlternarBloqueioCamadaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="24" Height="24" Padding="0" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Bloquear / Desbloquear camada contra seleção e movimento" AutomationProperties.Name="Alternar bloqueio da camada">
                                                        <ui:SymbolIcon Symbol="LockOpen24" FontSize="13">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Bloqueado}" Value="True">
                                                                            <Setter Property="Foreground" Value="#D97706" />
                                                                            <Setter Property="Symbol" Value="LockClosed24" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </Button>

                                                    <!-- Ícone Distintivo do Tipo de Objeto -->
                                                    <Border Grid.Column="2" Background="{StaticResource CorSuperficieSubtil}" CornerRadius="4" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Document24" FontSize="13" Foreground="{StaticResource CorTextoSuave}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tipo}" Value="Texto">
                                                                            <Setter Property="Symbol" Value="TextFont24" />
                                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tipo}" Value="CodigoBarras">
                                                                            <Setter Property="Symbol" Value="BarcodeScanner24" />
                                                                            <Setter Property="Foreground" Value="#059669" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tipo}" Value="Imagem">
                                                                            <Setter Property="Symbol" Value="Image24" />
                                                                            <Setter Property="Foreground" Value="#7C3AED" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tipo}" Value="Retangulo">
                                                                            <Setter Property="Symbol" Value="Square24" />
                                                                            <Setter Property="Foreground" Value="#D97706" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tipo}" Value="Linha">
                                                                            <Setter Property="Symbol" Value="LineHorizontal124" />
                                                                            <Setter Property="Foreground" Value="#475569" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </Border>

                                                    <!-- Nome Editável + Resumo Visual do Objeto -->
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="Transparent" BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                                                 Padding="2,0" Foreground="{StaticResource CorTexto}">
                                                            <TextBox.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SelecionarElementoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              CommandParameter="{Binding}" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                        <TextBlock Text="{Binding ResumoCamada}" FontSize="10" Foreground="{StaticResource CorTextoSuave}" Margin="2,1,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Reordenar Rápido & Badge de Grupo -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{StaticResource CorTagExclusivaFundo}" BorderBrush="{StaticResource CorTagExclusivaBorda}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                Visibility="{Binding GrupoId, Converter={StaticResource NullParaColapsadoConverter}}">
                                                            <TextBlock Text="{Binding NomeGrupo, TargetNullValue='Grupo'}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CorTagExclusivaTexto}" />
                                                        </Border>

                                                        <Button Command="{Binding DataContext.SubirCamadaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Subir camada">
                                                            <ui:SymbolIcon Symbol="ChevronUp24" FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                                                        </Button>
                                                        <Button Command="{Binding DataContext.DescerCamadaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Descer camada">
                                                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border Background="{StaticResource CorSuperficieSuave}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="10,8" Margin="0,10,0,0">
                            <TextBlock Text="💡 Clique em qualquer camada para selecioná-la no canvas ou edite o nome diretamente na lista." FontSize="10.5" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
