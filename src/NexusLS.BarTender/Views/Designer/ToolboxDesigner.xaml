<UserControl x:Class="NexusLS.BarTender.Views.Designer.ToolboxDesigner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:NexusLS.BarTender.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DesignerViewModel}">

    <UserControl.Resources>
        <Style x:Key="BotaoToolbox" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,1,0" Padding="12,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dados do produto" Style="{StaticResource Rotulo}" Margin="0,0,0,8" />
                <Button Command="{Binding InserirVariavelCommand}" CommandParameter="NomeProduto" Style="{StaticResource BotaoToolbox}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Box24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nome" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding InserirVariavelCommand}" CommandParameter="PrecoVarejo" Style="{StaticResource BotaoToolbox}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Money24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Preço" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AdicionarTamanhoCommand}" Style="{StaticResource BotaoToolbox}" ToolTip="Muda sozinho conforme o tamanho escolhido">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextExpand24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Tamanho" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding InserirVariavelCommand}" CommandParameter="Referencia" Style="{StaticResource BotaoToolbox}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Tag24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Referência" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AdicionarCodigoBarrasCommand}" Style="{StaticResource BotaoToolbox}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Código de barras" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Livre" Style="{StaticResource Rotulo}" Margin="0,12,0,8" />
                <Button Command="{Binding AdicionarTextoCommand}" Style="{StaticResource BotaoToolbox}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextFont24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Texto" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AdicionarImagemCommand}" Style="{StaticResource BotaoToolbox}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Image24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Logo / imagem" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Expander Header="Mais itens" Margin="0,12,0,0" Background="Transparent" BorderThickness="0">
                    <StackPanel Margin="0,8,0,0">
                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="PrecoAtacado" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Money24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Preço de atacado" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="NomeLoja" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BuildingShop24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Nome da loja" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="CodigoBarras" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Campo de código (EAN)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AdicionarQrCodeCommand}" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="QrCode24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="QR Code (Pix ou link)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AdicionarRetanguloCommand}" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Square24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Moldura" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AdicionarLinhaCommand}" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="LineHorizontal124" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Linha" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
