<UserControl x:Class="NexusLS.BarTender.Views.Designer.RibbonDesigner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:NexusLS.BarTender.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DesignerViewModel}">

    <UserControl.Resources>
        <Style x:Key="BotaoRibbon" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="28" />
        </Style>

        <Style x:Key="BotaoIconeRibbon" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>

        <Style x:Key="RotuloGrupoRibbon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <!-- ==================== 0: BARRA DE COMANDOS / RIBBON ==================== -->
    <StackPanel>
        <!-- BARRA DE VÍNCULO DO PRODUTO ATIVO (quando aberto pelo catálogo) -->
        <Border Background="{StaticResource CorDestaqueFundo}" BorderBrush="{StaticResource CorDestaqueBorda}" BorderThickness="0,0,0,1" Padding="14,5"
                Visibility="{Binding ModoProdutoAtivo, Converter={StaticResource BoolParaVisibilidadeConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CorSelecao}" BorderBrush="{StaticResource CorDestaqueBorda}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Tag24" FontSize="13" Foreground="{StaticResource CorDestaqueTexto}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="PRODUTO DO SISTEMA:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource CorDestaqueTexto}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding NomeProdutoAtivo}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CorTexto}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RefProdutoAtivo, StringFormat='{} (REF: {0})'}" Foreground="{StaticResource CorTextoSuave}" FontSize="11" VerticalAlignment="Center" Margin="4,0,10,0" />

                    <!-- Badge se tem etiqueta cadastrada -->
                    <Border Background="{StaticResource CorSucessoFundo}" BorderBrush="{StaticResource CorSucessoBorda}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                            Visibility="{Binding ProdutoTemEtiquetaExclusiva, Converter={StaticResource BoolParaVisibilidadeConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="{StaticResource CorSucessoTexto}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Etiqueta Exclusiva Vinculada" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource CorSucessoTexto}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CorAvisoFundo}" BorderBrush="{StaticResource CorAvisoBorda}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProdutoTemEtiquetaExclusiva}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Usando Modelo Padrão Global" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource CorAvisoTexto}" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Botões de Ação para o Produto -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SalvarEtiquetaNoProdutoCommand}" Style="{StaticResource BotaoPrimario}" Padding="12,5" Margin="0,0,6,0"
                            ToolTip="Cadastrar este layout como etiqueta exclusiva deste produto e aplicar a todos os tamanhos da referência">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Salvar Etiqueta Neste Produto" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RestaurarEtiquetaPadraoProdutoCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,5" FontSize="11.5"
                            Visibility="{Binding ProdutoTemEtiquetaExclusiva, Converter={StaticResource BoolParaVisibilidadeConverter}}"
                            ToolTip="Remover a etiqueta exclusiva deste produto e voltar a usar a etiqueta padrão">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Restaurar Padrão" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de Ribbon Principal Organizada em Grupos -->
        <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="10,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- GRUPO 1: DOCUMENTO & FOLHA -->
                <StackPanel Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding AbrirNovoDocumentoCommand}" Style="{StaticResource BotaoPrimario}" Height="28" Padding="10,0" Margin="0,0,5,0" ToolTip="Criar nova folha / modelo de etiqueta (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Novo" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AbrirGaleriaModelosCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Ver catálogo completo de modelos e predefinições">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Modelos" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="{StaticResource CorSelecaoSuave}" CornerRadius="4" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CatalogoModelos.Count}" Foreground="{StaticResource CorPrimaria}" FontSize="9.5" FontWeight="Black" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <ComboBox ItemsSource="{Binding PresetsDisponiveis}" SelectedItem="{Binding PresetSelecionado}" Width="165" Height="28" FontSize="11" Margin="0,0,5,0"
                                  SelectionChanged="PresetComboBox_SelectionChanged" ToolTip="Trocar layout atual rapidamente" />

                        <Border Background="{StaticResource CorSuperficieSuave}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="5,1" Height="28" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="L:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="0,0,2,0" />
                                <TextBox Text="{Binding FolhaLarguraMm, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" KeyDown="FolhaTextBox_KeyDown" Width="34" Height="22" Padding="1,0" FontSize="11" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" ToolTip="Largura da Folha (mm)" />
                                <TextBlock Text="×A:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="3,0,2,0" />
                                <TextBox Text="{Binding FolhaAlturaMm, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" KeyDown="FolhaTextBox_KeyDown" Width="34" Height="22" Padding="1,0" FontSize="11" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" ToolTip="Altura da Folha (mm)" />
                                <TextBlock Text="mm" FontSize="9.5" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="2,0,4,0" />
                                <Button Command="{Binding AlternarOrientacaoFolhaCommand}" Style="{StaticResource BotaoSecundario}" Width="22" Height="22" Padding="0" ToolTip="Inverter Orientação (Paisagem / Retrato)" AutomationProperties.Name="Inverter Orientação">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="DOCUMENTO &amp; FOLHA" Style="{StaticResource RotuloGrupoRibbon}" />
                </StackPanel>

                <Border Width="1" Height="36" Background="{StaticResource CorBorda}" Margin="4,0,8,0" />

                <!-- GRUPO 2: EDIÇÃO & HISTÓRICO -->
                <StackPanel Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding AlternarFerramentaMaoCommand}" ToolTip="Ferramenta Mão para arrastar a área (H ou Segurar Espaço)" AutomationProperties.Name="Ferramenta Mão">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotaoIconeRibbon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FerramentaMaoAtiva}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CorSelecao}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                            <Setter Property="Foreground" Value="{StaticResource CorDestaqueTexto}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="HandRight24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding DesfazerCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Desfazer (Ctrl+Z)" AutomationProperties.Name="Desfazer">
                            <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding RefazerCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Refazer (Ctrl+Y)" AutomationProperties.Name="Refazer">
                            <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding CopiarCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Copiar (Ctrl+C)" AutomationProperties.Name="Copiar">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding ColarCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Colar (Ctrl+V)" AutomationProperties.Name="Colar">
                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding DuplicarSelecionadoCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Duplicar objeto (Ctrl+D)" AutomationProperties.Name="Duplicar">
                            <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding AgruparCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Agrupar selecionados (Ctrl+G)" AutomationProperties.Name="Agrupar">
                            <ui:SymbolIcon Symbol="Group24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding DesagruparCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Desagrupar objetos (Ctrl+Shift+G)" AutomationProperties.Name="Desagrupar">
                            <ui:SymbolIcon Symbol="GroupDismiss24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding ExcluirSelecionadoCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Excluir selecionado (Del)" AutomationProperties.Name="Excluir">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="{StaticResource CorPerigo}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="HISTÓRICO &amp; EDIÇÃO" Style="{StaticResource RotuloGrupoRibbon}" />
                </StackPanel>

                <Border Width="1" Height="36" Background="{StaticResource CorBorda}" Margin="4,0,8,0" />

                <!-- GRUPO 3: ALINHAR, DISTRIBUIR & ORDEM -->
                <StackPanel Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding CentralizarNaPaginaCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Centralizar no centro da etiqueta (P)" AutomationProperties.Name="Centralizar na página">
                            <ui:SymbolIcon Symbol="Maximize24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding CentralizarHorizontalmenteCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Centralizar Horizontalmente (C)" AutomationProperties.Name="Centralizar horizontalmente">
                            <ui:SymbolIcon Symbol="AlignCenterHorizontal24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding CentralizarVerticalmenteCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Centralizar Verticalmente (E)" AutomationProperties.Name="Centralizar verticalmente">
                            <ui:SymbolIcon Symbol="AlignCenterVertical24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding AlinharEsquerdaCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Alinhar à Esquerda (L)" AutomationProperties.Name="Alinhar à esquerda">
                            <ui:SymbolIcon Symbol="AlignLeft24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding AlinharDireitaCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Alinhar à Direita (R)" AutomationProperties.Name="Alinhar à direita">
                            <ui:SymbolIcon Symbol="AlignRight24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding AlinharTopoCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Alinhar ao Topo (T)" AutomationProperties.Name="Alinhar ao topo">
                            <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding AlinharBaseCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Alinhar à Base (B)" AutomationProperties.Name="Alinhar à base">
                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding DistribuirHorizontalmenteCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Distribuir objetos uniformemente na horizontal" AutomationProperties.Name="Distribuir horizontalmente">
                            <ui:SymbolIcon Symbol="AlignSpaceEvenlyHorizontal24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding DistribuirVerticalmenteCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Distribuir objetos uniformemente na vertical" AutomationProperties.Name="Distribuir verticalmente">
                            <ui:SymbolIcon Symbol="AlignSpaceEvenlyVertical24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding TrazerParaFrenteCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Trazer para a Frente (Ctrl+Shift+])" AutomationProperties.Name="Trazer para a frente">
                            <ui:SymbolIcon Symbol="ArrowSortUp24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding EnviarParaTrasCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Enviar para Trás (Ctrl+Shift+[)" AutomationProperties.Name="Enviar para trás">
                            <ui:SymbolIcon Symbol="ArrowSortDown24" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="ALINHAR, DISTRIBUIR &amp; ORDEM" Style="{StaticResource RotuloGrupoRibbon}" />
                </StackPanel>

                <Border Width="1" Height="36" Background="{StaticResource CorBorda}" Margin="4,0,8,0" />

                <!-- GRUPO 4: ZOOM & ESCALA -->
                <StackPanel Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding Zoom100Command}" Style="{StaticResource BotaoRibbon}" Content="100%" Padding="6,0" ToolTip="Zoom 100% (Escala real)" />
                        <Button Command="{Binding Zoom200Command}" Style="{StaticResource BotaoRibbon}" Content="200%" Padding="6,0" ToolTip="Zoom 200% (Padrão)" />
                        <Button Command="{Binding ZoomAjustarCommand}" Style="{StaticResource BotaoRibbon}" Content="Ajustar (F4)" Padding="6,0" ToolTip="Ajustar etiqueta inteira na tela (F4)" />
                        <Button Command="{Binding ZoomMenosCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Reduzir zoom (Ctrl + Roda)" AutomationProperties.Name="Reduzir zoom">
                            <ui:SymbolIcon Symbol="Subtract24" FontSize="13" />
                        </Button>
                        <Border Background="{StaticResource CorSuperficieSuave}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="4" Padding="6,0" Height="28" Margin="0,0,3,0">
                            <TextBlock Text="{Binding ZoomNivel, StringFormat='{}{0:P0}'}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                        </Border>
                        <Button Command="{Binding ZoomMaisCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Aumentar zoom (Ctrl + Roda)" AutomationProperties.Name="Aumentar zoom">
                            <ui:SymbolIcon Symbol="Add24" FontSize="13" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="ZOOM &amp; ESCALA" Style="{StaticResource RotuloGrupoRibbon}" />
                </StackPanel>

                <Border Width="1" Height="36" Background="{StaticResource CorBorda}" Margin="4,0,8,0" />

                <!-- GRUPO 5: IMPRESSÃO & ARQUIVO -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding AbrirPreviaImpressaoCommand}" Style="{StaticResource BotaoRibbon}" Padding="9,0" ToolTip="Conferir pré-visualização de todas as etiquetas da grade na folha">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Eye24" FontSize="14" Foreground="{StaticResource CorPrimaria}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Prévia da Folha" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ImprimirTesteCommand}" Style="{StaticResource BotaoPrimario}" Height="28" Padding="10,0" Margin="0,0,4,0" ToolTip="Imprimir 1 etiqueta de teste na impressora padrão">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Print24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Imprimir Teste" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SalvarModeloCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Salvar layout em arquivo JSON (Ctrl+S)" AutomationProperties.Name="Salvar arquivo">
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" />
                        </Button>

                        <Button Command="{Binding CarregarModeloCommand}" Style="{StaticResource BotaoIconeRibbon}" ToolTip="Abrir layout salvo em arquivo JSON" AutomationProperties.Name="Abrir arquivo">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="IMPRESSÃO &amp; ARQUIVO" Style="{StaticResource RotuloGrupoRibbon}" />
                </StackPanel>

            </WrapPanel>
        </Border>
    </StackPanel>
</UserControl>
