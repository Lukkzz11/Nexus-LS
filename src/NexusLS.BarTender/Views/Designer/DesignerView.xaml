<UserControl x:Class="NexusLS.BarTender.Views.Designer.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:NexusLS.BarTender.ViewModels"
             xmlns:models="clr-namespace:NexusLS.BarTender.Models.Designer"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DesignerViewModel}"
             Focusable="True"
             KeyDown="UserControl_KeyDown"
             PreviewKeyDown="UserControl_KeyDown">

    <UserControl.Resources>
        <Style x:Key="BotaoRibbon" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="{StaticResource TamPequeno}" />
        </Style>

        <Style x:Key="BotaoToolbox" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="{StaticResource TamCorpo}" />
        </Style>

        <Style x:Key="BotaoVariavelRapida" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="{StaticResource TamPequeno}" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        </Style>

        <Style x:Key="SubsecaoCard" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RaioMedio}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardModeloGaleria" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RaioMedio}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource CorFundo}">
        <Grid.RowDefinitions>
            <!-- 0: Barra de Comandos / Ribbon Superior -->
            <RowDefinition Height="Auto" />
            <!-- 1: Área de Trabalho CAD (Toolbox Esquerda + Canvas Central + Inspector Direita) -->
            <RowDefinition Height="*" />
            <!-- 2: Barra de Status Inferior -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ==================== 0: BARRA DE COMANDOS / RIBBON ==================== -->
        <StackPanel Grid.Row="0">
            <!-- BARRA DE VÍNCULO DO PRODUTO ATIVO (quando aberto pelo catálogo) -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="14,6"
                    Visibility="{Binding ModoProdutoAtivo, Converter={StaticResource BoolParaVisibilidadeConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Tag24" FontSize="14" Foreground="#1D4ED8" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="PRODUTO DO SISTEMA:" FontWeight="Bold" FontSize="10.5" Foreground="#1D4ED8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding NomeProdutoAtivo}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CorTexto}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RefProdutoAtivo, StringFormat='{} (REF: {0})'}" Foreground="{StaticResource CorTextoSuave}" FontSize="11" VerticalAlignment="Center" Margin="4,0,10,0" />

                        <!-- Badge se tem etiqueta cadastrada -->
                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                Visibility="{Binding ProdutoTemEtiquetaExclusiva, Converter={StaticResource BoolParaVisibilidadeConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Foreground="#15803D" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Etiqueta Exclusiva Vinculada" FontWeight="Bold" FontSize="10.5" Foreground="#15803D" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProdutoTemEtiquetaExclusiva}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Usando Modelo Padrão Global" FontSize="10.5" FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Botões de Ação para o Produto -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding SalvarEtiquetaNoProdutoCommand}" Style="{StaticResource BotaoPrimario}" Padding="12,5" Margin="0,0,6,0"
                                ToolTip="Cadastrar este layout como etiqueta exclusiva deste produto no sistema">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Salvar Etiqueta Neste Produto" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RestaurarEtiquetaPadraoProdutoCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,5" FontSize="11.5"
                                Visibility="{Binding ProdutoTemEtiquetaExclusiva, Converter={StaticResource BoolParaVisibilidadeConverter}}"
                                ToolTip="Remover a etiqueta exclusiva deste produto e voltar a usar a etiqueta padrão">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Restaurar Padrão" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Barra de Ribbon Principal -->
            <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Modelos e Galeria -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Divisor -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Alinhamentos e Camadas -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Divisor -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Ações de Edição -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- Zoom e Impressão / Arquivo -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Grupo 1: Seleção de Modelo & Criação (Estilo Illustrator / Corel) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AbrirNovoDocumentoCommand}" Style="{StaticResource BotaoPrimario}" Padding="13,7" Margin="0,0,8,0" ToolTip="Criar nova folha / modelo de etiqueta (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Novo Documento" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="#1E40AF" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+N" Foreground="White" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AbrirGaleriaModelosCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,7" Margin="0,0,8,0" ToolTip="Ver catálogo completo de modelos e predefinições">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Sparkle24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Predefinições" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{StaticResource CorSelecaoSuave}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CatalogoModelos.Count}" Foreground="{StaticResource CorPrimaria}" FontSize="10" FontWeight="Black" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <ComboBox ItemsSource="{Binding PresetsDisponiveis}" SelectedItem="{Binding PresetSelecionado}" Width="220" Margin="0,0,8,0"
                              SelectionChanged="PresetComboBox_SelectionChanged" ToolTip="Trocar layout atual rapidamente" />

                    <!-- Controles Diretos da Folha / Etiqueta (Largura × Altura editável e Orientação estilo Corel) -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="6,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="L:" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <TextBox Text="{Binding FolhaLarguraMm, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" KeyDown="FolhaTextBox_KeyDown" Width="40" Height="24" Padding="2,0" FontSize="11" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" ToolTip="Largura da Folha (mm) - Pressione Enter para aplicar" />
                            <TextBlock Text=" × A:" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="3,0,3,0" />
                            <TextBox Text="{Binding FolhaAlturaMm, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" KeyDown="FolhaTextBox_KeyDown" Width="40" Height="24" Padding="2,0" FontSize="11" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" ToolTip="Altura da Folha (mm) - Pressione Enter para aplicar" />
                            <TextBlock Text=" mm" FontSize="10.5" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="2,0,6,0" />
                            <Button Command="{Binding AlternarOrientacaoFolhaCommand}" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" ToolTip="Inverter Orientação (Paisagem / Retrato)">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Divisor 1 -->
                <Border Grid.Column="1" Width="1" Background="{StaticResource CorBorda}" Margin="10,2" />

                <!-- Grupo 2: Alinhamento do Elemento Selecionado (Atalhos Corel) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ALINHAR:" Foreground="{StaticResource CorTextoSuave}" FontWeight="SemiBold" FontSize="{StaticResource TamMicro}" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <Button Command="{Binding CentralizarNaPaginaCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Centralizar no centro da etiqueta (P)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Maximize24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pág (P)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CentralizarHorizontalmenteCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Centralizar Horizontalmente na Etiqueta (C)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="AlignCenterHorizontal24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Centro H (C)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CentralizarVerticalmenteCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Centralizar Verticalmente na Etiqueta (E)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="AlignCenterVertical24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Centro V (E)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AlinharEsquerdaCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Alinhar à Esquerda na margem (L)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="AlignLeft24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Esq (L)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AlinharDireitaCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Alinhar à Direita na margem (R)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="AlignRight24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Dir (R)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AlinharTopoCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Alinhar ao Topo (T)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowUp24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Topo (T)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AlinharBaseCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Alinhar à Base (B)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Base (B)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding TrazerParaFrenteCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Trazer elemento para o topo (Shift+PageUp)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSortUp24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Frente" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding EnviarParaTrasCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Enviar elemento para trás (Shift+PageDown)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSortDown24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Trás" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Divisor 2 -->
                <Border Grid.Column="3" Width="1" Background="{StaticResource CorBorda}" Margin="10,2" />

                <!-- Grupo 3: Ações de Edição (Mão, Desfazer, Refazer, Copiar, Colar, Duplicar, Agrupar, Excluir) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AlternarFerramentaMaoCommand}" ToolTip="Ferramenta Mão para arrastar e navegar na área de trabalho (H)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotaoRibbon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FerramentaMaoAtiva}" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE" />
                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="HandRight24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mão (H)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DesfazerCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Desfazer última ação (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Desfazer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefazerCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Refazer ação (Ctrl+Y)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refazer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CopiarCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Copiar selecionado (Ctrl+C)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Copiar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ColarCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Colar objeto (Ctrl+V)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Colar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AgruparCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Agrupar objetos (Ctrl+G)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Group24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Agrupar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DesagruparCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Desagrupar objetos (Ctrl+Shift+G)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="GroupDismiss24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Desagrupar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DuplicarSelecionadoCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Duplicar elemento (Ctrl+D)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Duplicar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExcluirSelecionadoCommand}" Style="{StaticResource BotaoRibbon}" ToolTip="Remover elemento (Del)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource CorPerigo}" />
                            <TextBlock Text="Excluir" VerticalAlignment="Center" Foreground="{StaticResource CorPerigo}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Grupo 4: Zoom, Impressão Rápida e Arquivo -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom Controls (Corel Style) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Command="{Binding ZoomAjustarCommand}" Style="{StaticResource BotaoSecundario}" Content="Ajustar (F4)" Height="26" Padding="6,0" Margin="0,0,4,0" FontSize="10.5" ToolTip="Enquadrar etiqueta inteira na tela (F4)" />
                        <Button Command="{Binding ZoomMenosCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" ToolTip="Reduzir zoom">
                            <ui:SymbolIcon Symbol="Subtract24" FontSize="13" />
                        </Button>
                        <Button Command="{Binding ZoomPadraoCommand}" Style="{StaticResource BotaoSecundario}" Content="{Binding ZoomNivel, StringFormat='{}{0:P0}'}" Height="26" Padding="6,0" Margin="4,0" FontSize="11" ToolTip="Restaurar zoom 200%" />
                        <Button Command="{Binding ZoomMaisCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" ToolTip="Aumentar zoom">
                            <ui:SymbolIcon Symbol="Add24" FontSize="13" />
                        </Button>
                        <Button Command="{Binding Zoom100Command}" Style="{StaticResource BotaoSecundario}" Content="100%" Height="26" Padding="5,0" Margin="4,0,0,0" FontSize="10.5" ToolTip="Zoom 100% (tamanho real)" />
                        <Button Command="{Binding Zoom300Command}" Style="{StaticResource BotaoSecundario}" Content="300%" Height="26" Padding="5,0" Margin="4,0,0,0" FontSize="10.5" ToolTip="Zoom 300% (detalhe máximo)" />
                    </StackPanel>

                    <!-- Impressão de Teste -->
                    <Button Command="{Binding ImprimirTesteCommand}" Style="{StaticResource BotaoPrimario}" Padding="12,6" Margin="0,0,8,0" ToolTip="Disparar impressão de 1 teste na impressora padrão">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Print24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Imprimir Teste" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SalvarModeloCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,6" Margin="0,0,4,0" ToolTip="Salvar layout em arquivo JSON">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Salvar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CarregarModeloCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,6" ToolTip="Abrir layout salvo em arquivo JSON">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Abrir" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>

    <!-- ==================== 1: ÁREA DE TRABALHO CAD ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Esquerda: Caixa de Ferramentas & Variáveis (240px) -->
                <ColumnDefinition Width="240" />
                <!-- Centro: Bancada com Réguas e Canvas da Etiqueta -->
                <ColumnDefinition Width="*" />
                <!-- Direita: Painel Inspector de Propriedades (360px) -->
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- ==================== COLUNA ESQUERDA: TOOLBOX & VARIÁVEIS ==================== -->
            <Border Grid.Column="0" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,1,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Seção 1: Objetos & Formas -->
                        <TextBlock Text="INSERIR OBJETOS" Foreground="{StaticResource CorTextoSuave}" FontWeight="Bold" FontSize="{StaticResource TamMicro}" Margin="0,0,0,8" />

                        <Button Command="{Binding AdicionarTextoCommand}" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="TextFont24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Texto Livre" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AdicionarCodigoBarrasCommand}" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Código de Barras 1D" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AdicionarQrCodeCommand}" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="QrCode24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="QR Code 2D (Pix/Link)" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AdicionarImagemCommand}" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Image24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Logotipo / Imagem" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AdicionarRetanguloCommand}" Style="{StaticResource BotaoToolbox}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Square24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Moldura / Retângulo" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AdicionarLinhaCommand}" Style="{StaticResource BotaoToolbox}" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="LineHorizontal124" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Linha Divisória" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Seção 2: Dados Rápidos do Produto (Nexus LS) -->
                        <Border Background="{StaticResource CorBorda}" Height="1" Margin="0,0,0,14" />

                        <TextBlock Text="CAMPOS DO PRODUTO (NEXUS LS)" Foreground="{StaticResource CorTextoSuave}" FontWeight="Bold" FontSize="{StaticResource TamMicro}" Margin="0,0,0,4" />
                        <TextBlock Text="Inserir campo com vínculo e formatação automática:" Style="{StaticResource TextoApoio}" Margin="0,0,0,10" />

                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="NomeProduto" Style="{StaticResource BotaoVariavelRapida}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Nome do Produto" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="PrecoVarejo" Style="{StaticResource BotaoVariavelRapida}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Preço de Varejo (R$)" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="PrecoAtacado" Style="{StaticResource BotaoVariavelRapida}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Preço de Atacado" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="Referencia" Style="{StaticResource BotaoVariavelRapida}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Referência (REF)" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="Tamanho" Style="{StaticResource BotaoVariavelRapida}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Grade de Tamanho" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="CodigoBarras" Style="{StaticResource BotaoVariavelRapida}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Código de Barras (EAN)" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding InserirVariavelCommand}" CommandParameter="NomeLoja" Style="{StaticResource BotaoVariavelRapida}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Cabeçalho da Loja" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== CENTRO: BANCADA COM RÉGUAS & CANVAS ==================== -->
            <Grid Grid.Column="1" Background="{StaticResource CorColunaFundo}">
                <Grid.RowDefinitions>
                    <!-- 0: Barra de Teste Rápido com Produtos do ERP & Modos de Visualização -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: Bancada com Réguas e Canvas -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra Superior da Bancada: Teste de Produto ERP & Grade -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Controles de Produto do Catálogo -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TESTAR COM PRODUTO:" Foreground="{StaticResource CorTextoSuave}" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0" />

                            <Button Command="{Binding ProdutoAnteriorCommand}" Style="{StaticResource BotaoSecundario}" Width="28" Height="28" Padding="0" ToolTip="Produto anterior no catálogo" Margin="0,0,4,0">
                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" />
                            </Button>

                            <Button Command="{Binding ProximoProdutoCommand}" Style="{StaticResource BotaoSecundario}" Width="28" Height="28" Padding="0" ToolTip="Próximo produto no catálogo" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" />
                            </Button>

                            <!-- Badge com detalhes do produto ativo -->
                            <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Box24" FontSize="14" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProdutoAtual.Nome, TargetNullValue='Nenhum produto selecionado (usando dados de modelo)'}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource CorTexto}" MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProdutoAtual.PrecoVendaCentavos, Converter={StaticResource CentavosParaMoedaConverter}}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Seletor de Tamanho para Teste com Grade Nexus -->
                            <Border Background="#F1F5F9" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Tamanho do produto para testar a etiqueta e a regra de código de barras Nexus">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TAM:" FontWeight="Bold" FontSize="10" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding TamanhosParaTesteDisponiveis}"
                                              SelectedItem="{Binding TamanhoParaTeste, Mode=TwoWay}"
                                              MinWidth="54" Height="24" Padding="4,0" FontSize="11" FontWeight="SemiBold"
                                              VerticalAlignment="Center" BorderThickness="0" Background="Transparent" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Modos de Exibição e Grade -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding AlternarMostrarDadosReaisCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,5" Margin="0,0,6,0" ToolTip="Alternar entre ver nomes/preços reais ou códigos de variáveis {Nome}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Eye24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MostrarDadosReais, Converter={StaticResource BoolTexto}, ConverterParameter='Dados Reais|Variáveis'}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AlternarGradeCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,5" Margin="0,0,6,0" ToolTip="Mostrar/ocultar grade milimétrica de fundo">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Grid24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Grade" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding AlternarSnapCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,5" ToolTip="Alinhamento magnético inteligente aos passos de 0.5 mm">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Imã (0.5mm)" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bancada com Réguas e Canvas -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <!-- Régua X Horizontal (24px) -->
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Régua Y Vertical (24px) -->
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Canto 0,0 mm -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#F1F5F9" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,1,1">
                        <TextBlock Text="mm" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Régua Horizontal (X) -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" ClipToBounds="True">
                        <Canvas x:Name="ReguaHorizontalCanvas" Height="24" HorizontalAlignment="Left" />
                    </Border>

                    <!-- Régua Vertical (Y) -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,1,0" ClipToBounds="True">
                        <Canvas x:Name="ReguaVerticalCanvas" Width="24" VerticalAlignment="Top" />
                    </Border>

                    <!-- Bancada Central do Canvas (com Pan e Zoom estilo CAD/Corel) -->
                    <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="CanvasScrollViewer"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#E2E8F0" MouseDown="ScrollViewer_MouseDown"
                                  PreviewMouseDown="CanvasScrollViewer_PreviewMouseDown"
                                  PreviewMouseMove="CanvasScrollViewer_PreviewMouseMove"
                                  PreviewMouseUp="CanvasScrollViewer_PreviewMouseUp"
                                  PreviewMouseWheel="CanvasScrollViewer_PreviewMouseWheel"
                                  ScrollChanged="CanvasScrollViewer_ScrollChanged">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100">
                            <!-- Papel da Etiqueta com Sombra Realista (Mesa de Trabalho Corel/Illustrator) -->
                            <Border Background="White" CornerRadius="2" ClipToBounds="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" BlurRadius="24" ShadowDepth="6" Opacity="0.18" />
                                </Border.Effect>

                                <!-- Grid interno que contém o Canvas e Guias de Margem Segura -->
                                <Grid ClipToBounds="False">
                                    <!-- Canvas com elementos -->
                                    <Canvas x:Name="EditorCanvas"
                                            ClipToBounds="False"
                                            Background="White"
                                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                            MouseMove="Canvas_MouseMove"
                                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                                        <Canvas.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding ZoomNivel}" ScaleY="{Binding ZoomNivel}" />
                                        </Canvas.LayoutTransform>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ==================== DIREITA: PAINEL INSPECTOR & CAMADAS ==================== -->
            <Border Grid.Column="2" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1,0,0,0" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Abas Seletoras: Propriedades / Camadas -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Conteúdo da Aba Ativa -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- SELETOR DE ABAS DO INSPECTOR (PROPRIEDADES vs CAMADAS) -->
                    <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="{StaticResource RaioPequeno}" Padding="3" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Aba 1: Propriedades -->
                            <Button Grid.Column="0" Command="{Binding MudarAbaInspetorCommand}" CommandParameter="Propriedades" Padding="8,6" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="{StaticResource TamPequeno}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RaioPequeno}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AbaInspetorAtiva}" Value="Propriedades">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Propriedades" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Aba 2: Camadas (Photoshop Style) -->
                            <Button Grid.Column="1" Command="{Binding MudarAbaInspetorCommand}" CommandParameter="Camadas" Padding="8,6" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="{StaticResource TamPequeno}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RaioPequeno}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AbaInspetorAtiva}" Value="Camadas">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Layer24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Camadas" VerticalAlignment="Center" />
                                    <Border Background="#DBEAFE" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalCamadas}" Foreground="#1D4ED8" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- CONTEÚDO DAS ABAS -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- ABA 1: PROPRIEDADES (Folha e Elementos) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AbaInspetorAtiva}" Value="Propriedades">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Título do Inspector -->
                                <TextBlock Text="Inspector de Propriedades" Style="{StaticResource TituloSecao}" Margin="0,0,0,2" />
                                <TextBlock Text="Ajuste fino milimétrico e vinculação de dados" Style="{StaticResource TextoApoio}" Margin="0,0,0,12" />

                                <!-- PROPRIEDADES DA FOLHA / ETIQUETA (quando nenhum elemento está selecionado) -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="14" Margin="0,0,0,12"
                                        Visibility="{Binding ElementoSelecionado, Converter={StaticResource NullParaColapsadoConverter}, ConverterParameter=invert}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ui:SymbolIcon Symbol="DocumentPageBottomCenter24" FontSize="18" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Propriedades da Folha" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CorTexto}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Altere as dimensões e a orientação da folha da etiqueta em tempo real:" Style="{StaticResource TextoApoio}" Margin="0,0,0,12" />

                                        <!-- Largura e Altura da Folha -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Largura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FolhaLarguraMm, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" KeyDown="FolhaTextBox_KeyDown" FontWeight="Bold" FontSize="13" Padding="6,4" TextAlignment="Center" ToolTip="Pressione Enter para aplicar" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Altura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding FolhaAlturaMm, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.##}'}" KeyDown="FolhaTextBox_KeyDown" FontWeight="Bold" FontSize="13" Padding="6,4" TextAlignment="Center" ToolTip="Pressione Enter para aplicar" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Botão Inverter Orientação -->
                                        <Button Command="{Binding AlternarOrientacaoFolhaCommand}" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Stretch" Margin="0,0,0,14" Padding="10,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Girar Folha (Paisagem / Retrato)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Predefinições Rápidas de Tamanho -->
                                        <TextBlock Text="TAMANHOS RÁPIDOS" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamMicro}" FontWeight="Bold" Margin="0,0,0,6" />
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="50x30" Style="{StaticResource BotaoSecundario}" Margin="0,0,3,4" Padding="4,5" Content="50 × 30 mm" FontSize="11" />
                                            <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="40x25" Style="{StaticResource BotaoSecundario}" Margin="3,0,0,4" Padding="4,5" Content="40 × 25 mm" FontSize="11" />
                                            <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="60x40" Style="{StaticResource BotaoSecundario}" Margin="0,0,3,4" Padding="4,5" Content="60 × 40 mm" FontSize="11" />
                                            <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="100x50" Style="{StaticResource BotaoSecundario}" Margin="3,0,0,4" Padding="4,5" Content="100 × 50 mm" FontSize="11" />
                                            <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="100x150" Style="{StaticResource BotaoSecundario}" Margin="0,0,3,0" Padding="4,5" Content="100 × 150 mm" FontSize="11" />
                                            <Button Command="{Binding DefinirTamanhoFolhaCommand}" CommandParameter="30x20" Style="{StaticResource BotaoSecundario}" Margin="3,0,0,0" Padding="4,5" Content="30 × 20 mm (Joias)" FontSize="11" />
                                        </UniformGrid>

                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                                            <TextBlock Text="💡 A folha se ajusta instantaneamente no canvas central ao alterar as medidas." FontSize="10.5" Foreground="#1E40AF" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Quando há elemento selecionado -->
                                <StackPanel Visibility="{Binding ElementoSelecionado, Converter={StaticResource NullParaColapsadoConverter}}">
                                    <!-- Tipo do Elemento -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tipo do Objeto" Style="{StaticResource Rotulo}" Margin="0" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="10,3">
                                            <TextBlock Text="{Binding ElementoSelecionado.Tipo}" Foreground="{StaticResource CorPrimaria}" FontSize="{StaticResource TamPequeno}" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <!-- Nome da Camada / Elemento -->
                                    <TextBlock Text="NOME DA CAMADA" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamMicro}" FontWeight="Bold" Margin="0,2,0,4" />
                                    <TextBox Text="{Binding ElementoSelecionado.Nome, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Margin="0,0,0,10" />

                                    <!-- Rotação do Elemento -->
                                    <TextBlock Text="ROTAÇÃO DO OBJETO" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamMicro}" FontWeight="Bold" Margin="0,4,0,4" />
                                    <UniformGrid Columns="4" Margin="0,0,0,10">
                                        <Button Command="{Binding DefinirRotacaoCommand}" CommandParameter="0" Style="{StaticResource BotaoSecundario}" Padding="4,4" Margin="0,0,2,0" Content="0°" FontSize="11" />
                                        <Button Command="{Binding DefinirRotacaoCommand}" CommandParameter="90" Style="{StaticResource BotaoSecundario}" Padding="4,4" Margin="2,0,2,0" Content="90°" FontSize="11" />
                                        <Button Command="{Binding DefinirRotacaoCommand}" CommandParameter="180" Style="{StaticResource BotaoSecundario}" Padding="4,4" Margin="2,0,2,0" Content="180°" FontSize="11" />
                                        <Button Command="{Binding DefinirRotacaoCommand}" CommandParameter="270" Style="{StaticResource BotaoSecundario}" Padding="4,4" Margin="2,0,0,0" Content="270°" FontSize="11" />
                                    </UniformGrid>

                                    <!-- Medidas CAD em mm -->
                                    <TextBlock Text="POSIÇÃO &amp; DIMENSÕES (MM)" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamMicro}" FontWeight="Bold" Margin="0,6,0,6" />
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Posição X (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding ElementoSelecionado.X, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="Posição Y (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding ElementoSelecionado.Y, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Largura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding ElementoSelecionado.Largura, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="Altura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding ElementoSelecionado.Altura, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <!-- PROPRIEDADES DE TEXTO -->
                                    <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=Texto}">
                                        <Border Style="{StaticResource SubsecaoCard}">
                                            <StackPanel>
                                                <TextBlock Text="DADOS DO TEXTO" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="{StaticResource TamRotulo}" Margin="0,0,0,6" />

                                                <TextBlock Text="Campo Vinculado do Produto" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding VariaveisDisponiveis}"
                                                          SelectedItem="{Binding ElementoSelecionado.Variavel, Mode=TwoWay}"
                                                          Margin="0,0,0,8" />

                                                <TextBlock Text="Texto / Máscara ({Nome}, {Preco})" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ElementoSelecionado.Texto, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True" Height="46" Margin="0,0,0,4" />

                                                <TextBlock Text="Variáveis Rápidas (inserir no texto):" Style="{StaticResource TextoApoio}" FontSize="10" Margin="0,2,0,4" />
                                                <WrapPanel Margin="0,0,0,8">
                                                    <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Nome}" Style="{StaticResource BotaoSecundario}" Content="+ {Nome}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                                    <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="R$ {Preco}" Style="{StaticResource BotaoSecundario}" Content="+ R$ {Preco}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                                    <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Ref}" Style="{StaticResource BotaoSecundario}" Content="+ {Ref}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                                    <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Tamanho}" Style="{StaticResource BotaoSecundario}" Content="+ {Tamanho}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                                    <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Codigo}" Style="{StaticResource BotaoSecundario}" Content="+ {Codigo}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                                    <Button Command="{Binding InserirChipTextoCommand}" CommandParameter="{}{Loja}" Style="{StaticResource BotaoSecundario}" Content="+ {Loja}" Padding="5,2" Margin="0,0,4,4" FontSize="10" />
                                                </WrapPanel>

                                                <TextBlock Text="Família da Fonte (Fontes do Windows)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding FontesDisponiveis}" SelectedItem="{Binding ElementoSelecionado.Fonte, Mode=TwoWay}"
                                                          IsEditable="True" MaxDropDownHeight="280" Margin="0,0,0,8">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12.5" VerticalAlignment="Center" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <TextBlock Text="Cor do Texto" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#000000" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Preto">
                                                        <Ellipse Width="14" Height="14" Fill="#000000" Stroke="#94A3B8" StrokeThickness="1" />
                                                    </Button>
                                                    <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#FFFFFF" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Branco">
                                                        <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#94A3B8" StrokeThickness="1" />
                                                    </Button>
                                                    <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#DC2626" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Vermelho">
                                                        <Ellipse Width="14" Height="14" Fill="#DC2626" />
                                                    </Button>
                                                    <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#2563EB" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Azul">
                                                        <Ellipse Width="14" Height="14" Fill="#2563EB" />
                                                    </Button>
                                                    <Button Command="{Binding DefinirCorTextoCommand}" CommandParameter="#16A34A" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,8,0" ToolTip="Verde">
                                                        <Ellipse Width="14" Height="14" Fill="#16A34A" />
                                                    </Button>
                                                    <TextBox Text="{Binding ElementoSelecionado.CorTexto, UpdateSourceTrigger=PropertyChanged}" Width="70" FontSize="11" Padding="4,2" VerticalAlignment="Center" ToolTip="Código Hexadecimal da cor" />
                                                </StackPanel>

                                                <TextBlock Text="Alinhamento Horizontal" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding AlinhamentosDisponiveis}"
                                                          SelectedItem="{Binding ElementoSelecionado.Alinhamento, Mode=TwoWay}"
                                                          Margin="0,0,0,8" />

                                                <TextBlock Text="Tamanho Real da Fonte (pt)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ElementoSelecionado.TamanhoFonte, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Margin="0,0,0,8" />

                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <CheckBox Content="Negrito" IsChecked="{Binding ElementoSelecionado.Negrito, Mode=TwoWay}" Margin="0,0,10,0" />
                                                    <CheckBox Content="Itálico" IsChecked="{Binding ElementoSelecionado.Italico, Mode=TwoWay}" Margin="0,0,10,0" />
                                                    <CheckBox Content="Riscado (Preço DE)" IsChecked="{Binding ElementoSelecionado.Riscado, Mode=TwoWay}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- PROPRIEDADES DE CÓDIGO DE BARRAS -->
                                    <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=CodigoBarras}">
                                        <Border Style="{StaticResource SubsecaoCard}">
                                            <StackPanel>
                                                <TextBlock Text="CÓDIGO DE BARRAS" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="{StaticResource TamRotulo}" Margin="0,0,0,6" />

                                                <TextBlock Text="Padrão do Código" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding TiposCodigoDisponiveis}"
                                                          SelectedItem="{Binding ElementoSelecionado.TipoCodigo, Mode=TwoWay}"
                                                          Margin="0,0,0,8" />

                                                <TextBlock Text="Campo Vinculado do Produto" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding VariaveisDisponiveis}"
                                                          SelectedItem="{Binding ElementoSelecionado.Variavel, Mode=TwoWay}"
                                                          Margin="0,0,0,8" />

                                                <TextBlock Text="Valor Fixo / Fallback" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ElementoSelecionado.ValorCodigo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                                <CheckBox Content="Mostrar Texto Numérico Legível" IsChecked="{Binding ElementoSelecionado.MostrarTextoLegivel, Mode=TwoWay}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- PROPRIEDADES DE IMAGEM / LOGO -->
                                    <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=Imagem}">
                                        <Border Style="{StaticResource SubsecaoCard}">
                                            <StackPanel>
                                                <TextBlock Text="LOGOTIPO / IMAGEM" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="{StaticResource TamRotulo}" Margin="0,0,0,6" />

                                                <Button Command="{Binding TrocarImagemElementoCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,4,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Escolher Imagem (PNG/JPG)..." VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <CheckBox Content="Manter Proporção Original" IsChecked="{Binding ElementoSelecionado.ManterProporcao, Mode=TwoWay}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- PROPRIEDADES DE FORMA -->
                                    <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=Forma}">
                                        <Border Style="{StaticResource SubsecaoCard}">
                                            <StackPanel>
                                                <TextBlock Text="FORMA GEOMÉTRICA" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="{StaticResource TamRotulo}" Margin="0,0,0,6" />

                                                <TextBlock Text="Espessura do Traço" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ElementoSelecionado.EspessuraBorda, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Margin="0,0,0,8" />

                                                <TextBlock Text="Cantos Arredondados (Raio mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding ElementoSelecionado.RaioCanto, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Margin="0,0,0,8" />

                                                <CheckBox Content="Preencher Fundo" IsChecked="{Binding ElementoSelecionado.Preenchido, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- ABA 2: GERENCIADOR DE CAMADAS (PHOTOSHOP STYLE) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AbaInspetorAtiva}" Value="Camadas">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Título do Painel de Camadas -->
                                <TextBlock Text="Gerenciador de Camadas" Style="{StaticResource TituloSecao}" Margin="0,0,0,2" />
                                <TextBlock Text="Controle de profundidade, bloqueio e visibilidade" Style="{StaticResource TextoApoio}" Margin="0,0,0,10" />

                                <!-- Barra de Ferramentas das Camadas -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="6,4" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding SubirCamadaCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Subir camada / Avançar (Ctrl + ])">
                                                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="13" />
                                            </Button>
                                            <Button Command="{Binding DescerCamadaCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,6,0" ToolTip="Descer camada / Recuar (Ctrl + [)">
                                                <ui:SymbolIcon Symbol="ArrowDown24" FontSize="13" />
                                            </Button>
                                            <Button Command="{Binding AgruparCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Agrupar selecionados (Ctrl + G)">
                                                <ui:SymbolIcon Symbol="Group24" FontSize="13" />
                                            </Button>
                                            <Button Command="{Binding DesagruparCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,6,0" ToolTip="Desagrupar objetos (Ctrl + Shift + G)">
                                                <ui:SymbolIcon Symbol="GroupDismiss24" FontSize="13" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding DuplicarSelecionadoCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Duplicar camada selecionada (Ctrl + D)">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="13" />
                                            </Button>
                                            <Button Command="{Binding ExcluirSelecionadoCommand}" Style="{StaticResource BotaoSecundario}" Width="26" Height="26" Padding="0" ToolTip="Excluir camada (Del)">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="{StaticResource CorPerigo}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Lista de Camadas (Em ordem Z: Topo da lista = Frente da prancheta) -->
                                <Border Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}">
                                    <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding CamadasOrdenadas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ElementoDesign}">
                                                    <Border BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="8,6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F8FAFC" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Botão de Visibilidade (Olho) -->
                                                            <Button Grid.Column="0"
                                                                    Command="{Binding DataContext.AlternarVisibilidadeCamadaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="24" Height="24" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    ToolTip="Ocultar / Mostrar na prancheta">
                                                                <ui:SymbolIcon Symbol="Eye24" FontSize="14">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Visivel}" Value="False">
                                                                                    <Setter Property="Foreground" Value="#CBD5E1" />
                                                                                    <Setter Property="Symbol" Value="EyeOff24" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                            </Button>

                                                            <!-- Botão de Bloqueio (Cadeado) -->
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding DataContext.AlternarBloqueioCamadaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="24" Height="24" Padding="0" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    ToolTip="Bloquear / Desbloquear camada contra seleção e movimento">
                                                                <ui:SymbolIcon Symbol="LockOpen24" FontSize="13">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Foreground" Value="#94A3B8" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Bloqueado}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#D97706" />
                                                                                    <Setter Property="Symbol" Value="LockClosed24" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                            </Button>

                                                            <!-- Ícone Distintivo do Tipo de Objeto -->
                                                            <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Document24" FontSize="12" Foreground="{StaticResource CorTextoSuave}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Tipo}" Value="Texto">
                                                                                    <Setter Property="Symbol" Value="TextFont24" />
                                                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tipo}" Value="CodigoBarras">
                                                                                    <Setter Property="Symbol" Value="BarcodeScanner24" />
                                                                                    <Setter Property="Foreground" Value="#059669" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tipo}" Value="Imagem">
                                                                                    <Setter Property="Symbol" Value="Image24" />
                                                                                    <Setter Property="Foreground" Value="#7C3AED" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tipo}" Value="Retangulo">
                                                                                    <Setter Property="Symbol" Value="Square24" />
                                                                                    <Setter Property="Foreground" Value="#D97706" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tipo}" Value="Linha">
                                                                                    <Setter Property="Symbol" Value="LineHorizontal124" />
                                                                                    <Setter Property="Foreground" Value="#475569" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                            </Border>

                                                            <!-- Nome Editável da Camada & Seleção -->
                                                            <TextBox Grid.Column="3" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="Transparent" BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                                                     VerticalAlignment="Center" Padding="2,0" Foreground="{StaticResource CorTexto}">
                                                                <TextBox.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                                  Command="{Binding DataContext.SelecionarElementoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                  CommandParameter="{Binding}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>

                                                            <!-- Badge de Grupo (se pertencer a um grupo) -->
                                                            <Border Grid.Column="4" Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding GrupoId, Converter={StaticResource NullParaColapsadoConverter}}">
                                                                <TextBlock Text="{Binding NomeGrupo, TargetNullValue='Grupo'}" FontSize="9.5" FontWeight="Bold" Foreground="#6D28D9" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="10,8" Margin="0,10,0,0">
                                    <TextBlock Text="💡 Selecione qualquer camada diretamente nesta lista para editar suas propriedades, mesmo que esteja sobreposta no canvas." FontSize="10.5" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2: BARRA DE STATUS INFERIOR ==================== -->
        <Border Grid.Row="2" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Coordenadas do Cursor -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Cursor: " Foreground="{StaticResource CorTextoSuave}" FontSize="11" />
                    <TextBlock Text="X: " Foreground="{StaticResource CorTextoSuave}" FontSize="11" />
                    <TextBlock Text="{Binding MouseXMm, StringFormat='{}{0:0.0} mm'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" />
                    <TextBlock Text=" | Y: " Foreground="{StaticResource CorTextoSuave}" FontSize="11" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding MouseYMm, StringFormat='{}{0:0.0} mm'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" />
                </StackPanel>

                <!-- Dimensões do Papel -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Papel: " Foreground="{StaticResource CorTextoSuave}" FontSize="11" />
                    <TextBlock Text="{Binding Modelo.LarguraMm, StringFormat='{}{0:0.#}'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" />
                    <TextBlock Text=" × " FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                    <TextBlock Text="{Binding Modelo.AlturaMm, StringFormat='{}{0:0.#} mm'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" />
                </StackPanel>

                <!-- Objeto Selecionado -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Elemento Ativo: " Foreground="{StaticResource CorTextoSuave}" FontSize="11" />
                    <TextBlock Text="{Binding ElementoSelecionado.Tipo, TargetNullValue='Nenhum'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorPrimaria}" />
                </StackPanel>

                <!-- Zoom Level -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Escala: " Foreground="{StaticResource CorTextoSuave}" FontSize="11" />
                    <TextBlock Text="{Binding ZoomNivel, StringFormat='{}{0:P0}'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MODAL OVERLAY: NOVO DOCUMENTO (ESTILO ILLUSTRATOR / CORELDRAW) ==================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#95000000" Panel.ZIndex="100">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NovoDocumentoAberto}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GaleriaModelosAberta}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Width="1100" MaxWidth="1180" Height="690" MaxHeight="720" Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource CorBorda}" BorderThickness="1" Margin="16" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="12" Opacity="0.30" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header do Diálogo -->
                        <RowDefinition Height="Auto" />
                        <!-- Conteúdo Principal: Esquerda (Presets) + Direita (Inspector de Criação) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar / Header -->
                    <Border Grid.Row="0" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="20,14" CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Width="32" Height="32" Margin="0,0,10,0">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="18" Foreground="{StaticResource CorPrimaria}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Novo Documento · Criar Folha de Etiqueta" FontWeight="Bold" FontSize="18" Foreground="{StaticResource CorTexto}" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ESTÚDIO CAD" Foreground="{StaticResource CorPrimaria}" FontSize="10.5" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Escolha uma predefinição pronta ou configure o tamanho personalizado da folha, decidindo se será Etiqueta Normal ou de Composição Têxtil." Style="{StaticResource TextoApoio}" Margin="42,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding FecharNovoDocumentoCommand}" Style="{StaticResource BotaoFantasma}" Padding="10,6" FontSize="13" ToolTip="Fechar (Esc)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Fechar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Corpo Principal -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Coluna Esquerda: Abas de Categoria e Grade de Predefinições (Presets) -->
                            <ColumnDefinition Width="*" />
                            <!-- Divisor Vertical -->
                            <ColumnDefinition Width="1" />
                            <!-- Coluna Direita: Detalhes da Predefinição / Configuração da Folha (Inspector Illustrator Style) -->
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <!-- ==================== ÁREA ESQUERDA: PRESETS ==================== -->
                        <Grid Grid.Column="0" Margin="18,14,14,14">
                            <Grid.RowDefinitions>
                                <!-- Filtros por Categoria -->
                                <RowDefinition Height="Auto" />
                                <!-- Lista de Cartões -->
                                <RowDefinition Height="*" />
                                <!-- Rodapé Esquerdo -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Barra de Categorias Horizontal (Estilo Abas do Illustrator) -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="6,5" Margin="0,0,0,12">
                                <ItemsControl ItemsSource="{Binding CategoriasNovoDoc}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.FiltrarCategoriaNovoDocCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding}"
                                                    Padding="10,4"
                                                    Margin="2,2"
                                                    FontSize="11.5">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource IgualTag}">
                                                                        <Binding Path="DataContext.NovoDocCategoriaFiltro" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                        <Binding />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Background" Value="{StaticResource CorMenuAtivo}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                                <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Grade de Cartões de Predefinição -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding ModelosFiltradosNovoDoc}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:PredefinicaoEtiqueta}">
                                            <!-- Card clicável para carregar valores no Inspector -->
                                            <Border Style="{StaticResource CardModeloGaleria}" Margin="4,4">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Linha 1: Ícone, Nome, Categoria e Medida -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Width="32" Height="32" Margin="0,0,8,0">
                                                            <ui:SymbolIcon Symbol="{Binding Simbolo}" FontSize="18" Foreground="{StaticResource CorPrimaria}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                <TextBlock Text="{Binding Categoria}" Foreground="{StaticResource CorTextoSuave}" FontSize="10.5" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Border Grid.Column="2" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="7,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Dimensoes}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Linha 2: Descrição -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Descricao}" Style="{StaticResource TextoApoio}" TextWrapping="Wrap" Margin="0,2,0,8" Height="38" FontSize="11" />

                                                    <!-- Linha 3: Botão de Selecionar -->
                                                    <Button Grid.Row="2"
                                                            Command="{Binding DataContext.SelecionarPresetNovoDocCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource BotaoSecundario}"
                                                            Padding="10,5" HorizontalAlignment="Stretch">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Cursor24" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Selecionar Dimensões &amp; Layout" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Informação de Ajuda no Rodapé Esquerdo -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4,0,0">
                                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Dica: Você pode selecionar uma predefinição acima e ajustar as medidas livremente no painel ao lado." Foreground="{StaticResource CorTextoSuave}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Divisor Vertical -->
                        <Border Grid.Column="1" Background="{StaticResource CorBorda}" />

                        <!-- ==================== ÁREA DIREITA: DETALHES DA PREDEFINIÇÃO (PRESET DETAILS) ==================== -->
                        <Border Grid.Column="2" Background="#F8FAFC" Padding="18,14" CornerRadius="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Título do Painel -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Options24" FontSize="16" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="DETALHES DA PREDEFINIÇÃO" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource CorTexto}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 1. Nome do Documento -->
                                    <TextBlock Text="NOME DO DOCUMENTO" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamMicro}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NovoDocNome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="8,6" FontSize="12" />

                                    <!-- 2. Dimensões da Folha / Etiqueta -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="TAMANHO DA FOLHA" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamMicro}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Unidade: mm" Foreground="{StaticResource CorPrimaria}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Largura -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Largura (W)" FontSize="10.5" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding NovoDocLargura, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" Padding="8,6" FontSize="12" FontWeight="Bold" />
                                        </StackPanel>

                                        <!-- Altura -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Altura (H)" FontSize="10.5" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding NovoDocAltura, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" Padding="8,6" FontSize="12" FontWeight="Bold" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 3. Orientação (Retrato vs Paisagem) com Botões Ilustrados -->
                                    <TextBlock Text="ORIENTAÇÃO" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamMicro}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Botão Retrato -->
                                        <Button Grid.Column="0" Command="{Binding AlternarOrientacaoNovoDocCommand}" CommandParameter="Retrato" Padding="8,6" HorizontalContentAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NovoDocIsPaisagem}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource CorSelecaoSuave}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="12" Height="17" BorderBrush="{StaticResource CorTexto}" BorderThickness="1.5" CornerRadius="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Retrato ▯" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Botão Paisagem -->
                                        <Button Grid.Column="2" Command="{Binding AlternarOrientacaoNovoDocCommand}" CommandParameter="Paisagem" Padding="8,6" HorizontalContentAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NovoDocIsPaisagem}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource CorSelecaoSuave}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="17" Height="12" BorderBrush="{StaticResource CorTexto}" BorderThickness="1.5" CornerRadius="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Paisagem ▭" VerticalAlignment="Center" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- 4. TIPO / ESTRUTURA DA ETIQUETA (Normal vs Composição Têxtil vs Em Branco) -->
                                    <TextBlock Text="TIPO / ESTRUTURA DA ETIQUETA" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamMicro}" FontWeight="Bold" Margin="0,0,0,6" />

                                    <!-- Opção 1: Etiqueta Normal -->
                                    <Button Command="{Binding AlternarTipoNovoDocCommand}" CommandParameter="Normal" Margin="0,0,0,6" Padding="10,8" HorizontalContentAlignment="Left">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NovoDocTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=Normal}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CorSelecaoSuave}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid Width="290">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="Tag24" FontSize="16" Foreground="{StaticResource CorPrimaria}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Etiqueta Normal (Varejo / Preço)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CorTexto}" />
                                                <TextBlock Text="Loja, descrição, preço de varejo e código de barras" FontSize="10" Foreground="{StaticResource CorTextoSuave}" />
                                            </StackPanel>
                                            <ui:SymbolIcon Grid.Column="2" Symbol="Checkmark24" FontSize="15" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NovoDocTipo}" Value="Normal">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </Button>

                                    <!-- Opção 2: Etiqueta de Composição Têxtil -->
                                    <Button Command="{Binding AlternarTipoNovoDocCommand}" CommandParameter="Composicao" Margin="0,0,0,6" Padding="10,8" HorizontalContentAlignment="Left">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NovoDocTipo}" Value="Composicao">
                                                        <Setter Property="Background" Value="{StaticResource CorSelecaoSuave}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid Width="290">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="ShoppingBag24" FontSize="16" Foreground="#7C3AED" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Etiqueta de Composição (Têxtil)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CorTexto}" />
                                                <TextBlock Text="Composição de fibras, símbolos de lavagem, CNPJ e tamanho" FontSize="10" Foreground="{StaticResource CorTextoSuave}" />
                                            </StackPanel>
                                            <ui:SymbolIcon Grid.Column="2" Symbol="Checkmark24" FontSize="15" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NovoDocTipo}" Value="Composicao">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </Button>

                                    <!-- Opção 3: Em Branco -->
                                    <Button Command="{Binding AlternarTipoNovoDocCommand}" CommandParameter="EmBranco" Margin="0,0,0,12" Padding="10,8" HorizontalContentAlignment="Left">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NovoDocTipo}" Value="EmBranco">
                                                        <Setter Property="Background" Value="{StaticResource CorSelecaoSuave}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid Width="290">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="Square24" FontSize="16" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Em Branco (Personalizado)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CorTexto}" />
                                                <TextBlock Text="Folha limpa sem elementos para desenhar do zero" FontSize="10" Foreground="{StaticResource CorTextoSuave}" />
                                            </StackPanel>
                                            <ui:SymbolIcon Grid.Column="2" Symbol="Checkmark24" FontSize="15" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NovoDocTipo}" Value="EmBranco">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </Button>

                                    <!-- 5. Mini Prévia Proporcional em Tempo Real -->
                                    <Border Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="10" Margin="0,0,0,14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PRÉVIA PROPORCIONAL DA FOLHA" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            
                                            <Border Width="160" Height="90" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox Stretch="Uniform" Margin="6">
                                                    <Border Width="{Binding NovoDocLargura}" Height="{Binding NovoDocAltura}"
                                                            Background="White" BorderBrush="{StaticResource CorTexto}" BorderThickness="1.5" CornerRadius="2">
                                                        <Grid>
                                                            <!-- Linhas decorativas esquemáticas -->
                                                            <StackPanel VerticalAlignment="Center" Margin="2" Opacity="0.55">
                                                                <Border Height="2" Background="{StaticResource CorPrimaria}" Margin="2,1" CornerRadius="1" />
                                                                <Border Height="2" Background="{StaticResource CorTextoSuave}" Margin="2,1" CornerRadius="1" />
                                                                <Border Height="3" Background="{StaticResource CorTexto}" Margin="2,1" CornerRadius="1" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Viewbox>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding NovoDocLargura, StringFormat='{}{0:0.#}'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" />
                                                <TextBlock Text=" × " FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                                                <TextBlock Text="{Binding NovoDocAltura, StringFormat='{}{0:0.#} mm'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" />
                                                <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                                                <TextBlock Text="{Binding NovoDocTipo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 6. Botões de Ação Inferiores -->
                                    <StackPanel Margin="0,4,0,0">
                                        <Button Command="{Binding ConfirmarCriarNovoDocumentoCommand}" Style="{StaticResource BotaoPrimario}" Padding="14,10" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Criar Etiqueta" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding FecharNovoDocumentoCommand}" Style="{StaticResource BotaoSecundario}" Content="Cancelar" Padding="12,6" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ==================== MODAL DE GERAÇÃO: CÓDIGO DE BARRAS & QR CODE ==================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#95000000" Panel.ZIndex="110">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ModalCodigoAberto}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Width="780" MaxWidth="820" Height="580" MaxHeight="620" Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource CorBorda}" BorderThickness="1" Margin="16" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="12" Opacity="0.30" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Header com Título e Fechar -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Conteúdo Principal (Esquerda: Configurações, Direita: Preview Live) -->
                        <RowDefinition Height="*" />
                        <!-- 2: Rodapé com Ações (Cancelar e Inserir) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="20,16" CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#EEF2F6" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="20" Foreground="{StaticResource CorPrimaria}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModalCodigoTitulo}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource CorTexto}" />
                                <TextBlock Text="Escolha o padrão, configure os dados do produto ou texto fixo e veja o resultado em tempo real" FontSize="11" Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="2" Command="{Binding FecharModalCodigoCommand}" Style="{StaticResource BotaoSecundario}" Width="32" Height="32" Padding="0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- CORPO PRINCIPAL -->
                    <Grid Grid.Row="1" Margin="20,16">
                        <Grid.ColumnDefinitions>
                            <!-- Esquerda: Parâmetros e Opções -->
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="16" />
                            <!-- Direita: Prévia e Informações -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ESQUERDA -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                                <!-- 1. Padrão do Código -->
                                <TextBlock Text="PADRÃO / TIPO DO CÓDIGO" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Code 128 -->
                                    <Button Grid.Row="0" Grid.Column="0" Command="{Binding DefinirTipoSimboloCommand}" CommandParameter="Code128" Margin="0,0,4,4" Padding="10,8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModalCodigoTipo}" Value="{x:Static models:TipoSimboloCodigo.Code128}">
                                                        <Setter Property="Background" Value="#EBF3FF" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="Code 128 (1D)" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Padrão Alfanumérico" FontSize="10" Foreground="{StaticResource CorTextoSuave}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- EAN-13 -->
                                    <Button Grid.Row="0" Grid.Column="1" Command="{Binding DefinirTipoSimboloCommand}" CommandParameter="Ean13" Margin="4,0,0,4" Padding="10,8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModalCodigoTipo}" Value="{x:Static models:TipoSimboloCodigo.Ean13}">
                                                        <Setter Property="Background" Value="#EBF3FF" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="EAN-13 (1D)" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Comércio / 13 Dígitos" FontSize="10" Foreground="{StaticResource CorTextoSuave}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- QR Code (2D) -->
                                    <Button Grid.Row="1" Grid.Column="0" Command="{Binding DefinirTipoSimboloCommand}" CommandParameter="QrCode" Margin="0,4,4,0" Padding="10,8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModalCodigoTipo}" Value="{x:Static models:TipoSimboloCodigo.QrCode}">
                                                        <Setter Property="Background" Value="#EBF3FF" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="QR Code (2D)" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Links, Pix e Textos" FontSize="10" Foreground="{StaticResource CorTextoSuave}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Code 39 -->
                                    <Button Grid.Row="1" Grid.Column="1" Command="{Binding DefinirTipoSimboloCommand}" CommandParameter="Code39" Margin="4,4,0,0" Padding="10,8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModalCodigoTipo}" Value="{x:Static models:TipoSimboloCodigo.Code39}">
                                                        <Setter Property="Background" Value="#EBF3FF" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                                        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="Code 39 (1D)" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Industrial e Clássico" FontSize="10" Foreground="{StaticResource CorTextoSuave}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Botão Gerar EAN-13 Interno Nexus -->
                                <Button Command="{Binding GerarEan13NexusCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Stretch" ToolTip="Gera o próximo código de barras livre oficial do Nexus (EAN-13 com prefixo 2 e checksum)">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="14" Foreground="{StaticResource CorPrimaria}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Gerar Próximo EAN-13 Interno Nexus (Prefixo 2)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 2. Origem dos Dados -->
                                <TextBlock Text="ORIGEM DO CONTEÚDO" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Command="{Binding DefinirOrigemCodigoCommand}" CommandParameter="Produto" Padding="10,6" Margin="0,0,2,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModalCodigoOrigemProduto}" Value="True">
                                                            <Setter Property="Background" Value="White" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
                                                            <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Tag24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Campo do Produto" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Command="{Binding DefinirOrigemCodigoCommand}" CommandParameter="Fixo" Padding="10,6" Margin="2,0,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModalCodigoOrigemProduto}" Value="False">
                                                            <Setter Property="Background" Value="White" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
                                                            <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Valor Fixo / Manual" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Campo Variável do Produto (quando Origem == Produto) -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModalCodigoOrigemProduto}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Campo Vinculado" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding VariaveisDisponiveis}"
                                              SelectedItem="{Binding ModalCodigoVariavel, Mode=TwoWay}"
                                              Margin="0,0,0,12" />
                                </StackPanel>

                                <!-- Campo Texto Fixo (quando Origem == Fixo) -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModalCodigoOrigemProduto}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Texto / Conteúdo Personalizado" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ModalCodigoValorFixo, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12" />
                                </StackPanel>

                                <!-- 3. Dimensões no Canvas (Largura x Altura mm) -->
                                <TextBlock Text="DIMENSÕES NA ETIQUETA (MM)" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Largura (mm)" FontSize="11" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding ModalCodigoLarguraMm, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Altura (mm)" FontSize="11" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding ModalCodigoAlturaMm, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 4. Opção de Texto Legível (somente 1D) -->
                                <CheckBox Content="Exibir texto numérico legível abaixo das barras"
                                          IsChecked="{Binding ModalCodigoMostrarLegivel, Mode=TwoWay}"
                                          Margin="0,0,0,12">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModalCodigoEhQrCode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>

                                <!-- Mensagem informativa / Dica de validação -->
                                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="#0284C7" Margin="0,2,8,0" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding ModalCodigoAviso}" FontSize="11" Foreground="#0369A1" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- DIREITA: PRÉ-VISUALIZAÇÃO EM TEMPO REAL -->
                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="PRÉ-VISUALIZAÇÃO EM TEMPO REAL" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,12" HorizontalAlignment="Center" />

                                <!-- Container Branco do Código -->
                                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="6" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding ModalCodigoPreview}"
                                               MaxWidth="250" MaxHeight="200"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Stretch="Uniform" HorizontalAlignment="Center" />

                                        <!-- Texto Legível se habilitado -->
                                        <TextBlock Text="{Binding ModalCodigoValorResolvido}"
                                                   FontFamily="Consolas, Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="Black"
                                                   TextAlignment="Center"
                                                   Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ModalCodigoMostrarLegivel}" Value="True" />
                                                                <Condition Binding="{Binding ModalCodigoEhQrCode}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Detalhes da Codificação -->
                                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Conteúdo:" FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                                            <TextBlock Text="{Binding ModalCodigoValorResolvido}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTexto}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Dimensões:" FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" HorizontalAlignment="Right">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:0.#} × {1:0.#} mm">
                                                        <Binding Path="ModalCodigoLarguraMm" />
                                                        <Binding Path="ModalCodigoAlturaMm" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Formato:" FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                                            <TextBlock Text="{Binding ModalCodigoTipo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RODAPÉ DE AÇÕES -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="20,12" CornerRadius="0,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="1" Command="{Binding FecharModalCodigoCommand}" Style="{StaticResource BotaoSecundario}" Content="Cancelar" Padding="16,8" Margin="0,0,8,0" />

                            <Button Grid.Column="2" Command="{Binding ConfirmarInserirCodigoCommand}" Style="{StaticResource BotaoPrimario}" Padding="18,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Adicionar à Etiqueta" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
