<UserControl x:Class="NexusLS.BarTender.Views.Designer.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NexusLS.BarTender.ViewModels"
             xmlns:models="clr-namespace:NexusLS.BarTender.Models.Designer"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DesignerViewModel}"
             Focusable="True"
             KeyDown="UserControl_KeyDown">

    <UserControl.Resources>
        <Style x:Key="BotaoTool" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="{StaticResource TamRotulo}" />
        </Style>

        <Style x:Key="SubsecaoCard" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RaioMedio}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CardModeloGaleria" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RaioMedio}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Barra de Ferramentas Superior -->
            <RowDefinition Height="Auto" />
            <!-- 1: Área de Trabalho (Canvas Central + Painel de Propriedades) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== BARRA DE FERRAMENTAS SUPERIOR ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Painel}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Grupo 1: Inserir Elementos & Ferramentas -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="INSERIR:" Foreground="{StaticResource CorTextoSuave}" FontWeight="SemiBold" FontSize="{StaticResource TamPequeno}" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <Button Command="{Binding AdicionarTextoCommand}" Style="{StaticResource BotaoTool}" ToolTip="Inserir Caixa de Texto">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" Margin="0,0,5,0" />
                            <TextBlock Text="Texto" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AdicionarImagemCommand}" Style="{StaticResource BotaoTool}" ToolTip="Inserir Logotipo ou Imagem (PNG/JPG)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼️" Margin="0,0,5,0" />
                            <TextBlock Text="Logo / Imagem" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AdicionarCodigoBarrasCommand}" Style="{StaticResource BotaoTool}" ToolTip="Inserir Código de Barras 1D">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷️" Margin="0,0,5,0" />
                            <TextBlock Text="Código 1D" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AdicionarQrCodeCommand}" Style="{StaticResource BotaoTool}" ToolTip="Inserir QR Code 2D">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📱" Margin="0,0,5,0" />
                            <TextBlock Text="QR Code" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AdicionarRetanguloCommand}" Style="{StaticResource BotaoTool}" ToolTip="Inserir Moldura / Retângulo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔲" Margin="0,0,5,0" />
                            <TextBlock Text="Moldura" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AdicionarLinhaCommand}" Style="{StaticResource BotaoTool}" ToolTip="Inserir Linha Divisória">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➖" Margin="0,0,5,0" />
                            <TextBlock Text="Linha" />
                        </StackPanel>
                    </Button>

                    <!-- Divisor -->
                    <Border Width="1" Background="{StaticResource CorBorda}" Margin="6,2,8,2" />

                    <!-- Ações de Alinhamento -->
                    <Button Command="{Binding CentralizarHorizontalmenteCommand}" Style="{StaticResource BotaoTool}" ToolTip="Centralizar Horizontalmente no Papel">
                        <TextBlock Text="↔️ Centro H" />
                    </Button>

                    <Button Command="{Binding CentralizarVerticalmenteCommand}" Style="{StaticResource BotaoTool}" ToolTip="Centralizar Verticalmente no Papel">
                        <TextBlock Text="↕️ Centro V" />
                    </Button>

                    <!-- Divisor -->
                    <Border Width="1" Background="{StaticResource CorBorda}" Margin="6,2,8,2" />

                    <!-- Ações de Edição -->
                    <Button Command="{Binding DuplicarSelecionadoCommand}" Style="{StaticResource BotaoTool}" ToolTip="Duplicar Elemento (Ctrl+D)">
                        <TextBlock Text="📋 Duplicar" />
                    </Button>

                    <Button Command="{Binding ExcluirSelecionadoCommand}" Style="{StaticResource BotaoTool}" ToolTip="Remover Elemento (Del)">
                        <TextBlock Text="🗑️ Excluir" Foreground="{StaticResource CorPerigo}" />
                    </Button>
                </StackPanel>

                <!-- Grupo 2: Modelos, Galeria & Ações -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botão de Destaque da Galeria de Modelos -->
                    <Button Command="{Binding AbrirGaleriaModelosCommand}" Style="{StaticResource BotaoPrimario}" Margin="0,0,8,0" Padding="12,6" ToolTip="Ver todos os modelos pré-produzidos por categoria">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨" Margin="0,0,6,0" />
                            <TextBlock Text="Galeria de Modelos" FontWeight="Bold" />
                            <Border Background="White" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                <TextBlock Text="12" Foreground="{StaticResource CorPrimaria}" FontSize="10" FontWeight="Black" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <ComboBox ItemsSource="{Binding PresetsDisponiveis}" SelectedItem="{Binding PresetSelecionado}" Width="235" Margin="0,0,8,0"
                              SelectionChanged="PresetComboBox_SelectionChanged" ToolTip="Seletor Rápido de Modelo" />

                    <Button Command="{Binding ImprimirTesteCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,0" Padding="11,6" ToolTip="Imprimir 1 teste na impressora">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,5,0" />
                            <TextBlock Text="Imprimir Teste" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SalvarModeloCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,0" Padding="10,6" ToolTip="Salvar layout em arquivo JSON">
                        <TextBlock Text="💾 Salvar" />
                    </Button>

                    <Button Command="{Binding CarregarModeloCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,6" ToolTip="Abrir layout JSON">
                        <TextBlock Text="📂 Abrir..." />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ÁREA DE TRABALHO PRINCIPAL ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Esquerda: Bancada de Trabalho com Canvas da Etiqueta -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <!-- Direita: Painel de Propriedades do Elemento & Prévia -->
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- BANCADA DE TRABALHO DO DESIGNER -->
            <Border Grid.Column="0" Background="{StaticResource CorColunaFundo}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioGrande}" ClipToBounds="True">
                <Grid>
                    <!-- Tag de Medidas e Zoom -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,1,1" CornerRadius="0,0,6,0" Padding="12,6" Panel.ZIndex="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Dimensões:" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamPequeno}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Modelo.LarguraMm, StringFormat='{}{0:0.#} mm'}" Foreground="{StaticResource CorTexto}" FontWeight="Bold" FontSize="{StaticResource TamPequeno}" />
                            <TextBlock Text=" × " Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamPequeno}" />
                            <TextBlock Text="{Binding Modelo.AlturaMm, StringFormat='{}{0:0.#} mm'}" Foreground="{StaticResource CorTexto}" FontWeight="Bold" FontSize="{StaticResource TamPequeno}" />
                            <TextBlock Text="   |   Zoom:" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamPequeno}" Margin="8,0,6,0" />
                            <TextBlock Text="{Binding ZoomNivel, StringFormat='{}{0:P0}'}" Foreground="{StaticResource CorPrimaria}" FontWeight="Bold" FontSize="{StaticResource TamPequeno}" />
                            <TextBlock Text="   |   Atalhos: Del (Excluir), Ctrl+D (Duplicar), Setas (Mover)" Foreground="{StaticResource CorTextoSuave}" FontSize="11" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- ScrollViewer que envolve o Canvas -->
                    <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="Transparent" MouseDown="ScrollViewer_MouseDown">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                            <!-- Sombra suave e Borda do Papel da Etiqueta -->
                            <Border Background="White" CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#111827" BlurRadius="20" ShadowDepth="4" Opacity="0.12" />
                                </Border.Effect>

                                <!-- Canvas da Etiqueta -->
                                <Canvas x:Name="EditorCanvas"
                                        ClipToBounds="True"
                                        Background="White"
                                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                        MouseMove="Canvas_MouseMove"
                                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                                    <Canvas.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding ZoomNivel}" ScaleY="{Binding ZoomNivel}" />
                                    </Canvas.LayoutTransform>
                                </Canvas>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- PAINEL DE PROPRIEDADES DO ELEMENTO & PRÉVIA -->
            <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Título do Painel -->
                        <TextBlock Text="Propriedades do Elemento" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                        <TextBlock Text="Selecione um elemento na etiqueta para editar seus detalhes." Style="{StaticResource TextoApoio}" Margin="0,0,0,14" />

                        <!-- Mensagem quando nenhum elemento está selecionado -->
                        <Border Background="#F9FAFB" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="16" Margin="0,0,0,12"
                                Visibility="{Binding ElementoSelecionado, Converter={StaticResource NullParaColapsadoConverter}, ConverterParameter=invert}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="👆" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Nenhum elemento selecionado" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Clique em um item no papel ou use a barra superior para adicionar novos." Style="{StaticResource TextoApoio}" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Painel quando há elemento selecionado -->
                        <StackPanel Visibility="{Binding ElementoSelecionado, Converter={StaticResource NullParaColapsadoConverter}}">
                            <!-- Tipo do Elemento -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tipo" Style="{StaticResource Rotulo}" Margin="0" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="10,3">
                                    <TextBlock Text="{Binding ElementoSelecionado.Tipo}" Foreground="{StaticResource CorPrimaria}" FontSize="{StaticResource TamPequeno}" FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <!-- Posição e Dimensões em mm -->
                            <TextBlock Text="POSIÇÃO &amp; TAMANHO (MM)" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamPequeno}" FontWeight="Bold" Margin="0,6,0,6" />
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="X (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ElementoSelecionado.X, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Y (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ElementoSelecionado.Y, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Largura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ElementoSelecionado.Largura, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Altura (mm)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ElementoSelecionado.Altura, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}" />
                                </StackPanel>
                            </UniformGrid>

                            <!-- Botões de Alinhamento Rápido -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Command="{Binding CentralizarHorizontalmenteCommand}" Style="{StaticResource BotaoSecundario}" Content="↔️ Centralizar H" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                <Button Command="{Binding CentralizarVerticalmenteCommand}" Style="{StaticResource BotaoSecundario}" Content="↕️ Centralizar V" Padding="8,4" FontSize="11" />
                            </StackPanel>

                            <!-- PROPRIEDADES DE TEXTO -->
                            <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=Texto}">
                                <Border Style="{StaticResource SubsecaoCard}">
                                    <StackPanel>
                                        <TextBlock Text="DADOS DO TEXTO" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="{StaticResource TamRotulo}" Margin="0,0,0,6" />

                                        <TextBlock Text="Campo Dinâmico do ERP" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding VariaveisDisponiveis}"
                                                  SelectedItem="{Binding ElementoSelecionado.Variavel, Mode=TwoWay}"
                                                  Margin="0,0,0,8" />

                                        <TextBlock Text="Texto / Máscara ({Nome}, {Preco})" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ElementoSelecionado.Texto, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="48" Margin="0,0,0,8" />

                                        <TextBlock Text="Alinhamento" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding AlinhamentosDisponiveis}"
                                                  SelectedItem="{Binding ElementoSelecionado.Alinhamento, Mode=TwoWay}"
                                                  Margin="0,0,0,8" />

                                        <TextBlock Text="Tamanho da Fonte (pt)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ElementoSelecionado.TamanhoFonte, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Margin="0,0,0,8" />

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <CheckBox Content="Negrito" IsChecked="{Binding ElementoSelecionado.Negrito, Mode=TwoWay}" Margin="0,0,10,0" />
                                            <CheckBox Content="Itálico" IsChecked="{Binding ElementoSelecionado.Italico, Mode=TwoWay}" Margin="0,0,10,0" />
                                            <CheckBox Content="Riscado (Preço DE)" IsChecked="{Binding ElementoSelecionado.Riscado, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- PROPRIEDADES DE IMAGEM / LOGO -->
                            <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=Imagem}">
                                <Border Style="{StaticResource SubsecaoCard}">
                                    <StackPanel>
                                        <TextBlock Text="IMAGEM / LOGOTIPO" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="{StaticResource TamRotulo}" Margin="0,0,0,6" />

                                        <Button Command="{Binding TrocarImagemElementoCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,4,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁" Margin="0,0,6,0" />
                                                <TextBlock Text="Escolher Imagem (PNG/JPG)..." />
                                            </StackPanel>
                                        </Button>

                                        <CheckBox Content="Manter Proporção Original" IsChecked="{Binding ElementoSelecionado.ManterProporcao, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- PROPRIEDADES DE CÓDIGO DE BARRAS -->
                            <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=CodigoBarras}">
                                <Border Style="{StaticResource SubsecaoCard}">
                                    <StackPanel>
                                        <TextBlock Text="CÓDIGO DE BARRAS" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="{StaticResource TamRotulo}" Margin="0,0,0,6" />

                                        <TextBlock Text="Padrão do Código" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding TiposCodigoDisponiveis}"
                                                  SelectedItem="{Binding ElementoSelecionado.TipoCodigo, Mode=TwoWay}"
                                                  Margin="0,0,0,8" />

                                        <TextBlock Text="Campo Vinculado do Produto" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding VariaveisDisponiveis}"
                                                  SelectedItem="{Binding ElementoSelecionado.Variavel, Mode=TwoWay}"
                                                  Margin="0,0,0,8" />

                                        <TextBlock Text="Valor Fixo / Fallback" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ElementoSelecionado.ValorCodigo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                        <CheckBox Content="Mostrar Texto Numérico Legível" IsChecked="{Binding ElementoSelecionado.MostrarTextoLegivel, Mode=TwoWay}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- PROPRIEDADES DE MOLDURA E LINHA -->
                            <StackPanel Visibility="{Binding ElementoSelecionado.Tipo, Converter={StaticResource TipoElementoVisibilidadeConverter}, ConverterParameter=Forma}">
                                <Border Style="{StaticResource SubsecaoCard}">
                                    <StackPanel>
                                        <TextBlock Text="FORMA GEOMÉTRICA" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="{StaticResource TamRotulo}" Margin="0,0,0,6" />

                                        <TextBlock Text="Espessura da Linha" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ElementoSelecionado.EspessuraBorda, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.#}'}" Margin="0,0,0,8" />

                                        <CheckBox Content="Preencher Fundo" IsChecked="{Binding ElementoSelecionado.Preenchido, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- MINI PRÉVIA REALISTA -->
                        <Border Style="{StaticResource SubsecaoCard}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="PRÉVIA COM O PRODUTO DO ERP" Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamPequeno}" FontWeight="Bold" Margin="0,0,0,8" />
                                <Border Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="6" HorizontalAlignment="Center">
                                    <Image Source="{Binding PreviewImagem}" Stretch="Uniform" MaxHeight="130" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== MODAL OVERLAY: GALERIA DE MODELOS ==================== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Panel.ZIndex="100"
                Visibility="{Binding GaleriaModelosAberta, Converter={StaticResource BoolParaVisibilidadeConverter}}">
            <Border Width="920" MaxHeight="680" Background="White" CornerRadius="{StaticResource RaioGrande}"
                    BorderBrush="{StaticResource CorBorda}" BorderThickness="1" Margin="24" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.25" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header do Modal -->
                        <RowDefinition Height="Auto" />
                        <!-- Filtros por Categoria -->
                        <RowDefinition Height="Auto" />
                        <!-- Grade de Cartões de Modelos -->
                        <RowDefinition Height="*" />
                        <!-- Rodapé -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✨" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Galeria de Modelos de Etiquetas" FontWeight="Bold" FontSize="18" Foreground="{StaticResource CorTexto}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="12 MODELOS PRONTOS" Foreground="{StaticResource CorPrimaria}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Selecione um layout pré-produzido projetado para padrões de mercado térmico e folhas A4." Style="{StaticResource TextoApoio}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding FecharGaleriaModelosCommand}" Style="{StaticResource BotaoFantasma}" Content="✕ Fechar" Padding="12,6" FontSize="13" />
                    </Grid>

                    <!-- Filtros por Categoria -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="8,6" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding CategoriasGaleria}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.FiltrarCategoriaGaleriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BotaoSecundario}"
                                            Content="{Binding}"
                                            Padding="12,5"
                                            Margin="3,2"
                                            FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Grade de Cartões com os Modelos -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding ModelosFiltradosNaGaleria}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PredefinicaoEtiqueta}">
                                    <Border Style="{StaticResource CardModeloGaleria}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Linha 1: Ícone, Título e Medida -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Icone}" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nome}" FontWeight="Bold" Foreground="{StaticResource CorTexto}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Categoria}" Foreground="{StaticResource CorTextoSuave}" FontSize="11" />
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Dimensoes}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CorTexto}" />
                                                </Border>
                                            </Grid>

                                            <!-- Linha 2: Descrição -->
                                            <TextBlock Grid.Row="2" Text="{Binding Descricao}" Style="{StaticResource TextoApoio}" TextWrapping="Wrap" Margin="0,4,0,12" Height="42" />

                                            <!-- Linha 3: Botão Aplicar -->
                                            <Button Grid.Row="3" Command="{Binding DataContext.AplicarPredefinicaoGaleriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BotaoPrimario}"
                                                    Padding="12,8" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="⚡" Margin="0,0,6,0" />
                                                    <TextBlock Text="Usar Este Modelo" FontWeight="Bold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Rodapé do Modal -->
                    <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dica: Você pode customizar livremente qualquer elemento após carregar o modelo." Foreground="{StaticResource CorTextoSuave}" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding FecharGaleriaModelosCommand}" Style="{StaticResource BotaoSecundario}" Content="Fechar Galeria" Padding="14,6" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
