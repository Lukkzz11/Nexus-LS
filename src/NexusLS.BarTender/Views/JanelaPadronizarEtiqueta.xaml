<Window x:Class="NexusLS.BarTender.Views.JanelaPadronizarEtiqueta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Padronizar Etiqueta"
        Width="940" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" FontFamily="{StaticResource FonteTexto}"
        FontSize="{StaticResource TamCorpo}">

    <Window.Resources>
        <Style x:Key="ItemModeloPadronizar" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="BordaModelo"
                                Background="{StaticResource CorSuperficieSuave}"
                                BorderBrush="{StaticResource CorBorda}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource RaioMedio}"
                                Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaModelo" Property="Background" Value="{StaticResource CorHover}" />
                                <Setter TargetName="BordaModelo" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BordaModelo" Property="Background" Value="{StaticResource CorSelecaoSuave}" />
                                <Setter TargetName="BordaModelo" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="{StaticResource CorPainel}"
            BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
            CornerRadius="{StaticResource RaioGrande}">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="32" ShadowDepth="10" Opacity="0.24" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0" Padding="22,18" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1"
                    Background="{StaticResource CorSuperficieSuave}" CornerRadius="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="{StaticResource RaioMedio}"
                            Background="{StaticResource CorTagExclusivaFundo}" BorderBrush="{StaticResource CorTagExclusivaBorda}"
                            BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="22" Foreground="{StaticResource CorTagExclusivaTexto}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Padronizar Etiqueta do Catálogo" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource CorTexto}" />
                        <TextBlock Text="Escolha um modelo feito/salvo por você ou uma predefinição para deixar todas as etiquetas no mesmo padrão, mantendo Tamanho, Referência e Código de Barras (Ref + Tamanho) automáticos."
                                   FontSize="12" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="Fechar_Click"
                            Style="{StaticResource BotaoFantasma}" Width="34" Height="34" Padding="0"
                            VerticalAlignment="Top" ToolTip="Fechar" AutomationProperties.Name="Fechar">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource CorTextoSuave}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Corpo: Lista de Modelos à Esquerda, Prévia e Regras à Direita -->
            <Grid Grid.Row="1" Margin="22,18,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Coluna Esquerda: Seleção do Modelo e Escopo -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1. Escolha o modelo de etiqueta" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource CorTexto}" />
                            <TextBlock Text="Seus modelos salvos aparecem no topo da lista."
                                       Style="{StaticResource TextoApoio}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CarregarDeArquivoCommand}"
                                Style="{StaticResource BotaoSecundario}" Padding="10,6" FontSize="11.5"
                                ToolTip="Escolher um arquivo .json salvo no computador">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Abrir arquivo (.json)..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                            CornerRadius="{StaticResource RaioMedio}" Background="{StaticResource CorPainel}" Padding="8">
                        <ListBox ItemsSource="{Binding OpcoesModelos}"
                                 SelectedItem="{Binding OpcaoSelecionada, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ItemModeloPadronizar}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitulo}" FontSize="11.5"
                                                       Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource CorSuperficieSubtil}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource CorBordaCampo}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EhDoUsuario}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource CorTagExclusivaFundo}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CorTagExclusivaBorda}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding OrigemBadge}" FontSize="9.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EhDoUsuario}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource CorTagExclusivaTexto}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Onde aplicar -->
                    <Border Grid.Row="2" Style="{StaticResource Painel}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="2. Onde aplicar a padronização" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource CorTexto}" Margin="0,0,0,8" />
                            <RadioButton IsChecked="{Binding AplicarEmTodos, Mode=TwoWay}"
                                         Content="{Binding TextoEscopoTodos}"
                                         FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" Margin="0,0,0,6" />
                            <RadioButton IsChecked="{Binding AplicarApenasFiltrados, Mode=TwoWay}"
                                         Content="{Binding TextoEscopoFiltrados}"
                                         IsEnabled="{Binding PodeFiltrados}"
                                         Foreground="{StaticResource CorTexto}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Coluna Direita: Pré-visualização e Garantia das Regras -->
                <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Prévia do Padrão" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource CorTexto}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource CorSuperficieSubtil}"
                                        BorderBrush="{StaticResource CorBordaCampo}" BorderThickness="1"
                                        CornerRadius="{StaticResource RaioPequeno}" Padding="8,3">
                                    <TextBlock Text="{Binding PreviaDimensoes}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource CorTexto}" />
                                </Border>
                            </Grid>

                            <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Testar tamanho:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ItemsControl ItemsSource="{Binding TamanhosAmostra}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Command="{Binding DataContext.SelecionarTamanhoAmostraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BotaoSecundario}"
                                                    Padding="8,2" FontSize="11" FontWeight="Bold" Margin="0,0,4,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Imagem renderizada -->
                        <Border Grid.Row="1" Background="{StaticResource CorFundoMesa}"
                                BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                CornerRadius="{StaticResource RaioMedio}" Padding="14">
                            <Image Source="{Binding PreviaImagem}" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Resumo da Regra Inteligente (Tamanho + Ref + Código) -->
                        <Border Grid.Row="2" Background="{StaticResource CorSucessoFundo}"
                                BorderBrush="{StaticResource CorSucessoBorda}" BorderThickness="1"
                                CornerRadius="{StaticResource RaioMedio}" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" Foreground="{StaticResource CorSucessoTexto}"
                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Regras preservadas automaticamente" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource CorSucessoTexto}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock FontSize="11" Foreground="{StaticResource CorTexto}" TextWrapping="Wrap" Margin="0,0,0,2">
                                    <Run Text="• Tamanho dinâmico: " FontWeight="SemiBold" />
                                    <Run Text="{Binding PreviaTamanho, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource CorPrimaria}" />
                                    <Run Text=" (muda em cada tamanho da grade)" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{StaticResource CorTexto}" TextWrapping="Wrap" Margin="0,0,0,2">
                                    <Run Text="• Referência original mantida: " FontWeight="SemiBold" />
                                    <Run Text="{Binding PreviaReferencia, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text=" (não altera o cadastro)" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{StaticResource CorTexto}" TextWrapping="Wrap">
                                    <Run Text="• Código de Barras (Ref + Tamanho): " FontWeight="SemiBold" />
                                    <Run Text="{Binding PreviaCodigoBarras, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource CorSucessoTexto}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Rodapé -->
            <Border Grid.Row="2" Padding="22,14" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0"
                    Background="{StaticResource CorSuperficieSuave}" CornerRadius="0,0,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Ao padronizar, todas as etiquetas passam a seguir este modelo e ele fica salvo como padrão da loja."
                               Style="{StaticResource TextoApoio}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                                Padding="16,9" Margin="0,0,8,0" IsCancel="True" Click="Fechar_Click" />

                        <Button Style="{StaticResource BotaoPrimario}" Padding="20,9"
                                Click="ConfirmarPadronizacao_Click"
                                ToolTip="Aplicar este modelo padrão às etiquetas respeitando Tamanho, Referência e Código de Barras">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Padronizar Etiquetas" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
