<Window x:Class="NexusLS.BarTender.Views.JanelaProdutoCatalogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Produto do Catálogo"
        Width="900" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" FontFamily="{StaticResource FonteTexto}"
        FontSize="{StaticResource TamCorpo}">

    <Border Margin="18" Background="{StaticResource CorPainel}"
            BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
            CornerRadius="{StaticResource RaioGrande}">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="32" ShadowDepth="10" Opacity="0.24" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho: identidade do produto -->
            <Border Grid.Row="0" Padding="22,18" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1"
                    Background="{StaticResource CorSuperficieSuave}" CornerRadius="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="{StaticResource RaioMedio}"
                            Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}"
                            BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Box24" FontSize="22" Foreground="{StaticResource CorPrimaria}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nome}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border Background="{StaticResource CorSuperficieSubtil}" BorderBrush="{StaticResource CorBordaCampo}"
                                    BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="{Binding ReferenciaExibicao, StringFormat='Ref. {0}'}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" />
                            </Border>
                            <Border Background="{StaticResource CorSuperficieSubtil}" BorderBrush="{StaticResource CorBordaCampo}"
                                    BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="8,3">
                                <TextBlock Text="{Binding CategoriaExibicao}" FontSize="11.5"
                                           Foreground="{StaticResource CorTextoSuave}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="BtnFechar" Click="Fechar_Click"
                            Style="{StaticResource BotaoFantasma}" Width="34" Height="34" Padding="0"
                            VerticalAlignment="Top" ToolTip="Fechar" AutomationProperties.Name="Fechar">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource CorTextoSuave}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Corpo: dados do produto à esquerda, tamanhos e quantidades à direita -->
            <Grid Grid.Row="1" Margin="22,18,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Painel}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="DADOS DO PRODUTO" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,12" />

                            <TextBlock Text="Preço varejo" Style="{StaticResource Rotulo}" />
                            <TextBlock Text="{Binding PrecoVarejoFormatado}" FontSize="24" FontWeight="Black"
                                       Foreground="{StaticResource CorPrimaria}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Preço atacado" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding PrecoAtacadoFormatado}" FontWeight="SemiBold"
                                           Foreground="{StaticResource CorTexto}" FontSize="12" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Estoque" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding EstoqueTotalTexto}" FontWeight="SemiBold"
                                           Foreground="{StaticResource CorTexto}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="{StaticResource RaioGrande}" BorderThickness="1" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CorSuperficieSubtil}" />
                                <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TemEtiquetaPersonalizada}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource CorTagExclusivaFundo}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CorTagExclusivaBorda}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Tag24" FontSize="15" Margin="0,0,7,0"
                                               VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemEtiquetaPersonalizada}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CorTagExclusivaTexto}" />
                                                    <Setter Property="Symbol" Value="ShoppingBag24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock Text="Etiqueta vinculada" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding InfoEtiquetaNome}" FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding InfoEtiquetaDimensoes}" FontSize="11.5"
                                       Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CorInformacaoFundo}" BorderBrush="{StaticResource CorInformacaoBorda}"
                            BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="14" Foreground="{StaticResource CorInformacaoTitulo}"
                                           Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="As quantidades valem só para esta impressão. O cadastro do produto e o modelo da etiqueta não são alterados."
                                       FontSize="11" Foreground="{StaticResource CorInformacaoTexto}"
                                       TextWrapping="Wrap" LineHeight="16" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Tamanhos e quantidades" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource CorTexto}" />
                            <TextBlock Text="Informe quantas etiquetas deseja de cada tamanho. Todos os tamanhos aparecem, mesmo sem saldo: a etiqueta é de produção. Deixe em zero o que não vai imprimir."
                                       Style="{StaticResource TextoApoio}" Margin="0,3,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                CornerRadius="{StaticResource RaioMedio}" Background="{StaticResource CorPainel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{StaticResource CorCabecalho}" Padding="12,8"
                                        BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1"
                                        CornerRadius="7,7,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tamanho" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock Grid.Column="1" Text="Estoque" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock Grid.Column="2" Text="Quantidade" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource CorTextoSuave}" TextAlignment="Right" Margin="0,0,10,0" />
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="318">
                                    <ItemsControl ItemsSource="{Binding Linhas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource CorLinhaGrade}" BorderThickness="0,0,0,1" Padding="12,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="150" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Background="{StaticResource CorSelecaoSuave}"
                                                                BorderBrush="{StaticResource CorSelecao}" BorderThickness="1"
                                                                CornerRadius="{StaticResource RaioPequeno}" Padding="10,5"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TamanhoExibicao}" FontSize="13"
                                                                       FontWeight="Bold" Foreground="{StaticResource CorPrimaria}" />
                                                        </Border>

                                                        <TextBlock Grid.Column="1" Text="{Binding EstoqueTexto}"
                                                                   FontSize="12" Foreground="{StaticResource CorTextoSuave}"
                                                                   VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <Button Command="{Binding DiminuirCommand}" Style="{StaticResource BotaoSecundario}"
                                                                    Width="28" Height="30" Padding="0" Margin="0,0,6,0"
                                                                    ToolTip="Diminuir" AutomationProperties.Name="Diminuir quantidade">
                                                                <ui:SymbolIcon Symbol="Subtract24" FontSize="11" />
                                                            </Button>

                                                            <TextBox Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="62" Height="30" TextAlignment="Center"
                                                                     VerticalContentAlignment="Center" Padding="2"
                                                                     FontSize="13" FontWeight="Bold"
                                                                     AutomationProperties.Name="Quantidade de etiquetas">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource CorBordaCampo}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding QuantidadeInvalida}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource CorPerigo}" />
                                                                                <Setter Property="Foreground" Value="{StaticResource CorPerigo}" />
                                                                                <Setter Property="ToolTip" Value="{Binding MensagemErro}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>

                                                            <Button Command="{Binding AumentarCommand}" Style="{StaticResource BotaoSecundario}"
                                                                    Width="28" Height="30" Padding="0" Margin="6,0,0,0"
                                                                    ToolTip="Aumentar" AutomationProperties.Name="Aumentar quantidade">
                                                                <ui:SymbolIcon Symbol="Add24" FontSize="11" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}"
                                BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="14,10" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Resumo da seleção" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource CorTextoSuave}" />
                                    <TextBlock Text="{Binding ResumoSelecao}" FontSize="12"
                                               Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Total}" FontSize="28" FontWeight="Black"
                                               Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                                    <TextBlock Text="etiquetas" FontSize="12" Foreground="{StaticResource CorTextoSuave}"
                                               VerticalAlignment="Bottom" Margin="5,0,0,5" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Rodapé: validação e as duas saídas -->
            <Border Grid.Row="2" Padding="22,14" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0"
                    Background="{StaticResource CorSuperficieSuave}" CornerRadius="0,0,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MensagemValidacao}" Foreground="{StaticResource CorPerigo}"
                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemValidacao}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="O modelo escolhido no Estúdio é mantido e usado na impressão."
                                   Style="{StaticResource TextoApoio}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                                Padding="16,9" Margin="0,0,8,0" IsCancel="True" Click="Fechar_Click" />

                        <Button Style="{StaticResource BotaoSecundario}" Padding="16,9" Margin="0,0,8,0"
                                Click="AbrirEstudio_Click" ToolTip="Editar o modelo visual da etiqueta deste produto">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PaintBrush24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Abrir no Estúdio" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource BotaoPrimario}" Padding="18,9"
                                Click="IrParaImpressao_Click" ToolTip="Levar as quantidades para a preparação de impressão">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Print24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Ir para Impressão" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
