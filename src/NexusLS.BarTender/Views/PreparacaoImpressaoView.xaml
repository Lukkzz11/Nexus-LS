<UserControl x:Class="NexusLS.BarTender.Views.PreparacaoImpressaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:NexusLS.BarTender.Views">

    <UserControl.Resources>
        <!-- Campo pequeno de medida: rótulo em cima e caixa de texto embaixo. -->
        <Style x:Key="CampoMedida" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,8,10" />
            <Setter Property="Width" Value="104" />
        </Style>

        <Style x:Key="RotuloMedida" TargetType="TextBlock" BasedOn="{StaticResource Rotulo}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- Cartão visual clicável em ListBox (Formato de mídia e Sensor) -->
        <Style x:Key="CartaoSeletorMidiaItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Cartao"
                                Background="{StaticResource CorSuperficieSuave}"
                                BorderBrush="{StaticResource CorBordaCampo}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource RaioMedio}"
                                Padding="8,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cartao" Property="Background" Value="{StaticResource CorHover}" />
                                <Setter TargetName="Cartao" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cartao" Property="Background" Value="{StaticResource CorSelecaoSuave}" />
                                <Setter TargetName="Cartao" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1240" Margin="0,0,6,12">

            <!-- Cabeçalho: produto, referência e as ações de navegação -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Preparação de Impressão" Style="{StaticResource TituloTela}" />
                        <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}"
                                BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="8,2"
                                Margin="12,4,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Selecao.Nome, TargetNullValue='Nenhum produto'}" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" />
                        </Border>
                        <Border Background="{StaticResource CorSuperficieSubtil}" BorderBrush="{StaticResource CorBordaCampo}"
                                BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="8,2"
                                Margin="6,4,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Selecao.ReferenciaExibicao, StringFormat='Ref. {0}'}" FontSize="11.5"
                                       Foreground="{StaticResource CorTextoSuave}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="1. Confira as etiquetas e as quantidades.   2. Escolha a impressora.   3. Clique em Imprimir."
                               Style="{StaticResource TextoApoio}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Command="{Binding VoltarAoCatalogoCommand}" Style="{StaticResource BotaoSecundario}"
                            Padding="12,7" Margin="0,0,8,0" ToolTip="Voltar ao catálogo sem perder a seleção">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Catálogo" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding EditarQuantidadesCommand}" Style="{StaticResource BotaoSecundario}"
                            Padding="12,7" IsEnabled="{Binding TemSelecao}"
                            ToolTip="Reabrir o modal para corrigir tamanhos e quantidades">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Editar quantidades" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="372" />
                </Grid.ColumnDefinitions>

                <!-- ===================== PRÉVIA ===================== -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Painel}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Prévia real das etiquetas" Style="{StaticResource TituloSecao}" />
                                    <TextBlock Text="Uma imagem por tamanho com o modelo vinculado. Você pode ajustar as quantidades direto aqui."
                                               Style="{StaticResource TextoApoio}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource CorSuperficieSubtil}"
                                        BorderBrush="{StaticResource CorBordaCampo}" BorderThickness="1"
                                        CornerRadius="{StaticResource RaioPequeno}" Padding="9,4" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding ModeloDimensoes, StringFormat='Etiqueta {0}'}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" />
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding PreviaItens}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="172" Background="{StaticResource CorSuperficieSuave}"
                                                BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                                CornerRadius="{StaticResource RaioMedio}" Padding="8" Margin="0,0,10,10">
                                            <StackPanel>
                                                <Border Background="White" BorderBrush="{StaticResource CorBorda}"
                                                        BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}"
                                                        Height="88" Margin="0,0,0,7">
                                                    <Image Source="{Binding Imagem}" Stretch="Uniform" Margin="5" />
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Tamanho, StringFormat='Tamanho {0}'}"
                                                                   FontSize="11.5" FontWeight="Bold"
                                                                   Foreground="{StaticResource CorTexto}" />
                                                        <TextBlock Text="{Binding CodigoBarras}" FontSize="9.5"
                                                                   Foreground="{StaticResource CorTextoSuave}" />
                                                    </StackPanel>

                                                    <!-- Edição rápida de quantidade direto no cartão da prévia -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding Linha, Converter={StaticResource NullParaColapsadoConverter}}">
                                                        <Button Command="{Binding Linha.DiminuirCommand}" Style="{StaticResource BotaoSecundario}"
                                                                Width="20" Height="23" Padding="0" Margin="0,0,2,0"
                                                                ToolTip="Diminuir quantidade">
                                                            <ui:SymbolIcon Symbol="Subtract24" FontSize="9" />
                                                        </Button>
                                                        <TextBox Text="{Binding Linha.QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="34" Height="23" TextAlignment="Center"
                                                                 VerticalContentAlignment="Center" Padding="0"
                                                                 FontSize="11" FontWeight="Bold" />
                                                        <Button Command="{Binding Linha.AumentarCommand}" Style="{StaticResource BotaoSecundario}"
                                                                Width="20" Height="23" Padding="0" Margin="2,0,0,0"
                                                                ToolTip="Aumentar quantidade">
                                                            <ui:SymbolIcon Symbol="Add24" FontSize="9" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Grade rápida de tamanhos e quantidades direto na preparação -->
                            <Border Background="{StaticResource CorSuperficieSuave}" BorderBrush="{StaticResource CorBorda}"
                                    BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Ajustar quantidades por tamanho" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource CorTexto}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Selecao.Linhas}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBordaCampo}"
                                                        BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}"
                                                        Padding="8,5" Margin="0,0,8,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}"
                                                                BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TamanhoExibicao}" FontSize="11.5" FontWeight="Bold"
                                                                       Foreground="{StaticResource CorPrimaria}" />
                                                        </Border>
                                                        <Button Command="{Binding DiminuirCommand}" Style="{StaticResource BotaoSecundario}"
                                                                Width="22" Height="24" Padding="0" Margin="0,0,3,0" ToolTip="Diminuir">
                                                            <ui:SymbolIcon Symbol="Subtract24" FontSize="9.5" />
                                                        </Button>
                                                        <TextBox Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="42" Height="24" TextAlignment="Center"
                                                                 VerticalContentAlignment="Center" Padding="1"
                                                                 FontSize="11.5" FontWeight="Bold" />
                                                        <Button Command="{Binding AumentarCommand}" Style="{StaticResource BotaoSecundario}"
                                                                Width="22" Height="24" Padding="0" Margin="3,0,0,0" ToolTip="Aumentar">
                                                            <ui:SymbolIcon Symbol="Add24" FontSize="9.5" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CorSuperficieSubtil}" BorderBrush="{StaticResource CorBorda}"
                                    BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="12,9">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PaintBrush24" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding ModeloNome}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ModeloAjuste}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Organização na página/rolo -->
                    <Border Style="{StaticResource Painel}" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Como será organizado" Style="{StaticResource TituloSecao}" />
                                    <TextBlock Text="{Binding MapaResumo}" Style="{StaticResource TextoApoio}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding OrdemImpressao, StringFormat='Ordem: {0}'}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{StaticResource CorTextoSuave}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource CorDestaqueFundo}"
                                        BorderBrush="{StaticResource CorDestaqueBorda}" BorderThickness="1"
                                        CornerRadius="{StaticResource RaioPequeno}" Padding="10,5" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding PaginasTexto}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource CorDestaqueTexto}" />
                                </Border>
                            </Grid>

                            <Border Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioMedio}" Padding="10">
                                <Border MaxWidth="{Binding MapaLarguraMaxima}" HorizontalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding MapaPagina}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding DataContext.MapaColunas, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="3" CornerRadius="{StaticResource RaioPequeno}"
                                                        BorderThickness="1" Height="58">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource CorSuperficieSuave}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Vazia}" Value="True">
                                                                    <Setter Property="Background" Value="#FBFCFD" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource CorLinhaGrade}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Image Source="{Binding Imagem}" Stretch="Uniform" Margin="4" />
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Background="#B3FFFFFF" CornerRadius="3,0,5,0" Padding="5,1" Margin="0,0,0,0">
                                                            <TextBlock Text="{Binding Detalhe}" FontSize="9.5"
                                                                       Foreground="{StaticResource CorTextoSuave}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== IMPRIMIR E AJUSTES ===================== -->
                <StackPanel Grid.Column="2">
                    <!-- Imprimir: o que a pessoa precisa fica no alto -->
                    <Border Style="{StaticResource Painel}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Imprimir" Style="{StaticResource TituloSecao}" Margin="0,0,0,10" />

                            <TextBlock Text="Impressora instalada" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding ImpressorasInstaladas}"
                                      SelectedItem="{Binding ImpressoraSelecionada, Mode=TwoWay}"
                                      Margin="0,3,0,10" ToolTip="Impressora que receberá o trabalho" />

                            <!-- Ajuste de posição (rolo) e memória da tela -->
                            <TextBlock Text="Descer a impressão (se estiver cortando em cima)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                                <Button Content="−" Command="{Binding DescerMenosCommand}" Width="36" Height="32" />
                                <TextBlock Text="{Binding DescerMm, StringFormat='{}{0} mm'}" Width="64" TextAlignment="Center"
                                           VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" />
                                <Button Content="+" Command="{Binding DescerMaisCommand}" Width="36" Height="32" />
                            </StackPanel>
                            <Button Content="Salvar como padrão" Command="{Binding SalvarPredefinicaoCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                    ToolTip="Guarda impressora, papel e ajuste. Imprimir também salva." />

                            <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}"
                                    BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selecao.Nome}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Selecao.ReferenciaExibicao, StringFormat='Referência {0}'}"
                                                   FontSize="11" Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalEtiquetas}" FontSize="26" FontWeight="Black"
                                                   Foreground="{StaticResource CorPrimaria}" HorizontalAlignment="Right" />
                                        <TextBlock Text="etiquetas" FontSize="10.5" Foreground="{StaticResource CorTextoSuave}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Conferencia}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Tamanho, StringFormat='Tamanho {0}'}" FontSize="12"
                                                       Foreground="{StaticResource CorTexto}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Quantidade, StringFormat='{}{0} un.'}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,8" Background="{StaticResource CorBorda}" />

                            <TextBlock Text="{Binding ResumoMidia}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,4" />
                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,12">
                                <Run Text="Impressora: " />
                                <Run Text="{Binding ImpressoraSelecionada, Mode=OneWay, TargetNullValue='padrão do Windows'}" FontWeight="SemiBold" />
                                <Run Text="{Binding PaginasTexto, Mode=OneWay, StringFormat=' · {0}'}" />
                            </TextBlock>

                            <!-- Aviso de incompatibilidade / medida inválida -->
                            <Border Background="{StaticResource CorAvisoFundo}" BorderBrush="{StaticResource CorAvisoBorda}"
                                    BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="12,10" Margin="0,0,0,10"
                                    Visibility="{Binding TemAvisoMidia, Converter={StaticResource BoolParaVisibilidadeConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="15" Foreground="{StaticResource CorAvisoTexto}"
                                                   Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding AvisoMidia}" FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                               Foreground="{StaticResource CorAvisoTexto}" />
                                </Grid>
                            </Border>

                            <Button Command="{Binding ImprimirCommand}" Style="{StaticResource BotaoPrimario}"
                                    Padding="16,12" IsEnabled="{Binding PodeImprimir}"
                                    ToolTip="Enviar o trabalho para a impressora escolhida">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Print24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="IMPRIMIR" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding MensagemStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EnvioConcluido}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Painel}" Padding="18,12">
                        <Expander Header="Ajustes do papel (só se sair errado)">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Perfil da impressora" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding PerfisImpressora}"
                                          SelectedItem="{Binding PerfilImpressoraSelecionado, Mode=TwoWay}"
                                          DisplayMemberPath="Nome" Margin="0,3,0,4"
                                          ToolTip="Referência de largura e sensores; confira no manual do seu modelo" />
                                <TextBlock Text="{Binding PerfilImpressoraSelecionado.Observacao}" FontSize="10.5"
                                           Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <TextBlock Text="Formato de mídia (escolha o modelo do papel)" Style="{StaticResource Rotulo}" />
                                <ListBox ItemsSource="{Binding MidiasDisponiveis}"
                                         SelectedItem="{Binding MidiaSelecionada, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource CartaoSeletorMidiaItem}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Margin="0,4,0,10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <views:IlustracaoMidia Grid.Column="0" Midia="{Binding}" Width="52" Height="42"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nome}" FontSize="11.5" FontWeight="Bold"
                                                               Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Dimensoes}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource CorPrimaria}" />
                                                        <TextBlock Text=" · " FontSize="10.5" Foreground="{StaticResource CorTextoSuave}" />
                                                        <TextBlock Text="{Binding Distribuicao}" FontSize="10.5"
                                                                   Foreground="{StaticResource CorTextoSuave}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Etiquetas por fileira (depende do papel)" Style="{StaticResource Rotulo}" />
                                <ListBox ItemsSource="{Binding OpcoesFileira}"
                                         SelectedItem="{Binding FileiraSelecionada, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource CartaoSeletorMidiaItem}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Margin="0,4,0,10"
                                         ToolTip="Escolha quantas etiquetas o papel imprime lado a lado">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource CorTexto}" />
                                                <TextBlock Text="{Binding Descricao}" FontSize="9.5"
                                                           Foreground="{StaticResource CorTextoSuave}"
                                                           TextWrapping="Wrap" LineHeight="12" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Sensor / tipo de mídia" Style="{StaticResource Rotulo}" />
                                <ListBox ItemsSource="{Binding TiposMidia}"
                                         SelectedItem="{Binding TipoMidiaSelecionado, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource CartaoSeletorMidiaItem}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Margin="0,4,0,10">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <views:IlustracaoMidia Grid.Column="0" Tipo="{Binding Tipo}" Width="40" Height="38"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NomeCurto}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Descricao}" FontSize="9.5"
                                                               Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" LineHeight="12" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <WrapPanel Margin="0,4,0,0">
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Largura etiqueta (mm)" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding LarguraEtiquetaMm, StringFormat=0.##}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Altura etiqueta (mm)" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding AlturaEtiquetaMm, StringFormat=0.##}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Gap horizontal (mm)" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding EspacoHorizontalMm, StringFormat=0.##}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Gap vertical (mm)" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding EspacoVerticalMm, StringFormat=0.##}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Papel largura (mm)" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding PaginaLarguraMm, StringFormat=0.##}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Papel altura (mm)" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding PaginaAlturaMm, StringFormat=0.##}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Margem esq. (mm)" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding MargemEsquerdaMm, StringFormat=0.##}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Margem sup. (mm)" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding MargemSuperiorMm, StringFormat=0.##}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Colunas" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding Colunas}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}">
                                        <TextBlock Text="Linhas" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding Linhas}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource CampoMedida}" Width="128">
                                        <TextBlock Text="Máx. impressora (mm)" Style="{StaticResource RotuloMedida}" />
                                        <TextBox Text="{Binding LarguraMaximaImpressoraMm, StringFormat=0.##}"
                                                 ToolTip="Área imprimível em largura, conforme o manual da impressora" />
                                    </StackPanel>
                                </WrapPanel>

                                <Button Command="{Binding RestaurarMidiaDoPerfilCommand}" Style="{StaticResource BotaoSecundario}"
                                        Padding="10,6" HorizontalAlignment="Left" Margin="0,2,0,0"
                                        ToolTip="Voltar às medidas do perfil de mídia escolhido">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowReset24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Restaurar medidas do perfil" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
