<Window x:Class="NexusLS.BarTender.Views.JanelaDialogoFluent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nexus BarTender"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="520"
        FontFamily="{StaticResource FonteTexto}">

    <Border Margin="16"
            Background="{StaticResource CorPainel}"
            BorderBrush="{StaticResource CorBorda}"
            BorderThickness="1"
            CornerRadius="{StaticResource RaioGrande}">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="8" Opacity="0.22" />
        </Border.Effect>

        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho com Ícone e Título -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="BordaIcone" Grid.Column="0" Width="40" Height="40"
                        CornerRadius="{StaticResource RaioMedio}" Margin="0,0,14,0"
                        Background="{StaticResource CorSelecaoSuave}"
                        VerticalAlignment="Top">
                    <ui:SymbolIcon x:Name="IconeTipo" Symbol="Info24" FontSize="22"
                                   Foreground="{StaticResource CorPrimaria}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo" Text="Nexus BarTender"
                               FontWeight="Bold" FontSize="{StaticResource TamSecao}"
                               Foreground="{StaticResource CorTexto}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Corpo: Mensagem -->
            <TextBlock Grid.Row="1" x:Name="TxtMensagem" Text="Mensagem"
                       FontSize="{StaticResource TamCorpo}"
                       Foreground="{StaticResource CorTexto}"
                       LineHeight="20"
                       TextWrapping="Wrap" Margin="0,0,0,24" />

            <!-- Rodapé: Botões de Ação -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancelar" Style="{StaticResource BotaoSecundario}"
                        Content="Cancelar" Width="100" Height="36"
                        Margin="0,0,10,0" Click="BtnCancelar_Click" />
                <Button x:Name="BtnConfirmar" Style="{StaticResource BotaoPrimario}"
                        Content="OK" MinWidth="100" Height="36" Padding="16,0"
                        Click="BtnConfirmar_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
