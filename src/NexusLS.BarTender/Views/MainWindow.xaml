<Window x:Class="NexusLS.BarTender.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NexusLS.BarTender.ViewModels"
        xmlns:conv="clr-namespace:NexusLS.BarTender.Converters"
        mc:Ignorable="d"
        Title="Nexus BarTender - Impressão de Etiquetas &amp; Códigos de Barras"
        Width="1380" Height="840"
        MinWidth="1150" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundoApp}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Superior -->
            <RowDefinition Height="64" />
            <!-- 1: Conteúdo Principal -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== HEADER SUPERIOR ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CorFundoHeader}" BorderBrush="{StaticResource CorCardBorda}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identidade Visual BarTender -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CorBarTenderRoxo}" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="🏷️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NEXUS" Foreground="{StaticResource CorTextoPrincipal}" FontWeight="Bold" FontSize="17" />
                            <TextBlock Text=" BARTENDER" Foreground="{StaticResource CorBarTenderRoxo}" FontWeight="Black" FontSize="17" Margin="4,0,0,0" />
                            <Border Background="#2C2046" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PRO LABELS" Foreground="#C4B5FD" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Gerador de Códigos de Barras &amp; Estúdio de Etiquetas para Nexus LS" Foreground="{StaticResource CorTextoSecundario}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Status de Conexão com o Banco do Nexus LS -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CorCardFundo}" BorderBrush="{StaticResource CorCardBorda}" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource CorSucesso}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BancoConectado}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource CorPerigo}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusBanco}" Foreground="{StaticResource CorTextoPrincipal}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding SelecionarBancoCommand}" Style="{StaticResource BotaoSecundario}" Content="📁 Trocar Banco..." Margin="0,0,8,0" Padding="10,6" FontSize="12" />
                    <Button Command="{Binding RecarregarDadosCommand}" Style="{StaticResource BotaoSecundario}" Content="🔄 Atualizar" Padding="10,6" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== CORPO PRINCIPAL ==================== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <!-- Esquerda: Catálogo e Gerador de Códigos (60%) -->
                <ColumnDefinition Width="6*" MinWidth="520" />
                <ColumnDefinition Width="14" />
                <!-- Direita: Designer, Prévia e Fila (40%) -->
                <ColumnDefinition Width="4.4*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- COLUNA ESQUERDA: CATÁLOGO & GERADOR -->
            <Border Grid.Column="0" Background="{StaticResource CorCardFundo}" BorderBrush="{StaticResource CorCardBorda}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Título e Contadores -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Filtros e Busca -->
                        <RowDefinition Height="Auto" />
                        <!-- 2: Tabela de Produtos -->
                        <RowDefinition Height="*" />
                        <!-- 3: Barra de Ações Rápidas -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 0: Cabeçalho do Catálogo & Estatísticas -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Catálogo de Produtos" Foreground="{StaticResource CorTextoPrincipal}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="Selecione um produto para pré-visualizar ou gere códigos individuais e em lote" Foreground="{StaticResource CorTextoSecundario}" FontSize="11.5" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Indicadores Rápidos -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                <TextBlock Foreground="{StaticResource CorTextoPrincipal}" FontSize="11.5">
                                    <Run Text="Total: " Foreground="{StaticResource CorTextoSecundario}" />
                                    <Run Text="{Binding TotalProdutos, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Border>
                            <Border Background="#132E27" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                <TextBlock Foreground="{StaticResource CorSucesso}" FontSize="11.5">
                                    <Run Text="Com Código: " />
                                    <Run Text="{Binding ProdutosComCodigo, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Border>
                            <Border Background="#3B2A14" CornerRadius="6" Padding="8,4">
                                <TextBlock Foreground="{StaticResource CorAviso}" FontSize="11.5">
                                    <Run Text="Sem Código: " />
                                    <Run Text="{Binding ProdutosSemCodigo, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 1: Filtros e Barra de Busca -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Botões de Filtro -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                            <RadioButton Content="Todos" GroupName="Filtro"
                                         IsChecked="{Binding FiltroTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=Todos, Mode=TwoWay}"
                                         Style="{x:Null}" Margin="0,0,4,0" Cursor="Hand" VerticalAlignment="Center">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="bd" Background="#242938" CornerRadius="6" Padding="10,6">
                                            <TextBlock x:Name="tb" Text="Todos" Foreground="{StaticResource CorTextoSecundario}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CorPrimaria}" />
                                                <Setter TargetName="tb" Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <RadioButton Content="Sem Código" GroupName="Filtro"
                                         IsChecked="{Binding FiltroTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=SemCodigo, Mode=TwoWay}"
                                         Style="{x:Null}" Margin="0,0,4,0" Cursor="Hand" VerticalAlignment="Center">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="bd" Background="#242938" CornerRadius="6" Padding="10,6">
                                            <TextBlock x:Name="tb" Text="⚠️ Sem Código" Foreground="{StaticResource CorAviso}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CorAviso}" />
                                                <Setter TargetName="tb" Property="Foreground" Value="Black" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <RadioButton Content="Com Código" GroupName="Filtro"
                                         IsChecked="{Binding FiltroTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=ComCodigo, Mode=TwoWay}"
                                         Style="{x:Null}" Cursor="Hand" VerticalAlignment="Center">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="bd" Background="#242938" CornerRadius="6" Padding="10,6">
                                            <TextBlock x:Name="tb" Text="✅ Com Código" Foreground="{StaticResource CorSucesso}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CorSucesso}" />
                                                <Setter TargetName="tb" Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </StackPanel>

                        <!-- Campo de Busca -->
                        <Grid Grid.Column="1">
                            <TextBox Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}" Padding="28,7,10,7" />
                            <TextBlock Text="🔍" Foreground="{StaticResource CorTextoMuted}" FontSize="12"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                            <TextBlock Text="Pesquisar por nome, referência, categoria, código..."
                                       Foreground="{StaticResource CorTextoMuted}" FontSize="12" VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TextoBusca}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- 2: Tabela de Produtos -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ProdutosView}"
                              SelectedItem="{Binding ProdutoSelecionado, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <!-- Nome -->
                            <DataGridTemplateColumn Header="Produto / Nome" Width="2.8*" SortMemberPath="Nome">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="6,2">
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="{StaticResource CorTextoPrincipal}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Categoria}" Foreground="{StaticResource CorTextoMuted}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Referência -->
                            <DataGridTextColumn Header="Ref." Binding="{Binding Referencia}" Width="1*" />

                            <!-- Preço Varejo -->
                            <DataGridTextColumn Header="Preço Varejo" Binding="{Binding PrecoVarejoFormatado}" Width="1.1*" FontWeight="Bold" />

                            <!-- Preço Atacado -->
                            <DataGridTextColumn Header="Preço Atacado" Binding="{Binding PrecoAtacadoFormatado}" Width="1.1*" />

                            <!-- Estoque -->
                            <DataGridTextColumn Header="Estoque" Binding="{Binding EstoqueAtual}" Width="0.8*" />

                            <!-- Código de Barras -->
                            <DataGridTemplateColumn Header="Código de Barras" Width="1.8*" SortMemberPath="CodigoBarras">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" Margin="2" HorizontalAlignment="Left"
                                                Background="{Binding TemCodigoBarras, Converter={StaticResource StatusCodigoFundoConverter}}">
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding TemCodigoBarras, Converter={StaticResource StatusCodigoCorConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding CodigoBarras}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TemCodigoBarras}" Value="False">
                                                                <Setter Property="Text" Value="SEM CÓDIGO" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 3: Ações Rápidas do Catálogo -->
                    <Border Grid.Row="3" Background="#141720" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource CorCardBorda}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Geradores de Código -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Command="{Binding GerarCodigoIndividualCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" Margin="0,0,6,0" />
                                        <TextBlock Text="Gerar Código Individual (EAN-13)" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding GerarCodigosEmLoteCommand}" Style="{StaticResource BotaoRoxo}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✨" Margin="0,0,6,0" />
                                        <TextBlock Text="Gerar Códigos para Todos sem Código" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Fila de Impressão -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding AdicionarSelecionadoFilaCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,0">
                                    <TextBlock Text="➕ Fila" />
                                </Button>
                                <Button Command="{Binding PuxarEstoqueAtualCommand}" Style="{StaticResource BotaoSecundario}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦" Margin="0,0,4,0" />
                                        <TextBlock Text="Puxar Estoque p/ Fila" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- COLUNA DIREITA: DESIGNER, PRÉ-VISUALIZAÇÃO & FILA -->
            <Border Grid.Column="2" Background="{StaticResource CorCardFundo}" BorderBrush="{StaticResource CorCardBorda}" BorderThickness="1" CornerRadius="10" Padding="16">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="border" Background="#1C202C" CornerRadius="6,6,0,0" Padding="16,8" Margin="0,0,4,0" Cursor="Hand">
                                            <ContentPresenter ContentSource="Header" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{StaticResource CorCardHover}" />
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CorBarTenderRoxo}" />
                                                <Setter TargetName="border" Property="BorderThickness" Value="0,3,0,0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- TAB 1: DESIGNER & PRÉ-VISUALIZAÇÃO REALISTA -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" Margin="0,0,6,0" />
                                <TextBlock Text="Designer &amp; Prévia" Foreground="{StaticResource CorTextoPrincipal}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <!-- Barra de Controles de Zoom e Exportação -->
                                <RowDefinition Height="Auto" />
                                <!-- Área da Prévia com Canvas/Papel -->
                                <RowDefinition Height="280" />
                                <!-- Painel de Configurações e Formato -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Barra de Ferramentas de Zoom & Exportação -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Zoom -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Zoom:" Foreground="{StaticResource CorTextoSecundario}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Command="{Binding ZoomMenosCommand}" Style="{StaticResource BotaoSecundario}" Content="-" Width="28" Height="28" Padding="0" Margin="0,0,4,0" />
                                    <Button Command="{Binding ZoomPadraoCommand}" Style="{StaticResource BotaoSecundario}" Content="100%" Height="28" Padding="8,0" Margin="0,0,4,0" FontSize="11" />
                                    <Button Command="{Binding ZoomMaisCommand}" Style="{StaticResource BotaoSecundario}" Content="+" Width="28" Height="28" Padding="0" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ZoomNivel, StringFormat='{}{0:P0}'}" Foreground="{StaticResource CorTextoMuted}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Copiar ZPL / Exportar PNG -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding SalvarImagemCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,0" Padding="8,5" FontSize="11.5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾" Margin="0,0,4,0" />
                                            <TextBlock Text="Salvar PNG" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CopiarZplCommand}" Style="{StaticResource BotaoRoxo}" Padding="8,5" FontSize="11.5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" Margin="0,0,4,0" />
                                            <TextBlock Text="Copiar ZPL II" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Área de Prévia Realista da Etiqueta -->
                            <Border Grid.Row="1" Background="#0A0B10" CornerRadius="8" BorderBrush="{StaticResource CorCardBorda}" BorderThickness="1" Margin="0,0,0,12" ClipToBounds="True">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
                                    <Border Background="White" CornerRadius="3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.6" />
                                        </Border.Effect>
                                        <Image Source="{Binding PreviewImagem}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding ZoomNivel}" ScaleY="{Binding ZoomNivel}" />
                                            </Image.LayoutTransform>
                                        </Image>
                                    </Border>
                                </ScrollViewer>
                            </Border>

                            <!-- Opções de Personalização da Etiqueta -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Formato da Etiqueta -->
                                    <TextBlock Text="FORMATO DO PAPEL / BOBINA" Foreground="{StaticResource CorTextoSecundario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding FormatosDisponiveis}"
                                              SelectedItem="{Binding Config.Formato, Mode=TwoWay}"
                                              DisplayMemberPath="Nome"
                                              Background="{StaticResource CorInputFundo}"
                                              Foreground="{StaticResource CorTextoPrincipal}"
                                              BorderBrush="{StaticResource CorInputBorda}"
                                              Padding="10,6" Margin="0,0,0,12" FontSize="13" />

                                    <!-- Nome da Loja -->
                                    <TextBlock Text="CABEÇALHO DA LOJA" Foreground="{StaticResource CorTextoSecundario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Config.MostrarNomeLoja, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Config.NomeLoja, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Config.MostrarNomeLoja}" />
                                    </Grid>

                                    <!-- Opções Visuais em Grade -->
                                    <TextBlock Text="ELEMENTOS VISÍVEIS NA ETIQUETA" Foreground="{StaticResource CorTextoSecundario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <CheckBox Content="Nome do Produto" IsChecked="{Binding Config.MostrarNomeProduto, Mode=TwoWay}" />
                                        <CheckBox Content="Referência (REF)" IsChecked="{Binding Config.MostrarReferencia, Mode=TwoWay}" />
                                        <CheckBox Content="Preço Varejo (Grande)" IsChecked="{Binding Config.MostrarPrecoVarejo, Mode=TwoWay}" />
                                        <CheckBox Content="Preço Atacado" IsChecked="{Binding Config.MostrarPrecoAtacado, Mode=TwoWay}" />
                                        <CheckBox Content="Código Interno" IsChecked="{Binding Config.MostrarCodigoInterno, Mode=TwoWay}" />
                                        <CheckBox Content="Tamanho" IsChecked="{Binding Config.MostrarTamanho, Mode=TwoWay}" />
                                        <CheckBox Content="Código de Barras" IsChecked="{Binding Config.MostrarCodigoBarras, Mode=TwoWay}" />
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: FILA DE IMPRESSÃO & DISPARO -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" Margin="0,0,6,0" />
                                <TextBlock Text="Fila de Impressão" Foreground="{StaticResource CorTextoPrincipal}" FontWeight="Bold" FontSize="13" />
                                <Border Background="{StaticResource CorPrimaria}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding TotalEtiquetasFila}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <!-- Tabela de Itens da Fila -->
                                <RowDefinition Height="*" />
                                <!-- Rodapé com Totais e Botão de Impressão -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Lista da Fila -->
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding FilaImpressao}"
                                      Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <!-- Produto -->
                                    <DataGridTemplateColumn Header="Produto" Width="3*" SortMemberPath="Nome">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Margin="6,2">
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="{StaticResource CorTextoPrincipal}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CodigoBarras}" Foreground="{StaticResource CorTextoMuted}" FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Varejo -->
                                    <DataGridTextColumn Header="Preço" Binding="{Binding PrecoVarejoFormatado}" Width="1.2*" />

                                    <!-- Quantidade com Controles + e - -->
                                    <DataGridTemplateColumn Header="Qtd Etiquetas" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.DecrementarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource BotaoSecundario}" Content="-" Width="24" Height="24" Padding="0" Margin="0,0,6,0" />

                                                    <TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Width="40" Height="26"
                                                             TextAlignment="Center" VerticalAlignment="Center" Padding="2" FontSize="12" />

                                                    <Button Command="{Binding DataContext.IncrementarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource BotaoSecundario}" Content="+" Width="24" Height="24" Padding="0" Margin="6,0,8,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Remover -->
                                    <DataGridTemplateColumn Header="" Width="0.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoverItemFilaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BotaoSecundario}" Content="✕" Width="26" Height="24" Padding="0"
                                                        Foreground="{StaticResource CorPerigo}" ToolTip="Remover da fila" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Totais e Disparo de Impressão -->
                            <Border Grid.Row="1" Background="#141720" CornerRadius="8" Padding="14" BorderBrush="{StaticResource CorCardBorda}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Resumo das Etiquetas -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Foreground="{StaticResource CorTextoPrincipal}" FontSize="13">
                                                <Run Text="Total de Etiquetas: " Foreground="{StaticResource CorTextoSecundario}" />
                                                <Run Text="{Binding TotalEtiquetasFila, Mode=OneWay}" FontWeight="Black" FontSize="15" />
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource CorTextoMuted}" FontSize="11.5" Margin="0,2,0,0">
                                                <Run Text="Estimativa: " />
                                                <Run Text="{Binding TotalPaginasFila, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" página(s) / bobina" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="1" Command="{Binding LimparFilaCommand}" Style="{StaticResource BotaoSecundario}" Content="🗑️ Limpar Fila" FontSize="11.5" Padding="8,4" />
                                    </Grid>

                                    <!-- Botão Grande de Impressão -->
                                    <Button Grid.Row="1" Command="{Binding ImprimirCommand}" Style="{StaticResource BotaoSucesso}" Padding="16,12" FontSize="15" FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖨️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="IMPRIMIR ETIQUETAS NO WINDOWS" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
