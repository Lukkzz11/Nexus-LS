<Window x:Class="NexusLS.BarTender.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NexusLS.BarTender.ViewModels"
        xmlns:conv="clr-namespace:NexusLS.BarTender.Converters"
        xmlns:designer="clr-namespace:NexusLS.BarTender.Views.Designer"
        mc:Ignorable="d"
        Title="Nexus BarTender - Impressão de Etiquetas &amp; Códigos de Barras"
        Width="1420" Height="860"
        MinWidth="1150" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundo}"
        FontFamily="{StaticResource FonteTexto}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Estilo de Aba no Padrão do Nexus LS -->
        <Style x:Key="AbaNexus" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="18,10" Margin="0,0,4,0" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CorPainel}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="0,3,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillContador" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RaioPequeno}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Superior Nexus -->
            <RowDefinition Height="Auto" />
            <!-- 1: Conteúdo Principal -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== HEADER SUPERIOR NO ESTILO NEXUS ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identidade Visual Nexus BarTender -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="🏷️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NEXUS" Foreground="{StaticResource CorTexto}" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text=" BARTENDER" Foreground="{StaticResource CorPrimaria}" FontWeight="Black" FontSize="18" Margin="4,0,0,0" />
                            <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioPequeno}" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ESTÚDIO DE ETIQUETAS" Foreground="{StaticResource CorPrimaria}" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Gerador de Códigos de Barras &amp; Designer de Etiquetas integrado ao Nexus LS" Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Status de Conexão com o Banco SQLite -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource CorPositivo}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BancoConectado}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource CorPerigo}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusBanco}" Foreground="{StaticResource CorTexto}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding SelecionarBancoCommand}" Style="{StaticResource BotaoSecundario}" Content="📁 Trocar Banco..." Margin="0,0,8,0" Padding="12,6" FontSize="12" />
                    <Button Command="{Binding RecarregarDadosCommand}" Style="{StaticResource BotaoSecundario}" Content="🔄 Atualizar" Padding="12,6" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== CORPO PRINCIPAL ==================== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <!-- Esquerda: Catálogo e Gerador de Códigos (45%) -->
                <ColumnDefinition Width="4.6*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <!-- Direita: Designer, Prévia e Fila (55%) -->
                <ColumnDefinition Width="6.4*" MinWidth="580" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

            <!-- COLUNA ESQUERDA: CATÁLOGO & GERADOR -->
            <Border Grid.Column="0" Style="{StaticResource Painel}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Título e Contadores -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Filtros e Busca -->
                        <RowDefinition Height="Auto" />
                        <!-- 2: Tabela de Produtos -->
                        <RowDefinition Height="*" />
                        <!-- 3: Barra de Ações Rápidas -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 0: Título & Badges de Status -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Catálogo de Produtos" Style="{StaticResource TituloSecao}" VerticalAlignment="Center" />

                        <!-- Badges de contagem -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource PillContador}" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                                <TextBlock Text="{Binding TotalProdutos, StringFormat='{}Total: {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" />
                            </Border>
                            <Border Style="{StaticResource PillContador}" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1">
                                <TextBlock Text="{Binding ProdutosComCodigo, StringFormat='{}Com Código: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" />
                            </Border>
                            <Border Style="{StaticResource PillContador}" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1">
                                <TextBlock Text="{Binding ProdutosSemCodigo, StringFormat='{}Sem Código: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 1: Filtros e Busca -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Filtro por status do código -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <RadioButton Content="Todos" GroupName="FiltroCodigo" IsChecked="{Binding FiltroTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=Todos, Mode=TwoWay}" Margin="0,0,8,0" />
                            <RadioButton Content="Sem Código" GroupName="FiltroCodigo" IsChecked="{Binding FiltroTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=SemCodigo, Mode=TwoWay}" Margin="0,0,8,0" />
                            <RadioButton Content="Com Código" GroupName="FiltroCodigo" IsChecked="{Binding FiltroTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=ComCodigo, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Campo de Busca -->
                        <TextBox Grid.Column="1" Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}" Padding="10,6"
                                 AutomationProperties.Name="Pesquisar produtos" ToolTip="Buscar por nome, referência, categoria ou código..." />
                    </Grid>

                    <!-- 2: Tabela de Produtos -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ProdutosView}"
                              SelectedItem="{Binding ProdutoSelecionado, Mode=TwoWay}"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <!-- Nome -->
                            <DataGridTemplateColumn Header="Produto" Width="2.8*" SortMemberPath="Nome">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="6,2">
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Categoria}" Foreground="{StaticResource CorTextoSuave}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Referência -->
                            <DataGridTextColumn Header="Ref." Binding="{Binding Referencia}" Width="1*" />

                            <!-- Preço Varejo -->
                            <DataGridTextColumn Header="Preço Varejo" Binding="{Binding PrecoVarejoFormatado}" Width="1.1*" FontWeight="Bold" />

                            <!-- Preço Atacado -->
                            <DataGridTextColumn Header="Preço Atacado" Binding="{Binding PrecoAtacadoFormatado}" Width="1.1*" />

                            <!-- Estoque -->
                            <DataGridTextColumn Header="Estoque" Binding="{Binding EstoqueAtual}" Width="0.8*" />

                            <!-- Código de Barras -->
                            <DataGridTemplateColumn Header="Código de Barras" Width="1.8*" SortMemberPath="CodigoBarras">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" Margin="2" HorizontalAlignment="Left"
                                                Background="{Binding TemCodigoBarras, Converter={StaticResource StatusCodigoFundoConverter}}">
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding TemCodigoBarras, Converter={StaticResource StatusCodigoCorConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding CodigoBarras}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TemCodigoBarras}" Value="False">
                                                                <Setter Property="Text" Value="SEM CÓDIGO" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 3: Ações Rápidas do Catálogo -->
                    <Border Grid.Row="3" Background="#F9FAFB" CornerRadius="{StaticResource RaioMedio}" Padding="12,10" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Geradores de Código -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Command="{Binding GerarCodigoIndividualCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" Margin="0,0,6,0" />
                                        <TextBlock Text="Gerar Código (EAN-13)" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding GerarCodigosEmLoteCommand}" Style="{StaticResource BotaoPrimario}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✨" Margin="0,0,6,0" />
                                        <TextBlock Text="Gerar Todos s/ Código" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Fila de Impressão -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding AdicionarSelecionadoFilaCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,0">
                                    <TextBlock Text="➕ Fila" />
                                </Button>
                                <Button Command="{Binding PuxarEstoqueAtualCommand}" Style="{StaticResource BotaoSecundario}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦" Margin="0,0,4,0" />
                                        <TextBlock Text="Puxar Estoque" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- COLUNA DIREITA: DESIGNER, PRÉVIA & FILA -->
            <Border Grid.Column="2" Background="Transparent">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- TAB 1: ESTÚDIO & DESIGNER VISUAL (DRAG & DROP) -->
                    <TabItem Style="{StaticResource AbaNexus}" IsSelected="True">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" Margin="0,0,6,0" />
                                <TextBlock Text="Estúdio de Etiquetas" FontWeight="Bold" FontSize="13" />
                                <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="PRO" Foreground="{StaticResource CorPrimaria}" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>

                        <designer:DesignerView DataContext="{Binding DesignerVM}" Margin="0,8,0,0" />
                    </TabItem>

                    <!-- TAB 2: PRÉVIA RÁPIDA -->
                    <TabItem Style="{StaticResource AbaNexus}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,6,0" />
                                <TextBlock Text="Configuração Rápida" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </TabItem.Header>

                        <Border Style="{StaticResource Painel}" Margin="0,8,0,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="260" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Zoom e Exportação -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Zoom:" Style="{StaticResource Rotulo}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <Button Command="{Binding ZoomMenosCommand}" Style="{StaticResource BotaoSecundario}" Content="-" Width="28" Height="28" Padding="0" Margin="0,0,4,0" />
                                        <Button Command="{Binding ZoomPadraoCommand}" Style="{StaticResource BotaoSecundario}" Content="100%" Height="28" Padding="8,0" Margin="0,0,4,0" FontSize="11" />
                                        <Button Command="{Binding ZoomMaisCommand}" Style="{StaticResource BotaoSecundario}" Content="+" Width="28" Height="28" Padding="0" Margin="0,0,8,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding SalvarImagemCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,0" Padding="10,5">
                                            <TextBlock Text="💾 Salvar PNG" />
                                        </Button>
                                        <Button Command="{Binding CopiarZplCommand}" Style="{StaticResource BotaoSecundario}" Padding="10,5">
                                            <TextBlock Text="📋 Copiar ZPL II" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Prévia -->
                                <Border Grid.Row="1" Background="{StaticResource CorColunaFundo}" CornerRadius="{StaticResource RaioMedio}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" Margin="0,0,0,12" ClipToBounds="True">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
                                        <Border Background="White" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#111827" BlurRadius="16" ShadowDepth="4" Opacity="0.12" />
                                            </Border.Effect>
                                            <Image Source="{Binding PreviewImagem}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.LayoutTransform>
                                                    <ScaleTransform ScaleX="{Binding ZoomNivel}" ScaleY="{Binding ZoomNivel}" />
                                                </Image.LayoutTransform>
                                            </Image>
                                        </Border>
                                    </ScrollViewer>
                                </Border>

                                <!-- Opções -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Formato do Papel" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding FormatosDisponiveis}" SelectedItem="{Binding Config.Formato, Mode=TwoWay}" DisplayMemberPath="Nome" Margin="0,0,0,12" />

                                        <TextBlock Text="Cabeçalho da Loja" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Config.NomeLoja, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                        <TextBlock Text="Elementos Visíveis" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <UniformGrid Columns="2" Margin="0,0,0,12">
                                            <CheckBox Content="Nome do Produto" IsChecked="{Binding Config.MostrarNomeProduto, Mode=TwoWay}" />
                                            <CheckBox Content="Referência (REF)" IsChecked="{Binding Config.MostrarReferencia, Mode=TwoWay}" />
                                            <CheckBox Content="Preço Varejo" IsChecked="{Binding Config.MostrarPrecoVarejo, Mode=TwoWay}" />
                                            <CheckBox Content="Preço Atacado" IsChecked="{Binding Config.MostrarPrecoAtacado, Mode=TwoWay}" />
                                            <CheckBox Content="Código Interno" IsChecked="{Binding Config.MostrarCodigoInterno, Mode=TwoWay}" />
                                            <CheckBox Content="Tamanho" IsChecked="{Binding Config.MostrarTamanho, Mode=TwoWay}" />
                                            <CheckBox Content="Código de Barras" IsChecked="{Binding Config.MostrarCodigoBarras, Mode=TwoWay}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- TAB 3: FILA DE IMPRESSÃO -->
                    <TabItem Style="{StaticResource AbaNexus}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" Margin="0,0,6,0" />
                                <TextBlock Text="Fila de Impressão" FontWeight="Bold" FontSize="13" />
                                <Border Background="{StaticResource CorPrimaria}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding TotalEtiquetasFila}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>

                        <Border Style="{StaticResource Painel}" Margin="0,8,0,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Lista da Fila -->
                                <DataGrid Grid.Row="0" ItemsSource="{Binding FilaImpressao}" Margin="0,0,0,12">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Produto" Width="3*" SortMemberPath="Nome">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="6,2">
                                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CodigoBarras}" Foreground="{StaticResource CorTextoSuave}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Preço" Binding="{Binding PrecoVarejoFormatado}" Width="1.2*" />

                                        <DataGridTemplateColumn Header="Qtd Etiquetas" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Command="{Binding DataContext.DecrementarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource BotaoSecundario}" Content="-" Width="26" Height="26" Padding="0" Margin="0,0,6,0" />

                                                        <TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Width="44" Height="28"
                                                                 TextAlignment="Center" VerticalAlignment="Center" Padding="2" FontSize="12" />

                                                        <Button Command="{Binding DataContext.IncrementarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource BotaoSecundario}" Content="+" Width="26" Height="26" Padding="0" Margin="6,0,8,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="" Width="0.8*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.RemoverItemFilaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource BotaoFantasma}" Content="✕" ToolTip="Remover da fila" Padding="6,2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Rodapé da Fila -->
                                <Border Grid.Row="1" Background="#F9FAFB" CornerRadius="{StaticResource RaioMedio}" Padding="16,12" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Foreground="{StaticResource CorTexto}" FontSize="13">
                                                    <Run Text="Total de Etiquetas: " Foreground="{StaticResource CorTextoSuave}" />
                                                    <Run Text="{Binding TotalEtiquetasFila, Mode=OneWay}" FontWeight="Black" FontSize="16" />
                                                </TextBlock>
                                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="11.5" Margin="0,2,0,0">
                                                    <Run Text="Estimativa: " />
                                                    <Run Text="{Binding TotalPaginasFila, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" página(s) / bobina" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1" Command="{Binding LimparFilaCommand}" Style="{StaticResource BotaoSecundario}" Content="🗑️ Limpar Fila" FontSize="12" Padding="10,6" />
                                        </Grid>

                                        <!-- Opção de Modelo -->
                                        <Border Grid.Row="1" Background="White" CornerRadius="{StaticResource RaioPequeno}" Padding="12,8" Margin="0,0,0,12" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                                            <CheckBox Content="Imprimir usando o modelo montado no Estúdio de Etiquetas (com imagens/logo e QR code)"
                                                      IsChecked="{Binding UsarModeloDesigner, Mode=TwoWay}"
                                                      FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" />
                                        </Border>

                                        <!-- Botão Grande de Impressão -->
                                        <Button Grid.Row="2" Command="{Binding ImprimirCommand}" Style="{StaticResource BotaoPrimario}" Padding="16,12" FontSize="15" FontWeight="Bold">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🖨️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="IMPRIMIR ETIQUETAS NO WINDOWS" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
