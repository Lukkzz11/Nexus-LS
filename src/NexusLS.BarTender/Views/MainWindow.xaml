<ui:FluentWindow x:Class="NexusLS.BarTender.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:NexusLS.BarTender.ViewModels"
        xmlns:conv="clr-namespace:NexusLS.BarTender.Converters"
        xmlns:designer="clr-namespace:NexusLS.BarTender.Views.Designer"
        mc:Ignorable="d"
        Title="Nexus BarTender · Estúdio de Etiquetas &amp; Códigos de Barras"
        Height="860" Width="1440" MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None" Background="{StaticResource CorFundo}"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource FonteTexto}" FontSize="{StaticResource TamCorpo}">

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>

    <ui:FluentWindow.Resources>
        <!-- Estilo de item do menu lateral idêntico ao Nexus LS -->
        <Style x:Key="ItemDoMenu" TargetType="Button" BasedOn="{StaticResource BotaoMenu}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IgualTag}">
                            <Binding Path="TelaAtiva" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource CorMenuAtivo}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CorSelecao}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconeDoMenu" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="{StaticResource TamIcone}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PillContador" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RaioPequeno}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Barra de Título Windows 11 Fluent -->
            <RowDefinition Height="Auto" />
            <!-- 1: Conteúdo Principal com Sidebar -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título Fluent com botões minimizar/maximizar/fechar nativos -->
        <ui:TitleBar Grid.Row="0" Title="Nexus BarTender · Estúdio de Etiquetas &amp; Códigos" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Menu Lateral Padrão Nexus LS (230px) -->
                <ColumnDefinition Width="230" />
                <!-- Área de Conteúdo Ativo -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== MENU LATERAL (NEXUS LS) ==================== -->
            <Border Grid.Column="0" Style="{StaticResource PainelLateral}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Topo: Identidade do App -->
                        <RowDefinition Height="Auto" />
                        <!-- Meio: Itens do Menu -->
                        <RowDefinition Height="*" />
                        <!-- Rodapé: Conexão SQLite do Nexus LS -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Identidade Visual do BarTender -->
                    <Border Grid.Row="0" Padding="16,14,16,12" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Width="36" Height="36" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Tag24" FontSize="20" Foreground="{StaticResource CorPrimaria}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="NEXUS " FontWeight="Bold" FontSize="14" Foreground="{StaticResource CorTexto}" />
                                    <TextBlock Text="BARTENDER" FontWeight="Black" FontSize="14" Foreground="{StaticResource CorPrimaria}" />
                                </StackPanel>
                                <TextBlock Text="ETIQUETAS &amp; CÓDIGOS" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource CorTextoSuave}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Itens de Navegação -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,16">
                            <TextBlock Text="PRODUÇÃO DE ETIQUETAS" Style="{StaticResource SecaoMenu}" />

                            <!-- 1. Estúdio de Etiquetas (Designer CAD) -->
                            <Button Tag="Estudio" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaEstudioCommand}" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PaintBrush24" Style="{StaticResource IconeDoMenu}" />
                                    <TextBlock Text="Estúdio de Etiquetas" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 2. Catálogo de Produtos do ERP -->
                            <Button Tag="Catalogo" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaCatalogoCommand}" Margin="0,0,0,4">
                                <Grid Width="170">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <ui:SymbolIcon Symbol="Box24" Style="{StaticResource IconeDoMenu}" />
                                        <TextBlock Text="Catálogo ERP" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalProdutos}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 3. Fila de Impressão -->
                            <Button Tag="Fila" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFilaCommand}" Margin="0,0,0,4">
                                <Grid Width="170">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <ui:SymbolIcon Symbol="Print24" Style="{StaticResource IconeDoMenu}" />
                                        <TextBlock Text="Fila de Impressão" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource CorPrimaria}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalEtiquetasFila}" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 4. Configurações & Impressora -->
                            <TextBlock Text="PREFERÊNCIAS" Style="{StaticResource SecaoMenu}" Margin="20,16,18,6" />

                            <Button Tag="Configuracoes" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaConfiguracoesCommand}" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource IconeDoMenu}" />
                                    <TextBlock Text="Configurações" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 5. Licença & Atualizações -->
                            <Button Style="{StaticResource ItemDoMenu}" Command="{Binding AbrirAtualizadorLicencaCommand}">
                                <Grid Width="170">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Style="{StaticResource IconeDoMenu}" />
                                        <TextBlock Text="Licença &amp; Atualizador" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#15803D" CornerRadius="10" Padding="6,1" VerticalAlignment="Center"
                                            Visibility="{Binding TemAtualizacaoDisponivel, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="NOVA" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rodapé do Menu Lateral: Status do Banco SQLite & Licença -->
                    <Border Grid.Row="2" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="14,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource CorPositivo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BancoConectado}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource CorPerigo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusBanco}" Foreground="{StaticResource CorTexto}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding LicencaTexto}" Foreground="{StaticResource CorTextoSuave}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding RecarregarDadosCommand}" Style="{StaticResource BotaoSecundario}" Padding="8,4" FontSize="11" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SelecionarBancoCommand}" Style="{StaticResource BotaoSecundario}" Padding="8,4" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Banco..." VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== ÁREA DE CONTEÚDO ATIVO ==================== -->
            <Grid Grid.Column="1">

                <!-- 1. TELA DO ESTÚDIO DE ETIQUETAS (DESIGNER CAD) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TelaAtiva}" Value="Estudio">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <designer:DesignerView DataContext="{Binding DesignerVM}" />
                </Grid>

                <!-- 2. TELA DO CATÁLOGO DE PRODUTOS DO ERP -->
                <Grid Margin="20,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TelaAtiva}" Value="Catalogo">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <!-- Header com Título e Estatísticas -->
                        <RowDefinition Height="Auto" />
                        <!-- Barra de Busca e Filtros -->
                        <RowDefinition Height="Auto" />
                        <!-- Tabela de Produtos -->
                        <RowDefinition Height="*" />
                        <!-- Ações Rápidas no Rodapé -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Catálogo de Produtos do Nexus LS" Style="{StaticResource TituloTela}" />
                            <TextBlock Text="Selecione produtos para editar no Estúdio de Etiquetas, gerar códigos EAN-13 ou adicionar à fila." Style="{StaticResource TextoApoio}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Badges de Status -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource PillContador}" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                                <TextBlock Text="{Binding TotalProdutos, StringFormat='{}Total: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" />
                            </Border>
                            <Border Style="{StaticResource PillContador}" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1">
                                <TextBlock Text="{Binding ProdutosComCodigo, StringFormat='{}Com Código: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#15803D" />
                            </Border>
                            <Border Style="{StaticResource PillContador}" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1">
                                <TextBlock Text="{Binding ProdutosSemCodigo, StringFormat='{}Sem Código: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#B45309" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Barra de Busca & Filtros -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13.5" Padding="10,8" Margin="0,0,12,0" />

                        <!-- Filtro por Categoria -->
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CategoriasDisponiveis}"
                                  SelectedItem="{Binding CategoriaSelecionada, Mode=TwoWay}"
                                  Width="180" Margin="0,0,12,0" ToolTip="Filtrar por Categoria" />

                        <!-- Segmented Filter -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="Todos" IsChecked="{Binding FiltroTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=Todos, Mode=TwoWay}"
                                         Style="{StaticResource BotaoOpcao}" Margin="0,0,6,0" />
                            <RadioButton Content="Com Código" IsChecked="{Binding FiltroTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=ComCodigo, Mode=TwoWay}"
                                         Style="{StaticResource BotaoOpcao}" Margin="0,0,6,0" />
                            <RadioButton Content="Sem Código" IsChecked="{Binding FiltroTipo, Converter={StaticResource ComparisonConverter}, ConverterParameter=SemCodigo, Mode=TwoWay}"
                                         Style="{StaticResource BotaoOpcao}" />
                        </StackPanel>
                    </Grid>

                    <!-- Tabela de Produtos -->
                    <Border Grid.Row="2" Style="{StaticResource Painel}" Padding="0" Margin="0,0,0,14">
                        <DataGrid ItemsSource="{Binding ProdutosView}"
                                  SelectedItem="{Binding ProdutoSelecionado}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource CorLinhaGrade}" BorderThickness="0" Background="{StaticResource CorPainel}" RowHeight="42"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoInterno}" Width="90" IsReadOnly="True" />

                                <DataGridTemplateColumn Header="Produto" Width="3*" SortMemberPath="Nome">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="6,2">
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Referencia, TargetNullValue='Sem referência'}" Foreground="{StaticResource CorTextoSuave}" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria, TargetNullValue='—'}" Width="1.5*" IsReadOnly="True" />

                                <!-- Tamanho que vai para a fila (a etiqueta sai por tamanho) -->
                                <DataGridTemplateColumn Header="Tamanho" Width="1.15*" SortMemberPath="TamanhoSelecionado">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding OpcoesTamanho}"
                                                      SelectedItem="{Binding TamanhoSelecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="28" MinWidth="104" FontSize="11.5"
                                                      VerticalContentAlignment="Center"
                                                      ToolTip="Tamanho que entra na fila. &quot;Todos os tamanhos&quot; cria uma etiqueta para cada tamanho da grade." />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Preço Varejo" Binding="{Binding PrecoVarejoFormatado}" Width="1.2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Preço Atacado" Binding="{Binding PrecoAtacadoFormatado}" Width="1.2*" IsReadOnly="True" />

                                <!-- Status do Código de Barras -->
                                <DataGridTemplateColumn Header="Código de Barras" Width="1.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding TemCodigoBarras, Converter={StaticResource StatusCodigoFundoConverter}}"
                                                    CornerRadius="{StaticResource RaioPequeno}" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CodigoBarrasExibicao}"
                                                           Foreground="{Binding TemCodigoBarras, Converter={StaticResource StatusCodigoCorConverter}}"
                                                           FontWeight="SemiBold" FontSize="11.5" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Modelo de Etiqueta Cadastrado -->
                                <DataGridTemplateColumn Header="Etiqueta Vinculada" Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                <Border CornerRadius="{StaticResource RaioPequeno}" Padding="7,3" HorizontalAlignment="Left" ToolTip="{Binding DimensoesEtiquetaPersonalizada, StringFormat='{}Tamanho: {0}'}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F1F5F9" />
                                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TemEtiquetaPersonalizada}" Value="True">
                                                                    <Setter Property="Background" Value="#F3E8FF" />
                                                                    <Setter Property="BorderBrush" Value="#C084FC" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Tag24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TemEtiquetaPersonalizada}" Value="True">
                                                                            <Setter Property="Foreground" Value="#7E22CE" />
                                                                            <Setter Property="Symbol" Value="ShoppingBag24" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                        <TextBlock Text="{Binding NomeEtiquetaPersonalizada}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TemEtiquetaPersonalizada}" Value="True">
                                                                            <Setter Property="Foreground" Value="#7E22CE" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Ação Rápida de Usar no Estúdio & Adicionar à Fila com Qtd -->
                                <DataGridTemplateColumn Header="Ações" Width="2.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.UsarProdutoNoEstudioCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BotaoPrimario}" Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                        ToolTip="Abrir e editar a etiqueta deste produto no Estúdio">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="PaintBrush24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Abrir Etiqueta" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Quantidade Rápida -->
                                                <Button Command="{Binding DecrementarQtdCommand}" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,2,0">
                                                    <ui:SymbolIcon Symbol="Subtract24" FontSize="11" />
                                                </Button>
                                                <TextBox Text="{Binding QuantidadeAdicionar, UpdateSourceTrigger=PropertyChanged}" Width="34" Height="24"
                                                         TextAlignment="Center" VerticalContentAlignment="Center" FontSize="11" FontWeight="Bold" Padding="0" Margin="0,0,2,0" />
                                                <Button Command="{Binding IncrementarQtdCommand}" Style="{StaticResource BotaoSecundario}" Width="24" Height="24" Padding="0" Margin="0,0,4,0">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="11" />
                                                </Button>

                                                <Button Command="{Binding DataContext.AdicionarItemComQuantidadeFilaCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BotaoSecundario}" Padding="8,4" FontSize="11" ToolTip="Adicionar esta quantidade à fila">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Fila" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Ações Rápidas no Rodapé -->
                    <Border Grid.Row="3" Style="{StaticResource Painel}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Command="{Binding GerarCodigoIndividualCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Gerar Código EAN-13 para Selecionado" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding GerarCodigosEmLoteCommand}" Style="{StaticResource BotaoPrimario}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Gerar Códigos para Todos sem Código" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding PuxarEstoqueAtualCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Box24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Puxar Estoque da Loja p/ Fila" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. TELA DA FILA DE IMPRESSÃO -->
                <Grid Margin="20,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TelaAtiva}" Value="Fila">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <!-- Header da Fila -->
                        <RowDefinition Height="Auto" />
                        <!-- Tabela da Fila -->
                        <RowDefinition Height="*" />
                        <!-- Painel de Disparo de Impressão -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fila de Impressão de Etiquetas" Style="{StaticResource TituloTela}" />
                            <TextBlock Text="Revise a quantidade de cópias por item antes de enviar para a impressora térmica ou folha A4." Style="{StaticResource TextoApoio}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding LimparFilaCommand}" Style="{StaticResource BotaoSecundario}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Limpar Toda a Fila" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Painel}" Padding="0" Margin="0,0,0,14">
                        <DataGrid ItemsSource="{Binding FilaImpressao}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource CorLinhaGrade}" BorderThickness="0" Background="{StaticResource CorPainel}" RowHeight="46">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Produto" Width="3*" SortMemberPath="Nome">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="10,2">
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                                                <TextBlock Text="{Binding CodigoBarras, TargetNullValue='Sem código de barras'}" Foreground="{StaticResource CorTextoSuave}" FontSize="11.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Tamanho" Binding="{Binding TamanhoExibicao}" Width="1*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Preço Varejo" Binding="{Binding PrecoVarejoFormatado}" Width="1.5*" IsReadOnly="True" />

                                <DataGridTemplateColumn Header="Quantidade de Etiquetas" Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.DecrementarItemCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BotaoSecundario}" Width="30" Height="30" Padding="0" Margin="0,0,8,0">
                                                    <ui:SymbolIcon Symbol="Subtract24" FontSize="13" />
                                                </Button>

                                                <TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Width="52" Height="30"
                                                         TextAlignment="Center" VerticalContentAlignment="Center" Padding="2" FontSize="13" FontWeight="Bold" />

                                                <Button Command="{Binding DataContext.IncrementarItemCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BotaoSecundario}" Width="30" Height="30" Padding="0" Margin="8,0,0,0">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="0.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoverItemFilaCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BotaoFantasma}" ToolTip="Remover este item da fila" Padding="6,4">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{StaticResource CorPerigo}" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Rodapé de Disparo da Fila -->
                    <Border Grid.Row="2" Background="{StaticResource CorPainel}" CornerRadius="{StaticResource RaioGrande}" Padding="20,16" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource CorTexto}" FontSize="14">
                                        <Run Text="Total de Etiquetas a Imprimir: " Foreground="{StaticResource CorTextoSuave}" />
                                        <Run Text="{Binding TotalEtiquetasFila, Mode=OneWay}" FontWeight="Black" FontSize="18" Foreground="{StaticResource CorPrimaria}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,2,0,0">
                                        <Run Text="Estimativa de Páginas / Bobina: " />
                                        <Run Text="{Binding TotalPaginasFila, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource CorTexto}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Seleção de Impressora e Posição Inicial para Folhas A4 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Impressora de Destino" Style="{StaticResource Rotulo}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding ImpressorasInstaladas}" SelectedItem="{Binding ImpressoraSelecionada, Mode=TwoWay}" Width="240" Height="32" ToolTip="Selecione a impressora térmica ou padrão do Windows" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Posição Inicial (Folha A4)" Style="{StaticResource Rotulo}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding PosicaoInicialFolha, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="32" TextAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" ToolTip="Começar na etiqueta nº para reaproveitar folhas parcialmente usadas" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Checkbox de integração com o Estúdio -->
                            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="{StaticResource RaioPequeno}" Padding="12,10" Margin="0,0,0,14" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                                <CheckBox Content="Imprimir usando o modelo customizado ativo no Estúdio de Etiquetas (com imagens/logo, QR code e cores)"
                                          IsChecked="{Binding UsarModeloDesigner, Mode=TwoWay}"
                                          FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" />
                            </Border>

                            <!-- Botão Grande de Impressão -->
                            <Button Grid.Row="2" Command="{Binding ImprimirCommand}" Style="{StaticResource BotaoPrimario}" Padding="20,14" FontSize="16" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Print24" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="IMPRIMIR ETIQUETAS NO WINDOWS" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. TELA DE CONFIGURAÇÕES -->
                <ScrollViewer Margin="20,16" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TelaAtiva}" Value="Configuracoes">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Configurações de Impressão" Style="{StaticResource TituloTela}" Margin="0,0,0,4" />
                        <TextBlock Text="Personalize o cabeçalho padrão da sua loja e formatos de bobina." Style="{StaticResource TextoApoio}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource Painel}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DADOS DA LOJA" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CorTexto}" Margin="0,0,0,10" />

                                <TextBlock Text="Nome / Cabeçalho da Loja impresso nas etiquetas" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Config.NomeLoja, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                                <TextBlock Text="Formato de Papel Padrão" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding FormatosDisponiveis}" SelectedItem="{Binding Config.Formato, Mode=TwoWay}" DisplayMemberPath="Nome" Margin="0,0,0,14" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Painel}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="EXPORTAÇÃO ZPL II (ZEBRA)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CorTexto}" Margin="0,0,0,10" />
                                <TextBlock Text="Código ZPL II nativo gerado para a etiqueta atual:" Style="{StaticResource TextoApoio}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding DesignerVM.ZplCodigo, Mode=OneWay}" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="140" Margin="0,0,0,10" />
                                <Button Command="{Binding CopiarZplCommand}" Style="{StaticResource BotaoSecundario}" Padding="12,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Copiar Código ZPL II" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
