<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Menu lateral: coluna branca com um fio à direita; o item da tela aberta fica azul claro. -->

    <Style x:Key="PainelLateral" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CorMenu}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!-- Título de grupo do menu (VENDAS, ESTOQUE, GESTÃO). -->
    <Style x:Key="SecaoMenu" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
        <Setter Property="FontSize" Value="{StaticResource TamMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="20,20,18,6" />
    </Style>

    <!-- Item do menu: transparente, cinza claro ao passar o mouse, contorno azul no foco pelo teclado. -->
    <Style x:Key="BotaoMenu" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="10,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borda"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RaioMedio}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource CorFoco}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CorHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
