<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Tabelas (DataGrid). Estilos implícitos: toda tabela do programa ganha o mesmo visual sem precisar declarar nada.
        Cabeçalho discreto, só linhas horizontais leves, realce ao passar o mouse e azul claro na linha selecionada.
        As telas que pintam a linha por regra (ex.: estoque baixo) usam BasedOn {x:Type DataGridRow} e herdam isto.
    -->

    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}" />
        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CorLinhaGrade}" />
        <Setter Property="ColumnHeaderHeight" Value="{StaticResource AlturaCabecalhoTabela}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource CorCabecalho}" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
        <Setter Property="FontSize" Value="{StaticResource TamPequeno}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CorHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource CorSelecao}" />
                <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
            </Trigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>
