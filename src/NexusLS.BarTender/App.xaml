<Application x:Class="NexusLS.BarTender.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:NexusLS.BarTender.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/Tokens.xaml" />
                <ResourceDictionary Source="Resources/Tipografia.xaml" />
                <ResourceDictionary Source="Resources/Botoes.xaml" />
                <ResourceDictionary Source="Resources/Campos.xaml" />
                <ResourceDictionary Source="Resources/Tabelas.xaml" />
                <ResourceDictionary Source="Resources/Menu.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Conversores Globais -->
            <conv:CentavosParaMoedaConverter x:Key="CentavosParaMoedaConverter" />
            <conv:StatusCodigoCorConverter x:Key="StatusCodigoCorConverter" />
            <conv:StatusCodigoFundoConverter x:Key="StatusCodigoFundoConverter" />
            <conv:ComparisonConverter x:Key="ComparisonConverter" />
            <conv:BoolInversoConverter x:Key="BoolInversoConverter" />
            <conv:NullParaColapsadoConverter x:Key="NullParaColapsadoConverter" />
            <conv:TipoElementoVisibilidadeConverter x:Key="TipoElementoVisibilidadeConverter" />
            <conv:BoolParaVisibilidadeConverter x:Key="BoolParaVisibilidadeConverter" />
            <conv:IgualAoTagConverter x:Key="IgualTag" />
            <conv:BoolParaTextoConverter x:Key="BoolTexto" />
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <BooleanToVisibilityConverter x:Key="BoolVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
