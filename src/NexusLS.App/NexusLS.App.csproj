<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NexusLS.Core\NexusLS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\catalogo.zip" LogicalName="catalogo.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Nome do arquivo gerado: NexusLS.exe -->
    <AssemblyName>NexusLS</AssemblyName>
    <!-- Versão de desenvolvimento. Ao publicar, publicar-versao.ps1 grava a versão do release dentro do .exe. -->
    <Version>1.1.0</Version>
    <Product>Nexus LS</Product>
    <AssemblyTitle>Nexus LS</AssemblyTitle>
  </PropertyGroup>

</Project>
