<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NexusLS.Core\NexusLS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Nome do arquivo gerado: NexusLS.exe -->
    <AssemblyName>NexusLS</AssemblyName>
    <Product>Nexus LS</Product>
    <AssemblyTitle>Nexus LS</AssemblyTitle>
  </PropertyGroup>

</Project>
