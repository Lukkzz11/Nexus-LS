<ui:FluentWindow x:Class="NexusLS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nexus LS" Height="760" Width="1280" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15">

    <ui:FluentWindow.InputBindings>
        <!-- F1 abre o PDV de qualquer tela. -->
        <KeyBinding Key="F1" Command="{Binding IrParaPdvCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- Um estilo só para todos os itens do menu: o botão cujo Tag é igual ao item ativo vira um "cartão" branco. -->
        <Style x:Key="ItemDoMenu" TargetType="Button" BasedOn="{StaticResource BotaoMenu}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IgualTag}">
                            <Binding Path="ItemAtivo" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource CorMenuAtivo}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ícone + texto de um item do menu -->
        <Style x:Key="IconeDoMenu" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título no estilo do Windows 11 (com os botões de minimizar, maximizar e fechar) -->
        <ui:TitleBar Grid.Row="0" Title="Nexus LS" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu lateral, agrupado: Vendas, Estoque, Gestão -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,4,0,16">
                    <Button Tag="Inicio" AutomationProperties.Name="Início" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaInicioCommand}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Início" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="VENDAS" Style="{StaticResource SecaoMenu}" />
                    <Button Tag="Pdv" AutomationProperties.Name="PDV" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaPdvCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Cart24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="PDV  (F1)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Caixa" AutomationProperties.Name="Caixa" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaCaixaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Receipt24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Caixa" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Fechamento" AutomationProperties.Name="Fechamento de caixa" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFechamentoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Money24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Fechamento" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="MaisVendidos" AutomationProperties.Name="Mais vendidos" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaMaisVendidosCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowTrending24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Mais vendidos" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="ESTOQUE" Style="{StaticResource SecaoMenu}" />
                    <Button Tag="EstoqueDaLoja" AutomationProperties.Name="Estoque da loja" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaEstoqueCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Box24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Estoque da loja" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="GESTÃO" Style="{StaticResource SecaoMenu}" />
                    <Button Tag="Clientes" AutomationProperties.Name="Clientes" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaClientesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Clientes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Relatorios" AutomationProperties.Name="Relatórios" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaRelatoriosCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataBarVertical24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Relatórios" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Configuracoes" AutomationProperties.Name="Configurações" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaConfiguracoesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Configurações" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Área da tela atual. O ContentControl mostra o ViewModel e o WPF escolhe a View (veja App.xaml). -->
            <ContentControl Grid.Column="1" Content="{Binding TelaAtual}" Margin="8,4,24,20" />
        </Grid>
    </Grid>
</ui:FluentWindow>
