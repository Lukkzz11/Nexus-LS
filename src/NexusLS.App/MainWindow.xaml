<Window x:Class="NexusLS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus LS" Height="760" Width="1280" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource CorFundo}"
        FontFamily="Segoe UI" FontSize="15">

    <Window.Resources>
        <!-- Um estilo só para todos os itens do menu: o botão cujo Tag é igual ao item ativo fica destacado. -->
        <Style x:Key="ItemDoMenu" TargetType="Button" BasedOn="{StaticResource BotaoMenu}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IgualTag}">
                            <Binding Path="ItemAtivo" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource CorMenuAtivo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral, agrupado: Vendas, Estoque, Gestão -->
        <Border Background="{StaticResource CorMenu}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Nexus LS" Foreground="White" FontSize="20" FontWeight="Bold" Margin="18,22,18,10" />

                    <TextBlock Text="VENDAS" Style="{StaticResource SecaoMenu}" />
                    <Button Content="PDV" Tag="Pdv" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaPdvCommand}" />
                    <Button Content="Caixa" Tag="Caixa" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaCaixaCommand}" />
                    <Button Content="Mais vendidos" Tag="MaisVendidos" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaMaisVendidosCommand}" />

                    <TextBlock Text="ESTOQUE" Style="{StaticResource SecaoMenu}" />
                    <Button Content="Estoque da loja" Tag="EstoqueDaLoja" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaEstoqueCommand}" />
                    <Button Content="Etiquetas" Tag="Etiquetas" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaEtiquetasCommand}" />

                    <TextBlock Text="GESTÃO" Style="{StaticResource SecaoMenu}" />
                    <Button Content="Clientes" Tag="Clientes" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaClientesCommand}" />
                    <Button Content="Relatórios" Tag="Relatorios" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaRelatoriosCommand}" />
                    <Button Content="Configurações" Tag="Configuracoes" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaConfiguracoesCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Área da tela atual. O ContentControl mostra o ViewModel e o WPF escolhe a View (veja App.xaml). -->
        <ContentControl Grid.Column="1" Content="{Binding TelaAtual}" Margin="20" />
    </Grid>
</Window>
