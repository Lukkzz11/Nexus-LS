<Window x:Class="NexusLS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus LS" Height="760" Width="1280" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource CorFundo}"
        FontFamily="Segoe UI" FontSize="15">

    <Window.Resources>
        <!-- Um estilo por item do menu: o da tela aberta fica destacado. -->
        <Style x:Key="MenuPdv" TargetType="Button" BasedOn="{StaticResource BotaoMenu}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PdvAtivo}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CorMenuAtivo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuCaixa" TargetType="Button" BasedOn="{StaticResource BotaoMenu}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CaixaAtivo}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CorMenuAtivo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuEstoque" TargetType="Button" BasedOn="{StaticResource BotaoMenu}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstoqueAtivo}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CorMenuAtivo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuConfiguracoes" TargetType="Button" BasedOn="{StaticResource BotaoMenu}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConfiguracoesAtivo}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CorMenuAtivo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral, agrupado: Vendas, Estoque, Gestão -->
        <Border Background="{StaticResource CorMenu}">
            <StackPanel>
                <TextBlock Text="Nexus LS" Foreground="White" FontSize="20" FontWeight="Bold" Margin="18,22,18,10" />

                <TextBlock Text="VENDAS" Style="{StaticResource SecaoMenu}" />
                <Button Content="PDV" Style="{StaticResource MenuPdv}" Command="{Binding IrParaPdvCommand}" />
                <Button Content="Caixa" Style="{StaticResource MenuCaixa}" Command="{Binding IrParaCaixaCommand}" />

                <TextBlock Text="ESTOQUE" Style="{StaticResource SecaoMenu}" />
                <Button Content="Estoque da loja" Style="{StaticResource MenuEstoque}" Command="{Binding IrParaEstoqueCommand}" />

                <TextBlock Text="GESTÃO" Style="{StaticResource SecaoMenu}" />
                <Button Content="Configurações" Style="{StaticResource MenuConfiguracoes}" Command="{Binding IrParaConfiguracoesCommand}" />
            </StackPanel>
        </Border>

        <!-- Área da tela atual. O ContentControl mostra o ViewModel e o WPF escolhe a View (veja App.xaml). -->
        <ContentControl Grid.Column="1" Content="{Binding TelaAtual}" Margin="20" />
    </Grid>
</Window>
