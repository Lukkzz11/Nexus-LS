<ui:FluentWindow x:Class="NexusLS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nexus LS" Height="760" Width="1280" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None" Background="{StaticResource CorFundo}"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource FonteTexto}" FontSize="{StaticResource TamCorpo}">

    <ui:FluentWindow.InputBindings>
        <!-- F1 abre o PDV de qualquer tela. -->
        <KeyBinding Key="F1" Command="{Binding IrParaPdvCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- Um estilo só para todos os itens do menu: o botão cujo Tag é igual ao item ativo fica azul claro. -->
        <Style x:Key="ItemDoMenu" TargetType="Button" BasedOn="{StaticResource BotaoMenu}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IgualTag}">
                            <Binding Path="ItemAtivo" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource CorMenuAtivo}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CorSelecao}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ícone + texto de um item do menu -->
        <Style x:Key="IconeDoMenu" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="{StaticResource TamIcone}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título no estilo do Windows 11 (com os botões de minimizar, maximizar e fechar) -->
        <ui:TitleBar Grid.Row="0" Title="Nexus LS" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu lateral, agrupado: Vendas, Estoque, Gestão -->
            <Border Style="{StaticResource PainelLateral}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,0,16">
                    <Button Tag="Inicio" AutomationProperties.Name="Início" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaInicioCommand}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Início" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="VENDAS" Style="{StaticResource SecaoMenu}" Visibility="{Binding VerSecaoVendas, Converter={StaticResource BoolVis}}" />
                    <Button Tag="Pdv" Visibility="{Binding VerPdv, Converter={StaticResource BoolVis}}" AutomationProperties.Name="PDV" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaPdvCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Cart24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="PDV  (F1)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="VendaCliente" Visibility="{Binding VerPdv, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Venda Cliente" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaVendaClienteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonCircle24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Venda Cliente" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Caixa" Visibility="{Binding VerCaixa, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Caixa" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaCaixaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Receipt24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Caixa" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Fechamento" Visibility="{Binding VerCaixa, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Fechamento de caixa" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFechamentoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Money24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Fechamento" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Pedidos" Visibility="{Binding VerPdv, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Pedidos" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaPedidosCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TaskListSquareLtr24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Pedidos" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="MaisVendidos" Visibility="{Binding VerRelatorios, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Mais vendidos" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaMaisVendidosCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowTrending24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Mais vendidos" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Desempenho" Visibility="{Binding VerRelatorios, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Desempenho de vendas" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaDesempenhoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ChartMultiple24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Desempenho" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="ESTOQUE" Style="{StaticResource SecaoMenu}" Visibility="{Binding VerSecaoEstoque, Converter={StaticResource BoolVis}}" />
                    <Button Tag="EstoqueDaLoja" Visibility="{Binding VerEstoque, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Estoque da loja" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaEstoqueCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Box24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Estoque da loja" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Fabrica" Visibility="{Binding VerEstoque, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Estoque de fábrica" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFabricaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Building24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Fábrica" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="CalculadoraPrecos" Visibility="{Binding VerEstoque, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Calculadora de preços" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaCalculadoraPrecosCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Calculator24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Calculadora de preços" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Tag="Compras" Visibility="{Binding VerCompras, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Compras" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaComprasCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BoxArrowLeft24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Compras" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Fornecedores" Visibility="{Binding VerCompras, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Fornecedores" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFornecedoresCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Building24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Fornecedores" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="GESTÃO" Style="{StaticResource SecaoMenu}" Visibility="{Binding VerSecaoGestao, Converter={StaticResource BoolVis}}" />
                    <Button Tag="Agenda" AutomationProperties.Name="Agenda" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaAgendaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CalendarLtr24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Agenda" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Clientes" Visibility="{Binding VerClientes, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Clientes" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaClientesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Clientes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Financeiro" Visibility="{Binding VerFinanceiro, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Financeiro" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFinanceiroCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wallet24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Financeiro" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="ContasESaldos" Visibility="{Binding VerFinanceiro, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Contas e saldos" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaContasESaldosCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Money24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Contas e saldos" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Relatorios" Visibility="{Binding VerRelatorios, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Relatórios" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaRelatoriosCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataBarVertical24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Relatórios" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Funcionarios" Visibility="{Binding VerFuncionarios, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Funcionários" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFuncionariosCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Person24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Funcionários" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Atividades" Visibility="{Binding VerConfiguracoes, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Atividades" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaAtividadesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Atividades" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="Configuracoes" Visibility="{Binding VerConfiguracoes, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Configurações" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaConfiguracoesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource IconeDoMenu}" />
                            <TextBlock Text="Configurações" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Catálogo online: situação da fila de envio e conta do Firebase -->
                    <StackPanel Margin="18,18,14,0" DataContext="{Binding Sincronizacao}">
                        <TextBlock Text="Catálogo online" Style="{StaticResource SecaoMenu}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" FontSize="13" AutomationProperties.Name="Situação da sincronização" ToolTip="{Binding Detalhe}" />
                        <TextBlock Text="{Binding UsuarioTexto}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" Opacity="0.7"
                                   Visibility="{Binding TemSessao, Converter={StaticResource BoolVis}}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Sincronizar agora" Style="{StaticResource BotaoSecundario}" Padding="12,6" FontSize="13" Margin="0,0,6,6"
                                    Command="{Binding SincronizarAgoraCommand}" />
                            <Button Content="Reenviar com erro" Style="{StaticResource BotaoSecundario}" Padding="12,6" FontSize="13" Margin="0,0,6,6"
                                    Command="{Binding ReenviarErrosCommand}" Visibility="{Binding TemErros, Converter={StaticResource BoolVis}}" />
                            <Button Content="Entrar" Style="{StaticResource BotaoSecundario}" Padding="12,6" FontSize="13" Margin="0,0,6,6"
                                    Command="{Binding EntrarCommand}" Visibility="{Binding PodeEntrar, Converter={StaticResource BoolVis}}" />
                            <Button Content="Sair da conta" Style="{StaticResource BotaoSecundario}" Padding="12,6" FontSize="13" Margin="0,0,6,6"
                                    Command="{Binding SairCommand}" Visibility="{Binding TemSessao, Converter={StaticResource BoolVis}}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Margin="18,18,14,0">
                        <TextBlock Text="Licença" Style="{StaticResource SecaoMenu}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding LicencaTexto}" TextWrapping="Wrap" FontSize="13" AutomationProperties.Name="Situação da licença" />
                        <TextBlock Text="{Binding LicencaMensagem}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                        <Button Content="Ativar licença" Style="{StaticResource BotaoSecundario}" Margin="0,8,0,0" Padding="12,6" FontSize="13"
                                HorizontalAlignment="Left" Command="{Binding AtivarLicencaCommand}"
                                ToolTip="{Binding CodigoDestaMaquina, StringFormat='Código deste computador: {0}'}" />
                    </StackPanel>

                    <StackPanel Margin="18,18,14,0" Visibility="{Binding TemUsuario, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Usuário" Style="{StaticResource SecaoMenu}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding UsuarioTexto}" TextWrapping="Wrap" FontSize="13" AutomationProperties.Name="Usuário atual" />
                        <Button Content="Trocar usuário" Style="{StaticResource BotaoSecundario}" Margin="0,8,0,0" Padding="12,6" FontSize="13"
                                HorizontalAlignment="Left" Command="{Binding TrocarUsuarioCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Border>

            <!-- Área da tela atual. O ContentControl mostra o ViewModel e o WPF escolhe a View (veja App.xaml). -->
            <Grid Grid.Column="1" Margin="20,16,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Aviso de atualização: só aparece quando há versão nova. Nada é instalado sem o usuário clicar. -->
                <Border DataContext="{Binding Atualizacao}" Visibility="{Binding TemNovaVersao, Converter={StaticResource BoolVis}}"
                        Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1"
                        CornerRadius="{StaticResource RaioMedio}" Padding="16,10" Margin="0,0,0,12">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding AvisoTexto}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                                       AutomationProperties.Name="Aviso de atualização" />
                            <Button Content="Atualizar agora" Style="{StaticResource BotaoPrimario}" Padding="14,6" Command="{Binding AtualizarAgoraCommand}" />
                            <Button Content="O que mudou" Style="{StaticResource BotaoSecundario}" Padding="14,6" Margin="8,0,0,0" Command="{Binding VerNovidadesCommand}" />
                            <Button Content="Depois" Style="{StaticResource BotaoSecundario}" Padding="14,6" Margin="8,0,0,0" Command="{Binding DepoisCommand}" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding Baixando, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                            <TextBlock Text="{Binding ProgressoTexto}" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressoPercentual}" Height="8" Margin="0,4,0,0" />
                            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" Padding="12,4" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Command="{Binding CancelarDownloadCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                    </StackPanel>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding TelaAtual}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
