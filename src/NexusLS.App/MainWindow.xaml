<Window x:Class="NexusLS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus LS" Height="760" Width="1280" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource CorFundo}"
        FontFamily="Segoe UI" FontSize="15">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Background="{StaticResource CorMenu}">
            <StackPanel>
                <TextBlock Text="Nexus LS" Foreground="White" FontSize="20" FontWeight="Bold" Margin="18,22,18,22" />
                <Button Content="Caixa (PDV)" Style="{StaticResource BotaoMenu}"
                        Command="{Binding IrParaPdvCommand}" />
                <Button Content="Vendas" Style="{StaticResource BotaoMenu}"
                        Command="{Binding IrParaVendasCommand}" />
                <Button Content="Produtos" Style="{StaticResource BotaoMenu}"
                        Command="{Binding IrParaProdutosCommand}" />
                <Button Content="Estoque" Style="{StaticResource BotaoMenu}"
                        Command="{Binding IrParaEstoqueCommand}" />
            </StackPanel>
        </Border>

        <!-- Área da tela atual. O ContentControl mostra o ViewModel e o WPF escolhe a View (veja App.xaml). -->
        <ContentControl Grid.Column="1" Content="{Binding TelaAtual}" Margin="20" />
    </Grid>
</Window>
