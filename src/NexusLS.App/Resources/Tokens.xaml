<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        TOKENS do design system do Nexus LS: as únicas decisões visuais "cruas" (cores, fontes, espaços, cantos).
        Todo estilo e toda tela devem usar estes nomes em vez de escrever valores. Para mudar o visual do
        programa inteiro, mude aqui.
    -->

    <!-- ===== Cores: base ===== -->
    <SolidColorBrush x:Key="CorFundo" Color="#F3F4F6" />          <!-- fundo da janela -->
    <SolidColorBrush x:Key="CorPainel" Color="White" />           <!-- cartões, tabelas, campos -->
    <SolidColorBrush x:Key="CorMenu" Color="White" />             <!-- menu lateral -->
    <SolidColorBrush x:Key="CorTexto" Color="#111827" />
    <SolidColorBrush x:Key="CorTextoSuave" Color="#6B7280" />     <!-- rótulos, dicas, cabeçalho de tabela -->
    <SolidColorBrush x:Key="CorBorda" Color="#E5E7EB" />          <!-- contorno de cartão -->
    <SolidColorBrush x:Key="CorBordaCampo" Color="#D1D5DB" />     <!-- contorno de botão secundário e campo -->
    <SolidColorBrush x:Key="CorBordaForte" Color="#9CA3AF" />
    <SolidColorBrush x:Key="CorLinhaGrade" Color="#EEF0F3" />     <!-- linhas entre as linhas da tabela -->
    <SolidColorBrush x:Key="CorHover" Color="#F3F4F6" />          <!-- passar o mouse sobre linha, botão suave ou menu -->
    <SolidColorBrush x:Key="CorCabecalho" Color="#F9FAFB" />      <!-- cabeçalho de tabela -->

    <!-- ===== Cores: ação principal (azul) ===== -->
    <SolidColorBrush x:Key="CorPrimaria" Color="#2563EB" />
    <SolidColorBrush x:Key="CorPrimariaHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="CorPrimariaPressionada" Color="#1E40AF" />
    <SolidColorBrush x:Key="CorSelecao" Color="#DBEAFE" />        <!-- linha selecionada -->
    <SolidColorBrush x:Key="CorSelecaoSuave" Color="#EFF6FF" />   <!-- item ativo do menu -->
    <SolidColorBrush x:Key="CorFoco" Color="#2563EB" />
    <SolidColorBrush x:Key="CorSobrePrimaria" Color="White" />    <!-- texto sobre fundo azul -->
    <SolidColorBrush x:Key="CorSobrePrimariaSuave" Color="#DBEAFE" />
    <SolidColorBrush x:Key="CorMenuAtivo" Color="#EFF6FF" />

    <!-- ===== Cores: estados ===== -->
    <SolidColorBrush x:Key="CorSucesso" Color="#0F7B0F" />
    <SolidColorBrush x:Key="CorPositivo" Color="#15803D" />
    <SolidColorBrush x:Key="CorPerigo" Color="#C42B1C" />
    <SolidColorBrush x:Key="CorPerigoHover" Color="#A32317" />
    <SolidColorBrush x:Key="CorPerigoPressionado" Color="#8A1D13" />
    <SolidColorBrush x:Key="CorNegativo" Color="#B91C1C" />
    <SolidColorBrush x:Key="CorAlerta" Color="#FFF4CE" />
    <SolidColorBrush x:Key="CorAviso" Color="#B45309" />
    <SolidColorBrush x:Key="CorAvisoFundo" Color="#FFF7E6" />
    <SolidColorBrush x:Key="CorAtencaoFundo" Color="#FFEDD5" />
    <SolidColorBrush x:Key="CorAtencaoBorda" Color="#EA580C" />
    <SolidColorBrush x:Key="CorAtencaoTexto" Color="#9A3412" />
    <SolidColorBrush x:Key="CorSobreposicao" Color="#B3111827" /> <!-- véu atrás dos modais -->
    <SolidColorBrush x:Key="CorColunaFundo" Color="#ECEEF1" />

    <!-- ===== Tipografia ===== -->
    <FontFamily x:Key="FonteTexto">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="TamMicro">11</sys:Double>      <!-- título de grupo do menu -->
    <sys:Double x:Key="TamPequeno">12</sys:Double>    <!-- cabeçalho de tabela, dicas -->
    <sys:Double x:Key="TamRotulo">13</sys:Double>     <!-- rótulo de campo -->
    <sys:Double x:Key="TamCorpo">14</sys:Double>      <!-- texto padrão, tabelas, menu -->
    <sys:Double x:Key="TamSecao">16</sys:Double>      <!-- título de seção dentro da tela -->
    <sys:Double x:Key="TamTitulo">24</sys:Double>     <!-- título da tela -->
    <sys:Double x:Key="TamDestaque">32</sys:Double>   <!-- números grandes (totais) -->

    <!-- ===== Espaçamentos (escala de 4) ===== -->
    <Thickness x:Key="EspXS">4</Thickness>
    <Thickness x:Key="EspS">8</Thickness>
    <Thickness x:Key="EspM">12</Thickness>
    <Thickness x:Key="EspL">16</Thickness>
    <Thickness x:Key="EspXL">24</Thickness>

    <!-- ===== Cantos ===== -->
    <CornerRadius x:Key="RaioPequeno">6</CornerRadius>   <!-- campos, linhas -->
    <CornerRadius x:Key="RaioMedio">8</CornerRadius>     <!-- botões, menu, avisos -->
    <CornerRadius x:Key="RaioGrande">10</CornerRadius>   <!-- cartões e painéis -->

    <!-- ===== Medidas de controles ===== -->
    <sys:Double x:Key="AlturaControle">36</sys:Double>   <!-- botões e campos -->
    <sys:Double x:Key="AlturaCabecalhoTabela">36</sys:Double>
    <sys:Double x:Key="TamIcone">18</sys:Double>
</ResourceDictionary>
