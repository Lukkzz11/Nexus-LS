<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Tipografia: título da tela > título de seção > texto > rótulo > texto de apoio. -->

    <Style x:Key="TituloTela" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TamTitulo}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
    </Style>

    <!-- Título de um bloco dentro da tela ("Histórico do produto", "Editar cliente"). -->
    <Style x:Key="TituloSecao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TamSecao}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
    </Style>

    <!-- Rótulo pequeno em cima de um campo. -->
    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
        <Setter Property="FontSize" Value="{StaticResource TamRotulo}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- Texto de apoio: dicas, explicações, informação secundária. -->
    <Style x:Key="TextoApoio" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
        <Setter Property="FontSize" Value="{StaticResource TamPequeno}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Mensagem de sucesso (verde) ou erro (vermelho), conforme MensagemEhErro do ViewModel. -->
    <Style x:Key="TextoMensagem" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CorSucesso}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,14,0,0" />
        <Style.Triggers>
            <!-- Sem mensagem, não ocupa espaço (antes deixava uma faixa vazia embaixo dos avisos e formulários). -->
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource CorPerigo}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
