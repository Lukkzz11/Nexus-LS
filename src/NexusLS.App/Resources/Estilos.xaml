<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design system do Nexus. Este arquivo só reúne os dicionários, na ordem em que um depende do outro:
          Tokens     cores, fontes, espaçamentos, cantos e medidas (a única fonte de valores)
          Tipografia títulos, rótulos e textos de apoio
          Botoes     primário, secundário, perigo, fantasma, ícone, opção
          Campos     cartão (Painel), faixa de aviso, caixas de texto, listas e marcadores
          Tabelas    DataGrid: cabeçalho, linhas, células
          Menu       menu lateral
        Regra: telas e estilos usam os nomes dos Tokens; não escrevem cor, fonte ou raio direto.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Tipografia.xaml" />
        <ResourceDictionary Source="Botoes.xaml" />
        <ResourceDictionary Source="Campos.xaml" />
        <ResourceDictionary Source="Tabelas.xaml" />
        <ResourceDictionary Source="Menu.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
