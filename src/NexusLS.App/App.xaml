<Application x:Class="NexusLS.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:NexusLS.App.Converters"
             xmlns:vm="clr-namespace:NexusLS.App.ViewModels"
             xmlns:views="clr-namespace:NexusLS.App.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/Estilos.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:CentavosConverter x:Key="Centavos" />
            <conv:BoolParaTextoConverter x:Key="BoolTexto" />
            <conv:TipoMovimentacaoConverter x:Key="TipoMov" />
            <conv:FormaPagamentoConverter x:Key="FormaPag" />
            <conv:IgualAoTagConverter x:Key="IgualTag" />
            <conv:BoolInversoVisibilidadeConverter x:Key="BoolInverso" />
            <BooleanToVisibilityConverter x:Key="BoolVis" />

            <!-- Regra do MVVM no WPF: quando a janela mostra um ViewModel, o WPF procura aqui
                 qual View (tela) desenhar para ele. Assim o ViewModel nunca conhece a tela. -->
            <DataTemplate DataType="{x:Type vm:InicioViewModel}">
                <views:InicioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PdvViewModel}">
                <views:PdvView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VendasViewModel}">
                <views:VendasView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FechamentoViewModel}">
                <views:FechamentoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EstoqueLojaViewModel}">
                <views:EstoqueLojaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CalculadoraPrecosViewModel}">
                <views:CalculadoraPrecosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaisVendidosViewModel}">
                <views:MaisVendidosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ClientesViewModel}">
                <views:ClientesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RelatoriosViewModel}">
                <views:RelatoriosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FornecedoresViewModel}">
                <views:FornecedoresView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComprasViewModel}">
                <views:ComprasView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FuncionariosViewModel}">
                <views:FuncionariosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ContasESaldosViewModel}">
        <views:ContasESaldosView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SaldosViewModel}">
        <views:SaldosView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ContasFinanceirasViewModel}">
        <views:ContasFinanceirasView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CartoesViewModel}">
        <views:CartoesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChequesViewModel}">
        <views:ChequesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AtividadesViewModel}">
        <views:AtividadesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PedidosViewModel}">
                <views:PedidosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FinanceiroViewModel}">
                <views:FinanceiroView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CatalogoOnlineViewModel}">
                <views:CatalogoOnlineView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EtiquetasViewModel}">
                <views:EtiquetasView />
            </DataTemplate>            <DataTemplate DataType="{x:Type vm:ConfiguracoesViewModel}">
                <views:ConfiguracoesView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
