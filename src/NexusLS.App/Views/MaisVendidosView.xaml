<UserControl x:Class="NexusLS.App.Views.MaisVendidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Uma pizza: o desenho (fatias em Path) e a legenda com cor, valor e percentual -->
        <DataTemplate x:Key="FatiaDesenho">
            <Path Data="{Binding Caminho}" Fill="{Binding Cor}" Stroke="White" StrokeThickness="1" ToolTip="{Binding Legenda}" />
        </DataTemplate>
        <DataTemplate x:Key="FatiaLegenda">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Cor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Legenda}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Mais vendidos" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

        <!-- Período e opções -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="De:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding De}" Width="150" VerticalContentAlignment="Center" />
            <TextBlock Text="até:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Ate}" Width="150" VerticalContentAlignment="Center" />

            <Button Content="Hoje" Style="{StaticResource BotaoSecundario}" Margin="16,0,0,0" Padding="12,6"
                    Command="{Binding HojeCommand}" />
            <Button Content="7 dias" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding UltimosSeteDiasCommand}" />
            <Button Content="Este mês" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding MesAtualCommand}" />

            <CheckBox Content="Separar por tamanho" Margin="20,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding PorTamanho}" />

            <Button Content="Exportar (CSV)" Style="{StaticResource BotaoSecundario}" Margin="20,0,0,0" Padding="12,6"
                    Command="{Binding ExportarCommand}" ToolTip="Salva o ranking para abrir no Excel" />
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="{Binding Resumo}" FontWeight="SemiBold" Margin="0,8,0,10" />

        <Border Grid.Row="3" Style="{StaticResource Painel}" Padding="0">
            <DataGrid ItemsSource="{Binding Ranking}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource CorLinhaGrade}" BorderThickness="0"
                      Background="{StaticResource CorPainel}" RowHeight="38" FontSize="16">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Posicao, Mode=OneWay}" Width="60" />
                    <DataGridTextColumn Header="Produto" Binding="{Binding Nome, Mode=OneWay}" Width="*" />
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho, Mode=OneWay}" Width="130" />
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade, Mode=OneWay}" Width="120"
                                        ElementStyle="{StaticResource ColunaNumero}" />
                    <DataGridTextColumn Header="Faturamento" Width="150" ElementStyle="{StaticResource ColunaNumero}"
                                        Binding="{Binding FaturamentoCentavos, Mode=OneWay, Converter={StaticResource Centavos}}" />
                    <DataGridTextColumn Header="Vendas" Binding="{Binding NumeroDeVendas, Mode=OneWay}" Width="90"
                                        ElementStyle="{StaticResource ColunaNumero}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Participação no faturamento (sem vendas canceladas) -->
        <Grid Grid.Row="4" Margin="0,12,0,0" Visibility="{Binding TemPizzas, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Painel}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Produtos no faturamento" FontWeight="SemiBold" />
                    <TextBlock Text="Os 6 que mais faturaram; o resto vira Outros." FontSize="11" Opacity="0.7" Margin="0,0,0,6" />
                    <Viewbox Height="130" Margin="0,0,0,6"><ItemsControl ItemsSource="{Binding PizzaProdutos}" ItemTemplate="{StaticResource FatiaDesenho}" Width="200" Height="200"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Viewbox>
                    <ItemsControl ItemsSource="{Binding PizzaProdutos}" ItemTemplate="{StaticResource FatiaLegenda}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Painel}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Por categoria" FontWeight="SemiBold" />
                    <TextBlock Text="Quanto cada tipo de peça faturou." FontSize="11" Opacity="0.7" Margin="0,0,0,6" />
                    <Viewbox Height="130" Margin="0,0,0,6"><ItemsControl ItemsSource="{Binding PizzaCategorias}" ItemTemplate="{StaticResource FatiaDesenho}" Width="200" Height="200"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Viewbox>
                    <ItemsControl ItemsSource="{Binding PizzaCategorias}" ItemTemplate="{StaticResource FatiaLegenda}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Painel}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Por forma de pagamento" FontWeight="SemiBold" />
                    <TextBlock Text="Como os clientes pagaram (total das vendas)." FontSize="11" Opacity="0.7" Margin="0,0,0,6" />
                    <Viewbox Height="130" Margin="0,0,0,6"><ItemsControl ItemsSource="{Binding PizzaFormas}" ItemTemplate="{StaticResource FatiaDesenho}" Width="200" Height="200"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Viewbox>
                    <ItemsControl ItemsSource="{Binding PizzaFormas}" ItemTemplate="{StaticResource FatiaLegenda}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5" Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
    </Grid>
</UserControl>
