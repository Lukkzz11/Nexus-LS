<UserControl x:Class="NexusLS.App.Views.MaisVendidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Mais vendidos" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

        <!-- Período e opções -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="De:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding De}" Width="150" VerticalContentAlignment="Center" />
            <TextBlock Text="até:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Ate}" Width="150" VerticalContentAlignment="Center" />

            <Button Content="Hoje" Style="{StaticResource BotaoSecundario}" Margin="16,0,0,0" Padding="12,6"
                    Command="{Binding HojeCommand}" />
            <Button Content="7 dias" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding UltimosSeteDiasCommand}" />
            <Button Content="Este mês" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding MesAtualCommand}" />

            <CheckBox Content="Separar por tamanho" Margin="20,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding PorTamanho}" />

            <Button Content="Exportar (CSV)" Style="{StaticResource BotaoSecundario}" Margin="20,0,0,0" Padding="12,6"
                    Command="{Binding ExportarCommand}" ToolTip="Salva o ranking para abrir no Excel" />
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="{Binding Resumo}" FontWeight="SemiBold" Margin="0,8,0,10" />

        <Border Grid.Row="3" Style="{StaticResource Painel}" Padding="0">
            <DataGrid ItemsSource="{Binding Ranking}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource CorLinhaGrade}" BorderThickness="0"
                      Background="{StaticResource CorPainel}" RowHeight="38" FontSize="16">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Posicao, Mode=OneWay}" Width="60" />
                    <DataGridTextColumn Header="Produto" Binding="{Binding Nome, Mode=OneWay}" Width="*" />
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho, Mode=OneWay}" Width="130" />
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade, Mode=OneWay}" Width="120"
                                        ElementStyle="{StaticResource ColunaNumero}" />
                    <DataGridTextColumn Header="Faturamento" Width="150" ElementStyle="{StaticResource ColunaNumero}"
                                        Binding="{Binding FaturamentoCentavos, Mode=OneWay, Converter={StaticResource Centavos}}" />
                    <DataGridTextColumn Header="Vendas" Binding="{Binding NumeroDeVendas, Mode=OneWay}" Width="90"
                                        ElementStyle="{StaticResource ColunaNumero}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
    </Grid>
</UserControl>
