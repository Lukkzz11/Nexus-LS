<UserControl x:Class="NexusLS.App.Views.DesempenhoVendasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:NexusLS.App.Views">

    <UserControl.Resources>
        <!-- Barra horizontal: rótulo, barra proporcional e o valor por extenso -->
        <DataTemplate x:Key="BarraHorizontal">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Rotulo}" />
                <StackPanel Grid.Column="1">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fracao, Mode=OneWay}" Height="12" />
                    <TextBlock Text="{Binding Texto}" FontSize="12" Opacity="0.75" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Coluna vertical do gráfico de vendas no tempo -->
        <DataTemplate x:Key="ColunaVertical">
            <StackPanel Margin="2,0" ToolTip="{Binding Texto}">
                <Border Height="150" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <Border Background="#2563EB" CornerRadius="3,3,0,0" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleY="{Binding Fracao, Mode=OneWay}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock Text="{Binding Rotulo}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CartaoIndicador">
                            <Border Style="{StaticResource Painel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}" Opacity="0.75" />
                                    <TextBlock Text="{Binding Valor}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,4" />
                                    <TextBlock Text="{Binding Variacao}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Subiu}" Value="True"><Setter Property="Foreground" Value="{StaticResource CorPositivo}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Caiu}" Value="True"><Setter Property="Foreground" Value="{StaticResource CorNegativo}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                                </DataTemplate>

        <DataTemplate x:Key="LinhaDeRanking">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Detalhe}" Margin="12,0,0,0" Opacity="0.75" />
            </Grid>
        </DataTemplate>

        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Desempenho de vendas" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <WrapPanel>
                <Button Content="Hoje" Style="{StaticResource BotaoSecundario}" Padding="12,6" Command="{Binding HojeCommand}" />
                <Button Content="7 dias" Style="{StaticResource BotaoSecundario}" Padding="12,6" Margin="8,0,0,0" Command="{Binding UltimosSeteDiasCommand}" />
                <Button Content="30 dias" Style="{StaticResource BotaoSecundario}" Padding="12,6" Margin="8,0,0,0" Command="{Binding UltimosTrintaDiasCommand}" />
                <Button Content="Este mês" Style="{StaticResource BotaoSecundario}" Padding="12,6" Margin="8,0,0,0" Command="{Binding MesAtualCommand}" />
                <TextBlock Text="De:" VerticalAlignment="Center" Margin="20,0,8,0" />
                <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding De}" Width="150" />
                <TextBlock Text="até:" VerticalAlignment="Center" Margin="12,0,8,0" />
                <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Ate}" Width="150" />
                <TextBlock Text="Gráfico por:" VerticalAlignment="Center" Margin="20,0,8,0" />
                <RadioButton Content="Dia" GroupName="gran" IsChecked="{Binding PorDia}" Margin="0,0,10,0" />
                <RadioButton Content="Semana" GroupName="gran" IsChecked="{Binding PorSemana}" Margin="0,0,10,0" />
                <RadioButton Content="Mês" GroupName="gran" IsChecked="{Binding PorMes}" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="Categoria:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding OpcoesCategoria}" SelectedItem="{Binding FiltroCategoria}" Width="150" AutomationProperties.Name="Filtrar por categoria" />
                <TextBlock Text="Produto:" VerticalAlignment="Center" Margin="14,0,8,0" />
                <TextBox Text="{Binding FiltroProduto, UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.Name="Filtrar por produto" />
                <TextBlock Text="Pagamento:" VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox ItemsSource="{Binding OpcoesForma}" SelectedItem="{Binding FiltroForma}" Width="140" AutomationProperties.Name="Filtrar por pagamento" />
                <TextBlock Text="Vendedor:" VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox ItemsSource="{Binding OpcoesOperador}" SelectedItem="{Binding FiltroOperador}" Width="140" AutomationProperties.Name="Filtrar por vendedor" />
                <Button Content="Limpar filtros" Style="{StaticResource BotaoSecundario}" Padding="12,6" Margin="14,0,0,0" Command="{Binding LimparFiltrosCommand}" />
                <Button Content="Exportar CSV" Style="{StaticResource BotaoSecundario}" Padding="12,6" Margin="8,0,0,0" Command="{Binding ExportarCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding TextoPeriodo}" Opacity="0.75" Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- Indicadores -->
                <!-- os indicadores se repartem na largura toda (5 lado a lado em tela larga) -->
                <ItemsControl ItemsSource="{Binding Indicadores}" ItemTemplate="{StaticResource CartaoIndicador}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><v:GradeDeCartoes LarguraMinima="220" MaximoColunas="5" Espaco="12" IgualarAltura="True" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{Binding AvisoLucro}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,0,0,12" />

                <TextBlock Text="Nenhuma venda neste período." Margin="0,8" Opacity="0.75">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TemVendas}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Vendas no tempo -->
                <Border Style="{StaticResource Painel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Faturamento no tempo" Style="{StaticResource Subtitulo}" />
                        <ItemsControl ItemsSource="{Binding VendasNoTempo}" ItemTemplate="{StaticResource ColunaVertical}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Painel}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="Por categoria" Style="{StaticResource Subtitulo}" />
                            <ItemsControl ItemsSource="{Binding PorCategoriaBarras}" ItemTemplate="{StaticResource BarraHorizontal}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Painel}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Por forma de pagamento" Style="{StaticResource Subtitulo}" />
                            <ItemsControl ItemsSource="{Binding PorFormaBarras}" ItemTemplate="{StaticResource BarraHorizontal}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Painel}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="Por quem vendeu" Style="{StaticResource Subtitulo}" />
                            <ItemsControl ItemsSource="{Binding PorOperadorBarras}" ItemTemplate="{StaticResource BarraHorizontal}" />
                            <TextBlock Text="{Binding AvisoOperador}" TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Painel}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Mais vendidos" Style="{StaticResource Subtitulo}" />
                            <ItemsControl ItemsSource="{Binding MaisVendidosLista}" ItemTemplate="{StaticResource LinhaDeRanking}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Painel}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="Menos vendidos (entre os que venderam)" Style="{StaticResource Subtitulo}" />
                            <ItemsControl ItemsSource="{Binding MenosVendidosLista}" ItemTemplate="{StaticResource LinhaDeRanking}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Painel}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sem nenhuma venda no período" Style="{StaticResource Subtitulo}" />
                            <ItemsControl ItemsSource="{Binding SemVendasLista}" ItemTemplate="{StaticResource LinhaDeRanking}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Resumo completo de vendas -->
                <Border Style="{StaticResource Painel}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resumo completo de vendas" Style="{StaticResource Subtitulo}" Margin="0" FontSize="16" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Exportar resumo (CSV)" Style="{StaticResource BotaoSecundario}" Padding="12,6"
                                    Command="{Binding ExportarResumoCommand}" AutomationProperties.Name="Exportar resumo de vendas em CSV" />
                        </Grid>
                        <TextBlock Text="Considera o período escolhido, sem os filtros acima. Vendas canceladas ficam fora dos totais." Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding ResumoIndicadores}" ItemTemplate="{StaticResource CartaoIndicador}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><v:GradeDeCartoes LarguraMinima="220" MaximoColunas="3" Espaco="12" IgualarAltura="True" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding ResumoCancelamentos}" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Total por forma de pagamento" Style="{StaticResource Subtitulo}" />
                                <ItemsControl ItemsSource="{Binding ResumoFormas}" ItemTemplate="{StaticResource LinhaDeRanking}" />
                            </StackPanel>
                            <StackPanel Margin="12,0,0,12">
                                <TextBlock Text="Melhores dias da semana" Style="{StaticResource Subtitulo}" />
                                <ItemsControl ItemsSource="{Binding ResumoDias}" ItemTemplate="{StaticResource LinhaDeRanking}" />
                                <TextBlock Text="Melhores horários" Style="{StaticResource Subtitulo}" Margin="0,12,0,8" />
                                <ItemsControl ItemsSource="{Binding ResumoHorarios}" ItemTemplate="{StaticResource LinhaDeRanking}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Mais vendidos por quantidade" Style="{StaticResource Subtitulo}" />
                                <ItemsControl ItemsSource="{Binding ResumoPorQuantidade}" ItemTemplate="{StaticResource LinhaDeRanking}" />
                            </StackPanel>
                            <StackPanel Margin="12,0,0,12">
                                <TextBlock Text="Mais vendidos por valor" Style="{StaticResource Subtitulo}" />
                                <ItemsControl ItemsSource="{Binding ResumoPorValor}" ItemTemplate="{StaticResource LinhaDeRanking}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Por vendedor" Style="{StaticResource Subtitulo}" />
                                <ItemsControl ItemsSource="{Binding ResumoVendedores}" ItemTemplate="{StaticResource LinhaDeRanking}" />
                                <TextBlock Text="{Binding AvisoVendedores}" TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Pesquisa por referência/produto -->
                <Border Style="{StaticResource Painel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Pesquisar referência/produto" Style="{StaticResource Subtitulo}" FontSize="16" />
                        <TextBox Text="{Binding PesquisaReferencia, UpdateSourceTrigger=PropertyChanged}" MaxWidth="460" HorizontalAlignment="Left" Width="460"
                                 AutomationProperties.Name="Pesquisar referência ou produto" ToolTip="Referência, código interno, código de barras ou nome" />
                        <TextBlock Text="Digite a referência, o código ou parte do nome. Mostra o que foi vendido no período escolhido." Opacity="0.75" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BuscaAviso}" Foreground="DarkOrange" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemBusca}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding BuscaTotais}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <TextBlock Text="Por variação (tamanho)" Style="{StaticResource Subtitulo}" />
                            <ItemsControl ItemsSource="{Binding BuscaVariacoes}" ItemTemplate="{StaticResource LinhaDeRanking}" Margin="0,0,0,10" />
                            <TextBlock Text="Vendas em que apareceu" Style="{StaticResource Subtitulo}" />
                            <ItemsControl ItemsSource="{Binding BuscaVendas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Data}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Numero}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Quantidade}" Opacity="0.75" />
                                            <TextBlock Grid.Column="3" Text="{Binding Valor}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
    </Grid>
</UserControl>
