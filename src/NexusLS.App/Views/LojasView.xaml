<UserControl x:Class="NexusLS.App.Views.LojasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:NexusLS.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,8,8">
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Adicionar loja" Style="{StaticResource BotaoPrimario}" Padding="16,8" Command="{Binding AdicionarLojaCommand}"
                        ToolTip="Mostra o passo a passo para colocar outra loja no Nexus" AutomationProperties.Name="Adicionar loja" />
                <StackPanel>
                    <TextBlock Text="Lojas" Style="{StaticResource TituloSecao}" />
                    <TextBlock Style="{StaticResource TextoApoio}" Margin="0,2,0,0"
                               Text="Cada loja é um computador com o Nexus, com seus próprios dados. Aqui você vê esta loja e o desempenho dela." />
                </StackPanel>
            </DockPanel>

            <!-- Como adicionar uma loja -->
            <Border Style="{StaticResource Painel}" Margin="0,0,0,12" Background="{DynamicResource CorSelecaoSuave}"
                    Visibility="{Binding MostrandoComoAdicionar, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Fechar" Style="{StaticResource BotaoSecundario}" Padding="12,5" Command="{Binding FecharComoAdicionarCommand}"
                                AutomationProperties.Name="Fechar o passo a passo" />
                        <TextBlock Text="Como adicionar uma loja" Style="{StaticResource TituloSecao}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Passos}" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource CorPrimaria}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Numero}" Foreground="{DynamicResource CorSobrePrimaria}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Texto}" Style="{StaticResource TextoApoio}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource CorPainel}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Esta loja (este computador)" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding LojaNome}" FontWeight="SemiBold" FontSize="16" AutomationProperties.Name="Nome desta loja" />
                            <TextBlock Text="Código da loja" Style="{StaticResource Rotulo}" Margin="0,8,0,2" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Copiar código" Style="{StaticResource BotaoSecundario}" Padding="12,5" Margin="10,0,0,0"
                                        Command="{Binding CopiarCodigoCommand}" AutomationProperties.Name="Copiar o código desta loja" />
                                <TextBox Text="{Binding LojaId, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Código desta loja" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource TextoApoio}" Margin="0,6,0,0"
                                       Text="O código é criado sozinho e não muda. Para trocar o nome, abra as Configurações do Nexus." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <v:BarraPeriodo Margin="0,0,0,6" />
            <TextBlock Text="{Binding TextoPeriodo}" Style="{StaticResource TextoApoio}" Margin="0,0,0,10" />

            <Border Style="{StaticResource FaixaAviso}" Margin="0,0,0,10" Visibility="{Binding SemPermissao, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Você não tem permissão para ver os valores financeiros. Os números da loja ficam escondidos." TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Desempenho}" Margin="0,0,0,12" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><v:GradeDeCartoes LarguraMinima="230" MaximoColunas="4" Espaco="12" IgualarAltura="True" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Style="{StaticResource Painel}" Padding="0">
                <DataGrid ItemsSource="{Binding Lojas}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                          BorderThickness="0" Background="Transparent" AutomationProperties.Name="Lista de lojas" MinHeight="80">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Loja" Binding="{Binding Nome, Mode=OneWay}" Width="1.6*" />
                        <DataGridTextColumn Header="Faturamento" Binding="{Binding Faturamento, Mode=OneWay}" Width="1.2*" />
                        <DataGridTextColumn Header="Vendas" Binding="{Binding Vendas, Mode=OneWay}" Width="0.8*" />
                        <DataGridTextColumn Header="Ticket médio" Binding="{Binding TicketMedio, Mode=OneWay}" Width="1.1*" />
                        <DataGridTextColumn Header="Onde está" Binding="{Binding Situacao, Mode=OneWay}" Width="1.3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Style="{StaticResource TextoApoio}" Margin="0,8,0,0"
                       Text="As outras lojas aparecem no comparativo abaixo, lidas da nuvem. Nada é enviado sozinho: só quando você clica em Compartilhar com a nuvem." />
            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" AutomationProperties.Name="Mensagem das lojas" />

            <!-- Nuvem: compartilhar, receber e comparar as lojas -->
            <Border Style="{StaticResource Painel}" Margin="0,14,0,0" Visibility="{Binding TemNuvem, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="Nuvem das lojas" Style="{StaticResource TituloSecao}" />
                    <TextBlock Style="{StaticResource TextoApoio}" Margin="0,2,0,8"
                               Text="Compartilhar manda o resumo por dia, o estoque e os lançamentos desta loja (de anexos vai só o nome). Receber da nuvem traz os preços que o administrador definiu para esta loja." />
                    <WrapPanel>
                        <Button Content="Compartilhar com a nuvem" Style="{StaticResource BotaoPrimario}" Padding="16,8" Margin="0,0,8,6"
                                Command="{Binding CompartilharCommand}"
                                ToolTip="Envia esta loja para a nuvem agora" AutomationProperties.Name="Compartilhar com a nuvem" />
                        <Button Content="Enviar mesmo assim" Style="{StaticResource BotaoSecundario}" Padding="14,8" Margin="0,0,8,6"
                                Command="{Binding CompartilharMesmoAssimCommand}" Visibility="{Binding PrecisaConfirmarEnvio, Converter={StaticResource BoolVis}}"
                                AutomationProperties.Name="Enviar mesmo assim" />
                        <Button Content="Receber da nuvem" Style="{StaticResource BotaoSecundario}" Padding="14,8" Margin="0,0,8,6"
                                Command="{Binding ReceberPrecosCommand}" ToolTip="Traz os preços definidos para esta loja"
                                AutomationProperties.Name="Receber preços da nuvem" />
                        <Button Content="Ler as lojas da nuvem" Style="{StaticResource BotaoSecundario}" Padding="14,8" Margin="0,0,8,6"
                                Command="{Binding LerDaNuvemCommand}" AutomationProperties.Name="Ler as lojas da nuvem" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ProgressoNuvem}" Style="{StaticResource TextoApoio}" AutomationProperties.Name="Progresso do envio" />
                    <TextBlock Text="{Binding UltimoEnvioTexto}" Style="{StaticResource TextoApoio}" Margin="0,4,0,0" AutomationProperties.Name="Último envio" />
                    <TextBlock Text="Empresa na nuvem (o mesmo código em todas as lojas)" Style="{StaticResource Rotulo}" Margin="0,10,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Salvar" Style="{StaticResource BotaoSecundario}" Padding="12,5" Margin="10,0,0,0"
                                Command="{Binding SalvarEmpresaNuvemCommand}" AutomationProperties.Name="Salvar o código da empresa" />
                        <TextBox Text="{Binding EmpresaNuvem, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Código da empresa na nuvem" />
                    </DockPanel>

                    <Border Style="{StaticResource FaixaAviso}" Margin="0,12,0,0" Visibility="{Binding ComparativoDoCache, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding AvisoComparativo}" TextWrapping="Wrap" AutomationProperties.Name="Aviso do comparativo" />
                    </Border>
                    <TextBlock Text="{Binding AvisoComparativo}" Style="{StaticResource TextoApoio}" Margin="0,10,0,4"
                               Visibility="{Binding ComparativoDoCache, Converter={StaticResource BoolInverso}}" />
                    <DataGrid ItemsSource="{Binding Comparativo}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              BorderThickness="0" Background="Transparent" MinHeight="60" Visibility="{Binding TemComparativo, Converter={StaticResource BoolVis}}"
                              AutomationProperties.Name="Comparativo das lojas na nuvem">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loja" Binding="{Binding Nome, Mode=OneWay}" Width="1.6*" />
                            <DataGridTextColumn Header="Faturamento" Binding="{Binding Faturamento, Mode=OneWay}" Width="1.2*" />
                            <DataGridTextColumn Header="Vendas" Binding="{Binding Vendas, Mode=OneWay}" Width="0.8*" />
                            <DataGridTextColumn Header="Ticket médio" Binding="{Binding TicketMedio, Mode=OneWay}" Width="1.1*" />
                            <DataGridTextColumn Header="Enviado em" Binding="{Binding Atualizacao, Mode=OneWay}" Width="1.3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Preço por loja (só o administrador) -->
            <Border Style="{StaticResource Painel}" Margin="0,14,0,0" Visibility="{Binding EhAdministrador, Converter={StaticResource BoolVis}}">
                <Border.Resources>
                    <Style x:Key="MensagemPreco" TargetType="TextBlock" BasedOn="{StaticResource TextoMensagem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemPrecoEhErro}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource CorPerigo}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MensagemPrecoEhErro}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource CorSucesso}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
                <StackPanel Visibility="{Binding TemNuvem, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Preço por loja" Style="{StaticResource TituloSecao}" />
                    <TextBlock Style="{StaticResource TextoApoio}" Margin="0,2,0,8"
                               Text="O produto e o custo são únicos; só o preço de venda muda por loja. Cada loja recebe o seu ao clicar em Receber da nuvem. Sem preço da loja, vale o do cadastro." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Buscar" Style="{StaticResource BotaoSecundario}" Padding="14,6" Margin="10,0,0,0"
                                Command="{Binding BuscarProdutoDoPrecoCommand}" AutomationProperties.Name="Buscar produto para o preço por loja" />
                        <TextBox Text="{Binding BuscaProdutoPreco, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Produto do preço por loja" />
                    </DockPanel>
                    <TextBlock Text="{Binding ProdutoDoPrecoNome}" FontWeight="SemiBold" Margin="0,8,0,4" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding PrecosPorLoja}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Situacao}" Style="{StaticResource TextoApoio}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Varejo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Preço de varejo desta loja"
                                             AutomationProperties.Name="Preço de varejo da loja" />
                                    <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding Atacado, UpdateSourceTrigger=PropertyChanged}" ToolTip="Preço de atacado (opcional)"
                                             AutomationProperties.Name="Preço de atacado da loja" />
                                    <Button Grid.Column="3" Content="Salvar" Style="{StaticResource BotaoSecundario}" Padding="12,5" Margin="8,0,0,0"
                                            Command="{Binding DataContext.SalvarPrecoDaLojaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="Salvar preço da loja" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MensagemPreco}" Style="{StaticResource MensagemPreco}" AutomationProperties.Name="Mensagem do preço por loja" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
