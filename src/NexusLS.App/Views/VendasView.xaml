<UserControl x:Class="NexusLS.App.Views.VendasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:NexusLS.App.Views">

    <UserControl.Resources>
        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!-- Cartão de número do relatório do dia -->
        <Style x:Key="CartaoDoDia" TargetType="Border" BasedOn="{StaticResource Painel}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <!-- Bolinha da situação do caixa: verde aberto, laranja fechado -->
        <Style x:Key="PontoCaixa" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Fill" Value="{StaticResource CorPositivo}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Fechamento.TurnoAberto}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource CorAtencaoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Cabeçalho: situação do caixa e o botão Fechar (um clique, resumo e confirmação) ===== -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Caixa" Style="{StaticResource TituloTela}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding TemFechamento, Converter={StaticResource BoolVis}}">
                <Ellipse Style="{StaticResource PontoCaixa}" />
                <TextBlock Text="{Binding Fechamento.SituacaoTexto}" FontWeight="SemiBold" VerticalAlignment="Center"
                           AutomationProperties.Name="Situação do caixa" />
            </StackPanel>
            <Button Grid.Column="2" Content="Fechar caixa" Style="{StaticResource BotaoPrimario}" Padding="22,8" FontWeight="SemiBold"
                    AutomationProperties.Name="Fechar o caixa"
                    ToolTip="Mostra o resumo do dia e fecha o caixa depois da sua confirmação"
                    Visibility="{Binding Fechamento.PodeConferir, Converter={StaticResource BoolVis}}"
                    Command="{Binding Fechamento.FecharRapidoCommand}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Fechamento.Mensagem}" Style="{StaticResource TextoMensagem}" Margin="0,0,0,8" />

        <TabControl Grid.Row="2" x:Name="Abas" Padding="0">
            <!-- ===== Aba 1: o dia ===== -->
            <TabItem Header="Vendas do dia">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dia:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Data}" Width="150" VerticalContentAlignment="Center" />
                        <Button Content="Exportar vendas (CSV)" Style="{StaticResource BotaoSecundario}" Margin="16,0,0,0"
                                Padding="12,6" Command="{Binding ExportarVendasCommand}"
                                ToolTip="Uma linha por venda, para abrir no Excel" />
                        <Button Content="Exportar itens (CSV)" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                Padding="12,6" Command="{Binding ExportarItensCommand}"
                                ToolTip="Uma linha por item vendido, para abrir no Excel" />
                    </StackPanel>

                    <!-- Relatório do dia -->
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2.4*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CartaoDoDia}">
                            <StackPanel>
                                <TextBlock Text="TOTAL DO DIA" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Text="{Binding TotalDiaTexto}" FontSize="{StaticResource TamDestaque}" FontWeight="Bold"
                                           Foreground="{StaticResource CorPrimaria}" AutomationProperties.Name="Total do dia" />
                                <TextBlock Text="{Binding CanceladasTexto}" Style="{StaticResource TextoApoio}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CartaoDoDia}">
                            <StackPanel>
                                <TextBlock Text="VENDAS" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Text="{Binding QuantidadeVendasTexto}" FontSize="{StaticResource TamDestaque}" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CartaoDoDia}">
                            <StackPanel>
                                <TextBlock Text="TICKET MÉDIO" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Text="{Binding TicketMedioTexto}" FontSize="{StaticResource TamDestaque}" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource CartaoDoDia}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="POR FORMA DE PAGAMENTO" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Text="Nenhuma venda neste dia." Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoApoio}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormasDoDia.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding FormasDoDia}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,22,0">
                                                <TextBlock Text="{Binding Total}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="{StaticResource TamPequeno}">
                                                    <Run Text="{Binding Forma, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Vendas, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Caixa fechado: abrir aqui mesmo -->
                    <Border Grid.Row="2" Style="{StaticResource FaixaAviso}" Margin="0,0,0,12"
                            Visibility="{Binding Fechamento.PodeAbrir, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="O caixa está fechado. Troco na gaveta agora:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Width="130" AutomationProperties.Name="Troco inicial"
                                     Text="{Binding Fechamento.TrocoInicialTexto, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Abrir caixa" Style="{StaticResource BotaoPrimario}" Margin="10,0,0,0" Padding="16,6"
                                    Command="{Binding Fechamento.AbrirCaixaCommand}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>

                        <!-- Lista de vendas -->
                        <Border Style="{StaticResource Painel}" Padding="0">
                        <DataGrid ItemsSource="{Binding Vendas}"
                                  SelectedItem="{Binding Selecionada, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource CorLinhaGrade}" BorderThickness="0"
                                  Background="{StaticResource CorPainel}" RowHeight="38">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Background" Value="{StaticResource CorPainel}" />
                                    <Style.Triggers>
                                        <!-- venda cancelada: cinza e riscada, mas continua na lista -->
                                        <DataTrigger Binding="{Binding Cancelada}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CorSelecao}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nº" Binding="{Binding Id, Mode=OneWay}" Width="70" />
                                <DataGridTextColumn Header="Hora" Binding="{Binding DataHora, Mode=OneWay, StringFormat='HH:mm'}" Width="80" />
                                <DataGridTextColumn Header="Pagamento" Width="*"
                                                    Binding="{Binding FormaPagamento, Mode=OneWay, Converter={StaticResource FormaPag}}" />
                                <DataGridTextColumn Header="Total" Width="120" ElementStyle="{StaticResource ColunaNumero}"
                                                    Binding="{Binding TotalCentavos, Mode=OneWay, Converter={StaticResource Centavos}}" />
                                <DataGridTextColumn Header="Situação" Width="110"
                                                    Binding="{Binding Cancelada, Mode=OneWay, Converter={StaticResource BoolTexto}, ConverterParameter='Cancelada|Concluída'}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>

                <!-- ===== Detalhe ===== -->
                <Border Grid.Column="2" Style="{StaticResource Painel}" VerticalAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Detalhe da venda" FontSize="18" FontWeight="SemiBold" />

                        <TextBlock Text="Selecione uma venda na lista." Margin="0,8,0,0"
                                   Foreground="{StaticResource CorTextoSuave}"
                                   Visibility="{Binding TemSelecao, Converter={StaticResource BoolInverso}}" />

                        <StackPanel Visibility="{Binding TemSelecao, Converter={StaticResource BoolVis}}">
                            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" FontSize="16"
                                       Text="{Binding Selecionada.Id, StringFormat='Venda nº {0}'}" />
                            <TextBlock Text="{Binding Selecionada.DataHora, StringFormat='dd/MM/yyyy HH:mm'}"
                                       Foreground="{StaticResource CorTextoSuave}" />
                            <TextBlock Text="{Binding TextoOperador}" Foreground="{StaticResource CorTextoSuave}" />
                            <TextBlock Text="{Binding TextoCliente}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />

                            <ItemsControl ItemsSource="{Binding Selecionada.Itens}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Quantidade, Mode=OneWay}" FontWeight="Bold" />
                                                <Run Text="×" />
                                                <Run Text="{Binding NomeProduto, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TotalCentavos, Converter={StaticResource Centavos}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,12" />

                            <Grid>
                                <TextBlock Text="Subtotal" Foreground="{StaticResource CorTextoSuave}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding Selecionada.SubtotalCentavos, Converter={StaticResource Centavos}}" />
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="Desconto" Foreground="{StaticResource CorTextoSuave}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding Selecionada.DescontoCentavos, Converter={StaticResource Centavos}}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="Total" FontWeight="Bold" FontSize="18" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontSize="18"
                                           Text="{Binding Selecionada.TotalCentavos, Converter={StaticResource Centavos}}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{Binding Selecionada.FormaPagamento, Converter={StaticResource FormaPag}}"
                                           Foreground="{StaticResource CorTextoSuave}" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource CorTextoSuave}"
                                           Text="{Binding Selecionada.TrocoCentavos, Converter={StaticResource Centavos}, StringFormat='troco {0}'}" />
                            </Grid>

                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource CorPerigo}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Text="{Binding TextoCancelamento}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TextoCancelamento}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- WrapPanel: num painel estreito o botão de cancelar desce em vez de ficar cortado -->
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="Reimprimir cupom" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"
                                        Command="{Binding ReimprimirCupomCommand}" />
                                <Button Content="Nota em PDF" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"
                                        Command="{Binding NotaEmPdfCommand}" />
                                <Button Content="Cancelar venda" Style="{StaticResource BotaoPerigo}" Margin="0,0,0,8"
                                        Command="{Binding CancelarVendaCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== Aba 2: abrir, movimentar, conferir e histórico ===== -->
            <TabItem Header="Conferência e histórico" Visibility="{Binding TemFechamento, Converter={StaticResource BoolVis}}">
                <v:FechamentoView DataContext="{Binding Fechamento}" Margin="0,14,0,0" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
