<UserControl x:Class="NexusLS.App.Views.ProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Atalhos de teclado desta tela -->
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NovoCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SalvarCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="370" />
        </Grid.ColumnDefinitions>

        <!-- ===== Lista ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Produtos" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- UpdateSourceTrigger=PropertyChanged: busca a cada letra digitada -->
                <TextBox Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Buscar por nome ou código de barras" />
                <CheckBox Grid.Column="1" Content="Mostrar inativos" Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding MostrarInativos}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Painel}" Padding="0">
                <DataGrid ItemsSource="{Binding Produtos}"
                          SelectedItem="{Binding Selecionado, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E7EB" BorderThickness="0"
                          Background="White" RowHeight="36">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <!-- estoque abaixo do mínimo: fundo amarelo -->
                                <DataTrigger Binding="{Binding EstoqueBaixo}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CorAlerta}" />
                                </DataTrigger>
                                <!-- inativo: texto cinza -->
                                <DataTrigger Binding="{Binding Ativo}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CorSelecao}" />
                                    <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras, Mode=OneWay}" Width="140" />
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Preço" Width="110"
                                            Binding="{Binding PrecoVendaCentavos, Mode=OneWay, Converter={StaticResource Centavos}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Estoque" Binding="{Binding EstoqueAtual, Mode=OneWay}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mín." Binding="{Binding EstoqueMinimo, Mode=OneWay}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Situação" Width="90"
                                            Binding="{Binding Ativo, Mode=OneWay, Converter={StaticResource BoolTexto}, ConverterParameter='Ativo|Inativo'}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ===== Formulário ===== -->
        <Border Grid.Column="2" Style="{StaticResource Painel}" VerticalAlignment="Top">
            <StackPanel>
                <!-- Enter em qualquer campo do formulário salva (o evento de tecla "sobe" dos TextBox até aqui) -->
                <StackPanel.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SalvarCommand}" />
                </StackPanel.InputBindings>
                <TextBlock Text="{Binding TituloFormulario}" FontSize="18" FontWeight="SemiBold" />

                <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Código de barras (opcional)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Preço de venda (R$)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding PrecoVenda, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Preço de custo (R$)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding PrecoCusto, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Estoque mínimo" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding EstoqueMinimo, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Produto novo: pode informar o estoque inicial -->
                <StackPanel Visibility="{Binding EhNovo, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Estoque inicial" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding EstoqueInicial, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- Produto existente: o estoque só muda pela tela Estoque, para sempre deixar registro -->
                <TextBlock Visibility="{Binding EstaEditando, Converter={StaticResource BoolVis}}"
                           Style="{StaticResource Rotulo}" TextWrapping="Wrap">
                    <Run Text="Estoque atual:" />
                    <Run Text="{Binding EstoqueAtualEditando, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="(ajuste na tela Estoque)" />
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Salvar (Ctrl+S)" Style="{StaticResource BotaoPrimario}"
                            Command="{Binding SalvarCommand}" IsDefault="False" />
                    <Button Content="Novo (Ctrl+N)" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                            Command="{Binding NovoCommand}" />
                </StackPanel>

                <Button Content="{Binding TextoBotaoAtivo}" Style="{StaticResource BotaoPerigo}"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding AlternarAtivoCommand}"
                        Visibility="{Binding EstaEditando, Converter={StaticResource BoolVis}}" />

                <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
