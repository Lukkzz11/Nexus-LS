<UserControl x:Class="NexusLS.App.Views.CatalogoOnlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Catálogo online" Style="{StaticResource TituloTela}" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,14"
                       Text="O programa continua funcionando sem internet; os dados ficam neste computador. Quando você clicar em &quot;Atualizar Firestore&quot;, o catálogo (nome, categoria, referência, código de barras, preço de varejo e estoque por tamanho) é publicado no Firebase do seu projeto. Nada é enviado sozinho, e nada é apagado na nuvem." />

            <!-- ===== Atualizar ===== -->
            <Border Style="{StaticResource Painel}">
                <StackPanel>
                    <TextBlock Text="Atualizar o catálogo" FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Atualizar Firestore" Style="{StaticResource BotaoPrimario}"
                                AutomationProperties.Name="Atualizar Firestore"
                                IsEnabled="{Binding PodeAtualizar}" Command="{Binding AtualizarFirestoreCommand}" />
                        <Button Content="Cancelar o envio" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                Visibility="{Binding Ocupado, Converter={StaticResource BoolVis}}"
                                Command="{Binding CancelarEnvioCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ProgressoTexto}" Margin="0,10,0,0" />
                    <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressoPercentual}"
                                 Visibility="{Binding Ocupado, Converter={StaticResource BoolVis}}" />

                    <!-- Confirmação antes de enviar -->
                    <Border Margin="0,14,0,0" Padding="14" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{StaticResource CorBorda}" Background="{StaticResource CorAvisoFundo}"
                            Visibility="{Binding AguardandoConfirmacao, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding TextoConfirmacao}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       AutomationProperties.Name="Resumo do que será enviado" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Enviar agora" Style="{StaticResource BotaoPrimario}"
                                        AutomationProperties.Name="Enviar agora" Command="{Binding ConfirmarEnvioCommand}" />
                                <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                        Command="{Binding CancelarPreviaCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ResultadoTexto}" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold"
                               AutomationProperties.Name="Resultado da sincronização">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultadoEhErro}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Problemas}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CorAviso}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Configuração do Firebase ===== -->
            <Border Style="{StaticResource Painel}" Margin="0,16,0,0">
                <StackPanel IsEnabled="{Binding PodeEditar}">
                    <TextBlock Text="Firebase deste cliente" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SituacaoConfiguracao}" TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" Margin="0,4,0,0" />

                    <TextBlock Text="Id do projeto (ex.: minha-loja-1a2b3)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding ProjectId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Chave da API (Web API Key do projeto)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="E-mail do login da licença" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Senha (em branco mantém a que já está salva)" Style="{StaticResource Rotulo}" />
                    <PasswordBox x:Name="CaixaSenha" AutomationProperties.Name="Senha do Firebase" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Salvar configuração" Style="{StaticResource BotaoPrimario}" Command="{Binding SalvarConfiguracaoCommand}" />
                        <Button Content="Testar conexão" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding TestarConexaoCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                    <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="A senha é guardada com a proteção do Windows (só este usuário, neste computador, consegue ler). O programa nunca usa chave de administrador do Firebase." />
                </StackPanel>
            </Border>

            <!-- ===== Nuvem operacional (vendas e demais registros; os usuários entram neste projeto) ===== -->
            <Border Style="{StaticResource Painel}" Margin="0,16,0,0" Visibility="{Binding TemOperacional, Converter={StaticResource BoolVis}}">
                <StackPanel IsEnabled="{Binding PodeEditar}">
                    <TextBlock Text="Nuvem operacional (vendas)" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SituacaoOperacional}" TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" Margin="0,4,0,0" />

                    <TextBlock Text="Id do projeto operacional (outro projeto, privado)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding OperProjectId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Projeto operacional" />
                    <TextBlock Text="Chave da API (Web API Key)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding OperApiKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Chave da API operacional" />
                    <TextBlock Text="Nome da loja nos caminhos (ex.: minha-loja)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding OperLojaId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Loja operacional" />

                    <Button Content="Salvar nuvem operacional" Style="{StaticResource BotaoSecundario}" Margin="0,16,0,0" HorizontalAlignment="Left"
                            Command="{Binding SalvarOperacionalCommand}" />
                </StackPanel>
            </Border>

            <!-- ===== Histórico ===== -->
            <Border Style="{StaticResource Painel}" Margin="0,16,0,24">
                <StackPanel>
                    <TextBlock Text="Histórico de atualizações" FontSize="18" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Historico}" DisplayMemberPath="Texto" MaxHeight="260" Margin="0,8,0,0" />
                    <TextBlock Text="Ainda não houve nenhuma atualização." Foreground="{StaticResource CorTextoSuave}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Historico.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
