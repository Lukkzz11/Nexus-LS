<UserControl x:Class="NexusLS.App.Views.FinanceiroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="RotuloResumo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ValorResumo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ColunaResumo" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,36,0" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NovoCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SalvarCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ===== Resumo e lista ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Financeiro" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="De:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding De}" Width="140" VerticalContentAlignment="Center" />
                <TextBlock Text="até:" VerticalAlignment="Center" Margin="12,0,8,0" />
                <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Ate}" Width="140" VerticalContentAlignment="Center" />
                <Button Content="Este mês" Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" Padding="12,6" Command="{Binding MesAtualCommand}" />
                <Button Content="Mês anterior" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6" Command="{Binding MesAnteriorCommand}" />
                <Button Content="Próximos 30 dias" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6" Command="{Binding ProximosTrintaDiasCommand}" />
                <Button Content="Exportar (CSV)" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6" Command="{Binding ExportarCommand}" />
            </WrapPanel>

            <!-- Resumo do período -->
            <Border Grid.Row="2" Style="{StaticResource Painel}" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource ColunaResumo}">
                            <TextBlock Text="VENDAS (PDV)" Style="{StaticResource RotuloResumo}" />
                            <TextBlock Text="{Binding VendasTexto}" Style="{StaticResource ValorResumo}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource ColunaResumo}">
                            <TextBlock Text="LUCRO BRUTO" Style="{StaticResource RotuloResumo}" />
                            <TextBlock Text="{Binding LucroBrutoTexto}" Style="{StaticResource ValorResumo}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource ColunaResumo}">
                            <TextBlock Text="OUTRAS RECEITAS" Style="{StaticResource RotuloResumo}" />
                            <TextBlock Text="{Binding ReceitasTexto}" Style="{StaticResource ValorResumo}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource ColunaResumo}">
                            <TextBlock Text="DESPESAS PAGAS" Style="{StaticResource RotuloResumo}" />
                            <TextBlock Text="{Binding DespesasTexto}" Style="{StaticResource ValorResumo}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource ColunaResumo}">
                            <TextBlock Text="RESULTADO" Style="{StaticResource RotuloResumo}" />
                            <TextBlock Text="{Binding ResultadoTexto}" AutomationProperties.Name="Resultado do período">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ValorResumo}">
                                        <Setter Property="Foreground" Value="{StaticResource CorSucesso}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultadoNegativo}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource CorPerigo}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" Margin="0,0,24,0">
                            <Run Text="A pagar: " /><Run Text="{Binding APagarTexto, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" Margin="0,0,24,0">
                            <Run Text="A receber: " /><Run Text="{Binding AReceberTexto, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding AtrasadosTexto}" AutomationProperties.Name="Contas atrasadas">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemAtrasados}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CorPerigo}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding DespesasPorCategoria}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,20,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Filtros -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Buscar por descrição, categoria ou fornecedor" />
                <ComboBox Grid.Column="1" Margin="10,0,0,0" MinWidth="120" ItemsSource="{Binding FiltrosTipo}"
                          DisplayMemberPath="Nome" SelectedItem="{Binding FiltroTipo}" AutomationProperties.Name="Filtro por tipo" />
                <ComboBox Grid.Column="2" Margin="10,0,0,0" MinWidth="150" ItemsSource="{Binding FiltrosSituacao}"
                          DisplayMemberPath="Nome" SelectedItem="{Binding FiltroSituacao}" AutomationProperties.Name="Filtro por situação" />
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource Painel}" Padding="0">
                <DataGrid ItemsSource="{Binding Linhas}" SelectedItem="{Binding Selecionada, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          BorderThickness="0" Background="Transparent" AutomationProperties.Name="Lista de contas">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Atrasado}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CorPerigo}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vencimento" Binding="{Binding Vencimento, Mode=OneWay}" Width="1*" MinWidth="90" />
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao, Mode=OneWay}" Width="3*" MinWidth="140" />
                        <DataGridTextColumn Header="Categoria · fornecedor" Binding="{Binding Detalhe, Mode=OneWay}" Width="2*" MinWidth="120" />
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValorTexto, Mode=OneWay}" Width="1.2*" MinWidth="90" ElementStyle="{StaticResource ColunaNumero}" />
                        <DataGridTextColumn Header="Situação" Binding="{Binding SituacaoTexto, Mode=OneWay}" Width="1.2*" MinWidth="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Ações da conta escolhida -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox MinWidth="150" ItemsSource="{Binding Formas}" DisplayMemberPath="Nome" SelectedItem="{Binding PagarForma}"
                          AutomationProperties.Name="Forma de pagamento da baixa" />
                <Button Content="{Binding TextoPagar}" Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0" Padding="14,8"
                        IsEnabled="{Binding PodePagar}" Command="{Binding PagarCommand}" />
                <Button Content="Editar" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="14,8"
                        IsEnabled="{Binding PodeEditar}" Command="{Binding EditarSelecionadaCommand}" />
                <Button Content="Estornar pagamento" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="14,8"
                        IsEnabled="{Binding PodeEstornar}" Command="{Binding EstornarCommand}" />
                <Button Content="Cancelar conta" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="14,8"
                        IsEnabled="{Binding PodeCancelar}" Command="{Binding CancelarLancamentoCommand}" />
            </StackPanel>
        </Grid>

        <!-- ===== Formulário ===== -->
        <Border Grid.Column="2" Style="{StaticResource Painel}" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}" FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="{Binding PodeParcelar}">
                        <RadioButton Content="A pagar" GroupName="TipoConta" IsChecked="{Binding FormEhDespesa}" Margin="0,0,16,0" />
                        <RadioButton Content="A receber" GroupName="TipoConta" />
                    </StackPanel>

                    <TextBlock Text="Descrição" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding FormDescricao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descrição" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Valor (R$)" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding FormValor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Valor" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vencimento" Style="{StaticResource Rotulo}" />
                            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding FormVencimento}" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Categoria" Style="{StaticResource Rotulo}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Categorias}" Text="{Binding FormCategoria, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="Categoria" />

                    <TextBlock Text="Fornecedor ou cliente (opcional)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding FormContraparte, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel IsEnabled="{Binding PodeParcelar}">
                        <TextBlock Text="Parcelas (1 = à vista; vence todo mês no mesmo dia)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding FormParcelas, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="Parcelas" />

                        <CheckBox Content="Já foi pago / recebido" IsChecked="{Binding FormJaPago}" Margin="0,12,0,0" />
                        <ComboBox ItemsSource="{Binding Formas}" DisplayMemberPath="Nome" SelectedItem="{Binding FormForma}" Margin="0,6,0,0"
                                  IsEnabled="{Binding FormJaPago}" AutomationProperties.Name="Forma do pagamento" />
                    </StackPanel>

                    <TextBlock Text="Observação (opcional)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding FormObservacao, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Salvar (Ctrl+S)" Style="{StaticResource BotaoPrimario}" Command="{Binding SalvarCommand}" />
                        <Button Content="Novo (Ctrl+N)" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding NovoCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
