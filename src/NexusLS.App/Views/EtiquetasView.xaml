<UserControl x:Class="NexusLS.App.Views.EtiquetasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CelaCentralizada" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="470" />
        </Grid.ColumnDefinitions>

        <!-- ===== Escolher produtos e fila ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Etiquetas" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

            <Border Grid.Row="1" Style="{StaticResource Painel}">
                <StackPanel>
                    <TextBlock Text="1. Escolha o produto (nome, referência ou código de barras · Enter)" FontWeight="SemiBold" />
                    <TextBox x:Name="CaixaBusca" Margin="0,8,0,0" FontSize="18"
                             Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding EscolherPrimeiroCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <ListBox ItemsSource="{Binding Resultados}" SelectedItem="{Binding ResultadoSelecionado}"
                             MaxHeight="150" Margin="0,6,0,0" BorderBrush="{StaticResource CorBorda}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Nome}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource CorTextoSuave}"
                                               Text="{Binding PrecoVendaCentavos, Converter={StaticResource Centavos}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tamanho" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding OpcoesDeTamanho}" SelectedItem="{Binding TamanhoEscolhido}"
                                  Padding="8,6" />
                        <TextBlock Grid.Column="2" Text="Qtd." VerticalAlignment="Center" Margin="16,0,8,0" />
                        <TextBox Grid.Column="3" Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AdicionarCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="4" Content="Adicionar" Style="{StaticResource BotaoPrimario}" Margin="16,0,0,0"
                                Padding="14,7" Command="{Binding AdicionarCommand}" />
                        <Button Grid.Column="5" Content="Todos os tamanhos" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                Padding="14,7" Command="{Binding AdicionarTodosOsTamanhosCommand}"
                                Visibility="{Binding TemTamanhosReais, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Painel}" Padding="0" Margin="0,14,0,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Fila}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB" BorderThickness="0" Background="White" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Nome, Mode=OneWay}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CelaCentralizada}" />
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho, Mode=OneWay}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource CelaCentralizada}" />
                            <DataGridTemplateColumn Header="Código" Width="80" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Margin="6,0"
                                                   Text="{Binding TemCodigo, Converter={StaticResource BoolTexto}, ConverterParameter='sim|—'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cópias" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="4" Padding="2" FontSize="16" VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold"
                                                 Text="{Binding Quantidade, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="56" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Width="34" Padding="0,2" Style="{StaticResource BotaoSecundario}"
                                                ToolTip="Tirar da fila"
                                                Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="2. A fila está vazia. Escolha um produto acima e tecle Adicionar."
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                               Foreground="{StaticResource CorTextoSuave}" IsHitTestVisible="False"
                               Visibility="{Binding FilaVazia, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
        </Grid>

        <!-- ===== Impressão e prévia ===== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,6,0">
            <Border Style="{StaticResource Painel}">
                <StackPanel>
                    <TextBlock Text="3. Imprimir" FontSize="18" FontWeight="SemiBold" />

                    <TextBlock Text="Papel" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding Formatos}" DisplayMemberPath="Nome"
                              SelectedItem="{Binding FormatoSelecionado}" Padding="8,7" />

                    <StackPanel Visibility="{Binding MostrarPosicao, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Começar na etiqueta nº (para aproveitar uma folha já usada)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding PrimeiraPosicaoTexto, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                 HorizontalAlignment="Left" />
                    </StackPanel>

                    <CheckBox Content="Usar o preço de atacado" Margin="0,14,0,0" IsChecked="{Binding PrecoAtacado}"
                              ToolTip="Produto sem preço de atacado sai com o de varejo" />

                    <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" Margin="0,14,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Imprimir etiquetas" Style="{StaticResource BotaoPrimario}"
                                Command="{Binding ImprimirCommand}" />
                        <Button Content="Limpar fila" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                Command="{Binding LimparCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Prévia (página 1)" FontWeight="SemiBold" Margin="2,16,0,6" />
            <Border Background="#E5E7EB" CornerRadius="6" Padding="12" HorizontalAlignment="Left">
                <Image x:Name="PreviaImagem" Stretch="Uniform" MaxWidth="420" MaxHeight="520"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </StackPanel></ScrollViewer>
    </Grid>
</UserControl>
