<UserControl x:Class="NexusLS.App.Views.FornecedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NovoCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SalvarCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Fornecedores" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Buscar por nome, documento ou telefone" AutomationProperties.Name="Buscar fornecedor" />
                <CheckBox Grid.Column="1" Content="Mostrar inativos" Margin="16,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding MostrarInativos}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Painel}" Padding="0">
                <DataGrid ItemsSource="{Binding Fornecedores}" SelectedItem="{Binding Selecionado, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          BorderThickness="0" Background="Transparent" AutomationProperties.Name="Lista de fornecedores">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome, Mode=OneWay}" Width="3*" MinWidth="140" />
                        <DataGridTextColumn Header="Documento" Binding="{Binding Documento, Mode=OneWay}" Width="2*" MinWidth="110" />
                        <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone, Mode=OneWay}" Width="2*" MinWidth="100" />
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email, Mode=OneWay}" Width="2*" MinWidth="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Painel}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding TituloFormulario}" FontSize="18" FontWeight="SemiBold" />

                <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do fornecedor" />
                <TextBlock Text="CNPJ ou CPF" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Documento, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Telefone" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="E-mail" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Observação" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Salvar (Ctrl+S)" Style="{StaticResource BotaoPrimario}" Command="{Binding SalvarCommand}" />
                    <Button Content="Novo (Ctrl+N)" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding NovoCommand}" />
                    <Button Content="{Binding TextoAtivar}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                            Visibility="{Binding Editando, Converter={StaticResource BoolVis}}" Command="{Binding AlternarAtivoCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
