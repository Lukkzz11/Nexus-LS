<UserControl x:Class="NexusLS.App.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="LinhaDeCompromisso">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Quando}" VerticalAlignment="Top" Opacity="0.8" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Concluido}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Descricao}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Feito" Padding="10,4" Margin="6,0,0,0" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding DataContext.AlternarConcluidoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Content="Editar" Padding="10,4" Margin="6,0,0,0" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Content="Remover" Padding="10,4" Margin="6,0,0,0" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="2" Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
        <TextBlock Text="Agenda" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Calendar SelectedDate="{Binding Dia, Mode=TwoWay}" DisplayDate="{Binding Dia, Mode=OneWay}" AutomationProperties.Name="Calendário" />
                <Button Content="Ir para hoje" Command="{Binding HojeCommand}" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                <Border Style="{StaticResource Painel}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Próximos compromissos" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Proximos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding Quando}" FontSize="12" Opacity="0.7" />
                                        <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{Binding TituloDoDia}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border Style="{StaticResource Painel}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Compromissos}" ItemTemplate="{StaticResource LinhaDeCompromisso}" />
                            <TextBlock Text="Nada marcado para este dia." Opacity="0.65">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Compromissos.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Painel}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding FormularioTitulo}" FontWeight="SemiBold" />
                            <TextBlock Text="O que" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Título do compromisso" />
                            <CheckBox Content="Dia inteiro" IsChecked="{Binding DiaInteiro}" Margin="0,10,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hora (14:30)" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding Hora, UpdateSourceTrigger=PropertyChanged}" Width="100" IsEnabled="{Binding HorarioAtivo}" />
                                </StackPanel>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Até (opcional)" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding HoraFim, UpdateSourceTrigger=PropertyChanged}" Width="100" IsEnabled="{Binding HorarioAtivo}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Detalhes (opcional)" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Salvar" Command="{Binding SalvarCommand}" Style="{StaticResource BotaoPrimario}" />
                                <Button Content="Limpar" Command="{Binding NovoCommand}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
