<UserControl x:Class="NexusLS.App.Views.RelatoriosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Um "cartão" de número: rótulo pequeno em cima, valor grande embaixo -->
        <Style x:Key="CartaoNumero" TargetType="Border" BasedOn="{StaticResource Painel}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Relatórios" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

        <!-- Período e exportação -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="De:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding De}" Width="150" VerticalContentAlignment="Center" />
            <TextBlock Text="até:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Ate}" Width="150" VerticalContentAlignment="Center" />

            <Button Content="Hoje" Style="{StaticResource BotaoSecundario}" Margin="16,0,0,0" Padding="12,6"
                    Command="{Binding HojeCommand}" />
            <Button Content="7 dias" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding UltimosSeteDiasCommand}" />
            <Button Content="Este mês" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding MesAtualCommand}" />
            <Button Content="Mês anterior" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding MesAnteriorCommand}" />

            <Button Content="Exportar vendas (CSV)" Style="{StaticResource BotaoSecundario}" Margin="24,0,0,0" Padding="12,6"
                    Command="{Binding ExportarVendasCommand}" />
            <Button Content="Exportar itens (CSV)" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding ExportarItensCommand}" />
        </WrapPanel>

        <!-- Números do período -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="TOTAL VENDIDO" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding TotalTexto}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource CorPrimaria}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="LUCRO BRUTO" Foreground="{StaticResource CorTextoSuave}" FontSize="12"
                               ToolTip="Total vendido menos o custo das mercadorias. Não desconta taxas nem despesas." />
                    <TextBlock Text="{Binding LucroTexto}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource CorSucesso}"
                               AutomationProperties.Name="Lucro bruto" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="VENDAS" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding QuantidadeTexto}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="TICKET MÉDIO" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding TicketMedioTexto}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="DESCONTOS" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding DescontosTexto}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="CANCELADAS" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding CanceladasTexto}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Esquerda: por dia e por forma de pagamento -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.6*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Painel}" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Vendas por dia" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PorDia}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Dia}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Value="{Binding Percentual, Mode=OneWay}" Maximum="100"
                                                         Height="14" Margin="0,0,10,0" BorderThickness="0"
                                                         Foreground="{StaticResource CorPrimaria}" Background="#E5E7EB" />
                                            <TextBlock Grid.Column="2" Text="{Binding Total}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Vendas, StringFormat='{}{0}x'}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Foreground="{StaticResource CorTextoSuave}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Painel}" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Por forma de pagamento" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding PorForma}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Forma, Converter={StaticResource FormaPag}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Vendas, StringFormat='{}{0}x'}" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock Grid.Column="2" Text="{Binding TotalCentavos, Converter={StaticResource Centavos}}"
                                                   HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Painel}" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Por categoria (faturamento · lucro)" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PorCategoria}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Categoria}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Quantidade, StringFormat='{}{0}un'}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource CorTextoSuave}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Faturamento}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="{Binding Lucro}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource CorSucesso}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Direita: lista das vendas do período -->
            <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="0">
                <DataGrid ItemsSource="{Binding Vendas}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E7EB" BorderThickness="0"
                          Background="White" RowHeight="32">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cancelada}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CorSelecao}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº" Binding="{Binding Id, Mode=OneWay}" Width="60" />
                        <DataGridTextColumn Header="Data" Width="130"
                                            Binding="{Binding DataHora, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm'}" />
                        <DataGridTextColumn Header="Pagamento" Width="*"
                                            Binding="{Binding FormaPagamento, Mode=OneWay, Converter={StaticResource FormaPag}}" />
                        <DataGridTextColumn Header="Total" Width="110" ElementStyle="{StaticResource ColunaNumero}"
                                            Binding="{Binding TotalCentavos, Mode=OneWay, Converter={StaticResource Centavos}}" />
                        <DataGridTextColumn Header="Situação" Width="95"
                                            Binding="{Binding Cancelada, Mode=OneWay, Converter={StaticResource BoolTexto}, ConverterParameter='Cancelada|Concluída'}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding AvisoLucro}" TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
        </StackPanel>
    </Grid>
</UserControl>
