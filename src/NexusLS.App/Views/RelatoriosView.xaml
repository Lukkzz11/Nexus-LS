<UserControl x:Class="NexusLS.App.Views.RelatoriosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:NexusLS.App.Views"
             xmlns:conv="clr-namespace:NexusLS.App.Converters">

    <UserControl.Resources>
        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Um "cartão" de número: rótulo pequeno em cima, valor grande embaixo -->
        <Style x:Key="CartaoNumero" TargetType="Border" BasedOn="{StaticResource Painel}">
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <conv:ChaveParaPincelConverter x:Key="Pincel" />

        <!-- Uma fatia da rosca (Path) e a legenda dela -->
        <DataTemplate x:Key="FatiaDesenho">
            <Path Data="{Binding Caminho}" Fill="{Binding ChaveCor, Converter={StaticResource Pincel}}" Stroke="{StaticResource CorPainel}"
                  StrokeThickness="1" ToolTip="{Binding Legenda}" />
        </DataTemplate>
        <DataTemplate x:Key="FatiaLegenda">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Border Width="12" Height="12" CornerRadius="2" Background="{Binding ChaveCor, Converter={StaticResource Pincel}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Legenda}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Uma barra de ranking: nome e valor em cima, barra proporcional embaixo (a maior vale 1) -->
        <DataTemplate x:Key="BarraDeRanking">
            <StackPanel Margin="0,5" ToolTip="{Binding Texto}" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Texto}" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="12,0,0,0" />
                </Grid>
                <Border Height="8" CornerRadius="4" Margin="0,3,0,0" Background="{StaticResource CorLinhaGrade}">
                    <Border Background="{StaticResource CorSerie1}" CornerRadius="4" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fracao, Mode=OneWay}" /></Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BarraDeRankingVerde">
            <StackPanel Margin="0,5" ToolTip="{Binding Texto}" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Texto}" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="12,0,0,0" />
                </Grid>
                <Border Height="8" CornerRadius="4" Margin="0,3,0,0" Background="{StaticResource CorLinhaGrade}">
                    <Border Background="{StaticResource CorSerie2}" CornerRadius="4" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fracao, Mode=OneWay}" /></Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </DataTemplate>

        <conv:TrechoDoDreConverter x:Key="TrechoDoDre" />

        <!-- Uma linha do demonstrativo (rótulo à esquerda, valor à direita) -->
        <DataTemplate x:Key="LinhaDoDre">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rotulo}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Recuo}" Value="True">
                                    <Setter Property="Margin" Value="18,0,0,0" />
                                    <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Destaque}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Titulo}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Margin" Value="0,14,0,2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Valor}" HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Destaque}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Negativo}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CorPerigo}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Relatórios" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

        <!-- Período e exportação -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="De:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding De}" Width="150" VerticalContentAlignment="Center" />
            <TextBlock Text="até:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding Ate}" Width="150" VerticalContentAlignment="Center" />

            <Button Content="Hoje" Style="{StaticResource BotaoSecundario}" Margin="16,0,0,0" Padding="12,6"
                    Command="{Binding HojeCommand}" />
            <Button Content="7 dias" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding UltimosSeteDiasCommand}" />
            <Button Content="Este mês" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding MesAtualCommand}" />
            <Button Content="Mês anterior" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding MesAnteriorCommand}" />

            <Button Content="Exportar vendas (CSV)" Style="{StaticResource BotaoSecundario}" Margin="24,0,0,0" Padding="12,6"
                    Command="{Binding ExportarVendasCommand}" />
            <Button Content="Exportar itens (CSV)" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="12,6"
                    Command="{Binding ExportarItensCommand}" />
        </WrapPanel>

        <!-- Números do período -->
        <!-- os seis cartões se repartem na largura toda (6 lado a lado em tela larga, 2 linhas em tela estreita) -->
        <v:GradeDeCartoes Grid.Row="2" Margin="0,0,0,14" LarguraMinima="175" MaximoColunas="6" Espaco="12" IgualarAltura="True">
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="TOTAL VENDIDO" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding TotalTexto}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource CorPrimaria}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="LUCRO BRUTO" Foreground="{StaticResource CorTextoSuave}" FontSize="12"
                               ToolTip="Total vendido menos o custo das mercadorias. Não desconta taxas nem despesas." />
                    <TextBlock Text="{Binding LucroTexto}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource CorSucesso}"
                               AutomationProperties.Name="Lucro bruto" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="VENDAS" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding QuantidadeTexto}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="TICKET MÉDIO" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding TicketMedioTexto}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="DESCONTOS" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding DescontosTexto}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoNumero}">
                <StackPanel>
                    <TextBlock Text="CANCELADAS" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                    <TextBlock Text="{Binding CanceladasTexto}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </v:GradeDeCartoes>

        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
        <TabItem Header="Gráficos">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel>
                    <Border Style="{StaticResource Painel}" Padding="18,14" Visibility="{Binding TemGraficos, Converter={StaticResource BoolInverso}}">
                        <TextBlock Text="Nenhuma venda neste período para desenhar os gráficos." Foreground="{StaticResource CorTextoSuave}" />
                    </Border>

                    <StackPanel Visibility="{Binding TemGraficos, Converter={StaticResource BoolVis}}">
                        <!-- Comparação com o período anterior -->
                        <TextBlock Margin="0,0,0,8" Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Sem vendas no período anterior: não há com o que comparar." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemComparacao}" Value="True">
                                            <Setter Property="Text" Value="{Binding PeriodoAnteriorTexto}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Comparacao}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <v:GradeDeCartoes LarguraMinima="230" MaximoColunas="4" Espaco="12" IgualarAltura="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CartaoNumero}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                                            <TextBlock Text="{Binding Valor}" FontSize="22" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Variacao}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Subiu}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource CorSucesso}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Caiu}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource CorPerigo}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <v:GradeDeCartoes LarguraMinima="520" MaximoColunas="3" Espaco="12" IgualarAltura="True">
                            <!-- Vendas por dia (barras), com o período anterior em cinza ao lado -->
                            <Border Style="{StaticResource Painel}" Padding="16,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GranularidadeTexto}" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                                        <TextBlock Text="Vendas por dia" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding MaiorBarraTexto}" Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,2,0,8" />
                                    <ItemsControl ItemsSource="{Binding ColunasPorDia}" AutomationProperties.Name="Gráfico de vendas por dia">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="1,0" ToolTip="{Binding Dica}" Background="Transparent">
                                                    <Grid Height="230">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Margin="0,0,1,0" Background="{StaticResource CorSerie1}" CornerRadius="3,3,0,0"
                                                                VerticalAlignment="Stretch" RenderTransformOrigin="0.5,1">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleY="{Binding Fracao, Mode=OneWay}" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                        <Border Grid.Column="1" Margin="1,0,0,0" Background="{StaticResource CorSerieOutros}" CornerRadius="3,3,0,0"
                                                                VerticalAlignment="Stretch" RenderTransformOrigin="0.5,1">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleY="{Binding FracaoAnterior, Mode=OneWay}" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                    <Border BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" />
                                                    <TextBlock Text="{Binding Rotulo}" FontSize="10" Foreground="{StaticResource CorTextoSuave}" TextWrapping="NoWrap"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource CorSerie1}" Margin="0,0,6,0" />
                                        <TextBlock Text="Período escolhido" FontSize="12" Margin="0,0,16,0" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding TemComparacao, Converter={StaticResource BoolVis}}">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource CorSerieOutros}" Margin="0,0,6,0" />
                                            <TextBlock Text="Período anterior" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Formas de pagamento (rosca) -->
                            <Border Style="{StaticResource Painel}" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Vendas por forma de pagamento" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalFormasTexto, StringFormat='Total {0}'}" Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,2,0,8" />
                                    <Viewbox Height="170" Margin="0,0,0,8">
                                        <Grid Width="200" Height="200">
                                            <ItemsControl ItemsSource="{Binding PizzaFormas}" ItemTemplate="{StaticResource FatiaDesenho}" Width="200" Height="200">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Ellipse Width="108" Height="108" Fill="{StaticResource CorPainel}" />
                                        </Grid>
                                    </Viewbox>
                                    <ItemsControl ItemsSource="{Binding PizzaFormas}" ItemTemplate="{StaticResource FatiaLegenda}" />
                                </StackPanel>
                            </Border>

                            <!-- Categorias (rosca) -->
                            <Border Style="{StaticResource Painel}" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Vendas por categoria" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalCategoriasTexto, StringFormat='Total {0}'}" Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,2,0,8" />
                                    <Viewbox Height="170" Margin="0,0,0,8">
                                        <Grid Width="200" Height="200">
                                            <ItemsControl ItemsSource="{Binding PizzaCategorias}" ItemTemplate="{StaticResource FatiaDesenho}" Width="200" Height="200">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Ellipse Width="108" Height="108" Fill="{StaticResource CorPainel}" />
                                        </Grid>
                                    </Viewbox>
                                    <ItemsControl ItemsSource="{Binding PizzaCategorias}" ItemTemplate="{StaticResource FatiaLegenda}" />
                                </StackPanel>
                            </Border>

                        </v:GradeDeCartoes>

                        <v:GradeDeCartoes LarguraMinima="520" MaximoColunas="2" Espaco="12" IgualarAltura="True" Margin="0,12,0,0">
                            <!-- O que mais saiu (peças) -->
                            <Border Style="{StaticResource Painel}" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="O que mais saiu (peças)" FontWeight="SemiBold" />
                                    <TextBlock Text="Os 10 produtos com mais peças vendidas." Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,2,0,8" />
                                    <ItemsControl ItemsSource="{Binding RankingPecas}" ItemTemplate="{StaticResource BarraDeRanking}" />
                                </StackPanel>
                            </Border>

                            <!-- O que mais faturou (valor) -->
                            <Border Style="{StaticResource Painel}" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="O que mais faturou (valor)" FontWeight="SemiBold" />
                                    <TextBlock Text="Os 10 produtos que mais renderam, já com o desconto da venda." Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding RankingValor}" ItemTemplate="{StaticResource BarraDeRankingVerde}" />
                                </StackPanel>
                            </Border>
                        </v:GradeDeCartoes>

                        <TextBlock Text="{Binding ConferenciaGraficos}" TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,12,0,16" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Vendas">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Esquerda: por dia e por forma de pagamento -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.6*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Painel}" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Vendas por dia" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PorDia}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Dia}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Value="{Binding Percentual, Mode=OneWay}" Maximum="100"
                                                         Height="14" Margin="0,0,10,0" BorderThickness="0"
                                                         Foreground="{StaticResource CorPrimaria}" Background="{StaticResource CorLinhaGrade}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Total}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Vendas, StringFormat='{}{0}x'}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Foreground="{StaticResource CorTextoSuave}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Painel}" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Por forma de pagamento" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding PorForma}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Forma, Converter={StaticResource FormaPag}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Vendas, StringFormat='{}{0}x'}" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock Grid.Column="2" Text="{Binding TotalCentavos, Converter={StaticResource Centavos}}"
                                                   HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Painel}" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Por categoria (itens antes do desconto · lucro)" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PorCategoria}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Categoria}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Quantidade, StringFormat='{}{0}un'}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource CorTextoSuave}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Faturamento}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="{Binding Lucro}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource CorSucesso}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Direita: lista das vendas do período -->
            <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="0">
                <DataGrid ItemsSource="{Binding Vendas}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource CorLinhaGrade}" BorderThickness="0"
                          Background="{StaticResource CorPainel}" RowHeight="32">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Background" Value="{StaticResource CorPainel}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Cancelada}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CorSelecao}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº" Binding="{Binding Id, Mode=OneWay}" Width="60" />
                        <DataGridTextColumn Header="Data" Width="130"
                                            Binding="{Binding DataHora, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm'}" />
                        <DataGridTextColumn Header="Pagamento" Width="*"
                                            Binding="{Binding FormaPagamento, Mode=OneWay, Converter={StaticResource FormaPag}}" />
                        <DataGridTextColumn Header="Total" Width="110" ElementStyle="{StaticResource ColunaNumero}"
                                            Binding="{Binding TotalCentavos, Mode=OneWay, Converter={StaticResource Centavos}}" />
                        <DataGridTextColumn Header="Situação" Width="95"
                                            Binding="{Binding Cancelada, Mode=OneWay, Converter={StaticResource BoolTexto}, ConverterParameter='Cancelada|Concluída'}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        </TabItem>

        <TabItem Header="Demonstrativo (DRE)" Visibility="{Binding TemDre, Converter={StaticResource BoolVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Em tela larga o resultado fica à esquerda e "fora do resultado" + fluxo de caixa à direita; em tela estreita, um embaixo do outro -->
                    <v:GradeDeCartoes LarguraMinima="460" MaximoColunas="2">
                        <Border Style="{StaticResource Painel}" Padding="18,12">
                            <ItemsControl ItemTemplate="{StaticResource LinhaDoDre}" AutomationProperties.Name="Demonstrativo do período">
                                <ItemsControl.ItemsSource>
                                    <MultiBinding Converter="{StaticResource TrechoDoDre}" ConverterParameter="resultado">
                                        <Binding Path="Dre" />
                                        <Binding Path="Dre.Count" />
                                    </MultiBinding>
                                </ItemsControl.ItemsSource>
                            </ItemsControl>
                        </Border>
                        <Border Style="{StaticResource Painel}" Padding="18,0,18,12">
                            <ItemsControl ItemTemplate="{StaticResource LinhaDoDre}" AutomationProperties.Name="Fora do resultado e fluxo de caixa">
                                <ItemsControl.ItemsSource>
                                    <MultiBinding Converter="{StaticResource TrechoDoDre}" ConverterParameter="fora">
                                        <Binding Path="Dre" />
                                        <Binding Path="Dre.Count" />
                                    </MultiBinding>
                                </ItemsControl.ItemsSource>
                            </ItemsControl>
                        </Border>
                    </v:GradeDeCartoes>
                    <TextBlock Text="{Binding DreAvisos}" TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>

        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding AvisoLucro}" TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
        </StackPanel>
    </Grid>
</UserControl>
