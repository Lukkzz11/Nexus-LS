<UserControl x:Class="NexusLS.App.Views.PdvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexusLS.App.ViewModels">

    <UserControl.Resources>
        <!-- "Azulejo" usado nos modais (tamanho, pagamento, parcelas...): o selecionado fica azul. -->
        <DataTemplate x:Key="Azulejo" DataType="{x:Type vm:OpcaoViewModel}">
            <Border x:Name="borda" Margin="5" Padding="12,14" CornerRadius="8" BorderThickness="2"
                    BorderBrush="{StaticResource CorBorda}" Background="{StaticResource CorPainel}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="texto" Text="{Binding Texto}" FontSize="22" FontWeight="Bold"
                               TextAlignment="Center" Foreground="{StaticResource CorTexto}" />
                    <TextBlock x:Name="detalhe" Text="{Binding Detalhe}" FontSize="13" TextAlignment="Center"
                               Foreground="{StaticResource CorTextoSuave}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Esgotada}" Value="True">
                    <Setter TargetName="borda" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Selecionada}" Value="True">
                    <Setter TargetName="borda" Property="Background" Value="{StaticResource CorPrimaria}" />
                    <Setter TargetName="borda" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                    <Setter TargetName="texto" Property="Foreground" Value="{StaticResource CorSobrePrimaria}" />
                    <Setter TargetName="detalhe" Property="Foreground" Value="{StaticResource CorSobrePrimariaSuave}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TituloModal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
        </Style>

        <!-- "Tecla" do guia de atalhos (como o ERP: F2, F8, Esc...) -->
        <Style x:Key="Tecla" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CorSelecaoSuave}" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RaioPequeno}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TextoTecla" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="{StaticResource TamRotulo}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
        </Style>
        <Style x:Key="PontoCaixaPdv" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{StaticResource CorPositivo}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CaixaAberto}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource CorAtencaoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DicaModal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="Margin" Value="0,18,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!-- Atalhos de teclado ficam no código da View (PdvView.xaml.cs): F2, F10, Espaço, setas, Enter e Esc. -->
    <Grid>
        <!-- ================= Tela principal ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ===== Busca e carrinho ===== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="PDV" Style="{StaticResource TituloTela}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding TemCaixa, Converter={StaticResource BoolVis}}">
                        <Ellipse Style="{StaticResource PontoCaixaPdv}" />
                        <TextBlock Text="{Binding CaixaTexto}" FontWeight="SemiBold" Foreground="{StaticResource CorTextoSuave}"
                                   AutomationProperties.Name="Situação do caixa" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <!-- Caixa fechado: abre aqui mesmo, sem sair do PDV -->
                    <Border Style="{StaticResource FaixaAviso}" Margin="0,0,0,10"
                            Visibility="{Binding CaixaFechado, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="O caixa está fechado. Troco na gaveta agora:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Width="130" AutomationProperties.Name="Troco inicial"
                                     Text="{Binding TrocoAberturaTexto, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Abrir caixa" Style="{StaticResource BotaoPrimario}" Margin="10,0,0,0" Padding="16,6"
                                    Command="{Binding AbrirCaixaCommand}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Buscar produto (F2): nome, referência ou código de barras · Enter escolhe"
                               Foreground="{StaticResource CorTextoSuave}" FontSize="13" Margin="0,0,0,4" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <TextBox x:Name="CaixaBusca" FontSize="28" Padding="12,10"
                             Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <!-- Atacado: a caixa de busca ganha borda azul; no varejo continua como sempre. -->
                                    <DataTrigger Binding="{Binding EhAtacado}" Value="True">
                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                        <Setter Property="BorderThickness" Value="3" />
                                        <Setter Property="Background" Value="#EFF6FF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Como no ERP: busca vazia com itens no carrinho lembra que Enter finaliza -->
                    <TextBlock Text="Enter para finalizar  ↵" FontWeight="SemiBold" FontSize="14" IsHitTestVisible="False"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{StaticResource CorPrimaria}"
                               Visibility="{Binding DicaFinalizar, Converter={StaticResource BoolVis}}" />
                </Grid>

                <!-- Resultados ao vivo: ↑ ↓ destacam; Enter usa o destacado (se você desceu) -->
                <Border Grid.Row="3" Style="{StaticResource Painel}" Padding="0" Margin="0,6,0,0"
                        Visibility="{Binding TemResultados, Converter={StaticResource BoolVis}}">
                    <ListBox ItemsSource="{Binding Resultados}" SelectedItem="{Binding ResultadoSelecionado}"
                             MaxHeight="300" BorderThickness="0" FontSize="20" Focusable="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="borda" Background="Transparent" Padding="12,6"
                                                    BorderBrush="{StaticResource CorLinhaGrade}" BorderThickness="0,0,0,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="borda" Property="Background" Value="{StaticResource CorSelecao}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="{StaticResource TamPequeno}" Foreground="{StaticResource CorTextoSuave}">
                                            <Run Text="Ref: " /><Run Text="{Binding Referencia, Mode=OneWay, TargetNullValue='sem ref.'}" /><Run Text="   " /><Run Text="{Binding CodigoBarras, Mode=OneWay}" FontFamily="Consolas" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding PrecoVendaCentavos, Converter={StaticResource Centavos}}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                               Foreground="{StaticResource CorTextoSuave}"
                                               Text="{Binding EstoqueAtual, StringFormat='estoque {0}'}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Carrinho -->
                <Border Grid.Row="4" Style="{StaticResource Painel}" Padding="0" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,10" TextElement.Foreground="{StaticResource CorTextoSuave}" TextElement.FontSize="13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PRODUTO" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="UNITÁRIO (editável)" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       ToolTip="Digite o preço de uma unidade. Apague o campo para voltar ao preço da tabela." />
                            <TextBlock Grid.Column="2" Text="QTD." HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="TOTAL (editável)" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       ToolTip="Digite o total da linha (ex.: 3 por R$ 100). Apague o campo para voltar ao preço da tabela." />
                            <Button Grid.Column="4" Content="Esvaziar" FontSize="12" Padding="6,3" HorizontalAlignment="Right"
                                    Style="{StaticResource BotaoSecundario}" ToolTip="Esvaziar o carrinho (pede confirmação)"
                                    Command="{Binding EsvaziarCommand}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Carrinho vazio. Leia o código de barras ou digite o nome do produto e tecle Enter."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="40" FontSize="18"
                                   Foreground="{StaticResource CorTextoSuave}"
                                   Visibility="{Binding CarrinhoVazio, Converter={StaticResource BoolVis}}" />

                        <ListBox Grid.Row="1" x:Name="ListaItens" ItemsSource="{Binding Itens}"
                                 SelectedItem="{Binding ItemSelecionado}"
                                 BorderThickness="0" FontSize="22" HorizontalContentAlignment="Stretch">
                            <ListBox.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding RemoverSelecionadoCommand}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="borda" Background="Transparent" Padding="14,6"
                                                        BorderBrush="{StaticResource CorLinhaGrade}" BorderThickness="0,0,0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="borda" Property="Background" Value="{StaticResource CorSelecao}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Nome, Mode=OneWay}" />
                                            <Run Text="{Binding TamanhoTexto, Mode=OneWay}" FontSize="15"
                                                 Foreground="{StaticResource CorTextoSuave}" />
                                        </TextBlock>

                                        <!-- Preço de uma unidade: editável. Enter confirma; vazio volta ao preço da tabela. -->
                                        <TextBox Grid.Column="1" Margin="6,0" TextAlignment="Right" FontSize="20"
                                                 Text="{Binding PrecoUnitarioTexto, UpdateSourceTrigger=LostFocus}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrecoEditado}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource CorAlerta}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- Quantidade editável: − [número] + -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="−" Width="38" Padding="0,2" Style="{StaticResource BotaoSecundario}"
                                                    Command="{Binding DataContext.DiminuirCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBox Width="68" Margin="6,0" TextAlignment="Center" FontWeight="Bold" FontSize="20" Padding="2,6"
                                                     Text="{Binding Quantidade, UpdateSourceTrigger=LostFocus}" />
                                            <Button Content="+" Width="38" Padding="0,2" Style="{StaticResource BotaoSecundario}"
                                                    Command="{Binding DataContext.AumentarCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <!-- Total da linha: editável também (ex.: "3 por R$ 100"). -->
                                        <TextBox Grid.Column="3" Margin="6,0" TextAlignment="Right" FontSize="20" FontWeight="Bold"
                                                 Text="{Binding TotalTexto, UpdateSourceTrigger=LostFocus}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrecoEditado}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource CorAlerta}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <Button Grid.Column="4" Content="✕" Width="34" Padding="0,2" HorizontalAlignment="Right"
                                                ToolTip="Remover item (Del)" Style="{StaticResource BotaoSecundario}"
                                                Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="5" Margin="0,12,0,0" TextElement.FontSize="13" TextElement.Foreground="{StaticResource CorTextoSuave}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Border Style="{StaticResource Tecla}"><TextBlock Text="F2" Style="{StaticResource TextoTecla}" /></Border><TextBlock Text="Buscar" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Border Style="{StaticResource Tecla}"><TextBlock Text="Enter" Style="{StaticResource TextoTecla}" /></Border><TextBlock Text="Escolhe o produto · busca vazia fecha a venda" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Border Style="{StaticResource Tecla}"><TextBlock Text="F10" Style="{StaticResource TextoTecla}" /></Border><TextBlock Text="Fecha a venda" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Border Style="{StaticResource Tecla}"><TextBlock Text="F8 / Espaço" Style="{StaticResource TextoTecla}" /></Border><TextBlock Text="Varejo/Atacado" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Border Style="{StaticResource Tecla}"><TextBlock Text="Del" Style="{StaticResource TextoTecla}" /></Border><TextBlock Text="Remove o item" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Border Style="{StaticResource Tecla}"><TextBlock Text="Esc" Style="{StaticResource TextoTecla}" /></Border><TextBlock Text="Fecha a janela" VerticalAlignment="Center" /></StackPanel>
                </WrapPanel>
            </Grid>

            <!-- ===== Resumo da venda ===== -->
            <Border Grid.Column="2" Style="{StaticResource Painel}" VerticalAlignment="Stretch">
                <StackPanel>
                    <!-- Venda Cliente: quem está comprando e quanto já deve -->
                    <Border Visibility="{Binding EmModoCliente, Converter={StaticResource BoolVis}}" Background="{StaticResource CorAtencaoFundo}"
                            BorderBrush="{StaticResource CorAtencaoBorda}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Venda Cliente" Style="{StaticResource Rotulo}" />
                            <TextBlock Text="{Binding ClienteFixoNome}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ClienteFixoDivida}" FontSize="12" />
                            <TextBlock Text="{Binding ClienteFixoInfo}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Trocar cliente" Command="{Binding TrocarClienteCommand}" Focusable="False" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,0" />
                                <Button Content="Sair" Command="{Binding SairDoModoClienteCommand}" Focusable="False" Style="{StaticResource BotaoSecundario}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Tabela de preço (Espaço troca)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <!-- No atacado o botão fica azul, para ninguém esquecer em que tabela está vendendo. -->
                    <Button Content="{Binding TabelaTexto}" FontSize="18" Focusable="False"
                            Command="{Binding AlternarTabelaCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EhAtacado}" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="BorderBrush" Value="#1D4ED8" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="SUBTOTAL" Style="{StaticResource Rotulo}" Margin="0,20,0,0" />
                    <TextBlock Text="{Binding SubtotalTexto}" FontSize="52" FontWeight="Bold"
                               Foreground="{StaticResource CorPrimaria}" />
                    <TextBlock Text="{Binding ResumoItensTexto}" Foreground="{StaticResource CorTextoSuave}" />

                    <Button Content="FECHAR VENDA (F10)" Style="{StaticResource BotaoPrimario}" FontSize="20"
                            Padding="16,14" Margin="0,24,0,0" Command="{Binding FecharVendaCommand}" Focusable="False" />

                    <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" FontSize="17" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Modais encadeados ================= -->
        <Grid x:Name="Sobreposicao" Background="{StaticResource CorSobreposicao}" Focusable="True" FocusVisualStyle="{x:Null}"
              Visibility="{Binding ModalAberto, Converter={StaticResource BoolVis}}">

            <!-- TAMANHO -->
            <Border Style="{StaticResource Painel}" Width="680" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding EmTamanho, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="Escolha o tamanho" Style="{StaticResource TituloModal}" />
                    <TextBlock Text="{Binding ProdutoModalTexto}" FontSize="18" Margin="0,4,0,16"
                               Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding OpcoesTamanho}" ItemTemplate="{StaticResource Azulejo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                    <TextBlock Style="{StaticResource DicaModal}"
                               Text="← → ↑ ↓ ou digite a letra/número do tamanho (M, GG, 38) · Enter confirma · Esc volta à busca" />
                </StackPanel>
            </Border>

            <!-- QUANTIDADE -->
            <Border Style="{StaticResource Painel}" Width="520" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding EmQuantidade, Converter={StaticResource BoolVis}}">
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="Quantidade" Style="{StaticResource TituloModal}" />
                    <TextBlock Text="{Binding ProdutoModalTexto}" FontSize="18" Margin="0,4,0,0"
                               Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TamanhoModalTexto}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="▲" FontSize="26" HorizontalAlignment="Center" Margin="0,16,0,0"
                               Foreground="{StaticResource CorTextoSuave}" />
                    <!-- Digite o número ou use ↑ ↓. O texto já vem selecionado: é só digitar por cima. -->
                    <TextBox x:Name="CaixaQuantidade" Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="72" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center"
                             Width="220" Padding="0,4" MaxLength="4"
                             Foreground="{StaticResource CorPrimaria}"
                             PreviewTextInput="SoNumeros" InputMethod.IsInputMethodEnabled="False" />
                    <TextBlock Text="▼" FontSize="26" HorizontalAlignment="Center"
                               Foreground="{StaticResource CorTextoSuave}" />
                    <TextBlock Text="{Binding QuantidadeMaximoTexto}" HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{StaticResource CorTextoSuave}" />
                    <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource DicaModal}" TextAlignment="Center"
                               Text="Digite o número ou use ↑ ↓ · Enter confirma · Esc volta à busca" />
                </StackPanel>
            </Border>

            <!-- DESCONTO -->
            <Border Style="{StaticResource Painel}" Width="560" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding EmDesconto, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="Desconto" Style="{StaticResource TituloModal}" />
                    <TextBlock Text="Pode ficar vazio (sem desconto)." Foreground="{StaticResource CorTextoSuave}" Margin="0,4,0,12" />
                    <ItemsControl ItemsSource="{Binding OpcoesDesconto}" ItemTemplate="{StaticResource Azulejo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding DescontoDica}" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="CaixaDesconto" FontSize="28" Padding="12,10"
                             Text="{Binding DescontoTexto, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding DescontoResumo}" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,0"
                               Foreground="{StaticResource CorPrimaria}" />
                    <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                    <TextBlock Style="{StaticResource DicaModal}"
                               Text="← → ↑ ↓ trocam entre R$ e % · Enter segue para o pagamento · Esc volta à busca" />
                </StackPanel>
            </Border>

            <!-- PAGAMENTO -->
            <Border Style="{StaticResource Painel}" Width="720" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding EmPagamento, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Pagamento" Style="{StaticResource TituloModal}" />
                        <TextBlock Text="{Binding TotalFinalTexto}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Right"
                                   Foreground="{StaticResource CorPrimaria}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding OpcoesPagamento}" ItemTemplate="{StaticResource Azulejo}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Cartão de crédito: parcelas -->
                    <StackPanel Visibility="{Binding EmCredito, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding AcrescimoTexto}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Rotulo}">
                                    <Setter Property="Text" Value="Parcelas: tecle Enter para escolher" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EscolhendoParcelas}" Value="True">
                                            <Setter Property="Text" Value="Escolha as parcelas com as setas (← ↓ menos · → ↑ mais) e tecle Enter para finalizar" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding OpcoesParcela}" ItemTemplate="{StaticResource Azulejo}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Dinheiro: valor recebido (já vem com o total) e troco -->
                    <StackPanel Visibility="{Binding EmDinheiro, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Valor recebido (R$)" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="CaixaRecebido" FontSize="28" Padding="12,10"
                                 Text="{Binding ValorRecebidoTexto, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding TrocoTexto}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="{StaticResource CorSucesso}" />
                    </StackPanel>

                    <!-- A prazo: escolher o cliente -->
                    <StackPanel Visibility="{Binding EmAPrazo, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Cliente (digite o nome · ↑ ↓ escolhem · nome novo + Enter cadastra)" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="CaixaCliente" FontSize="22" Padding="10,8"
                                 Text="{Binding ClienteBusca, UpdateSourceTrigger=PropertyChanged}" />
                        <ListBox ItemsSource="{Binding ClientesResultado}" SelectedItem="{Binding ClienteDestacado}"
                                 MaxHeight="150" FontSize="18" Focusable="False" Margin="0,6,0,0"
                                 DisplayMemberPath="Nome" />
                    </StackPanel>

                    <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                    <TextBlock Style="{StaticResource DicaModal}"
                               Text="← → ↑ ↓ trocam a forma (no crédito, ↑ ↓ mudam as parcelas) · Enter finaliza a venda · Esc volta à busca" />
                </StackPanel>
            </Border>

            <!-- SUCESSO -->
            <Border Style="{StaticResource Painel}" Width="620" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding EmSucesso, Converter={StaticResource BoolVis}}">
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="✔" FontSize="64" HorizontalAlignment="Center" Foreground="{StaticResource CorSucesso}" />
                    <TextBlock Text="{Binding SucessoTitulo}" Style="{StaticResource TituloModal}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SucessoDetalhe}" FontSize="20" HorizontalAlignment="Center" Margin="0,6,0,18"
                               Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" TextAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding OpcoesSucesso}" ItemTemplate="{StaticResource Azulejo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource DicaModal}" TextAlignment="Center"
                               Text="← → ↑ ↓ alternam · Enter confirma · Esc = nova venda" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
