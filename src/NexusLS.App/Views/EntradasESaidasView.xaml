<UserControl x:Class="NexusLS.App.Views.EntradasESaidasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:NexusLS.App.Views">
    <UserControl.Resources>
        <Style x:Key="RotuloTotal" TargetType="TextBlock" BasedOn="{StaticResource TextoApoio}" />
        <Style x:Key="ValorTotal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NovoCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SalvarCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ===== Lista ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Entradas e saídas" Style="{StaticResource TituloTela}" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Style="{StaticResource TextoApoio}" Margin="0,0,0,12"
                       Text="Dinheiro que entrou ou saiu da empresa fora das vendas do caixa: aluguel, energia, aporte, retirada. Você pode anexar a foto da nota ou o comprovante." />

            <StackPanel Grid.Row="2" Margin="0,0,0,10" Visibility="{Binding SemPermissao, Converter={StaticResource BoolInverso}}">
                <v:BarraPeriodo />
                <WrapPanel Margin="0,10,0,0">
                    <ComboBox ItemsSource="{Binding OpcoesTipo}" DisplayMemberPath="Nome" SelectedItem="{Binding FiltroTipo}" MinWidth="160"
                              AutomationProperties.Name="Filtrar por entrada ou saída" />
                    <ComboBox ItemsSource="{Binding OpcoesCategoria}" SelectedItem="{Binding FiltroCategoria}" MinWidth="150" Margin="8,0,0,0"
                              AutomationProperties.Name="Filtrar por categoria" />
                    <ComboBox ItemsSource="{Binding OpcoesAnexo}" SelectedItem="{Binding FiltroAnexo}" MinWidth="150" Margin="8,0,0,0"
                              AutomationProperties.Name="Filtrar por ter anexo ou não" />
                    <TextBox Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="8,0,0,0"
                             ToolTip="Buscar por descrição, categoria ou observação" AutomationProperties.Name="Buscar por descrição ou categoria" />
                    <Button Content="Limpar filtros" Style="{StaticResource BotaoSecundario}" Padding="12,6" Margin="8,0,0,0" Command="{Binding LimparFiltrosCommand}"
                            AutomationProperties.Name="Limpar os filtros" />
                </WrapPanel>
            </StackPanel>

            <Border Grid.Row="3" Style="{StaticResource Painel}" Padding="18,14" Margin="0,0,0,10"
                    Visibility="{Binding SemPermissao, Converter={StaticResource BoolInverso}}">
                <WrapPanel>
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="ENTRADAS" Style="{StaticResource RotuloTotal}" />
                        <TextBlock Text="{Binding TotalEntradas}" Style="{StaticResource ValorTotal}" AutomationProperties.Name="Total de entradas" />
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="SAÍDAS" Style="{StaticResource RotuloTotal}" />
                        <TextBlock Text="{Binding TotalSaidas}" Style="{StaticResource ValorTotal}" AutomationProperties.Name="Total de saídas" />
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="SALDO" Style="{StaticResource RotuloTotal}" />
                        <TextBlock Text="{Binding Saldo}" AutomationProperties.Name="Saldo do período">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ValorTotal}">
                                    <Setter Property="Foreground" Value="{DynamicResource CorSucesso}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SaldoNegativo}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource CorPerigo}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Contagem}" Style="{StaticResource TextoApoio}" VerticalAlignment="Bottom" />
                </WrapPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Painel}" Padding="0" Visibility="{Binding SemPermissao, Converter={StaticResource BoolInverso}}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Linhas}" SelectedItem="{Binding Selecionada, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              BorderThickness="0" Background="Transparent" AutomationProperties.Name="Lista de entradas e saídas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data, Mode=OneWay}" Width="1*" MinWidth="90" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo, Mode=OneWay}" Width="0.8*" MinWidth="70" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao, Mode=OneWay}" Width="2.6*" MinWidth="140" />
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria, Mode=OneWay}" Width="1.5*" MinWidth="100" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding Valor, Mode=OneWay}" Width="1.3*" MinWidth="100" />
                            <DataGridTextColumn Header="Anexo" Binding="{Binding Anexos, Mode=OneWay}" Width="0.9*" MinWidth="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Nenhum lançamento neste período. Use o formulário ao lado para lançar uma entrada ou saída."
                               Style="{StaticResource TextoApoio}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextAlignment="Center"
                               Visibility="{Binding Vazio, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource FaixaAviso}" VerticalAlignment="Top" Visibility="{Binding SemPermissao, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Você não tem permissão para ver os valores financeiros. Peça a um gerente ou administrador." TextWrapping="Wrap" />
            </Border>

            <TextBlock Grid.Row="5" Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" AutomationProperties.Name="Mensagem das entradas e saídas" />
        </Grid>

        <!-- ===== Formulário e anexos ===== -->
        <Border Grid.Column="2" Style="{StaticResource Painel}" Visibility="{Binding SemPermissao, Converter={StaticResource BoolInverso}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Novo" Style="{StaticResource BotaoSecundario}" Padding="12,6" Command="{Binding NovoCommand}"
                                ToolTip="Limpar o formulário para um lançamento novo (Ctrl+N)" AutomationProperties.Name="Novo lançamento" />
                        <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource TituloSecao}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="O que aconteceu" Style="{StaticResource Rotulo}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Saída (paguei)" GroupName="tipoLancamento" IsChecked="{Binding FormEhSaida}" Margin="0,0,16,0"
                                     AutomationProperties.Name="Saída: dinheiro que saiu da empresa" />
                        <RadioButton Content="Entrada (recebi)" GroupName="tipoLancamento" IsChecked="{Binding FormEhEntrada}"
                                     AutomationProperties.Name="Entrada: dinheiro que entrou na empresa" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Data" Style="{StaticResource Rotulo}" />
                            <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding FormData}" AutomationProperties.Name="Data do lançamento" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valor (R$)" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding FormValorTexto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Valor do lançamento em reais" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Categoria" Style="{StaticResource Rotulo}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding CategoriasDoFormulario}" Text="{Binding FormCategoria, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Escolha uma da lista ou digite uma nova" AutomationProperties.Name="Categoria do lançamento" />

                    <TextBlock Text="Descrição" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding FormDescricao, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Descrição do lançamento" />

                    <TextBlock Text="Como foi pago ou recebido (opcional)" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding OpcoesForma}" DisplayMemberPath="Nome" SelectedItem="{Binding FormForma}"
                              AutomationProperties.Name="Forma de pagamento do lançamento" />

                    <TextBlock Text="Observação (opcional)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding FormObservacao, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44"
                             AutomationProperties.Name="Observação do lançamento" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Padding="18,8" Command="{Binding SalvarCommand}"
                                ToolTip="Salvar o lançamento (Ctrl+S)" AutomationProperties.Name="Salvar o lançamento" />
                        <Button Content="Excluir" Style="{StaticResource BotaoPerigo}" Padding="18,8" Margin="8,0,0,0" Command="{Binding ExcluirCommand}"
                                Visibility="{Binding EstaEditando, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Excluir o lançamento" />
                    </WrapPanel>

                    <Separator Margin="0,18,0,12" />
                    <TextBlock Text="Foto ou documento" Style="{StaticResource TituloSecao}" />
                    <TextBlock Text="{Binding DicaAnexo}" Style="{StaticResource TextoApoio}" Margin="0,4,0,8" />
                    <Button Content="Escolher arquivo..." Style="{StaticResource BotaoSecundario}" Padding="14,8" HorizontalAlignment="Left"
                            IsEnabled="{Binding PodeAnexar}" Command="{Binding AnexarArquivoCommand}" AutomationProperties.Name="Escolher um arquivo para anexar" />

                    <ItemsControl ItemsSource="{Binding AnexosDoLancamento}" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}" />
                                        <TextBlock Text="{Binding Detalhe}" Style="{StaticResource TextoApoio}" />
                                        <TextBlock Text="{Binding Aviso}" Foreground="{DynamicResource CorPerigo}" FontSize="12" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="Abrir" Style="{StaticResource BotaoSecundario}" Padding="12,5"
                                                    Command="{Binding DataContext.AbrirAnexoCommand, RelativeSource={RelativeSource AncestorType={x:Type v:EntradasESaidasView}}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="Abrir o anexo" />
                                            <Button Content="Remover" Style="{StaticResource BotaoSecundario}" Padding="12,5" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoverAnexoCommand, RelativeSource={RelativeSource AncestorType={x:Type v:EntradasESaidasView}}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="Remover o anexo" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
