<UserControl x:Class="NexusLS.App.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Número de destaque dos cartões menores. -->
        <Style x:Key="NumeroGrande" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TamDestaque}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="RotuloIndicador" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TamRotulo}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
        </Style>

        <!-- Bolinha de situação: verde = tudo certo, laranja = precisa de atenção (Tag verdadeiro). -->
        <Style x:Key="PontoSituacao" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{StaticResource CorPositivo}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource CorAtencaoBorda}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Uma linha de "atenção": bolinha + texto + botão; fio fino embaixo. -->
        <Style x:Key="LinhaAtencao" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CorLinhaGrade}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,14" />
        </Style>
        <Style x:Key="ValorAtencao" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RotuloAtencao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TamPequeno}" />
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
        </Style>

        <!-- Atalho: ladrilho com ícone, nome e dica. -->
        <Style x:Key="BotaoAtalho" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="IconeAtalho" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch" Margin="0,0,16,24">

            <!-- Cabeçalho: saudação, data e a ação principal do dia -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Saudacao}" Style="{StaticResource TituloTela}" />
                    <TextBlock Text="{Binding DataTexto}" Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Atualizar" Style="{StaticResource BotaoFantasma}" Command="{Binding AtualizarCommand}" />
                    <Button Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0" Padding="20,10"
                            AutomationProperties.Name="Abrir o PDV" Command="{Binding AbrirPdvCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Cart24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Abrir o PDV (F1)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" Margin="0,8,0,0" />

            <!-- Indicadores do dia: vendas em destaque (azul), ticket médio e caixa -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource CorPrimaria}" CornerRadius="{StaticResource RaioGrande}" Padding="24,20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Vendas de hoje" FontSize="{StaticResource TamRotulo}" FontWeight="SemiBold"
                                   Foreground="{StaticResource CorSobrePrimariaSuave}" />
                        <TextBlock Text="{Binding VendasHojeTexto}" FontSize="40" FontWeight="SemiBold" Margin="0,8,0,6"
                                   Foreground="{StaticResource CorSobrePrimaria}" AutomationProperties.Name="Vendas de hoje" />
                        <TextBlock Text="{Binding VendasHojeDetalhe}" Foreground="{StaticResource CorSobrePrimaria}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ComparacaoOntemTexto}" Foreground="{StaticResource CorSobrePrimariaSuave}"
                                   FontSize="{StaticResource TamPequeno}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Painel}" Padding="22,20" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="Ticket médio" Style="{StaticResource RotuloIndicador}" />
                        <TextBlock Text="{Binding TicketMedioTexto}" Style="{StaticResource NumeroGrande}" Margin="0,12,0,6" />
                        <TextBlock Text="valor médio por venda, hoje" Style="{StaticResource TextoApoio}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="22,20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Caixa" Style="{StaticResource RotuloIndicador}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,14">
                            <Ellipse Style="{StaticResource PontoSituacao}" Tag="{Binding CaixaFechado}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding CaixaTexto}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}"
                                       AutomationProperties.Name="Situação do caixa" />
                        </StackPanel>
                        <Button Content="Fechamento do caixa" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Left"
                                Command="{Binding AbrirFechamentoCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Atenção e agenda -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>

                <Border Style="{StaticResource Painel}" Margin="0,0,8,0" Padding="22,20,22,6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Precisa de atenção" Style="{StaticResource TituloSecao}" />
                            <TextBlock Text="Tudo em dia" HorizontalAlignment="Right" Foreground="{StaticResource CorPositivo}" FontWeight="SemiBold"
                                       Visibility="{Binding TudoEmDia, Converter={StaticResource BoolVis}}" />
                        </Grid>
                        <Border Height="12" />

                        <Border Style="{StaticResource LinhaAtencao}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource PontoSituacao}" Tag="{Binding EstoqueBaixoAlerta}" VerticalAlignment="Top" Margin="0,22,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Estoque" Style="{StaticResource RotuloAtencao}" />
                                    <TextBlock Text="{Binding EstoqueBaixoTexto}" Style="{StaticResource ValorAtencao}" />
                                    <ItemsControl ItemsSource="{Binding EstoquesBaixos}" Margin="0,6,0,0"
                                                  Visibility="{Binding EstoqueBaixoAlerta, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource TextoApoio}" Margin="0,2" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Ver estoque" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Top" Command="{Binding AbrirEstoqueCommand}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LinhaAtencao}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource PontoSituacao}" Tag="{Binding DividaAlerta}" VerticalAlignment="Top" Margin="0,22,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Clientes devendo (a prazo)" Style="{StaticResource RotuloAtencao}" />
                                    <TextBlock Text="{Binding DividaTexto}" Style="{StaticResource ValorAtencao}" />
                                    <TextBlock Text="{Binding DividaDetalhe}" Style="{StaticResource TextoApoio}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Ver clientes" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Top" Command="{Binding AbrirClientesCommand}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource LinhaAtencao}" Visibility="{Binding TemBackup, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource PontoSituacao}" Tag="{Binding BackupAlerta}" VerticalAlignment="Top" Margin="0,22,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Backup dos dados" Style="{StaticResource RotuloAtencao}" />
                                    <TextBlock Text="{Binding BackupTexto}" Style="{StaticResource ValorAtencao}" AutomationProperties.Name="Situação do backup" />
                                    <TextBlock Text="{Binding BackupDetalhe}" Style="{StaticResource TextoApoio}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Configurações" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Top" Command="{Binding AbrirConfiguracoesCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Painel}" Padding="22,20" Margin="8,0,0,0" Visibility="{Binding TemAgenda, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Agenda de hoje" Style="{StaticResource TituloSecao}" VerticalAlignment="Center" />
                            <Button Content="Abrir agenda" Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Right" Padding="8,4"
                                    Foreground="{StaticResource CorPrimaria}" Command="{Binding AbrirAgendaCommand}" />
                        </Grid>
                        <TextBlock Text="Nenhum compromisso para hoje." Style="{StaticResource TextoApoio}" Margin="0,14,0,0"
                                   Visibility="{Binding AgendaVazia, Converter={StaticResource BoolVis}}" />
                        <ItemsControl ItemsSource="{Binding AgendaHoje}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CorCabecalho}" CornerRadius="{StaticResource RaioPequeno}" Padding="12,9" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Atalhos -->
            <TextBlock Text="Ir para" Style="{StaticResource TituloSecao}" Margin="0,26,0,12" />
            <ItemsControl ItemsSource="{Binding Atalhos}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource BotaoAtalho}" Command="{Binding Abrir}" AutomationProperties.Name="{Binding Nome}">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource CorSelecaoSuave}" CornerRadius="{StaticResource RaioMedio}" Width="42" Height="42" Margin="0,0,14,0">
                                    <ui:SymbolIcon Symbol="{Binding Icone}" Style="{StaticResource IconeAtalho}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Dica}" Style="{StaticResource TextoApoio}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
