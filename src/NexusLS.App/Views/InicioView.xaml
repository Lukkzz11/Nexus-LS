<UserControl x:Class="NexusLS.App.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Tela limpa: sem quadros. Cada informação é uma linha com um fio fino embaixo. -->
        <Style x:Key="Linha" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
        <Style x:Key="RotuloLinha" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetalheLinha" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Valor que fica laranja quando o Tag (o alerta) é verdadeiro -->
        <Style x:Key="ValorLinha" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="#B45309" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LinkDiscreto" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="720" HorizontalAlignment="Left">
            <TextBlock Text="Início" Style="{StaticResource TituloTela}" />
            <TextBlock Text="{Binding DataTexto}" Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Abrir o PDV (F1)" Style="{StaticResource BotaoPrimario}"
                        AutomationProperties.Name="Abrir o PDV" Command="{Binding AbrirPdvCommand}" />
                <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding AtualizarCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" Margin="0,0,0,8" />

            <!-- Hoje -->
            <Border Style="{StaticResource Linha}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Vendas de hoje" Style="{StaticResource RotuloLinha}" />
                        <TextBlock Text="{Binding VendasHojeDetalhe}" Style="{StaticResource DetalheLinha}" />
                        <TextBlock Text="{Binding ComparacaoOntemTexto}" Style="{StaticResource DetalheLinha}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding VendasHojeTexto}" Style="{StaticResource ValorLinha}" AutomationProperties.Name="Vendas de hoje" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Linha}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Ticket médio de hoje" Style="{StaticResource RotuloLinha}" />
                    <TextBlock Grid.Column="1" Text="{Binding TicketMedioTexto}" Style="{StaticResource ValorLinha}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Linha}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Caixa" Style="{StaticResource RotuloLinha}" />
                    <TextBlock Grid.Column="1" Text="{Binding CaixaTexto}" Style="{StaticResource ValorLinha}" AutomationProperties.Name="Situação do caixa" />
                    <Button Grid.Column="2" Content="Fechamento" Style="{StaticResource LinkDiscreto}" Command="{Binding AbrirFechamentoCommand}" />
                </Grid>
            </Border>

            <!-- Atenção -->
            <Border Style="{StaticResource Linha}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Estoque" Style="{StaticResource RotuloLinha}" />
                    <TextBlock Grid.Column="1" Text="{Binding EstoqueBaixoTexto}" Style="{StaticResource ValorLinha}" Tag="{Binding EstoqueBaixoAlerta}" />
                    <Button Grid.Column="2" Content="Ver" Style="{StaticResource LinkDiscreto}" Command="{Binding AbrirEstoqueCommand}" />
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding EstoquesBaixos}" Margin="0,6,0,6"
                          Visibility="{Binding EstoqueBaixoAlerta, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource DetalheLinha}" Margin="12,2,0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Linha}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Clientes devendo (a prazo)" Style="{StaticResource RotuloLinha}" />
                        <TextBlock Text="{Binding DividaDetalhe}" Style="{StaticResource DetalheLinha}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DividaTexto}" Style="{StaticResource ValorLinha}" Tag="{Binding DividaAlerta}" />
                    <Button Grid.Column="2" Content="Ver" Style="{StaticResource LinkDiscreto}" Command="{Binding AbrirClientesCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Linha}" Visibility="{Binding TemBackup, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Backup dos dados" Style="{StaticResource RotuloLinha}" />
                        <TextBlock Text="{Binding BackupDetalhe}" Style="{StaticResource DetalheLinha}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding BackupTexto}" Style="{StaticResource ValorLinha}" Tag="{Binding BackupAlerta}"
                               AutomationProperties.Name="Situação do backup" />
                    <Button Grid.Column="2" Content="Abrir" Style="{StaticResource LinkDiscreto}" Command="{Binding AbrirConfiguracoesCommand}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
