<UserControl x:Class="NexusLS.App.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SalvarCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Formulário ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Configurações" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Dados da loja (aparecem no cupom)" FontSize="18" FontWeight="SemiBold" />

                        <TextBlock Text="Nome da loja" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding NomeLoja, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="CNPJ ou CPF" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Documento, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Endereço" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Telefone" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Nome do operador (aparece nas vendas e cancelamentos)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding NomeOperador, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Mensagem no rodapé do cupom" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding RodapeCupom, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Impressão do cupom" FontSize="18" FontWeight="SemiBold" />

                        <TextBlock Text="Impressora" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Impressoras}" SelectedItem="{Binding ImpressoraSelecionada}" Padding="8,7" />

                        <TextBlock Text="Largura do papel" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Larguras}" DisplayMemberPath="Texto"
                                  SelectedItem="{Binding LarguraSelecionada}" Padding="8,7" />

                        <CheckBox Content="Imprimir o cupom sozinho ao finalizar a venda" Margin="0,16,0,0"
                                  IsChecked="{Binding ImprimirAoFinalizar}" />
                        <CheckBox Content="Perguntar o tamanho no PDV (desligado: vai direto à quantidade quando só há uma opção)"
                                  Margin="0,10,0,0" IsChecked="{Binding PerguntarTamanho}" />

                        <CheckBox Content="Abrir o programa direto no PDV (desligado: abre na tela Início; o PDV fica no F1)"
                                  Margin="0,10,0,0" IsChecked="{Binding AbrirNoPdv}" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Salvar (Ctrl+S)" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding SalvarCommand}" />
                            <Button Content="Imprimir cupom de teste" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                    Command="{Binding ImprimirTesteCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                    </StackPanel>
                </Border>
                            <!-- ===== Backup ===== -->
                <Border Style="{StaticResource Painel}" Margin="0,16,0,24"
                        Visibility="{Binding TemBackup, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Backup dos dados" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UltimoBackupTexto}" Foreground="{StaticResource CorTextoSuave}" Margin="0,4,0,0" />

                        <TextBlock Text="Pasta dos backups" Style="{StaticResource Rotulo}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PastaBackup, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Escolher..." Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                    Command="{Binding EscolherPastaBackupCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding AvisoBackup}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="Backup automático" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding IntervalosBackup}" DisplayMemberPath="Texto"
                                  SelectedItem="{Binding IntervaloSelecionado}" Padding="8,7" />

                        <TextBlock Text="Quantos backups guardar (os mais antigos são apagados)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding ManterTexto, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Fazer backup agora" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding FazerBackupAgoraCommand}" />
                            <Button Content="Salvar preferências" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                    Command="{Binding SalvarBackupCommand}" />
                        </StackPanel>

                        <TextBlock Text="Backups guardados" Style="{StaticResource Rotulo}" />
                        <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding BackupSelecionado}"
                                 DisplayMemberPath="Texto" MaxHeight="180" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Restaurar o selecionado" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding RestaurarCommand}" />
                        </StackPanel>
                        <TextBlock Text="Para restaurar um arquivo de outra pasta, deixe nenhum item selecionado e clique em Restaurar."
                                   Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="{Binding MensagemBackup}" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#15803D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemBackupEhErro}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ===== Apagar dados (só administrador) ===== -->
                <Border Style="{StaticResource Painel}" Margin="0,0,0,24"
                        Visibility="{Binding TemLimparDados, Converter={StaticResource BoolVis}}">
                    <StackPanel DataContext="{Binding LimparDados}">
                        <TextBlock Text="Apagar dados" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Para começar do zero ou tirar os dados de teste. Antes de apagar, o programa faz um backup de segurança (que nunca é apagado sozinho). Funcionários, configurações e a trilha de atividades nunca são apagados." />

                        <RadioButton GroupName="NivelLimpeza" Margin="0,12,0,0" IsChecked="True"
                                     Content="Só o movimento (recomendado)" AutomationProperties.Name="Apagar só o movimento" />
                        <TextBlock Text="{Binding DescricaoMovimento}" Foreground="{StaticResource CorTextoSuave}" FontSize="13"
                                   TextWrapping="Wrap" Margin="26,0,0,6" />
                        <RadioButton GroupName="NivelLimpeza" IsChecked="{Binding ApagarTudo}"
                                     Content="Tudo da loja" AutomationProperties.Name="Apagar tudo da loja" />
                        <TextBlock Text="{Binding DescricaoTudo}" Foreground="{StaticResource CorTextoSuave}" FontSize="13"
                                   TextWrapping="Wrap" Margin="26,0,0,6" />

                        <TextBlock Text="Para confirmar, digite APAGAR" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Confirmacao, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Confirmação para apagar" />

                        <Button Content="Apagar dados" Style="{StaticResource BotaoSecundario}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding ApagarCommand}" />

                        <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#15803D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Prévia do cupom ===== -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="Prévia do cupom" FontSize="18" FontWeight="SemiBold" Margin="0,48,0,10" />
            <Border Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="4"
                    Padding="20" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Previa}" FontFamily="Consolas" FontSize="14"
                           Foreground="{StaticResource CorTexto}" />
            </Border>
            <TextBlock Text="Esta é uma venda de exemplo. O cupom real tem os itens e totais da venda."
                       Foreground="{StaticResource CorTextoSuave}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
