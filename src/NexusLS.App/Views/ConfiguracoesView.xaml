<UserControl x:Class="NexusLS.App.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:NexusLS.App.Views">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SalvarCommand}" />
    </UserControl.InputBindings>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Configurações" Style="{StaticResource TituloTela}" Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu lateral das configurações: montado no código (ConfiguracoesView.xaml.cs), agrupado por assunto -->
            <Border Style="{StaticResource PainelLateral}" Margin="0,0,12,0" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MenuConfig" Margin="0,8,0,12" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer x:Name="PgCaixa" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Border Style="{StaticResource Painel}" Margin="0,0,0,16" Visibility="{Binding TemSeguranca, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Regras do caixa" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Quando a regra pede um gerente, aparece a tela de PIN e só um gerente ou administrador libera. Cada autorização fica registrada em Atividades. Sem funcionários cadastrados, nada é pedido." />
                                <TextBlock Text="Retirada (sangria ou despesa) acima de quanto precisa de gerente? (R$, em branco = sem limite)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding SangriaMaximaTexto, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Sangria máxima sem gerente" />
                                <CheckBox Margin="0,16,0,0" IsChecked="{Binding PinGerenteParaCancelar}">
                                    <TextBlock Text="Cancelar uma venda exige o PIN de um gerente (quando quem cancela não é gerente nem administrador)" TextWrapping="Wrap" />
                                </CheckBox>
                                <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                        Command="{Binding SalvarCaixaRegrasCommand}" />
                                <TextBlock Text="{Binding MensagemCaixaRegras}" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MensagemCaixaRegrasEhErro}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Painel}">
                            <StackPanel>
                                <TextBlock Text="Abertura do caixa" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="O Nexus já exige o caixa aberto, e do dia de hoje, para finalizar uma venda. O troco inicial padrão fica em Parâmetros." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PgCrediario" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Border Style="{StaticResource Painel}" Margin="0,0,0,16" Visibility="{Binding TemSeguranca, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Atraso e limite de crédito" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Valem para as vendas a prazo. A multa e os juros aparecem na ficha do cliente com título vencido, como valor a cobrar por fora; eles não mudam a dívida registrada." />
                                <TextBlock Text="Multa por atraso (% do saldo vencido, cobrada uma vez)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding MultaAtrasoTexto, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Multa por atraso" />
                                <TextBlock Text="Juros ao mês (% do saldo vencido, contados por dia de atraso)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding JurosMesTexto, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Juros ao mês" />
                                <TextBlock Text="Limite de crédito dos clientes novos (R$, em branco = sem limite)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding LimiteCreditoPadraoTexto, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Limite de crédito padrão" />
                                <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                        Command="{Binding SalvarCrediarioCommand}" />
                                <TextBlock Text="{Binding MensagemCrediario}" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MensagemCrediarioEhErro}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Painel}">
                            <StackPanel>
                                <TextBlock Text="Como funciona hoje" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="O prazo da venda a prazo é de 30 dias (dá para ajustar o vencimento de cada título na ficha do cliente). O limite de cada cliente fica no cadastro dele, e a venda é barrada quando passa dele. Os títulos vencidos aparecem destacados na tela Início." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PgComissoes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Border Style="{StaticResource Painel}" Margin="0,0,0,16" Visibility="{Binding TemComissoes, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Regra da comissão" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="A comissão é um percentual da venda líquida de cada vendedor (o nome que aparece nas vendas). Quem não tem percentual próprio usa o padrão." />
                                <TextBlock Text="Comissão padrão (% da venda líquida, 0 = não paga)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding ComissaoPadraoTexto, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Comissão padrão" />
                                <CheckBox Margin="0,14,0,0" IsChecked="{Binding ComissaoDescontaDevolucoes}">
                                    <TextBlock Text="Descontar da comissão o que o vendedor teve devolvido no período" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Text="Percentual de cada vendedor (em branco = usa o padrão)" Style="{StaticResource Rotulo}" Margin="0,16,0,4" />
                                <ItemsControl ItemsSource="{Binding VendedoresComissao}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding PercentualTexto, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Percentual do vendedor" />
                                                <TextBlock Grid.Column="2" Text="%" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Salvar regra" Style="{StaticResource BotaoPrimario}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                        Command="{Binding SalvarComissaoCommand}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Painel}" Visibility="{Binding TemComissoes, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Fechamento do mês" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Mostra quanto cada vendedor tem de comissão no mês, pelas regras acima. Só calcula: o pagamento você faz por fora." />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ComboBox ItemsSource="{Binding MesesComissao}" DisplayMemberPath="Texto" SelectedItem="{Binding MesSelecionado}"
                                              Width="220" Padding="8,7" AutomationProperties.Name="Mês" />
                                    <Button Content="Calcular" Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0" Command="{Binding CalcularComissaoCommand}" />
                                    <Button Content="Copiar para planilha" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding CopiarComissaoCommand}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding TemResultadoComissao, Converter={StaticResource BoolVis}}" Margin="0,14,0,0">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vendedor" Style="{StaticResource Rotulo}" />
                                        <TextBlock Grid.Column="1" Text="Vendas" Style="{StaticResource Rotulo}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Vendido" Style="{StaticResource Rotulo}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="Devolvido" Style="{StaticResource Rotulo}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="%" Style="{StaticResource Rotulo}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="Comissão" Style="{StaticResource Rotulo}" TextAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ResultadoComissao}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" /><ColumnDefinition Width="60" /><ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Vendedor}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Vendas}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Vendido}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Devolvido}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Percentual}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Comissao}" TextAlignment="Right" FontWeight="SemiBold" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ResumoComissao}" Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding MensagemComissao}" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MensagemComissaoEhErro}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PgEstoque" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Border Style="{StaticResource Painel}" Margin="0,0,0,16" Visibility="{Binding TemEstoqueConfig, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Aviso de estoque baixo" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Produto fica abaixo do mínimo quando o estoque atual é menor que o estoque mínimo dele. O mínimo de cada produto é definido no cadastro; o valor sugerido para produtos novos fica em Parâmetros." />
                                <CheckBox Margin="0,14,0,0" IsChecked="{Binding AvisarEstoqueBaixo}">
                                    <TextBlock Text="Avisar ao abrir o Nexus quando houver produto abaixo do mínimo" TextWrapping="Wrap" />
                                </CheckBox>
                                <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                        Command="{Binding SalvarEstoqueCommand}" />
                                <TextBlock Text="{Binding MensagemEstoque}" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MensagemEstoqueEhErro}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Painel}" Visibility="{Binding TemEstoqueConfig, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Situação agora" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ResumoEstoqueBaixo}" Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding ListaEstoqueBaixo}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Margin="0,2" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                        Command="{Binding AtualizarEstoqueBaixoCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PgNotificacoes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Border Style="{StaticResource Painel}" Visibility="{Binding TemSeguranca, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Avisos ao abrir o Nexus" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Os avisos aparecem juntos, numa janela só, quando o Nexus abre. O aviso de estoque baixo é ligado em Estoque e produtos. Backup que falhou e nova versão já avisam sozinhos." />
                                <CheckBox Margin="0,14,0,0" IsChecked="{Binding AvisarContas}">
                                    <TextBlock Text="Avisar das contas a pagar vencidas e a vencer (para quem tem acesso ao Financeiro)" TextWrapping="Wrap" />
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Avisar as que vencem em até" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding DiasContasTexto, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0" AutomationProperties.Name="Dias de aviso das contas" />
                                    <TextBlock Text="dia(s)  (0 = só hoje)" VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox Margin="0,18,0,0" IsChecked="{Binding AvisarBackupAtrasado}">
                                    <TextBlock Text="Avisar quando o backup estiver atrasado" TextWrapping="Wrap" />
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Considerar atrasado depois de" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding DiasBackupTexto, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0" AutomationProperties.Name="Dias do backup atrasado" />
                                    <TextBlock Text="dia(s) sem backup" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                        Command="{Binding SalvarNotificacoesCommand}" />
                                <TextBlock Text="{Binding MensagemNotificacoes}" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MensagemNotificacoesEhErro}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PgEtiquetas" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Border Style="{StaticResource Painel}" Visibility="{Binding TemSeguranca, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Padrão da tela de Etiquetas" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="É o que a tela de Etiquetas já abre escolhido. Dá para trocar na hora, sem mexer aqui. A impressora e o desenho da etiqueta ficam no Nexus BarTender." />
                                <TextBlock Text="Formato do papel" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                                <ComboBox ItemsSource="{Binding FormatosEtiqueta}" SelectedItem="{Binding FormatoEtiquetaPadrao}"
                                          Width="360" HorizontalAlignment="Left" Padding="8,7" AutomationProperties.Name="Formato do papel" />
                                <CheckBox Margin="0,14,0,0" IsChecked="{Binding EtiquetaPrecoAtacado}">
                                    <TextBlock Text="Já abrir com o preço de atacado marcado" TextWrapping="Wrap" />
                                </CheckBox>
                                <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                        Command="{Binding SalvarEtiquetasCommand}" />
                                <TextBlock Text="{Binding MensagemEtiquetas}" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MensagemEtiquetasEhErro}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PgIntegracoes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Border Style="{StaticResource Painel}" Margin="0,0,0,16" Visibility="{Binding TemIntegracoes, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Serviços ligados ao Nexus" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Só mostra a situação. Cada serviço é configurado onde sempre foi: Google em Backup, Mercado Pago em Pagamentos, nuvem e ERP na tela de conexão." />
                                <ItemsControl ItemsSource="{Binding Integracoes}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="300" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Situacao}" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                        Command="{Binding AtualizarIntegracoesCommand}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Painel}" Visibility="{Binding TemIntegracoes, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Exportar para o contador" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Gera 3 planilhas do mês (abrem direto no Excel): vendas, itens vendidos e contas a pagar e a receber. As canceladas vêm marcadas na coluna Situação. As contas entram pela data de vencimento." />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ComboBox ItemsSource="{Binding MesesContador}" DisplayMemberPath="Texto" SelectedItem="{Binding MesContador}"
                                              Width="220" Padding="8,7" AutomationProperties.Name="Mês" />
                                    <Button Content="Exportar..." Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0" Command="{Binding ExportarContadorCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding MensagemIntegracoes}" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MensagemIntegracoesEhErro}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PgSeguranca" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Border Style="{StaticResource Painel}" Margin="0,0,0,16" Visibility="{Binding TemSeguranca, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Bloqueio e acesso" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Vale para este computador. Só funciona quando há funcionários cadastrados (sem eles, o programa abre direto, como sempre)." />
                                <TextBlock Text="Pedir o PIN de novo depois de quantos minutos parado? (0 = nunca)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding MinutosInatividadeTexto, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"
                                         AutomationProperties.Name="Minutos de inatividade" />
