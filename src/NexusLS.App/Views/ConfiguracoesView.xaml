<UserControl x:Class="NexusLS.App.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:NexusLS.App.Views">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SalvarCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Configurações" Style="{StaticResource TituloTela}" Margin="0,0,0,10" />

        <TabControl Grid.Row="1" Padding="0">
            <TabItem Header="Loja e cupom">
                <!-- Em tela larga: dados da loja, impressão e prévia lado a lado; em tela estreita os cartões descem -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <v:GradeDeCartoes LarguraMinima="380" MaximoColunas="3" Margin="0,0,0,24">
                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Dados da loja (aparecem no cupom)" FontSize="18" FontWeight="SemiBold" />

                        <TextBlock Text="Nome fantasia" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding NomeLoja, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Razão social" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding RazaoSocial, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CNPJ ou CPF" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Documento, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Inscrição estadual" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding InscricaoEstadual, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Endereço" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Cidade e UF" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding CidadeUf, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="E-mail da loja" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Chave Pix da loja" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding ChavePix, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Telefone" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Nome do operador (aparece nas vendas e cancelamentos)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding NomeOperador, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Mensagem no rodapé do cupom" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding RodapeCupom, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Impressão do cupom" FontSize="18" FontWeight="SemiBold" />

                        <TextBlock Text="Impressora" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Impressoras}" SelectedItem="{Binding ImpressoraSelecionada}" Padding="8,7" />

                        <TextBlock Text="Largura do papel" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Larguras}" DisplayMemberPath="Texto"
                                  SelectedItem="{Binding LarguraSelecionada}" Padding="8,7" />

                        <TextBlock Text="O que mostrar no cupom" Style="{StaticResource Rotulo}" Margin="0,16,0,0" />
                        <WrapPanel>
                            <CheckBox Content="Razão social" IsChecked="{Binding CupomMostrarRazaoSocial}" Margin="0,4,18,0" />
                            <CheckBox Content="CNPJ e inscrição" IsChecked="{Binding CupomMostrarDocumento}" Margin="0,4,18,0" />
                            <CheckBox Content="Endereço e cidade" IsChecked="{Binding CupomMostrarEndereco}" Margin="0,4,18,0" />
                            <CheckBox Content="Telefone" IsChecked="{Binding CupomMostrarTelefone}" Margin="0,4,18,0" />
                            <CheckBox Content="Chave Pix no rodapé" IsChecked="{Binding CupomMostrarPix}" Margin="0,4,18,0" />
                        </WrapPanel>
                        <TextBlock Text="Linhas em branco no fim (para o corte da impressora)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding CupomLinhasFinais, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />

                        <CheckBox Margin="0,16,0,0"
                                  IsChecked="{Binding ImprimirAoFinalizar}">
                            <TextBlock Text="Imprimir o cupom sozinho ao finalizar a venda" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding PerguntarTamanho}">
                            <TextBlock Text="Perguntar o tamanho no PDV (desligado: vai direto à quantidade quando só há uma opção)" TextWrapping="Wrap" />
                        </CheckBox>

                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding AbrirNoPdv}">
                            <TextBlock Text="Abrir o programa direto no PDV (desligado: abre na tela Início; o PDV fica no F1)" TextWrapping="Wrap" />
                        </CheckBox>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Salvar (Ctrl+S)" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding SalvarCommand}" />
                            <Button Content="Imprimir cupom de teste" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                    Command="{Binding ImprimirTesteCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="Prévia do cupom" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="4"
                            Padding="20" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Previa}" FontFamily="Consolas" FontSize="14"
                                   Foreground="{StaticResource CorTexto}" />
                    </Border>
                    <TextBlock Text="Esta é uma venda de exemplo. O cupom real tem os itens e totais da venda."
                               Foreground="{StaticResource CorTextoSuave}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
                    </v:GradeDeCartoes>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Vendas e aparência">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <v:GradeDeCartoes LarguraMinima="380" MaximoColunas="2" Margin="0,0,0,24">

                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Aparência" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Tamanho das telas" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Zooms}" DisplayMemberPath="Texto" SelectedItem="{Binding ZoomSelecionado}"
                                  Padding="8,7" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Tamanho das telas" />
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Aumenta ou diminui o conteúdo das telas (o menu lateral não muda). Vale na hora e fica guardado neste computador." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Vendas" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Desconto sugerido por peça na Venda Cliente (R$)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding DescontoPorPeca, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Desconto por peça" />
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Ao fechar uma venda para um cliente de atacado, a tela de desconto já abre com este valor vezes a quantidade de peças. Você pode mudar na hora." />
                        <Button Content="Salvar preferências" Style="{StaticResource BotaoPrimario}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Command="{Binding SalvarPreferenciasCommand}" />
                        <TextBlock Text="{Binding MensagemPreferencias}" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemPreferenciasEhErro}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Perguntar o tamanho, imprimir ao finalizar e abrir no PDV ficam na aba Loja e cupom." />
                    </StackPanel>
                </Border>

                    </v:GradeDeCartoes>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Parâmetros">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <Border Style="{StaticResource Painel}" Margin="0,0,0,24" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Parâmetros da loja" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Valores que o programa já sugere no dia a dia. Você sempre pode mudar na hora." />

                            <!-- os três parâmetros lado a lado em tela larga, um embaixo do outro em tela estreita -->
                            <v:GradeDeCartoes LarguraMinima="300" MaximoColunas="3" Espaco="24">
                                <StackPanel>
                                    <TextBlock Text="Troco inicial padrão na abertura do caixa (R$)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding FundoTrocoPadrao, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"
                                             AutomationProperties.Name="Troco inicial padrão" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Estoque mínimo sugerido ao cadastrar um produto" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding EstoqueMinimoPadrao, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"
                                             AutomationProperties.Name="Estoque mínimo padrão" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Margem desejada sugerida no cadastro do produto (%)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding MargemPadrao, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"
                                             AutomationProperties.Name="Margem padrão" />
                                    <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Zero deixa o campo em branco." />
                                </StackPanel>
                            </v:GradeDeCartoes>

                            <Button Content="Salvar (Ctrl+S)" Style="{StaticResource BotaoPrimario}" Margin="0,18,0,0" HorizontalAlignment="Left"
                                    Command="{Binding SalvarCommand}" />
                            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <!-- backup local e Google Drive lado a lado em tela larga -->
                    <v:GradeDeCartoes LarguraMinima="420" MaximoColunas="2" Margin="0,0,0,24">
                <Border Style="{StaticResource Painel}"
                        Visibility="{Binding TemBackup, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Backup dos dados" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UltimoBackupTexto}" Foreground="{StaticResource CorTextoSuave}" Margin="0,4,0,0" />

                        <TextBlock Text="Pasta dos backups" Style="{StaticResource Rotulo}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PastaBackup, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Escolher..." Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                    Command="{Binding EscolherPastaBackupCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding AvisoBackup}" Foreground="{StaticResource CorAviso}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="Backup automático" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding IntervalosBackup}" DisplayMemberPath="Texto"
                                  SelectedItem="{Binding IntervaloSelecionado}" Padding="8,7" />

                        <TextBlock Text="Quantos backups guardar (os mais antigos são apagados)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding ManterTexto, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Fazer backup agora" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding FazerBackupAgoraCommand}" />
                            <Button Content="Salvar preferências" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                    Command="{Binding SalvarBackupCommand}" />
                        </StackPanel>

                        <TextBlock Text="Backups guardados" Style="{StaticResource Rotulo}" />
                        <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding BackupSelecionado}"
                                 DisplayMemberPath="Texto" MaxHeight="180" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Restaurar o selecionado" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding RestaurarCommand}" />
                        </StackPanel>
                        <TextBlock Text="Para restaurar um arquivo de outra pasta, deixe nenhum item selecionado e clique em Restaurar."
                                   Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="{Binding MensagemBackup}" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemBackupEhErro}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                    
                        <Border Style="{StaticResource Painel}" Visibility="{Binding TemGoogle, Converter={StaticResource BoolVis}}">
                            <StackPanel IsEnabled="{Binding GoogleOcupado, Converter={StaticResource BoolInverso}}">
                                <TextBlock Text="Google Drive" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding GoogleSituacao}" Foreground="{StaticResource CorTextoSuave}" Margin="0,4,0,0" />
                                <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Envia uma cópia do backup para a pasta &quot;Nexus LS Backups&quot; do seu Drive. O programa só enxerga os arquivos que ele mesmo criou. Você precisa criar um acesso (Client ID e Client Secret, tipo &quot;App para computador&quot;) no Google Cloud, com a Google Drive API ativada; o passo a passo está no manual." />

                                <TextBlock Text="Client ID" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Client ID do Google" />
                                <TextBlock Text="Client Secret (em branco mantém o que já está salvo)" Style="{StaticResource Rotulo}" />
                                <PasswordBox x:Name="CaixaSegredoGoogle" AutomationProperties.Name="Client Secret do Google" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Salvar credenciais" Style="{StaticResource BotaoSecundario}" Command="{Binding SalvarGoogleCommand}" />
                                    <Button Content="Conectar ao Google" Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0" Command="{Binding ConectarGoogleCommand}" />
                                    <Button Content="Desconectar" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding DesconectarGoogleCommand}" />
                                </StackPanel>
                                <Button Content="Enviar o backup selecionado (ou o mais recente) ao Drive" Style="{StaticResource BotaoSecundario}"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding EnviarBackupAoDriveCommand}" />

                                <TextBlock Text="{Binding MensagemGoogle}" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MensagemGoogleEhErro}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </v:GradeDeCartoes>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Sistema">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                    <!-- os cartões do sistema se repartem em até 3 colunas -->
                    <v:GradeDeCartoes LarguraMinima="400" MaximoColunas="3" Margin="0,0,0,24">

                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Este computador" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Pasta dos dados" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding PastaDeDados}" TextWrapping="Wrap" />
                        <TextBlock Text="Tamanho do banco de dados" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding TamanhoDoBanco}" />
                        <TextBlock Text="Licença" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding LicencaTexto}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Abrir a pasta dos dados" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,6"
                                    Command="{Binding AbrirPastaDeDadosCommand}" />
                            <Button Content="Abrir Atualizador / Ativador" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,6"
                                    Command="{Binding AbrirAtualizadorCommand}" />
                            <Button Content="Portal Web" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,6"
                                    Command="{Binding AbrirPortalWebCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}"
                        Visibility="{Binding TemAtualizacao, Converter={StaticResource BoolVis}}">
                    <StackPanel DataContext="{Binding Atualizacao}">
                        <TextBlock Text="Atualizações" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersaoAtualTexto}" Margin="0,4,0,0" AutomationProperties.Name="Versão do programa" />
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"
                                   Text="Ao abrir, o programa procura sozinho uma versão nova e só avisa; nada é instalado sem você clicar em Atualizar agora." />
                        <Button Content="Verificar atualizações" Style="{StaticResource BotaoSecundario}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Command="{Binding VerificarAgoraCommand}" />
                        <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Atalhos do teclado" FontSize="18" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Atalhos}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Tecla}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Funcao}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}"
                        Visibility="{Binding TemLimparDados, Converter={StaticResource BoolVis}}">
                    <StackPanel DataContext="{Binding LimparDados}">
                        <TextBlock Text="Apagar dados" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Para começar do zero ou tirar os dados de teste. Antes de apagar, o programa faz um backup de segurança (que nunca é apagado sozinho). Funcionários, configurações e a trilha de atividades nunca são apagados." />

                        <RadioButton GroupName="NivelLimpeza" Margin="0,12,0,0" IsChecked="True"
                                     Content="Só o movimento (recomendado)" AutomationProperties.Name="Apagar só o movimento" />
                        <TextBlock Text="{Binding DescricaoMovimento}" Foreground="{StaticResource CorTextoSuave}" FontSize="13"
                                   TextWrapping="Wrap" Margin="26,0,0,6" />
                        <RadioButton GroupName="NivelLimpeza" IsChecked="{Binding ApagarTudo}"
                                     Content="Tudo da loja" AutomationProperties.Name="Apagar tudo da loja" />
                        <TextBlock Text="{Binding DescricaoTudo}" Foreground="{StaticResource CorTextoSuave}" FontSize="13"
                                   TextWrapping="Wrap" Margin="26,0,0,6" />

                        <TextBlock Text="Para confirmar, digite APAGAR" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Confirmacao, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Confirmação para apagar" />

                        <Button Content="Apagar dados" Style="{StaticResource BotaoSecundario}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding ApagarCommand}" />

                        <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource CorPositivo}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CorNegativo}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                    </v:GradeDeCartoes>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
