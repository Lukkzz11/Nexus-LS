<UserControl x:Class="NexusLS.App.Views.EstoqueLojaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NovoCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SalvarCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- ===== Lista de produtos e histórico ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <TextBlock Text="Estoque da loja" Style="{StaticResource TituloTela}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Vender sem baixa (Todos)" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                            AutomationProperties.Name="Marcar todos para vender sem baixa" ToolTip="Ativa a opção 'Vender sem baixa' em todos os produtos cadastrados de uma só vez."
                            Command="{Binding AtivarVenderSemBaixaEmTodosCommand}" />
                    <Button Content="Adicionar sobra" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                            AutomationProperties.Name="Adicionar sobra" ToolTip="Cadastra uma peça que sobrou: continua sendo estoque e vende no PDV, só fica separada na lista de Sobras."
                            Command="{Binding AdicionarSobraCommand}" />
                    <Button Content="Exportar CSV" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                            AutomationProperties.Name="Exportar CSV" ToolTip="Salva o estoque inteiro (uma linha por tamanho) numa planilha CSV para o Excel."
                            Command="{Binding ExportarCsvCommand}" />
                    <Button Content="Importar CSV" Style="{StaticResource BotaoSecundario}"
                            AutomationProperties.Name="Importar CSV" ToolTip="Cadastra vários produtos de uma planilha (CSV). Produtos que já existem não são alterados."
                            IsEnabled="{Binding PodeImportar}" Command="{Binding ImportarCsvCommand}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Buscar por nome, referência ou código de barras" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <RadioButton Content="Todos" GroupName="VisaoEstoque" IsChecked="{Binding VisaoTodos, Mode=TwoWay}" Margin="0,0,8,0" />
                    <RadioButton Content="Estoque" GroupName="VisaoEstoque" IsChecked="{Binding VisaoEstoqueNormal, Mode=TwoWay}" Margin="0,0,8,0" />
                    <RadioButton Content="{Binding TextoSobras}" GroupName="VisaoEstoque" IsChecked="{Binding VisaoSobras, Mode=TwoWay}"
                                 AutomationProperties.Name="Sobras" />
                </StackPanel>
                <CheckBox Grid.Column="2" Content="Abaixo do mínimo" Margin="16,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding SomenteAbaixoDoMinimo}" />
                <CheckBox Grid.Column="3" Content="Mostrar inativos" Margin="16,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding MostrarInativos}" />
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource CorAlerta}" CornerRadius="6" Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding TemAlerta, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding TextoAlerta}" FontWeight="SemiBold" />
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Painel}" Padding="0">
                <DataGrid ItemsSource="{Binding Produtos}"
                          SelectedItem="{Binding Selecionado, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource CorLinhaGrade}" BorderThickness="0"
                          Background="{StaticResource CorPainel}" RowHeight="36">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Background" Value="{StaticResource CorPainel}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstoqueBaixo}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CorAlerta}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Ativo}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CorSelecao}" />
                                    <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras, Mode=OneWay}" Width="1*" MinWidth="62" />
                        <DataGridTextColumn Header="Ref." Binding="{Binding Referencia, Mode=OneWay}" Width="0.6*" MinWidth="46" />
                        <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria, Mode=OneWay}" Width="0.9*" MinWidth="80" />
                        <DataGridTextColumn Header="Produto" Binding="{Binding Nome, Mode=OneWay}" Width="4*" MinWidth="150" />
                        <DataGridTextColumn Header="Varejo" Width="1*" MinWidth="68" ElementStyle="{StaticResource ColunaNumero}"
                                            Binding="{Binding PrecoVendaCentavos, Mode=OneWay, Converter={StaticResource Centavos}}" />
                        <DataGridTextColumn Header="Atacado" Width="1*" MinWidth="72" ElementStyle="{StaticResource ColunaNumero}"
                                            Binding="{Binding PrecoAtacadoCentavos, Mode=OneWay, Converter={StaticResource Centavos}}" />
                        <DataGridTextColumn Header="Estoque" Binding="{Binding EstoqueAtual, Mode=OneWay}" Width="0.7*" MinWidth="60"
                                            ElementStyle="{StaticResource ColunaNumero}" />
                        <DataGridTextColumn Header="Mín." Binding="{Binding EstoqueMinimo, Mode=OneWay}" Width="0.6*" MinWidth="44"
                                            ElementStyle="{StaticResource ColunaNumero}" />
                        <DataGridTextColumn Header="Situação" Width="0.8*" MinWidth="64"
                                            Binding="{Binding Ativo, Mode=OneWay, Converter={StaticResource BoolTexto}, ConverterParameter='Ativo|Inativo'}" />
                        <DataGridTextColumn Header="Tipo" Width="0.6*" MinWidth="58"
                                            Binding="{Binding Sobra, Mode=OneWay, Converter={StaticResource BoolTexto}, ConverterParameter='Sobra|'}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Grid.Row="4" Text="Histórico do produto selecionado" FontWeight="SemiBold" Margin="0,14,0,6" />

            <Border Grid.Row="5" Style="{StaticResource Painel}" Padding="0">
                <DataGrid ItemsSource="{Binding Movimentacoes}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource CorLinhaGrade}" BorderThickness="0"
                          Background="{StaticResource CorPainel}" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Width="132"
                                            Binding="{Binding DataHora, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm'}" />
                        <DataGridTextColumn Header="Tipo" Width="96"
                                            Binding="{Binding Tipo, Mode=OneWay, Converter={StaticResource TipoMov}}" />
                        <DataGridTextColumn Header="Tam." Width="125" Binding="{Binding Tamanho, Mode=OneWay}" />
                        <DataGridTextColumn Header="Qtd." Width="52" ElementStyle="{StaticResource ColunaNumero}"
                                            Binding="{Binding Quantidade, Mode=OneWay, StringFormat='{}{0:+#;-#;0}'}" />
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo, Mode=OneWay}" Width="*" MinWidth="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ===== Painel do produto: duas abas ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl BorderThickness="0" Background="Transparent" Padding="0" FontSize="15">
                <!-- Aba 1: cadastro -->
                <TabItem Header="Produto" Padding="14,6">
                    <Border Style="{StaticResource Painel}" Margin="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Enter em qualquer campo do formulário salva (o evento de tecla "sobe" dos TextBox até aqui) -->
                                <StackPanel.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SalvarCommand}" />
                                </StackPanel.InputBindings>
                                <TextBlock Text="{Binding TituloFormulario}" FontSize="18" FontWeight="SemiBold" />

                                <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Visibility="{Binding FotoDisponivel, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="84" Height="84" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource CorBorda}" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding FotoImagem}" Stretch="UniformToFill" AutomationProperties.Name="Foto do produto" />
                                            <TextBlock Text="Sem foto" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource CorTextoSuave}" FontSize="12"
                                                       Visibility="{Binding TemFoto, Converter={StaticResource BoolInverso}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SituacaoFoto}" TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" FontSize="12" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Escolher foto..." Style="{StaticResource BotaoSecundario}" Padding="10,4" Command="{Binding TrocarFotoCommand}"
                                                    AutomationProperties.Name="Escolher foto do produto" />
                                            <Button Content="Remover" Style="{StaticResource BotaoSecundario}" Padding="10,4" Margin="6,0,0,0" Command="{Binding RemoverFotoCommand}"
                                                    Visibility="{Binding TemFoto, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Remover foto" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Código de barras" Style="{StaticResource Rotulo}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Content="Gerar" Style="{StaticResource BotaoSecundario}"
                                                    Margin="6,0,0,0" Padding="10,4" Command="{Binding GerarCodigoBarrasCommand}"
                                                    AutomationProperties.Name="Gerar código de barras"
                                                    ToolTip="Cria um código EAN-13 interno (começa com 2) que não repete" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Referência" Style="{StaticResource Rotulo}" />
                                        <TextBox Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Categoria" Style="{StaticResource Rotulo}" />
                                        <TextBox Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Categoria" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Código interno" Style="{StaticResource Rotulo}" />
                                        <TextBox Text="{Binding CodigoInterno, Mode=OneWay}" IsReadOnly="True"
                                                 ToolTip="Gerado pelo sistema (INT-000001...)" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Preço varejo (R$)" Style="{StaticResource Rotulo}" />
                                        <TextBox Text="{Binding PrecoVenda, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Preço atacado (R$)" Style="{StaticResource Rotulo}" />
                                        <TextBox Text="{Binding PrecoAtacado, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Vazio = vale o preço de varejo" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Preço de custo (R$)" Style="{StaticResource Rotulo}" />
                                        <TextBox Text="{Binding PrecoCusto, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Estoque mínimo" Style="{StaticResource Rotulo}" />
                                        <TextBox Text="{Binding EstoqueMinimo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Sobra da loja" Margin="0,10,0,0"
                                          IsChecked="{Binding Sobra}" AutomationProperties.Name="Sobra da loja"
                                          ToolTip="Peça que sobrou: segue como estoque normal (vende no PDV), só fica separada na lista de Sobras" />
                                <CheckBox Content="Vender sem baixa de estoque (serviço ou encomenda)" Margin="0,10,0,0"
                                          IsChecked="{Binding VenderSemBaixa}" AutomationProperties.Name="Vender sem baixa"
                                          ToolTip="O PDV não confere nem baixa o estoque deste produto" />

                                <!-- Calculadora de preço -->
                                <TextBlock Text="{Binding TextoMargem}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{StaticResource CorTextoSuave}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Margem desejada (%)" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Width="80" Text="{Binding MargemDesejada, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Margem desejada" />
                                    <Button Content="Calcular preço" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                            Padding="10,4" Command="{Binding CalcularPrecoCommand}"
                                            ToolTip="Calcula o preço de varejo a partir do custo e da margem" />
                                </StackPanel>

                                <!-- Produto novo: estoque inicial (vai para "Sem tamanho"; tamanhos têm a própria aba) -->
                                <StackPanel Visibility="{Binding EhNovo, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="Estoque inicial (sem tamanho)" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding EstoqueInicial, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <TextBlock Visibility="{Binding EstaEditando, Converter={StaticResource BoolVis}}"
                                           Style="{StaticResource Rotulo}" TextWrapping="Wrap"
                                           Text="O estoque só muda na aba &quot;Tamanhos e estoque&quot;, para sempre deixar registro." />

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Content="Salvar (Ctrl+S)" Style="{StaticResource BotaoPrimario}"
                                            Command="{Binding SalvarCommand}" />
                                    <Button Content="Novo (Ctrl+N)" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                            Command="{Binding NovoCommand}" />
                                </StackPanel>

                                <Button Content="{Binding TextoBotaoAtivo}" Style="{StaticResource BotaoPerigo}"
                                        Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Command="{Binding AlternarAtivoCommand}"
                                        Visibility="{Binding EstaEditando, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Aba 2: grade de tamanhos e ajuste de estoque -->
                <TabItem Header="Tamanhos e estoque" Padding="14,6">
                    <Border Style="{StaticResource Painel}" Margin="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Escolha ou salve um produto primeiro (aba &quot;Produto&quot;)."
                                           Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap"
                                           Visibility="{Binding EhNovo, Converter={StaticResource BoolVis}}" />

                                <StackPanel Visibility="{Binding EstaEditando, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding NomeEditando}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding EstoqueTotalTexto}" Foreground="{StaticResource CorTextoSuave}" />

                                    <TextBlock Text="Grade de tamanhos (clique no tamanho para ajustá-lo)" Style="{StaticResource Rotulo}" />
                                    <DataGrid ItemsSource="{Binding Grade}" SelectedItem="{Binding TamanhoSelecionado, Mode=TwoWay}"
                                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource CorLinhaGrade}" BorderBrush="{StaticResource CorBorda}"
                                              Background="{StaticResource CorPainel}" RowHeight="32" MaxHeight="190" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho, Mode=OneWay}" Width="*" />
                                            <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque, Mode=OneWay}" Width="90"
                                                                ElementStyle="{StaticResource ColunaNumero}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NovoTamanho, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Ex.: P, M, G, 38, 40. Enter adiciona.">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AdicionarTamanhoCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="Adicionar" Margin="8,0,0,0"
                                                Style="{StaticResource BotaoSecundario}" Command="{Binding AdicionarTamanhoCommand}" />
                                        <Button Grid.Column="2" Content="Remover" Margin="8,0,0,0"
                                                Style="{StaticResource BotaoSecundario}" Command="{Binding RemoverTamanhoCommand}"
                                                IsEnabled="{Binding PodeRemoverTamanho}" />
                                    </Grid>

                                    <Separator Margin="0,18" />

                                    <TextBlock Text="Ajuste de estoque" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TextoTamanhoAjuste}" Foreground="{StaticResource CorTextoSuave}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />

                                    <TextBlock Text="Tipo" Style="{StaticResource Rotulo}" />
                                    <ComboBox ItemsSource="{Binding Opcoes}" DisplayMemberPath="Nome"
                                              SelectedItem="{Binding TipoSelecionado}" Padding="8,7" />

                                    <TextBlock Text="{Binding RotuloQuantidade}" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AplicarAjusteCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <TextBlock Text="Motivo (obrigatório para perda e correção)" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AplicarAjusteCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <Button Content="Aplicar ajuste (Enter)" Style="{StaticResource BotaoPrimario}"
                                            Command="{Binding AplicarAjusteCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="1" Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
        </Grid>
    </Grid>
</UserControl>
