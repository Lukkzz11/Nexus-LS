<Window x:Class="NexusLS.App.Views.ComprovanteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:NexusLS.App.Views"
        Title="Editar comprovante de venda" Width="1180" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CorFundo}"
        Foreground="{StaticResource CorTexto}">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SalvarCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Editar comprovante de venda" Style="{StaticResource TituloTela}" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="400" MinWidth="360" /></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                <StackPanel Margin="0,0,0,12">
            <!-- Modelo do comprovante: escolher um já ajusta as opções abaixo (dá para mudar depois) -->
            <Border Style="{StaticResource Painel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Modelo do comprovante" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,8"
                               Text="Life: o estilo do ERP PDV Life. Compacto: um item por linha, enxuto. Comprovante de venda: com número, referência, total da nota, recebido, troco, garantia e assinatura." />
                    <ItemsControl ItemsSource="{Binding Modelos}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="ModeloCupom" Margin="0,0,8,0" Padding="4,8" Content="{Binding Nome}"
                                             IsChecked="{Binding Escolhido, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

                <Border Style="{StaticResource Painel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Comprovante de venda (cupom não fiscal 80 mm)" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Escolha o que aparece no comprovante. Ele sai sempre como CUPOM NÃO FISCAL: o programa não emite nota fiscal." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="4"
                                    Width="110" Height="64" Padding="4">
                                <Grid>
                                    <Image Source="{Binding LogoPrevia}" Stretch="Uniform" AutomationProperties.Name="Logo do cupom" />
                                    <TextBlock Text="Sem logo" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding TemLogo}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Button Content="Enviar logo" Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding EnviarLogoCommand}" />
                            <Button Content="Remover" Style="{StaticResource BotaoFantasma}" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding RemoverLogoCommand}" />
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Imagem PNG, JPG ou BMP. O programa reduz e imprime em tons de cinza no topo do cupom." />

                        <TextBlock Text="O que mostrar no cupom" Style="{StaticResource Rotulo}" Margin="0,16,0,6" />
                        <UniformGrid Columns="2">
                            <CheckBox Content="Logo da loja" IsChecked="{Binding CupomMostrarLogo}" Margin="0,3,12,3" />
                            <CheckBox Content="Razão social" IsChecked="{Binding CupomMostrarRazaoSocial}" Margin="0,3,12,3" />
                            <CheckBox Content="Endereço" IsChecked="{Binding CupomMostrarEndereco}" Margin="0,3,12,3" />
                            <CheckBox Content="Cidade e UF" IsChecked="{Binding CupomMostrarCidade}" Margin="0,3,12,3" />
                            <CheckBox Content="CNPJ ou CPF" IsChecked="{Binding CupomMostrarDocumento}" Margin="0,3,12,3" />
                            <CheckBox Content="Inscrição estadual" IsChecked="{Binding CupomMostrarInscricao}" Margin="0,3,12,3" />
                            <CheckBox Content="Telefone / WhatsApp" IsChecked="{Binding CupomMostrarTelefone}" Margin="0,3,12,3" />
                            <CheckBox Content="E-mail" IsChecked="{Binding CupomMostrarEmail}" Margin="0,3,12,3" />
                            <CheckBox Content="Nome do operador" IsChecked="{Binding CupomMostrarOperador}" Margin="0,3,12,3" />
                            <CheckBox Content="Nome do cliente" IsChecked="{Binding CupomMostrarCliente}" Margin="0,3,12,3" />
                            <CheckBox Content="Forma de pagamento e troco" IsChecked="{Binding CupomMostrarPagamento}" Margin="0,3,12,3" />
                            <CheckBox Content="Chave Pix no rodapé" IsChecked="{Binding CupomMostrarPix}" Margin="0,3,12,3" />
                            <CheckBox Content="Linha “Impresso pelo Nexus”" IsChecked="{Binding CupomMostrarAssinatura}" Margin="0,3,12,3" />
                            <CheckBox Content="Referência do produto em cada item" IsChecked="{Binding CupomMostrarReferencia}" Margin="0,3,12,3" />
                            <CheckBox Content="“CUPOM NÃO FISCAL” dentro de uma caixa" IsChecked="{Binding CupomTituloEmCaixa}" Margin="0,3,12,3" />
                            <CheckBox Content="Assinatura do cliente" IsChecked="{Binding CupomMostrarAssinaturaCliente}" Margin="0,3,12,3" />
                        </UniformGrid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mensagem no cabeçalho (opcional)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding CupomMensagemCabecalho, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="3" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Mensagem no cabeçalho do cupom" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mensagem no rodapé" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding RodapeCupom, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="3" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Mensagem no rodapé do cupom" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Garantia / termos (opcional, sai antes da assinatura)" Style="{StaticResource Rotulo}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding CupomTextoGarantia, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="4" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Garantia e termos do cupom" />
                        <TextBlock Foreground="{StaticResource CorTextoSuave}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Rodapé: agradecimento, política de trocas, redes sociais. Em branco, sai “OBRIGADO PELA PREFERÊNCIA! VOLTE SEMPRE!”." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Impressão do cupom" FontSize="18" FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Impressora" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding Impressoras}" SelectedItem="{Binding ImpressoraSelecionada}" Padding="8,7" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Largura do papel" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding Larguras}" DisplayMemberPath="Texto"
                                          SelectedItem="{Binding LarguraSelecionada}" Padding="8,7" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Linhas em branco no fim (para o corte da impressora)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding CupomLinhasFinais, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" />

                        <CheckBox Margin="0,16,0,0" IsChecked="{Binding ImprimirAoFinalizar}"
                                  Content="Imprimir o cupom sozinho ao finalizar a venda" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Salvar (Ctrl+S)" Style="{StaticResource BotaoPrimario}"
                                    Command="{Binding SalvarCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
            <v:PreviaCupomControl Grid.Column="1" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Command="{Binding SalvarCommand}" />
            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Click="Fechar_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
