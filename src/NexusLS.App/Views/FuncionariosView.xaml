<UserControl x:Class="NexusLS.App.Views.FuncionariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="AvisoLogin" TargetType="Border" BasedOn="{StaticResource Painel}">
            <Setter Property="Background" Value="{StaticResource CorAlerta}" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Funcionários" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

            <Border Grid.Row="1" Style="{StaticResource AvisoLogin}"
                    Visibility="{Binding LoginDesligado, Converter={StaticResource BoolVis}}">
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                           Text="O login está desligado: qualquer pessoa que abrir o programa pode tudo. Para ligar, crie o primeiro administrador no painel ao lado. Depois disso o programa passa a pedir o PIN ao abrir e cada funcionário só vê o que o perfil permite." />
            </Border>

            <CheckBox Grid.Row="2" Content="Mostrar desativados" Margin="0,0,0,10" IsChecked="{Binding MostrarInativos}"
                      Visibility="{Binding LoginAtivo, Converter={StaticResource BoolVis}}" />

            <Border Grid.Row="3" Style="{StaticResource Painel}" Padding="0"
                    Visibility="{Binding LoginAtivo, Converter={StaticResource BoolVis}}">
                <DataGrid ItemsSource="{Binding Funcionarios}" SelectedItem="{Binding Selecionado, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          BorderThickness="0" Background="Transparent" AutomationProperties.Name="Lista de funcionários">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome, Mode=OneWay}" Width="3*" MinWidth="130" />
                        <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo, Mode=OneWay}" Width="2*" MinWidth="90" />
                        <DataGridTextColumn Header="Perfil" Binding="{Binding PerfilTexto, Mode=OneWay}" Width="2*" MinWidth="100" />
                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo, Mode=OneWay}" Width="0.8*" MinWidth="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Painel}" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do funcionário" />

                    <StackPanel Visibility="{Binding LoginAtivo, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Cargo (opcional)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Telefone (opcional)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Perfil" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Perfis}" DisplayMemberPath="Nome" SelectedItem="{Binding PerfilSelecionado}"
                                  AutomationProperties.Name="Perfil" />

                        <TextBlock Text="Pode acessar" Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding PermissoesLista}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Nome}" IsChecked="{Binding Marcada}" Margin="0,2"
                                              IsEnabled="{Binding DataContext.PerfilPersonalizado, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Rotulo}">
                        <TextBlock.Text>PIN (4 a 8 números; ao editar, em branco mantém o atual)</TextBlock.Text>
                    </TextBlock>
                    <PasswordBox x:Name="CaixaPin" MaxLength="8" AutomationProperties.Name="PIN" />
                    <TextBlock Text="Repita o PIN" Style="{StaticResource Rotulo}" />
                    <PasswordBox x:Name="CaixaPinConfirmacao" MaxLength="8" AutomationProperties.Name="Repita o PIN" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource BotaoPrimario}" Command="{Binding SalvarCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Salvar" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoginDesligado}" Value="True">
                                                <Setter Property="Text" Value="Ativar o login" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Content="Novo" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding NovoCommand}"
                                Visibility="{Binding LoginAtivo, Converter={StaticResource BoolVis}}" />
                        <Button Content="{Binding TextoAtivar}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding AlternarAtivoCommand}"
                                Visibility="{Binding Editando, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                    <Button Content="Gerar novo código de recuperação" Style="{StaticResource BotaoSecundario}" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Command="{Binding NovoCodigoCommand}"
                            Visibility="{Binding EhAdministradorEditado, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
