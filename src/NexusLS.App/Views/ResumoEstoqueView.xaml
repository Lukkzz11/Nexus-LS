<UserControl x:Class="NexusLS.App.Views.ResumoEstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Uma barra: nome e valor em cima, barra embaixo -->
        <DataTemplate x:Key="Barra">
            <StackPanel Margin="0,0,0,8">
                <Grid>
                    <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis" Margin="0,0,130,0" />
                    <TextBlock Text="{Binding Valor}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentual, Mode=OneWay}" Height="10" Margin="0,3,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Alerta}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CorPerigo}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="Numero" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="AvisoVazio" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,24">
            <TextBlock Text="Resumo do estoque" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="O que tem, o que mais sai e o que está acabando." Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,12" />

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Style="{StaticResource Painel}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Produtos ativos" Style="{StaticResource Rotulo}" /><TextBlock Text="{Binding ProdutosAtivos}" Style="{StaticResource Numero}" /></StackPanel></Border>
                <Border Style="{StaticResource Painel}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Peças em estoque" Style="{StaticResource Rotulo}" /><TextBlock Text="{Binding PecasEmEstoque}" Style="{StaticResource Numero}" /></StackPanel></Border>
                <Border Style="{StaticResource Painel}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Valor em estoque (custo)" Style="{StaticResource Rotulo}" /><TextBlock Text="{Binding ValorCusto}" Style="{StaticResource Numero}" /></StackPanel></Border>
                <Border Style="{StaticResource Painel}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Valor em estoque (venda)" Style="{StaticResource Rotulo}" /><TextBlock Text="{Binding ValorVenda}" Style="{StaticResource Numero}" /></StackPanel></Border>
                <Border Style="{StaticResource Painel}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Estoque baixo" Style="{StaticResource Rotulo}" /><TextBlock Text="{Binding QtdBaixo}" Style="{StaticResource Numero}" Foreground="{StaticResource CorAtencaoBorda}" /></StackPanel></Border>
                <Border Style="{StaticResource Painel}"><StackPanel><TextBlock Text="Esgotados" Style="{StaticResource Rotulo}" /><TextBlock Text="{Binding QtdEsgotado}" Style="{StaticResource Numero}" Foreground="{StaticResource CorPerigo}" /></StackPanel></Border>
            </UniformGrid>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Painel}" Margin="0,0,8,8">
                    <StackPanel>
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding OpcoesDias}" SelectedItem="{Binding Dias}" Width="70" ToolTip="Período em dias" />
                            <TextBlock Text="O que mais sai" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding PeriodoTexto}" Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,2,0,10" />
                        <ItemsControl ItemsSource="{Binding MaisSaem}" ItemTemplate="{StaticResource Barra}" />
                        <TextBlock Text="Nenhuma venda no período.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AvisoVazio}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MaisSaem.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Painel}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Estoque por categoria" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding PorCategoria}" ItemTemplate="{StaticResource Barra}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Painel}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Onde tem mais estoque" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding MaioresEstoques}" ItemTemplate="{StaticResource Barra}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Estoque baixo ou esgotado" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding EstoqueBaixo}" ItemTemplate="{StaticResource Barra}" />
                        <TextBlock Text="Nenhum produto abaixo do mínimo.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AvisoVazio}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstoqueBaixo.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
