<UserControl x:Class="NexusLS.App.Views.EditorCatalogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Editor do catálogo" Style="{StaticResource TituloTela}" />
            <TextBlock Text="Escolha como o catálogo online aparece. Salvar guarda neste computador; Publicar envia ao Firebase (documento meta/vitrine)."
                       TextWrapping="Wrap" Foreground="{StaticResource CorTextoSuave}" Margin="0,2,0,12" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Visual" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Modelo" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Modelos}" DisplayMemberPath="Rotulo" SelectedValuePath="Id" SelectedValue="{Binding Modelo}" AutomationProperties.Name="Modelo" />
                        <TextBlock Text="Fonte" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Fontes}" DisplayMemberPath="Rotulo" SelectedValuePath="Id" SelectedValue="{Binding Fonte}" AutomationProperties.Name="Fonte" />
                        <TextBlock Text="Ordem dos produtos" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Ordens}" DisplayMemberPath="Rotulo" SelectedValuePath="Id" SelectedValue="{Binding OrdemProdutos}" AutomationProperties.Name="Ordem dos produtos" />
                        <CheckBox Content="Mostrar a descrição nos cartões dos produtos" IsChecked="{Binding MostrarDescricao}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Cores (vazio = a do modelo)" FontSize="16" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Cores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rotulo}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Rotulo}" />
                                        <Border Grid.Column="2" Width="28" Height="28" Margin="8,0,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource CorBordaCampo}"
                                                Background="{Binding Previa, TargetNullValue=Transparent}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Avisos}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#B45309" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Textos do topo" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Faixa de anúncio" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding TextoAnuncio, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Linha pequena acima do título" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Eyebrow, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Título" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Dados da loja" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding LojaNome, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Apresentação" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding LojaApresentacao, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="54" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Telefone" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Instagram (sem @)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Instagram, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="WhatsApp (com DDD, só números)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Whatsapp, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="E-mail" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Endereço" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Atacado e novidades" FontSize="16" FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mínimo de peças no atacado" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding AtacadoMinPecas, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Produtos no carrossel de novidades" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding NovidadesQtd, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Banners}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Painel}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Selo" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding Selo, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Título" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Parte em destaque" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding Destaque, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Subtítulo" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding Subtitulo, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Texto do botão" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding BotaoRotulo, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="12" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Salvar" Style="{StaticResource BotaoSecundario}" Command="{Binding SalvarCommand}" />
                <Button Content="Publicar no Firebase" Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0" Command="{Binding PublicarCommand}"
                        Visibility="{Binding PodePublicar, Converter={StaticResource BoolVis}}" />
                <Button Content="Voltar ao padrão" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding RestaurarCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
        </StackPanel>
    </Grid>
</UserControl>
