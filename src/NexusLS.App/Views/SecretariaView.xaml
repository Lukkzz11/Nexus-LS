<UserControl x:Class="NexusLS.App.Views.SecretariaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding AtualizarCommand}" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="Secretária" Style="{StaticResource TituloTela}" />
                <TextBlock Text="{Binding Resumo}" Opacity="0.75" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- O que fazer -->
            <Border Style="{StaticResource Painel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="O que fazer" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Tarefas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,6,12">
                                        <Button DockPanel.Dock="Right" Content="WhatsApp" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Style="{StaticResource BotaoSecundario}"
                                                Visibility="{Binding TemWhatsApp, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.ChamarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock FontSize="10" FontWeight="Bold" Opacity="0.7">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Etiqueta}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Urgente}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detalhe}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Calendário de pagamentos (só para quem vê o Financeiro) -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding VerFinanceiro, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource Painel}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Próximo ›" Command="{Binding MesSeguinteCommand}" Style="{StaticResource BotaoSecundario}" />
                                <Button DockPanel.Dock="Right" Content="‹ Anterior" Command="{Binding MesAnteriorCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding TituloDoMes}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <UniformGrid Columns="7" Margin="0,0,0,4">
                                <TextBlock Text="dom" HorizontalAlignment="Center" Opacity="0.6" FontSize="11" />
                                <TextBlock Text="seg" HorizontalAlignment="Center" Opacity="0.6" FontSize="11" />
                                <TextBlock Text="ter" HorizontalAlignment="Center" Opacity="0.6" FontSize="11" />
                                <TextBlock Text="qua" HorizontalAlignment="Center" Opacity="0.6" FontSize="11" />
                                <TextBlock Text="qui" HorizontalAlignment="Center" Opacity="0.6" FontSize="11" />
                                <TextBlock Text="sex" HorizontalAlignment="Center" Opacity="0.6" FontSize="11" />
                                <TextBlock Text="sáb" HorizontalAlignment="Center" Opacity="0.6" FontSize="11" />
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding Dias}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button MinHeight="64" Margin="1" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Command="{Binding DataContext.EscolherDiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Numero}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="caixa" Padding="4,3" CornerRadius="6" BorderThickness="1" BorderBrush="#33808080" Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Pago}" Value="True">
                                                            <Setter TargetName="caixa" Property="Background" Value="#2216A34A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Atrasado}" Value="True">
                                                            <Setter TargetName="caixa" Property="Background" Value="#33DC2626" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Hoje}" Value="True">
                                                            <Setter TargetName="caixa" Property="BorderBrush" Value="#808080" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Selecionado}" Value="True">
                                                            <Setter TargetName="caixa" Property="BorderBrush" Value="#2563EB" />
                                                            <Setter TargetName="caixa" Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Numero}" Value="">
                                                            <Setter TargetName="caixa" Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="caixa" Property="Opacity" Value="0.75" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="caixa" Property="BorderBrush" Value="#2563EB" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" FontSize="12" />
                                                <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding APagar}" FontSize="10" Foreground="#DC2626" />
                                                        <TextBlock Text="{Binding AReceber}" FontSize="10" Foreground="#16A34A" />
                                                        <TextBlock Text="{Binding Saldo}" FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Opacity" Value="0.7" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SaldoNegativo}" Value="True">
                                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Viewbox>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding AlertaDoMes}" FontWeight="SemiBold" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="O saldo previsto parte do dinheiro de hoje (gaveta e bancos) e soma as contas até o dia. Vendas futuras não entram."
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Painel}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TituloDoDia}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding ContasDoDia}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Situacao}" Opacity="0.7" Margin="10,0,0,0" />
                                            <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Marcar neste dia" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <TextBlock Text="O que" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descrição do pagamento" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Valor" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" Width="120" AutomationProperties.Name="Valor" />
                                </StackPanel>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Repetir por (meses)" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding RepetirMeses, UpdateSourceTrigger=PropertyChanged}" Width="120" AutomationProperties.Name="Repetir por meses" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Content="É um valor a receber" IsChecked="{Binding ERecebimento}" Margin="0,10,0,0" />
                            <Button Content="Marcar no calendário" Command="{Binding MarcarCommand}" Style="{StaticResource BotaoPrimario}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" />
                            <TextBlock Text="Para dar baixa, editar ou cancelar, use a tela Financeiro." FontSize="11" Opacity="0.6" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
