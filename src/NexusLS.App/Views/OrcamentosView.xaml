<UserControl x:Class="NexusLS.App.Views.OrcamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ===== Lista ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Orçamentos" Style="{StaticResource TituloTela}" Margin="0,0,0,14" />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Buscar por número, cliente, telefone ou item" AutomationProperties.Name="Buscar orçamento" />
                <CheckBox Grid.Column="1" Content="Só em aberto" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SoAbertos}" />
                <Button Grid.Column="2" Content="Novo orçamento" Style="{StaticResource BotaoPrimario}" Margin="16,0,0,0"
                        AutomationProperties.Name="Novo orçamento" Command="{Binding NovoCommand}" />
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" Margin="0,0,0,8" />

            <Border Grid.Row="3" Style="{StaticResource Painel}">
                <Grid>
                    <TextBlock Text="Nenhum orçamento por aqui. Clique em &quot;Novo orçamento&quot; para montar o primeiro."
                               Foreground="{DynamicResource CorTextoSuave}" TextWrapping="Wrap"
                               Visibility="{Binding ListaVazia, Converter={StaticResource BoolVis}}" />
                    <ListBox ItemsSource="{Binding Lista}" SelectedItem="{Binding Selecionado}" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lista de orçamentos"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" AutomationProperties.Name="{Binding DescricaoAcessivel}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Cliente}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Opacity="0.7">
                                            <Run Text="{Binding Numero, Mode=OneWay}" /> · <Run Text="{Binding Data, Mode=OneWay}" /> · <Run Text="{Binding Situacao, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Total}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Detalhe ===== -->
        <Border Grid.Column="2" Style="{StaticResource Painel}" VerticalAlignment="Top"
                Visibility="{Binding FormAberto, Converter={StaticResource BoolInverso}}">
            <Grid>
                <TextBlock Text="Escolha um orçamento na lista para ver os detalhes." Foreground="{DynamicResource CorTextoSuave}" TextWrapping="Wrap"
                           Visibility="{Binding TemSelecao, Converter={StaticResource BoolInverso}}" />
                <StackPanel Visibility="{Binding TemSelecao, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding DetalheTitulo}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetalheCliente}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetalheValores}" Foreground="{DynamicResource CorTextoSuave}" Margin="0,2,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="Itens" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                    <ItemsControl ItemsSource="{Binding DetalheItens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DetalheTotal}" Margin="0,6,0,0" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="{Binding DetalheObservacao}" Foreground="{DynamicResource CorTextoSuave}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <Button Content="Enviar por WhatsApp" Style="{StaticResource BotaoPrimario}" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                            Command="{Binding EnviarWhatsAppCommand}" />
                    <Button Content="Ver PDF" Style="{StaticResource BotaoSecundario}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Command="{Binding VerPdfCommand}" />
                    <StackPanel Visibility="{Binding EstaAberto, Converter={StaticResource BoolVis}}">
                        <Button Content="Cliente aprovou: virar pedido" Style="{StaticResource BotaoSecundario}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Command="{Binding VirarPedidoCommand}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Corrigir" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Stretch" Command="{Binding CorrigirCommand}" />
                            <Button Grid.Column="2" Content="Recusado" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Stretch" Command="{Binding RecusarCommand}" />
                        </Grid>
                    </StackPanel>
                    <Button Content="Reabrir" Style="{StaticResource BotaoSecundario}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Visibility="{Binding PodeReabrir, Converter={StaticResource BoolVis}}" Command="{Binding ReabrirCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Montar / corrigir ===== -->
        <Border Grid.Column="2" Style="{StaticResource Painel}" VerticalAlignment="Top"
                Visibility="{Binding FormAberto, Converter={StaticResource BoolVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="{Binding TituloForm}" FontSize="18" FontWeight="SemiBold" />

                    <TextBlock Text="Cliente cadastrado (opcional)" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding Clientes}" DisplayMemberPath="Nome" SelectedItem="{Binding ClienteCadastrado}" AutomationProperties.Name="Cliente cadastrado" />
                    <StackPanel Visibility="{Binding SemClienteCadastrado, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Ou o nome do cliente" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding ClienteNome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do cliente" />
                        <TextBlock Text="Telefone / WhatsApp" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding ClienteTelefone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Telefone do cliente" />
                    </StackPanel>

                    <TextBlock Text="Adicionar produto (digite e tecle Enter)" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
                    <TextBox Text="{Binding BuscaProduto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar produto do orçamento">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AdicionarProdutoCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <ListBox ItemsSource="{Binding Resultados}" SelectedItem="{Binding ResultadoSelecionado}" MaxHeight="130" MouseDoubleClick="AoDarDoisCliques">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Resultados.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Nome}" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Item sem cadastro (serviço, encomenda)" Style="{StaticResource BotaoSecundario}" Margin="0,8,0,0" Padding="10,5" FontSize="13"
                            HorizontalAlignment="Left" Command="{Binding AdicionarItemLivreCommand}" />

                    <ItemsControl ItemsSource="{Binding ItensForm}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NomeEditavel}" FontWeight="SemiBold" AutomationProperties.Name="Nome do item" />
                                            <Button Grid.Column="1" Content="Remover" Style="{StaticResource BotaoSecundario}" Padding="8,3" FontSize="12" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoverItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding Tamanhos}" SelectedItem="{Binding Tamanho}" Visibility="{Binding TemVariosTamanhos, Converter={StaticResource BoolVis}}" />
                                            <TextBox Grid.Column="2" Text="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quantidade" AutomationProperties.Name="Quantidade" />
                                            <TextBox Grid.Column="4" Text="{Binding PrecoTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Preço unitário (R$)" AutomationProperties.Name="Preço" />
                                        </Grid>
                                        <TextBlock Text="{Binding TotalTexto}" HorizontalAlignment="Right" Margin="0,4,0,0" FontSize="13" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Desconto (R$)" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Desconto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Desconto" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vale por (dias, de hoje)" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding ValidadeDias, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Validade em dias" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Condições: prazo e pagamento (o cliente lê)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"
                             AutomationProperties.Name="Condições" />

                    <TextBlock Margin="0,12,0,0" FontSize="18" FontWeight="Bold"><Run Text="Total: " /><Run Text="{Binding TotalForm, Mode=OneWay}" /></TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Salvar orçamento" Style="{StaticResource BotaoPrimario}" AutomationProperties.Name="Salvar orçamento" Command="{Binding SalvarCommand}" />
                        <Button Content="Voltar" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding FecharFormCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
