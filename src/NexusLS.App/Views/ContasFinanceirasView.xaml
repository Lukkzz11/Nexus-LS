<UserControl x:Class="NexusLS.App.Views.ContasFinanceirasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,12,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Esquerda: lista de contas e transferências -->
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Contas" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox Content="Mostrar desativadas" Margin="20,0,0,0" VerticalAlignment="Center" IsChecked="{Binding MostrarDesativadas}" />
                </StackPanel>
                <Border Style="{StaticResource Painel}" Padding="0" Margin="0,0,0,18">
                    <DataGrid ItemsSource="{Binding Contas}" SelectedItem="{Binding Selecionada, Mode=TwoWay}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="220"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" BorderThickness="0" Background="Transparent"
                              RowHeight="36" AutomationProperties.Name="Lista de contas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Conta" Binding="{Binding Nome, Mode=OneWay}" Width="2*" MinWidth="150" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Saldo inicial" Binding="{Binding SaldoInicial, Mode=OneWay}" Width="1*" MinWidth="100" ElementStyle="{StaticResource ColunaNumero}" />
                            <DataGridTextColumn Header="Desde" Binding="{Binding Desde, Mode=OneWay}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Text="Transferências (últimos 60 dias)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border Style="{StaticResource Painel}" Padding="0">
                    <DataGrid ItemsSource="{Binding Transferencias}" SelectedItem="{Binding TransferenciaSelecionada, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" BorderThickness="0" Background="Transparent"
                              RowHeight="36" MaxHeight="260" AutomationProperties.Name="Lista de transferências">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data, Mode=OneWay}" Width="100" />
                            <DataGridTextColumn Header="De → para" Binding="{Binding DeParaTexto, Mode=OneWay}" Width="2*" MinWidth="160" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding Valor, Mode=OneWay}" Width="1*" MinWidth="100" ElementStyle="{StaticResource ColunaNumero}" />
                            <DataGridTextColumn Header="Situação" Binding="{Binding Situacao, Mode=OneWay}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Button Content="Cancelar a transferência selecionada" Style="{StaticResource BotaoSecundario}" Margin="0,10,0,0"
                        HorizontalAlignment="Left" Command="{Binding CancelarTransferenciaCommand}" />
                <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoMensagem}" />
            </StackPanel>

            <!-- Direita: formulários -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Painel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding TituloFormulario}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome da conta" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton GroupName="TipoConta" Content="Conta de banco" IsChecked="{Binding EhBanco}" Margin="0,0,16,0" />
                            <RadioButton GroupName="TipoConta" Content="Dinheiro (gaveta, cofre)" />
                        </StackPanel>
                        <TextBlock Text="Saldo inicial" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding SaldoInicialTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quanto havia na conta na data abaixo"
                                 AutomationProperties.Name="Saldo inicial" />
                        <TextBlock Text="Desse dia em diante o programa soma o que entra e sai" Style="{StaticResource Rotulo}" />
                        <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding DataSaldoInicial}" VerticalContentAlignment="Center" />
                        <CheckBox Content="Conta padrão (onde caem Pix e cartão)" IsChecked="{Binding Padrao}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Command="{Binding SalvarCommand}" />
                            <Button Content="Nova" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding NovaCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Desativar" Style="{StaticResource BotaoSecundario}" Command="{Binding DesativarCommand}"
                                    Visibility="{Binding PodeDesativar, Converter={StaticResource BoolVis}}" />
                            <Button Content="Reativar" Style="{StaticResource BotaoSecundario}" Command="{Binding ReativarCommand}"
                                    Visibility="{Binding PodeReativar, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Painel}">
                    <StackPanel>
                        <TextBlock Text="Transferir entre contas" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Não é receita nem despesa: o dinheiro só muda de lugar. Para levar dinheiro da gaveta ao banco, use esta transferência (a sangria do caixa é uma retirada sem destino)."
                                   TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource CorTextoSuave}" Margin="0,4,0,0" />
                        <TextBlock Text="Sai de" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding ContasAtivas}" SelectedItem="{Binding TransfOrigem}" DisplayMemberPath="Nome" Padding="8,7"
                                  AutomationProperties.Name="Conta de origem" />
                        <TextBlock Text="Vai para" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding ContasAtivas}" SelectedItem="{Binding TransfDestino}" DisplayMemberPath="Nome" Padding="8,7"
                                  AutomationProperties.Name="Conta de destino" />
                        <TextBlock Text="Valor" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding TransfValorTexto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Valor da transferência" />
                        <TextBlock Text="Dia" Style="{StaticResource Rotulo}" />
                        <DatePicker SelectedDateFormat="Short" SelectedDate="{Binding TransfData}" VerticalContentAlignment="Center" />
                        <TextBlock Text="Observação (opcional)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding TransfDescricao, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Transferir" Style="{StaticResource BotaoPrimario}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Command="{Binding TransferirCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
