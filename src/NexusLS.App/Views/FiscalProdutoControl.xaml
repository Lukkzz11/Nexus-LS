<UserControl x:Class="NexusLS.App.Views.FiscalProdutoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander Header="Dados fiscais (NFC-e e reforma tributária)" Margin="0,10,0,0">
        <StackPanel Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                       Text="Tudo opcional: o que ficar vazio usa o padrão da página Fiscal. Confirme os códigos com o seu contador." />

            <UniformGrid Columns="3" Margin="0,8,0,0">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Unidade comercial" Style="{StaticResource Rotulo}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Unidades}" Text="{Binding Unidade, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Vazio = UN" AutomationProperties.Name="Unidade comercial" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="CEST (7 números)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Cest, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"
                             ToolTip="Só para produto com substituição tributária (ST)." AutomationProperties.Name="CEST" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Origem da mercadoria" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding Origens}" SelectedItem="{Binding Origem}" AutomationProperties.Name="Origem da mercadoria" />
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="ICMS" FontWeight="SemiBold" Margin="0,12,0,0" />
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="CSOSN / CST" Style="{StaticResource Rotulo}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Csosn}" Text="{Binding CstIcms, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Simples Nacional: 102 (sem crédito) é o mais comum. Regime normal: CST de 2 números."
                              AutomationProperties.Name="CSOSN ou CST do ICMS" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Alíquota (%)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding AliquotaIcms, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Alíquota do ICMS" />
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="PIS e COFINS" FontWeight="SemiBold" Margin="0,12,0,0" />
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="CST do PIS" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding CstPis, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" ToolTip="Ex.: 07, 01" AutomationProperties.Name="CST do PIS" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Alíquota PIS (%)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding AliquotaPis, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Alíquota do PIS" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="CST da COFINS" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding CstCofins, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" AutomationProperties.Name="CST da COFINS" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Alíquota COFINS (%)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding AliquotaCofins, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Alíquota da COFINS" />
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="Reforma tributária (IBS / CBS)" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                       Text="Novos tributos (NT 2025.002). Para o Simples Nacional a exigência em produção está prevista para 2027; já dá para classificar os produtos. Preencha o CST e o cClassTrib juntos." />
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="CST IBS/CBS (3 números)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding CstIbsCbs, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" ToolTip="Ex.: 000 (tributação integral)" AutomationProperties.Name="CST IBS CBS" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="cClassTrib (6 números)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding ClassTribIbsCbs, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" ToolTip="Ex.: 000001" AutomationProperties.Name="cClassTrib" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Expander>
</UserControl>
