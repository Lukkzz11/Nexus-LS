<Window x:Class="NexusLS.App.Views.GestaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nexus — Gestão" Height="760" Width="1280" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="{DynamicResource CorFundo}" Foreground="{DynamicResource CorTexto}"
        FontFamily="{StaticResource FonteTexto}" FontSize="{StaticResource TamCorpo}">

    <Window.Resources>
        <Style x:Key="ItemDoMenu" TargetType="Button" BasedOn="{StaticResource BotaoMenu}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IgualTag}">
                            <Binding Path="ItemAtivo" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource CorMenuAtivo}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CorSelecao}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource CorMenuAtivoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconeDoMenu" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="{StaticResource TamIcone}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PainelLateral}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,14,16">
                    <TextBlock Text="{Binding UsuarioTexto}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,8" />
                    <Button Content="Fechar a gestão" Style="{StaticResource BotaoSecundario}" Padding="12,6" FontSize="13"
                            AutomationProperties.Name="Fechar a gestão" Click="Fechar_Click" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,16">
                        <TextBlock Text="VENDAS" Style="{StaticResource SecaoMenu}" Margin="20,0,18,6" />
                        <Button Tag="Agenda" AutomationProperties.Name="Agenda" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaAgendaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CalendarLtr24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Agenda" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Clientes" Visibility="{Binding VerClientes, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Clientes" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaClientesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Clientes" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Relatorios" Visibility="{Binding VerRelatorios, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Relatórios" ToolTip="Gráficos, vendas e demonstrativo de resultado (DRE)" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaRelatoriosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataBarVertical24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Relatórios" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Gaveta" Visibility="{Binding VerRelatorios, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Gaveta de documentos" ToolTip="PDFs e documentos guardados no computador: cupons, relatórios, notas" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaGavetaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Gaveta" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="WhatsApp" Visibility="{Binding VerRelatorios, Converter={StaticResource BoolVis}}" AutomationProperties.Name="WhatsApp" ToolTip="Mandar ofertas do catálogo, comprovantes e documentos pelo WhatsApp (sem custo)" Style="{StaticResource ItemDoMenu}" Command="{Binding AbrirWhatsAppCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Chat24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="WhatsApp" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="FINANCEIRO" Style="{StaticResource SecaoMenu}" Margin="20,14,18,6" Visibility="{Binding VerFinanceiro, Converter={StaticResource BoolVis}}" />
                        <Button Tag="Financeiro" Visibility="{Binding VerFinanceiro, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Financeiro" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFinanceiroCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wallet24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Financeiro" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="ContasESaldos" Visibility="{Binding VerFinanceiro, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Contas e saldos" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaContasESaldosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Money24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Contas e saldos" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="RelatorioFinanceiro" Visibility="{Binding VerFinanceiro, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Relatório financeiro" ToolTip="Entradas, saídas e saldo de um período" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaRelatorioFinanceiroCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentData24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Relatório financeiro" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="ESTOQUE E COMPRAS" Style="{StaticResource SecaoMenu}" Margin="20,14,18,6" Visibility="{Binding VerGrupoEstoque, Converter={StaticResource BoolVis}}" />
                        <Button Tag="RelatorioProdutos" Visibility="{Binding VerRelatorios, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Relatório de produtos" ToolTip="Mais vendidos, curva ABC, por categoria, por tamanho e parados" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaRelatorioProdutosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataPie24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Relatório de produtos" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Compras" Visibility="{Binding VerCompras, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Compras" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaComprasCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BoxArrowLeft24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Compras" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Fornecedores" Visibility="{Binding VerCompras, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Fornecedores" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFornecedoresCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Building24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Fornecedores" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="CalculadoraPrecos" Visibility="{Binding VerEstoque, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Calculadora de preços" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaCalculadoraPrecosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Calculator24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Calculadora de preços" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="PESSOAS" Style="{StaticResource SecaoMenu}" Margin="20,14,18,6" Visibility="{Binding VerGrupoPessoas, Converter={StaticResource BoolVis}}" />
                        <Button Tag="Funcionarios" Visibility="{Binding VerFuncionarios, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Funcionários" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaFuncionariosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Person24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Funcionários" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Atividades" Visibility="{Binding VerConfiguracoes, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Atividades" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaAtividadesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Atividades" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="EMPRESA" Style="{StaticResource SecaoMenu}" Margin="20,14,18,6" Visibility="{Binding VerGrupoEmpresa, Converter={StaticResource BoolVis}}" />
                        <Button Tag="GestaoEmpresa" Visibility="{Binding VerConfiguracoes, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Gestão da empresa" ToolTip="Lojas e desempenho de cada uma (só o administrador)" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaGestaoEmpresaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BuildingShop24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Gestão da empresa" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="EntradasESaidas" Visibility="{Binding VerFinanceiro, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Entradas e saídas" ToolTip="Lançar dinheiro que entrou ou saiu da empresa, com foto ou documento anexado" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaEntradasESaidasCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSwap24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Entradas e saídas" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Tag="Configuracoes" Visibility="{Binding VerConfiguracoes, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Configurações" Style="{StaticResource ItemDoMenu}" Command="{Binding IrParaConfiguracoesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource IconeDoMenu}" />
                                <TextBlock Text="Configurações" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding TelaAtual}" Margin="20,16,24,20">
            <ContentControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
            </ContentControl.LayoutTransform>
        </ContentControl>
    </Grid>
</Window>
