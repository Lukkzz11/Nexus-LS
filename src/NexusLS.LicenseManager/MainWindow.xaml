<Window x:Class="NexusLS.LicenseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus LS — License Manager"
        Width="1360" Height="860"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid Name="RootGrid">
        <ProgressBar Name="LoadingProgress" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0" Panel.ZIndex="10" />
    </Grid>
</Window>
