<Window x:Class="NexusLS.LojaOnline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nexus Loja Online" Width="1360" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#0F172A" Loaded="AoCarregar">
    <Grid>
        <wv2:WebView2 x:Name="Navegador" Visibility="Collapsed" DefaultBackgroundColor="#0F172A" />
        <TextBlock x:Name="Aviso" Text="Abrindo o catálogo online..." Foreground="#CBD5E1" FontSize="15"
                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" />
    </Grid>
</Window>
