<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        TOKENS do design system do Nexus: as únicas decisões visuais "cruas" (cores, fontes, espaços, cantos).
        Todo estilo e toda tela devem usar estes nomes em vez de escrever valores. Para mudar o visual do
        programa inteiro, mude aqui.
    -->

    <!-- ===== Cores: base ===== -->
    <SolidColorBrush x:Key="CorFundo" Color="#F8FAFC" />          <!-- fundo da janela -->
    <SolidColorBrush x:Key="CorPainel" Color="White" />           <!-- cartões, tabelas, campos -->
    <SolidColorBrush x:Key="CorMenu" Color="White" />             <!-- menu lateral -->
    <SolidColorBrush x:Key="CorTexto" Color="#0F172A" />
    <SolidColorBrush x:Key="CorTextoSuave" Color="#64748B" />     <!-- rótulos, dicas, cabeçalho de tabela -->
    <SolidColorBrush x:Key="CorBorda" Color="#E2E8F0" />          <!-- contorno de cartão -->
    <SolidColorBrush x:Key="CorBordaCampo" Color="#CBD5E1" />     <!-- contorno de botão secundário e campo -->
    <SolidColorBrush x:Key="CorBordaForte" Color="#94A3B8" />
    <SolidColorBrush x:Key="CorLinhaGrade" Color="#F1F5F9" />     <!-- linhas entre as linhas da tabela -->
    <SolidColorBrush x:Key="CorHover" Color="#F1F5F9" />          <!-- passar o mouse sobre linha, botão suave ou menu -->
    <SolidColorBrush x:Key="CorCabecalho" Color="#F8FAFC" />      <!-- cabeçalho de tabela -->

    <!-- ===== Cores: ação principal (Azul Windows Fluent) ===== -->
    <SolidColorBrush x:Key="CorPrimaria" Color="#0067B8" />
    <SolidColorBrush x:Key="CorPrimariaHover" Color="#005A9E" />
    <SolidColorBrush x:Key="CorPrimariaPressionada" Color="#004578" />
    <SolidColorBrush x:Key="CorSelecao" Color="#E0EDF8" />        <!-- linha selecionada -->
    <SolidColorBrush x:Key="CorSelecaoSuave" Color="#F0F6FC" />   <!-- item ativo do menu -->
    <SolidColorBrush x:Key="CorFoco" Color="#0067B8" />
    <SolidColorBrush x:Key="CorSobrePrimaria" Color="White" />    <!-- texto sobre fundo azul -->
    <SolidColorBrush x:Key="CorSobrePrimariaSuave" Color="#E0EDF8" />
    <SolidColorBrush x:Key="CorMenuAtivo" Color="#F0F6FC" />

    <!-- ===== Cores: estados ===== -->
    <SolidColorBrush x:Key="CorSucesso" Color="#16A34A" />
    <SolidColorBrush x:Key="CorPositivo" Color="#15803D" />
    <SolidColorBrush x:Key="CorPerigo" Color="#DC2626" />
    <SolidColorBrush x:Key="CorPerigoHover" Color="#B91C1C" />
    <SolidColorBrush x:Key="CorPerigoPressionado" Color="#991B1B" />
    <SolidColorBrush x:Key="CorNegativo" Color="#DC2626" />
    <SolidColorBrush x:Key="CorAlerta" Color="#FEF3C7" />
    <SolidColorBrush x:Key="CorAviso" Color="#D97706" />
    <SolidColorBrush x:Key="CorAvisoFundo" Color="#FFFBEB" />
    <SolidColorBrush x:Key="CorAtencaoFundo" Color="#FFEDD5" />
    <SolidColorBrush x:Key="CorAtencaoBorda" Color="#EA580C" />
    <SolidColorBrush x:Key="CorAtencaoTexto" Color="#9A3412" />
    <SolidColorBrush x:Key="CorSobreposicao" Color="#B30F172A" /> <!-- véu atrás dos modais -->
    <SolidColorBrush x:Key="CorColunaFundo" Color="#F8FAFC" />

    <!-- Paleta categórica dos gráficos (pizzas): cores bem distintas entre si, na ordem de uso. "Outros" é sempre cinza. -->
    <SolidColorBrush x:Key="CorSerie1" Color="#2563EB" />
    <SolidColorBrush x:Key="CorSerie2" Color="#16A34A" />
    <SolidColorBrush x:Key="CorSerie3" Color="#F59E0B" />
    <SolidColorBrush x:Key="CorSerie4" Color="#DC2626" />
    <SolidColorBrush x:Key="CorSerie5" Color="#7C3AED" />
    <SolidColorBrush x:Key="CorSerie6" Color="#0891B2" />
    <SolidColorBrush x:Key="CorSerie7" Color="#DB2777" />
    <SolidColorBrush x:Key="CorSerieOutros" Color="#9CA3AF" />

    <!-- ===== Tipografia ===== -->
    <FontFamily x:Key="FonteTexto">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="TamMicro">11</sys:Double>      <!-- título de grupo do menu -->
    <sys:Double x:Key="TamPequeno">12</sys:Double>    <!-- cabeçalho de tabela, dicas -->
    <sys:Double x:Key="TamRotulo">13</sys:Double>     <!-- rótulo de campo -->
    <sys:Double x:Key="TamCorpo">14</sys:Double>      <!-- texto padrão, tabelas, menu -->
    <sys:Double x:Key="TamSecao">16</sys:Double>      <!-- título de seção dentro da tela -->
    <sys:Double x:Key="TamTitulo">24</sys:Double>     <!-- título da tela -->
    <sys:Double x:Key="TamDestaque">32</sys:Double>   <!-- números grandes (totais) -->

    <!-- ===== Espaçamentos (escala de 4) ===== -->
    <Thickness x:Key="EspXS">4</Thickness>
    <Thickness x:Key="EspS">8</Thickness>
    <Thickness x:Key="EspM">12</Thickness>
    <Thickness x:Key="EspL">16</Thickness>
    <Thickness x:Key="EspXL">24</Thickness>

    <!-- ===== Cantos ===== -->
    <CornerRadius x:Key="RaioPequeno">6</CornerRadius>   <!-- campos, linhas -->
    <CornerRadius x:Key="RaioMedio">8</CornerRadius>     <!-- botões, menu, avisos -->
    <CornerRadius x:Key="RaioGrande">10</CornerRadius>   <!-- cartões e painéis -->

    <!-- ===== Medidas de controles ===== -->
    <sys:Double x:Key="AlturaControle">36</sys:Double>   <!-- botões e campos -->
    <sys:Double x:Key="AlturaCabecalhoTabela">36</sys:Double>
    <sys:Double x:Key="TamIcone">18</sys:Double>
</ResourceDictionary>
