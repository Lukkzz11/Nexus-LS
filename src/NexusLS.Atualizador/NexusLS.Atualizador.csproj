<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NexusLS.Core\NexusLS.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>nexus.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>atualizador</AssemblyName>
    <Version>1.2.0</Version>
    <Product>Nexus LS Atualizador e Ativador</Product>
    <AssemblyTitle>Atualizador e Ativador Nexus LS</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="nexus.ico" />
    <Resource Include="Assets\emblema.png" />
    <Resource Include="Assets\emblema-branco.png" />
  </ItemGroup>
</Project>
