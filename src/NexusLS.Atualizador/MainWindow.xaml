<Window x:Class="NexusLS.Atualizador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus LS — Atualizador e Ativador de Licença"
        Height="760" Width="1020" MinHeight="660" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundo}" Foreground="{StaticResource CorTexto}"
        FontFamily="{StaticResource FonteTexto}">

    <Window.Resources>
        <!-- Estilo de Aba padronizado com o Nexus LS -->
        <Style x:Key="AbaNexus" TargetType="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{StaticResource CorCabecalho}"
                                BorderBrush="{StaticResource CorBorda}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Padding="20,10"
                                Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CorPainel}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="0,3,0,0" />
                                <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CorHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão Superior de Status -->
        <Style x:Key="CartaoStatus" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CorPainel}" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RaioGrande}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1" Color="#000000" Opacity="0.04" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Cabeçalho Superior Oficial -->
            <RowDefinition Height="Auto" />
            <!-- 1: Cartões Rápidos de Status -->
            <RowDefinition Height="Auto" />
            <!-- 2: Abas Principais de Conteúdo -->
            <RowDefinition Height="*" />
            <!-- 3: Rodapé e Barra de Status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. CABEÇALHO SUPERIOR NEXUS ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1"
                            CornerRadius="{StaticResource RaioMedio}" Width="42" Height="42" Margin="0,0,14,0">
                        <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NEXUS" Foreground="{StaticResource CorTexto}" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text=" ATUALIZADOR" Foreground="{StaticResource CorPrimaria}" FontWeight="Black" FontSize="18" Margin="4,0,0,0" />
                            <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioPequeno}" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GESTÃO &amp; ATIVAÇÃO" Foreground="{StaticResource CorPrimaria}" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Gerenciamento de versões, ativação de licenças offline e portal em nuvem"
                                   Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Botão de Iniciar o Nexus LS -->
                <Button Grid.Column="2" x:Name="BtnIniciarNexus" Style="{StaticResource BotaoPrimario}"
                        Padding="18,10" VerticalAlignment="Center" Click="BtnIniciarNexus_Click" ToolTip="Executa o aplicativo principal Nexus LS">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Iniciar Nexus LS" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ==================== 1. CARTÕES RÁPIDOS DE STATUS ==================== -->
        <Grid Grid.Row="1" Margin="24,18,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Situação da Licença -->
            <Border Grid.Column="0" Style="{StaticResource CartaoStatus}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SITUAÇÃO DA LICENÇA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                        <TextBlock x:Name="TxtLicencaStatus" Text="Verificando..." FontSize="16" FontWeight="Bold" Margin="0,4,0,2" />
                        <TextBlock x:Name="TxtLicencaDetalhe" Text="" FontSize="12" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource CorHover}" CornerRadius="20" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="🔑" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Versão Instalada -->
            <Border Grid.Column="2" Style="{StaticResource CartaoStatus}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VERSÃO INSTALADA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                        <TextBlock x:Name="TxtVersaoStatus" Text="Verificando..." FontSize="16" FontWeight="Bold" Margin="0,4,0,2" />
                        <TextBlock x:Name="TxtVersaoArquivo" Text="" FontSize="12" Foreground="{StaticResource CorTextoSuave}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource CorHover}" CornerRadius="20" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Código do Computador -->
            <Border Grid.Column="4" Style="{StaticResource CartaoStatus}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CÓDIGO DESTE COMPUTADOR (HWID)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                        <TextBlock x:Name="TxtCodigoMaquina" Text="Carregando..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource CorPrimaria}" Margin="0,4,0,2" />
                        <TextBlock Text="Identificador único para amarrar licenças" FontSize="12" Foreground="{StaticResource CorTextoSuave}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource CorSelecaoSuave}" CornerRadius="20" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="💻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. ABAS PRINCIPAIS ==================== -->
        <TabControl Grid.Row="2" Margin="24,0,24,18" Background="Transparent" BorderThickness="0">

            <!-- ABA 1: LICENÇA & ATIVAÇÃO -->
            <TabItem Header="🔑  Licença &amp; Ativação" Style="{StaticResource AbaNexus}">
                <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                        CornerRadius="0,10,10,10" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Título da Seção -->
                            <TextBlock Text="Emissão e Ativação de Licença" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                            <TextBlock Text="Gerencie licenças locais assinadas criptograficamente para uso offline sem depender de conexão contínua."
                                       Style="{StaticResource TextoApoio}" Margin="0,0,0,16" />

                            <!-- Status da Chave Privada do Fornecedor -->
                            <Border x:Name="BrdChaveStatus" Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}"
                                    BorderThickness="1" CornerRadius="{StaticResource RaioMedio}" Padding="14,10" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtChaveStatus" Text="Verificando chave mestra..." FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource CorPrimaria}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Formulário de Licença -->
                            <TextBlock Text="Nome do Cliente ou Estabelecimento:" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCliente" Text="Loja Principal" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Coluna Validade -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Data de Validade (AAAA-MM-DD):" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtValidade" Text="" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <Button Content="+30 dias" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,6" Padding="10,5" FontSize="11" Click="BtnAdicionarDias_Click" Tag="30" />
                                        <Button Content="+90 dias" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,6" Padding="10,5" FontSize="11" Click="BtnAdicionarDias_Click" Tag="90" />
                                        <Button Content="+1 ano" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,6" Padding="10,5" FontSize="11" Click="BtnAdicionarDias_Click" Tag="365" />
                                        <Button Content="+2 anos" Style="{StaticResource BotaoSecundario}" Margin="0,0,6,6" Padding="10,5" FontSize="11" Click="BtnAdicionarDias_Click" Tag="730" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Coluna Máquina -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Computador Autorizado (* = qualquer máquina):" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtMaquina" Text="*" Margin="0,0,0,8" />
                                    <Button Content="💻 Usar código desta máquina" Style="{StaticResource BotaoSecundario}"
                                            HorizontalAlignment="Left" Padding="10,5" FontSize="11" Click="BtnPreencherMaquina_Click"
                                            ToolTip="Preenche automaticamente com o identificador exclusivo deste computador" />
                                </StackPanel>
                            </Grid>

                            <Separator Background="{StaticResource CorBorda}" Margin="0,10,0,18" />

                            <!-- Botões de Ação de Licença -->
                            <WrapPanel>
                                <Button x:Name="BtnGerarEAtivar" Style="{StaticResource BotaoPrimario}" Margin="0,0,12,10" Padding="18,10" Click="BtnGerarEAtivar_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Gerar e Ativar Nesta Máquina" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnSalvarArquivo" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,10" Padding="16,10" Click="BtnSalvarArquivo_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Salvar Arquivo (.json)" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnInstalarArquivo" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,10" Padding="16,10" Click="BtnInstalarArquivo_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📂" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Instalar Licença de Arquivo" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRemoverLicenca" Style="{StaticResource BotaoPerigo}" Margin="0,0,12,10" Padding="16,10" Click="BtnRemoverLicenca_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🗑️" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Remover Licença Atual" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ABA 2: ATUALIZAÇÕES DO NEXUS LS -->
            <TabItem Header="🔄  Atualizações do Nexus LS" Style="{StaticResource AbaNexus}">
                <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                        CornerRadius="0,10,10,10" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Título da Seção -->
                            <TextBlock Text="Controle de Atualização do Executável" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                            <TextBlock Text="Verifique versões online no repositório de atualizações, faça backups automáticos e atualize o NexusLS.exe."
                                       Style="{StaticResource TextoApoio}" Margin="0,0,0,16" />

                            <!-- Caminho do Executável -->
                            <TextBlock Text="Caminho do Executável Instalado:" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCaminhoExe" Text="C:\NexusLS\publicar\NexusLS.exe" />
                                <Button Grid.Column="2" Content="Selecionar..." Style="{StaticResource BotaoSecundario}"
                                        Padding="14,7" Click="BtnSelecionarExe_Click" />
                            </Grid>

                            <!-- Painel de Novidades Encontradas -->
                            <Border x:Name="BrdNovidade" Visibility="Collapsed" Background="{StaticResource CorSelecaoSuave}"
                                    BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}"
                                    Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="TxtNovidadeTitulo" Text="Nova versão disponível!" FontWeight="Bold" FontSize="15" Foreground="{StaticResource CorPrimaria}" />
                                    <TextBlock x:Name="TxtNovidadeNotas" Text="" FontSize="13" Margin="0,6,0,12" TextWrapping="Wrap" />
                                    <Button x:Name="BtnBaixarEInstalar" Content="Baixar e Instalar Versão Online" Style="{StaticResource BotaoSucesso}"
                                            HorizontalAlignment="Left" Padding="16,8" Click="BtnBaixarEInstalar_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Ações de Atualização -->
                            <WrapPanel Margin="0,0,0,16">
                                <Button x:Name="BtnVerificarAtualizacao" Style="{StaticResource BotaoPrimario}" Margin="0,0,12,10" Padding="18,10" Click="BtnVerificarAtualizacao_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Verificar Atualizações Online" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRestaurarBackup" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,10" Padding="16,10" Click="BtnRestaurarBackup_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⏪" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Restaurar Versão Anterior (Backup)" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCopiarCompilado" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,10" Padding="16,10" Click="BtnCopiarCompilado_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Atualizar a partir de Nova Build Local" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Barra de Progresso de Download -->
                            <ProgressBar x:Name="PrgAtualizacao" Height="6" Visibility="Collapsed" Margin="0,0,0,10"
                                         Foreground="{StaticResource CorPrimaria}" Background="{StaticResource CorLinhaGrade}" BorderThickness="0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ABA 3: PORTAL WEB -->
            <TabItem Header="🌐  Portal Web &amp; Nuvem" Style="{StaticResource AbaNexus}">
                <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                        CornerRadius="0,10,10,10" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Título da Seção -->
                            <TextBlock Text="Portal Web do Atualizador e Ativador" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                            <TextBlock Text="Acesse o portal web online na Vercel e o repositório para gestão remota, download do instalador e documentação."
                                       Style="{StaticResource TextoApoio}" Margin="0,0,0,16" />

                            <TextBlock Text="Endereço do Portal Web:" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtUrlPortal" Text="https://github.com/Lukkzz11/Nexus-LS---Update" Margin="0,0,0,16" />

                            <WrapPanel Margin="0,0,0,18">
                                <Button x:Name="BtnAbrirPortalWeb" Style="{StaticResource BotaoPrimario}" Padding="18,10" Click="BtnAbrirPortalWeb_Click" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌐" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Abrir Portal Web no Navegador" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAbrirReleases" Style="{StaticResource BotaoSecundario}" Padding="16,10" Click="BtnAbrirReleases_Click" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Releases no GitHub" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAbrirFirebaseApp" Style="{StaticResource BotaoSecundario}" Padding="16,10" Click="BtnAbrirFirebaseApp_Click" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔥" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Web App Firebase" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Caixa de Dicas e Informações Úteis -->
                            <Border Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioMedio}" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Informações e Diretórios do Sistema" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource CorTexto}" />
                                    </StackPanel>
                                    <TextBlock Text="• Repositório de Atualizações &amp; Web App: Lukkzz11/Nexus-LS---Update" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,3" />
                                    <TextBlock Text="• Local da licença ativada: %LOCALAPPDATA%\NexusLS\licenca.json" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,3" />
                                    <TextBlock Text="• Chave mestra privada do fornecedor: %USERPROFILE%\NexusLS_chaves\licenca-privada.txt" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,3" />
                                    <TextBlock Text="• Banco de dados principal: %LOCALAPPDATA%\NexusLS\nexus.db" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,3" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ==================== 3. BARRA DE STATUS INFERIOR ==================== -->
        <Border Grid.Row="3" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CorSelecaoSuave}" CornerRadius="10" Width="18" Height="18" Margin="0,0,8,0">
                        <TextBlock Text="ℹ️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TxtStatusGeral" Text="Pronto." FontSize="12" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="📌 Criar Atalho na Área de Trabalho" Style="{StaticResource BotaoSecundario}"
                        Padding="12,6" FontSize="12" Click="BtnCriarAtalho_Click" ToolTip="Cria o atalho direto para o Atualizador e Ativador na Área de Trabalho" />
            </Grid>
        </Border>
    </Grid>
</Window>
