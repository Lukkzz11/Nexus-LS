                                            <Path Data="{StaticResource IconeCopiar}" Width="13" Height="13" Fill="#334155" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Copiar HWID" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtLicencaDetalhe" Text="" FontSize="12" Foreground="#64748B" Margin="0,12,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtLicencaStatus" Text="" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PÁGINA 4: DIAGNÓSTICO E SUPORTE ==================== -->
            <ScrollViewer x:Name="PageDiagnostico" Grid.Row="1" Margin="28,20,28,16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                    <!-- Barra Superior de Diagnóstico -->
                    <Border Style="{StaticResource CardBranco}" Padding="20,16" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Diagnóstico do Sistema e Conectividade" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="Verificações reais de conexão, autorização, integridade de arquivos e executáveis." FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnExecutarDiagnostico" Style="{StaticResource BotaoPrimario}" Padding="18,10" Margin="0,0,10,0" Click="BtnExecutarDiagnostico_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeDiagnostico}" Width="14" Height="14" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="EXECUTAR DIAGNÓSTICO" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCopiarDiagnostico" Style="{StaticResource BotaoSecundario}" Padding="14,10" Margin="0,0,10,0" Click="BtnCopiarDiagnostico_Click" ToolTip="Copiar relatório técnico completo">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeCopiar}" Width="13" Height="13" Fill="#334155" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Copiar Relatório" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAbrirPastaDados" Style="{StaticResource BotaoSecundario}" Padding="14,10" Click="BtnAbrirPastaDados_Click" ToolTip="Abrir pasta de dados %LOCALAPPDATA%\NexusLS">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconePasta}" Width="13" Height="13" Fill="#334155" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Pasta de Dados" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Lista de Verificações Reais com Badges -->
                    <Border Style="{StaticResource CardBranco}" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Itens Verificados Individualmente" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14" />

                            <!-- Item 1: Conexão Internet -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconeNuvem}" Width="18" Height="18" Fill="#2563EB" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Conexão com a Internet" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock x:Name="TxtDiagInternetDesc" Text="Acesso à rede mundial e resolução de DNS" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BrdDiagInternet" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                        <TextBlock x:Name="TxtDiagInternetStatus" Text="Aprovado" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Item 2: Comunicação Firebase -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconeTerminal}" Width="18" Height="18" Fill="#D97706" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Comunicação com o Firebase (Servidor Central)" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock x:Name="TxtDiagFirebaseDesc" Text="API REST do Firestore (projeto nexus-ls) e Cloud Functions" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BrdDiagFirebase" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                        <TextBlock x:Name="TxtDiagFirebaseStatus" Text="Aprovado" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Item 3: Validação da Licença Comercial -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconeChave}" Width="18" Height="18" Fill="#16A34A" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Validação da Licença Comercial" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock x:Name="TxtDiagLicencaDesc" Text="Assinatura HMAC local e checagem de HWID" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BrdDiagLicenca" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                        <TextBlock x:Name="TxtDiagLicencaStatus" Text="Autorizada" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Item 4: Instalação Nexus LS -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconePlay}" Width="18" Height="18" Fill="#2563EB" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Instalação do Nexus LS (ERP &amp; PDV)" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock x:Name="TxtDiagNexusDesc" Text="Executável NexusLS.exe localizado" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BrdDiagNexus" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                        <TextBlock x:Name="TxtDiagNexusStatus" Text="Instalado" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Item 5: Instalação BarTender -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconeEtiqueta}" Width="18" Height="18" Fill="#16A34A" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Instalação do Nexus BarTender (Etiquetas)" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock x:Name="TxtDiagBarTenderDesc" Text="Executável NexusBarTender.exe localizado" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BrdDiagBarTender" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                        <TextBlock x:Name="TxtDiagBarTenderStatus" Text="Instalado" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Item 6: Integridade de Arquivos -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconeEscudo}" Width="18" Height="18" Fill="#475569" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Integridade dos Arquivos e Executáveis" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock x:Name="TxtDiagArquivosDesc" Text="Arquivos binários íntegros e legíveis" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BrdDiagArquivos" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                        <TextBlock x:Name="TxtDiagArquivosStatus" Text="Íntegros" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Item 7: Sistema de Atualização -->
                            <Border Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconeAtualizar}" Width="18" Height="18" Fill="#2563EB" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Sistema de Atualizações Oficiais (GitHub Releases)" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <TextBlock x:Name="TxtDiagUpdatesDesc" Text="Comunicação com repositório Lukkzz11/Nexus-LS---Update" FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                    <Border Grid.Column="2" x:Name="BrdDiagUpdates" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                        <TextBlock x:Name="TxtDiagUpdatesStatus" Text="Operacional" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Informações do Ambiente e Máquina -->
                    <Border Style="{StaticResource CardBranco}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Ambiente e Sistema Operacional" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SISTEMA OPERACIONAL" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtDiagSO" Text="Windows 11 (x64)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,8" />
                                    <TextBlock Text="COMPUTADOR / TERMINAL" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtDiagComputador" Text="PC-DESKTOP" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PLATAFORMA .NET" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtDiagDotNet" Text=".NET 10.0 Windows (WPF)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,8" />
                                    <TextBlock Text="PASTA DE EXECUÇÃO" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtDiagPastaExec" Text="C:\NexusLS" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PÁGINA 5: SOBRE O NEXUS ==================== -->
            <ScrollViewer x:Name="PageSobre" Grid.Row="1" Margin="28,20,28,16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardBranco}" Padding="30" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                                        CornerRadius="14" Width="64" Height="64" Margin="0,0,18,0" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/emblema.png" Width="40" Height="42"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="NEXUS" FontWeight="Bold" FontSize="24" Foreground="#0F172A" />
                                        <TextBlock Text=" HUB" FontWeight="Black" FontSize="24" Foreground="#2563EB" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="Central de Aplicativos e Gerenciamento do Ecossistema Nexus" FontSize="13" Foreground="#64748B" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="O Nexus Hub centraliza o lançamento, a atualização e a validação de licenças dos sistemas Nexus LS (ERP e Frente de Caixa) e Nexus BarTender (Estúdio de Etiquetas), proporcionando uma experiência de gestão comercial moderna e ágil para o seu negócio."
                                       FontSize="13" Foreground="#334155" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,24" />

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="NEXUS HUB" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="v1.2.6 (Oficial)" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="NEXUS LS (ERP/PDV)" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="TxtSobreVersaoNexus" Text="v1.2.6" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="NEXUS BARTENDER" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock x:Name="TxtSobreVersaoBarTender" Text="v1.2.6" FontSize="14" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Desenvolvimento e Suporte" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                            <TextBlock Text="Desenvolvido por Nexus LS Sistemas para o ecossistema Life Surf. Todos os direitos reservados. Software protegido por direitos autorais e tecnologia de licenciamento em nuvem com conformidade LGPD."
                                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== BARRA DE STATUS INFERIOR DISCRETA ==================== -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="28,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Ambiente:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtStatusGeral" Text="Pronto" FontSize="11" Foreground="#334155" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="BtnCriarAtalhoDesktop" Style="{StaticResource BotaoSecundario}"
                            Padding="12,5" FontSize="11" Click="BtnCriarAtalhoDesktop_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconeAtalho}" Width="12" Height="12" Fill="#334155" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Criar Atalho na Área de Trabalho" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
