                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PÁGINA 3: LICENÇA COMERCIAL ==================== -->
            <ScrollViewer x:Name="PageLicenca" Grid.Row="1" Margin="28,20,28,16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                    <!-- Bloco de Ativação -->
                    <Border Style="{StaticResource CardBranco}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Ativação da Licença Comercial" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Informe a chave da assinatura fornecida para autorizar o uso dos sistemas Nexus neste computador." FontSize="12" Foreground="#64748B" Margin="0,3,0,16" />

                            <TextBlock Text="Chave da Licença (ex.: NEXUS-XXXX-XXXX-XXXX):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtChaveLicenca" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                         CharacterCasing="Upper" MaxLength="64" VerticalContentAlignment="Center" Padding="10,8" Background="#F8FAFC" BorderBrush="#CBD5E1" />
                                <Button Grid.Column="2" Style="{StaticResource BotaoSecundario}" Padding="14,8" Click="BtnColarChave_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeColar}" Width="13" Height="13" Fill="#334155" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
