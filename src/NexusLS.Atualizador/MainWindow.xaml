<Window x:Class="NexusLS.Atualizador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus LS — Atualizador e Ativador de Licença"
        Height="720" Width="920" MinHeight="620" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundo}" Foreground="{StaticResource CorTexto}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{StaticResource CorPainel}" CornerRadius="10" Padding="20,16" Margin="0,0,0,16"
                BorderBrush="{StaticResource CorPainelBorda}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Nexus LS · Atualizador &amp; Ativador" FontSize="22" FontWeight="Bold" Foreground="{StaticResource CorTexto}" />
                    <TextBlock Text="Gerenciamento de versões, ativação de licenças offline e portal web integrado."
                               FontSize="13" Foreground="{StaticResource CorTextoSecundario}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnIniciarNexus" Content="🚀 Iniciar Nexus LS" Style="{StaticResource BotaoSucesso}"
                        Padding="16,10" VerticalAlignment="Center" Click="BtnIniciarNexus_Click" />
            </Grid>
        </Border>

        <!-- Cartões de Status Rápido -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card Licença -->
            <Border Grid.Column="0" Background="{StaticResource CorPainel}" CornerRadius="8" Padding="14,12"
                    BorderBrush="{StaticResource CorPainelBorda}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="SITUAÇÃO DA LICENÇA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CorTextoSecundario}" />
                    <TextBlock x:Name="TxtLicencaStatus" Text="Verificando..." FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtLicencaDetalhe" Text="" FontSize="11" Foreground="{StaticResource CorTextoSecundario}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Card Versão -->
            <Border Grid.Column="2" Background="{StaticResource CorPainel}" CornerRadius="8" Padding="14,12"
                    BorderBrush="{StaticResource CorPainelBorda}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="VERSÃO INSTALADA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CorTextoSecundario}" />
                    <TextBlock x:Name="TxtVersaoStatus" Text="Verificando..." FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtVersaoArquivo" Text="" FontSize="11" Foreground="{StaticResource CorTextoSecundario}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Card Máquina -->
            <Border Grid.Column="4" Background="{StaticResource CorPainel}" CornerRadius="8" Padding="14,12"
                    BorderBrush="{StaticResource CorPainelBorda}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CÓDIGO DESTE COMPUTADOR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CorTextoSecundario}" />
                    <TextBlock x:Name="TxtCodigoMaquina" Text="Carregando..." FontSize="14" FontWeight="Bold" Foreground="{StaticResource CorDestaque}" Margin="0,4,0,0" />
                    <TextBlock Text="Use para amarrar a licença a esta máquina" FontSize="11" Foreground="{StaticResource CorTextoSecundario}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Abas de Conteúdo Principal -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,8" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource CorPainel}" />
                                        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ABA 1: LICENÇA & ATIVAÇÃO -->
            <TabItem Header="🔑 Licença &amp; Ativação">
                <Border Background="{StaticResource CorPainel}" CornerRadius="0,8,8,8" Padding="20"
                        BorderBrush="{StaticResource CorPainelBorda}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Chave do Fornecedor -->
                            <TextBlock Text="Chave Privada do Fornecedor (Emissão de Licenças)" FontSize="15" FontWeight="SemiBold" />
                            <Border x:Name="BrdChaveStatus" Background="#1B2D26" BorderBrush="{StaticResource CorSucesso}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,8" Margin="0,6,0,16">
                                <TextBlock x:Name="TxtChaveStatus" Text="Verificando chave mestra..." Foreground="{StaticResource CorSucesso}" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="Nome do Cliente / Estabelecimento:" FontSize="13" Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCliente" Text="Loja Principal" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Data de Validade (AAAA-MM-DD):" FontSize="13" Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtValidade" Text="" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <Button Content="+30 dias" Style="{StaticResource BotaoSecundario}" Margin="0,0,4,4" Padding="8,4" FontSize="11" Click="BtnAdicionarDias_Click" Tag="30" />
                                        <Button Content="+90 dias" Style="{StaticResource BotaoSecundario}" Margin="0,0,4,4" Padding="8,4" FontSize="11" Click="BtnAdicionarDias_Click" Tag="90" />
                                        <Button Content="+1 ano" Style="{StaticResource BotaoSecundario}" Margin="0,0,4,4" Padding="8,4" FontSize="11" Click="BtnAdicionarDias_Click" Tag="365" />
                                        <Button Content="+2 anos" Style="{StaticResource BotaoSecundario}" Margin="0,0,4,4" Padding="8,4" FontSize="11" Click="BtnAdicionarDias_Click" Tag="730" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Máquina (* = qualquer computador):" FontSize="13" Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtMaquina" Text="*" Margin="0,0,0,6" />
                                    <Button Content="Preencher com o código desta máquina" Style="{StaticResource BotaoSecundario}"
                                            HorizontalAlignment="Left" Padding="8,4" FontSize="11" Click="BtnPreencherMaquina_Click" />
                                </StackPanel>
                            </Grid>

                            <Separator Background="{StaticResource CorPainelBorda}" Margin="0,8,0,16" />

                            <!-- Botões de Ação de Licença -->
                            <WrapPanel>
                                <Button x:Name="BtnGerarEAtivar" Content="⚡ Gerar e Ativar Nesta Máquina" Margin="0,0,10,10" Padding="16,10"
                                        Click="BtnGerarEAtivar_Click" />
                                <Button x:Name="BtnSalvarArquivo" Content="💾 Gerar e Salvar Arquivo (.json)" Style="{StaticResource BotaoSecundario}"
                                        Margin="0,0,10,10" Padding="14,10" Click="BtnSalvarArquivo_Click" />
                                <Button x:Name="BtnInstalarArquivo" Content="📂 Instalar Licença de Arquivo" Style="{StaticResource BotaoSecundario}"
                                        Margin="0,0,10,10" Padding="14,10" Click="BtnInstalarArquivo_Click" />
                                <Button x:Name="BtnRemoverLicenca" Content="🗑️ Remover Licença Atual" Style="{StaticResource BotaoSecundario}"
                                        Margin="0,0,10,10" Padding="14,10" Click="BtnRemoverLicenca_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ABA 2: ATUALIZAÇÕES DO NEXUS LS -->
            <TabItem Header="🔄 Atualizações do Nexus LS">
                <Border Background="{StaticResource CorPainel}" CornerRadius="0,8,8,8" Padding="20"
                        BorderBrush="{StaticResource CorPainelBorda}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Controle de Atualização do Executável" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Verifique versões online no GitHub Releases, faça backups automáticos e atualize o NexusLS.exe."
                                       FontSize="13" Foreground="{StaticResource CorTextoSecundario}" Margin="0,4,0,16" />

                            <TextBlock Text="Executável Alvo:" FontSize="13" Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCaminhoExe" Text="C:\NexusLS\publicar\NexusLS.exe" />
                                <Button Grid.Column="2" Content="Selecionar..." Style="{StaticResource BotaoSecundario}"
                                        Padding="12,6" Click="BtnSelecionarExe_Click" />
                            </Grid>

                            <!-- Painel de Novidades Encontradas -->
                            <Border x:Name="BrdNovidade" Visibility="Collapsed" Background="#1E293B" BorderBrush="{StaticResource CorDestaque}"
                                    BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtNovidadeTitulo" Text="Nova versão disponível!" FontWeight="Bold" FontSize="14" Foreground="{StaticResource CorDestaque}" />
                                    <TextBlock x:Name="TxtNovidadeNotas" Text="" FontSize="12" Margin="0,6,0,10" TextWrapping="Wrap" />
                                    <Button x:Name="BtnBaixarEInstalar" Content="Baixar e Instalar Versão Online" Style="{StaticResource BotaoSucesso}"
                                            HorizontalAlignment="Left" Padding="12,6" Click="BtnBaixarEInstalar_Click" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,0,0,14">
                                <Button x:Name="BtnVerificarAtualizacao" Content="🔍 Verificar Atualizações Online" Margin="0,0,10,10"
                                        Padding="14,10" Click="BtnVerificarAtualizacao_Click" />
                                <Button x:Name="BtnRestaurarBackup" Content="⏪ Restaurar Versão Anterior (Backup)" Style="{StaticResource BotaoSecundario}"
                                        Margin="0,0,10,10" Padding="14,10" Click="BtnRestaurarBackup_Click" />
                                <Button x:Name="BtnCopiarCompilado" Content="📁 Atualizar a partir de Nova Build Local" Style="{StaticResource BotaoSecundario}"
                                        Margin="0,0,10,10" Padding="14,10" Click="BtnCopiarCompilado_Click" />
                            </WrapPanel>

                            <ProgressBar x:Name="PrgAtualizacao" Height="6" Visibility="Collapsed" Margin="0,0,0,10"
                                         Foreground="{StaticResource CorDestaque}" Background="#2E2E3A" BorderThickness="0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ABA 3: PORTAL WEB -->
            <TabItem Header="🌐 Portal Web">
                <Border Background="{StaticResource CorPainel}" CornerRadius="0,8,8,8" Padding="20"
                        BorderBrush="{StaticResource CorPainelBorda}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Portal Web do Atualizador e Ativador" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Acesse a versão web para gestão remota de clientes, consulta de versões e ativador em nuvem."
                                       FontSize="13" Foreground="{StaticResource CorTextoSecundario}" Margin="0,4,0,16" />

                            <TextBlock Text="Endereço do Portal Web:" FontSize="13" Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtUrlPortal" Text="https://github.com/Lukkzz11/Nexus-LS---Update" Margin="0,0,0,14" />

                            <WrapPanel Margin="0,0,0,16">
                                <Button x:Name="BtnAbrirPortalWeb" Content="🌐 Abrir Portal Web no Navegador" Padding="16,10"
                                        Click="BtnAbrirPortalWeb_Click" Margin="0,0,10,10" />
                                <Button x:Name="BtnAbrirReleases" Content="📦 Acessar Releases no GitHub" Style="{StaticResource BotaoSecundario}"
                                        Padding="14,10" Click="BtnAbrirReleases_Click" Margin="0,0,10,10" />
                                <Button x:Name="BtnAbrirFirebaseApp" Content="🔥 Abrir Web App Firebase" Style="{StaticResource BotaoSecundario}"
                                        Padding="14,10" Click="BtnAbrirFirebaseApp_Click" Margin="0,0,10,10" />
                            </WrapPanel>

                            <Border Background="#1C1E26" CornerRadius="6" Padding="14" BorderBrush="{StaticResource CorPainelBorda}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="💡 Informações Úteis" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                    <TextBlock Text="• Repositório de Atualizações: Lukkzz11/Nexus-LS-Atualizacoes" FontSize="12" Foreground="{StaticResource CorTextoSecundario}" Margin="0,2" />
                                    <TextBlock Text="• Repositório do Portal Web: Lukkzz11/Nexus-LS---Update" FontSize="12" Foreground="{StaticResource CorTextoSecundario}" Margin="0,2" />
                                    <TextBlock Text="• Local da licença instalada: %LOCALAPPDATA%\NexusLS\licenca.json" FontSize="12" Foreground="{StaticResource CorTextoSecundario}" Margin="0,2" />
                                    <TextBlock Text="• Local da chave mestra do fornecedor: %USERPROFILE%\NexusLS_chaves\licenca-privada.txt" FontSize="12" Foreground="{StaticResource CorTextoSecundario}" Margin="0,2" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Barra de Mensagem / Status Inferior -->
        <Border Grid.Row="3" Background="{StaticResource CorPainel}" CornerRadius="6" Padding="14,10" Margin="0,12,0,0"
                BorderBrush="{StaticResource CorPainelBorda}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusGeral" Text="Pronto." FontSize="12" Foreground="{StaticResource CorTextoSecundario}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Criar Atalho na Área de Trabalho" Style="{StaticResource BotaoSecundario}"
                        Padding="10,5" FontSize="11" Click="BtnCriarAtalho_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
