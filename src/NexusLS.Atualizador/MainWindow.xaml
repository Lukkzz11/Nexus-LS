                                        <Path Data="{StaticResource IconeErro}" Width="13" Height="13" Fill="#B91C1C" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Desvincular deste Computador" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <TextBlock x:Name="TxtResultadoLicenca" Text="" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" />
                        </StackPanel>
                    </Border>

                    <!-- Bloco de Detalhes da Licença e HWID -->
                    <Border Style="{StaticResource CardBranco}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Dados da Licença e Terminais Autorizados" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="CLIENTE RESPONSÁVEL" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtLicencaCliente" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="EMPRESA / ESTABELECIMENTO" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtLicencaEmpresa" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="PLANO CONTRATADO" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtLicencaPlano" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="VALIDADE &amp; DIAS RESTANTES" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtLicencaValidade" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="DISPOSITIVOS AUTORIZADOS" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtLicencaDispositivos" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#15803D" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="4">
                                    <TextBlock Text="ÚLTIMA VERIFICAÇÃO" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtLicencaVerificacao" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Bloco do HWID -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CÓDIGO DESTE COMPUTADOR (HWID)" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
