<Window x:Class="NexusLS.Atualizador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Hub — Central de Aplicativos e Atualizações"
        Icon="nexus.ico"
        Height="760" Width="1120" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <!-- Estilo dos Botões de Navegação Lateral -->
        <Style x:Key="ItemMenuLateral" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="10,3,10,3" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Ativo">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF" />
                                <Setter Property="Foreground" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sombra suave para os cartões de aplicativos -->
        <DropShadowEffect x:Key="SombraSuave" BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.05" />

        <!-- Estilo de Card Padrão -->
        <Style x:Key="CardBranco" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect" Value="{StaticResource SombraSuave}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 0: MENU LATERAL FIXO (SIDEBAR) -->
            <ColumnDefinition Width="230" />
            <!-- 1: ÁREA DE CONTEÚDO PRINCIPAL -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 0. MENU LATERAL FIXO ==================== -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Topo: Marca Nexus Hub -->
                    <RowDefinition Height="Auto" />
                    <!-- Centro: Itens de Navegação -->
                    <RowDefinition Height="*" />
                    <!-- Base: Status de Conexão e Versão -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Topo: Marca Nexus Hub -->
                <Border Grid.Row="0" Padding="20,18,16,16" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                                CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                            <Image Source="pack://application:,,,/Assets/emblema.png" Width="24" Height="26"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NEXUS" FontWeight="Bold" FontSize="16" Foreground="#0F172A" />
                                <TextBlock Text=" HUB" FontWeight="Black" FontSize="16" Foreground="#2563EB" Margin="3,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Central de Aplicativos" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Lista de Navegação -->
                <StackPanel Grid.Row="1" Margin="0,14,0,10">
                    <Button x:Name="BtnMenuInicio" Style="{StaticResource ItemMenuLateral}" Tag="Ativo" Click="BtnMenuInicio_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconeInicio}" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Início" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMenuAtualizacoes" Style="{StaticResource ItemMenuLateral}" Click="BtnMenuAtualizacoes_Click">
                        <Grid Width="180">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconeAtualizar}" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="Atualizações" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="BadgeMenuUpdate" Visibility="Collapsed" Background="#EF4444" CornerRadius="8"
                                    Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Novo" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="BtnMenuLicenca" Style="{StaticResource ItemMenuLateral}" Click="BtnMenuLicenca_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconeChave}" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Licença" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMenuDiagnostico" Style="{StaticResource ItemMenuLateral}" Click="BtnMenuDiagnostico_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconeDiagnostico}" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Diagnóstico" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMenuSobre" Style="{StaticResource ItemMenuLateral}" Click="BtnMenuSobre_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconeInfo}" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Sobre o Nexus" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Rodapé da Sidebar: Conexão e HWID -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse x:Name="DotStatusConexao" Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtSidebarConexao" Text="Conectado • Licença Ativa" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="HWID:" FontSize="10" Foreground="#94A3B8" Margin="0,0,4,0" />
                            <TextBlock x:Name="TxtSidebarHwid" Text="Carregando..." FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#334155" />
                        </StackPanel>
                        <TextBlock Text="Nexus Hub v1.2.6" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 1. ÁREA DE CONTEÚDO PRINCIPAL ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Topo da Página: Título e Status Superior -->
                <RowDefinition Height="Auto" />
                <!-- Conteúdo Dinâmico das Páginas -->
                <RowDefinition Height="*" />
                <!-- Barra de Status Inferior Discreta -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR DE CONTEXTO -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,14">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTituloPagina" Text="Central de Aplicativos" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock x:Name="TxtSubtituloPagina" Text="Ambiente central de gerenciamento e inicialização dos softwares Nexus" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Badge Superior da Empresa / Licença & Botão Sincronizar Git -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BrdTopoEmpresa" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconeEmpresa}" Width="13" Height="13" Fill="#1E40AF" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtTopoEmpresa" Text="Life Surf" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" VerticalAlignment="Center" />
                                <TextBlock Text="•" FontSize="12" Foreground="#93C5FD" Margin="6,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtTopoLicencaBadge" Text="Licença Autorizada" FontWeight="SemiBold" FontSize="11" Foreground="#16A34A" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnSincronizarGit" Style="{StaticResource BotaoSecundario}"
                                Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center"
                                Click="BtnSincronizarTudo_Click" ToolTip="Verifica se os programas instalados conferem com a versão do GitHub e atualiza automaticamente">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconeAtualizar}" Width="12" Height="12" Fill="#334155" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtRotuloSincronizarGit" Text="Sincronizar Git" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== PÁGINA 1: INÍCIO (TELA PRINCIPAL) ==================== -->
            <Grid x:Name="PageInicio" Grid.Row="1" Margin="28,20,28,16" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Área dos Dois Grandes Aplicativos -->
                    <RowDefinition Height="*" MinHeight="320" />
                    <!-- Espaçamento -->
                    <RowDefinition Height="18" />
                    <!-- Painel Compacto de Informações da Instalação -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- DOIS GRANDES BOTÕES/CARTÕES DOS APLICATIVOS (LADO A LADO) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CARTÃO 1: NEXUS LS (ERP & PDV) -->
                    <Border x:Name="CardAppNexus" Grid.Column="0" Style="{StaticResource CardBranco}" Padding="26"
                            Cursor="Hand" MouseDown="CardAppNexus_MouseDown">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho do Card: Ícone + Título + Badge de Status -->
                            <StackPanel Grid.Row="0">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Ícone Grande Nexus LS -->
                                    <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                                            CornerRadius="14" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/Assets/emblema.png" Width="32" Height="34"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Nexus LS" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                                                    CornerRadius="12" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtBadgeNexusLS" Text="● Instalado" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Sistema ERP e Frente de Caixa (PDV)" FontSize="13" Foreground="#64748B" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Descrição e Detalhes da Versão -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="Gestão completa de vendas, fechamento de caixa, controle de estoque, clientes, emissão de comprovantes térmicos e retaguarda."
                                           FontSize="13" Foreground="#475569" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14" />

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtVersaoDetalheNexus" Text="Versão instalada: v1.2.6" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Pronto para uso" FontSize="11" Foreground="#15803D" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Botão Grande: ABRIR NEXUS LS -->
                            <Button x:Name="BtnIniciarNexus" Grid.Row="2" Height="50"
                                    Background="#2563EB" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="BtnIniciarNexus_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#1D4ED8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconePlay}" Width="14" Height="14" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="ABRIR NEXUS LS" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- CARTÃO 2: NEXUS BARTENDER -->
                    <Border x:Name="CardAppBarTender" Grid.Column="2" Style="{StaticResource CardBranco}" Padding="26"
                            Cursor="Hand" MouseDown="CardAppBarTender_MouseDown">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho do Card: Ícone + Título + Badge de Status -->
                            <StackPanel Grid.Row="0">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Ícone Grande BarTender -->
                                    <Border Grid.Column="0" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1"
                                            CornerRadius="14" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeEtiqueta}" Width="26" Height="26" Fill="#16A34A" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Nexus BarTender" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                                                    CornerRadius="12" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtBadgeBarTender" Text="● Instalado" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Gerenciamento e impressão de etiquetas" FontSize="13" Foreground="#64748B" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Descrição e Detalhes da Versão -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="Impressão autônoma de etiquetas térmicas, código de barras (EAN-13, Code 128), gôndolas de produtos e personalização com logotipo."
                                           FontSize="13" Foreground="#475569" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14" />

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtVersaoDetalheBarTender" Text="Versão instalada: v1.2.6" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Pronto para uso" FontSize="11" Foreground="#15803D" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Botão Grande: ABRIR BARTENDER -->
                            <Button x:Name="BtnIniciarBarTender" Grid.Row="2" Height="50"
                                    Background="#059669" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="BtnIniciarBarTender_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#047857" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconePlay}" Width="14" Height="14" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="ABRIR BARTENDER" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- PAINEL COMPACTO E ORGANIZADO: INFORMAÇÕES DA INSTALAÇÃO -->
                <Border Grid.Row="2" Style="{StaticResource CardBranco}" Padding="22,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconeEscudo}" Width="15" Height="15" Fill="#2563EB" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Informações da Instalação e Licença Comercial" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Linha 1 -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="CLIENTE RESPONSÁVEL" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtHomeCliente" Text="Carregando..." FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="EMPRESA / LOJA" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtHomeEmpresa" Text="Carregando..." FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="PLANO CONTRATADO" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtHomePlano" Text="COMERCIAL" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="SITUAÇÃO DA LICENÇA" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtHomeLicencaStatus" Text="Ativa e Autorizada" FontSize="13" FontWeight="Bold" Foreground="#15803D" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Linha 2 -->
                            <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="DATA DE VALIDADE" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtHomeValidade" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="DIAS RESTANTES" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtHomeDiasRestantes" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="VERSÃO INSTALADA" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
