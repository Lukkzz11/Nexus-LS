                                </StackPanel>
                                <Border Grid.Column="1" x:Name="BrdBadgeStatusBarTender" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                                        CornerRadius="16" Padding="12,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtStatusModuloBarTender" Text="v1.2.6" FontSize="12" FontWeight="Bold" Foreground="#15803D" />
                                </Border>
                            </Grid>

                            <!-- Caminho do BarTender -->
                            <TextBlock Text="Caminho do Executável do BarTender (NexusBarTender.exe):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
