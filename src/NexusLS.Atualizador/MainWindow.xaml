                                    <Button x:Name="BtnBaixarEInstalarBarTender" Style="{StaticResource BotaoSucesso}"
                                            HorizontalAlignment="Left" Padding="18,10" Click="BtnBaixarEInstalarBarTender_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconeDownload}" Width="14" Height="14" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Baixar e Instalar Atualização do BarTender" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Ações -->
                            <WrapPanel Margin="0,0,0,12">
                                <Button x:Name="BtnVerificarAtualizacaoBarTender" Style="{StaticResource BotaoPrimario}" Margin="0,0,10,10" Padding="18,10" Click="BtnVerificarAtualizacaoBarTender_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeAtualizar}" Width="14" Height="14" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Buscar Atualizações do BarTender" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRestaurarBackupBarTender" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,10" Padding="16,10" Click="BtnRestaurarBackupBarTender_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeBackup}" Width="14" Height="14" Fill="#334155" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Restaurar Versão Anterior" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCopiarCompiladoBarTender" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,10" Padding="16,10" Click="BtnCopiarCompiladoBarTender_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconePasta}" Width="14" Height="14" Fill="#334155" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Instalar Pacote Local (.exe)" FontWeight="SemiBold" />
