                                <Button Grid.Column="2" Content="Procurar..." Style="{StaticResource BotaoSecundario}" Padding="14,7" Click="BtnSelecionarBarTenderExe_Click" />
                            </Grid>

                            <!-- Box de Novidade BarTender -->
                            <Border x:Name="BrdNovidadeBarTender" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="TxtNovidadeTituloBarTender" Text="Nova versão disponível!" FontWeight="Bold" FontSize="15" Foreground="#1E40AF" />
