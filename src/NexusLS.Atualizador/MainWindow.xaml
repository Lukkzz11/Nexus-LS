                                            <TextBlock x:Name="TxtCodigoMaquina" Text="Carregando..." FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="#2563EB" />
                                            <TextBlock x:Name="TxtNomeComputador" Text=" • Terminal" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0" />
