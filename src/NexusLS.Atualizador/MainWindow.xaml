<Window x:Class="NexusLS.Atualizador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus LS — Atualizador e Ativador de Licença"
        Icon="pack://application:,,,/nexus.ico"
        Height="780" Width="1040" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CorFundo}" Foreground="{StaticResource CorTexto}"
        FontFamily="{StaticResource FonteTexto}">

    <Window.Resources>
        <!-- Estilo de Aba padronizado com o Nexus -->
        <Style x:Key="AbaNexus" TargetType="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{StaticResource CorCabecalho}"
                                BorderBrush="{StaticResource CorBorda}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Padding="20,10"
                                Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CorPainel}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="0,3,0,0" />
                                <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CorHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão Superior de Status -->
        <Style x:Key="CartaoStatus" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CorPainel}" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RaioGrande}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1" Color="#000000" Opacity="0.04" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Cabeçalho Superior Oficial -->
            <RowDefinition Height="Auto" />
            <!-- 1: Cartões Rápidos de Status -->
            <RowDefinition Height="Auto" />
            <!-- 2: Abas Principais de Conteúdo -->
            <RowDefinition Height="*" />
            <!-- 3: Rodapé e Barra de Status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. CABEÇALHO SUPERIOR NEXUS ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1"
                            CornerRadius="{StaticResource RaioMedio}" Width="42" Height="42" Margin="0,0,14,0">
                        <Image Source="pack://application:,,,/Assets/emblema.png" Width="26" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NEXUS" Foreground="{StaticResource CorTexto}" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text=" ATUALIZADOR" Foreground="{StaticResource CorPrimaria}" FontWeight="Black" FontSize="18" Margin="4,0,0,0" />
                            <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioPequeno}" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LICENCIAMENTO &amp; UPDATES" Foreground="{StaticResource CorPrimaria}" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Central de ativação de licença comercial, verificação de validade e atualização segura do Nexus LS"
                                   Foreground="{StaticResource CorTextoSuave}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Botões de Iniciar o Nexus e BarTender -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnIniciarNexus" Style="{StaticResource BotaoPrimario}"
                            Padding="16,10" Margin="0,0,8,0" VerticalAlignment="Center" Click="BtnIniciarNexus_Click" ToolTip="Executa o aplicativo principal Nexus LS">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/emblema-branco.png" Width="16" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="TxtBotaoIniciarNexus" Text="Iniciar Nexus LS" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnIniciarBarTender" Style="{StaticResource BotaoSecundario}"
                            Padding="14,10" VerticalAlignment="Center" Click="BtnIniciarBarTender_Click" ToolTip="Executa o estúdio de impressão Nexus BarTender">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏷️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="BarTender" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1. CARTÕES RÁPIDOS DE STATUS ==================== -->
        <Grid Grid.Row="1" Margin="24,18,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Situação da Licença -->
            <Border Grid.Column="0" Style="{StaticResource CartaoStatus}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SITUAÇÃO DA LICENÇA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                        <TextBlock x:Name="TxtLicencaStatus" Text="Verificando..." FontSize="16" FontWeight="Bold" Margin="0,4,0,2" />
                        <TextBlock x:Name="TxtLicencaDetalhe" Text="" FontSize="12" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource CorHover}" CornerRadius="20" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="🔑" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Versão Instalada -->
            <Border Grid.Column="2" Style="{StaticResource CartaoStatus}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VERSÃO INSTALADA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                        <TextBlock x:Name="TxtVersaoStatus" Text="Verificando..." FontSize="16" FontWeight="Bold" Margin="0,4,0,2" />
                        <TextBlock x:Name="TxtVersaoArquivo" Text="" FontSize="12" Foreground="{StaticResource CorTextoSuave}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource CorHover}" CornerRadius="20" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Código do Computador -->
            <Border Grid.Column="4" Style="{StaticResource CartaoStatus}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CÓDIGO DESTE COMPUTADOR (HWID)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,2">
                            <TextBlock x:Name="TxtCodigoMaquina" Text="Carregando..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                            <Button x:Name="BtnCopiarHwid" Content="📋 Copiar" Style="{StaticResource BotaoSecundario}"
                                    Padding="8,2" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Click="BtnCopiarHwid_Click" ToolTip="Copiar o código deste computador para a área de transferência" />
                        </StackPanel>
                        <TextBlock x:Name="TxtNomeComputador" Text="Identificador único deste terminal" FontSize="12" Foreground="{StaticResource CorTextoSuave}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource CorSelecaoSuave}" CornerRadius="20" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="💻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. ABAS PRINCIPAIS ==================== -->
        <TabControl x:Name="TabControle" Grid.Row="2" Margin="24,0,24,18" Background="Transparent" BorderThickness="0">

            <!-- ABA 0: CENTRAL DO CLIENTE (HOME / LAUNCHER) -->
            <TabItem Header="🏠  Início (Central do Cliente)" Style="{StaticResource AbaNexus}">
                <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                        CornerRadius="0,10,10,10" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                            <!-- Cartão de Boas-Vindas do Cliente / Empresa -->
                            <Border Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioGrande}" Padding="20" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                            <TextBlock Text="Cliente:" FontSize="13" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtHomeCliente" Text="Carregando..." FontSize="18" FontWeight="Bold" Foreground="{StaticResource CorTexto}" VerticalAlignment="Center" />
                                            <TextBlock Text="•" FontSize="14" Foreground="{StaticResource CorTextoSuave}" Margin="8,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Empresa:" FontSize="13" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtHomeEmpresa" Text="Carregando..." FontSize="18" FontWeight="Bold" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtHomeDetalhesLicenca" Text="Consultando licença comercial..." FontSize="12" Foreground="{StaticResource CorTextoSuave}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" x:Name="BrdHomeStatusBadge" Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1"
                                            CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtHomeStatusBadge" Text="● Verificando..." FontWeight="Bold" FontSize="12" Foreground="{StaticResource CorPrimaria}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Título da Seção dos Aplicativos -->
                            <TextBlock Text="Aplicativos do Nexus" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                            <TextBlock Text="Clique para iniciar diretamente os sistemas instalados neste computador." Style="{StaticResource TextoApoio}" Margin="0,0,0,16" />

                            <!-- Grid dos Dois Apps Principais -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Nexus LS (ERP & PDV) -->
                                <Border Grid.Column="0" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                        CornerRadius="{StaticResource RaioGrande}" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RaioMedio}" Width="40" Height="40" Margin="0,0,12,0">
                                                <Image Source="pack://application:,,,/Assets/emblema.png" Width="24" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Nexus LS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CorTexto}" />
                                                <TextBlock Text="Sistema ERP &amp; Frente de Caixa PDV" FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="Controle completo de vendas, estoque, fechamento de caixa, clientes, emissão de comprovantes e retaguarda."
                                                   FontSize="12" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                        <StackPanel Grid.Row="2">
                                            <TextBlock x:Name="TxtHomeNexusStatus" Text="Verificando status..." FontSize="11" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,10" />
                                            <Button Style="{StaticResource BotaoPrimario}" Padding="16,10" Click="BtnIniciarNexus_Click" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="▶" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Iniciar Nexus LS" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 2: Nexus BarTender -->
                                <Border Grid.Column="2" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                        CornerRadius="{StaticResource RaioGrande}" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Background="{StaticResource CorSelecaoSuave}" BorderBrush="{StaticResource CorSelecao}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RaioMedio}" Width="40" Height="40" Margin="0,0,12,0">
                                                <TextBlock Text="🏷️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Nexus BarTender" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CorTexto}" />
                                                <TextBlock Text="Estúdio de Impressão de Etiquetas" FontSize="11" Foreground="{StaticResource CorTextoSuave}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="Impressão autônoma de etiquetas térmicas, código de barras, gôndolas e personalização com logotipo."
                                                   FontSize="12" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                        <StackPanel Grid.Row="2">
                                            <TextBlock x:Name="TxtHomeBarTenderStatus" Text="Verificando status..." FontSize="11" Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,10" />
                                            <Button Style="{StaticResource BotaoSecundario}" Padding="16,10" Click="BtnIniciarBarTender_Click" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="🏷️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Iniciar BarTender" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Seção de Ações Rápidas: Updates e Licença -->
                            <TextBlock Text="Gerenciamento &amp; Atualizações" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                            <TextBlock Text="Acesse as ferramentas de atualização ou altere as configurações da licença." Style="{StaticResource TextoApoio}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card Update -->
                                <Border Grid.Column="0" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                        CornerRadius="{StaticResource RaioGrande}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Central de Atualizações" FontWeight="Bold" FontSize="14" Foreground="{StaticResource CorTexto}" />
                                            <TextBlock Text="Consulte novas versões na nuvem e atualize o Nexus LS ou BarTender com segurança." FontSize="11" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource BotaoSecundario}" Padding="12,8" Click="BtnHomeIrParaUpdates_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔄" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Ver Atualizações" FontWeight="SemiBold" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Card Licença -->
                                <Border Grid.Column="2" Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                        CornerRadius="{StaticResource RaioGrande}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Licenciamento &amp; Terminais" FontWeight="Bold" FontSize="14" Foreground="{StaticResource CorTexto}" />
                                            <TextBlock Text="Altere a chave da licença, veja o HWID e consulte as vagas autorizadas." FontSize="11" Foreground="{StaticResource CorTextoSuave}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource BotaoSecundario}" Padding="12,8" Click="BtnHomeIrParaLicenca_Click" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔑" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Gerenciar Licença" FontWeight="SemiBold" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ABA 1: LICENÇA & ATIVAÇÃO -->
            <TabItem Header="🔑  Licença Comercial" Style="{StaticResource AbaNexus}">
                <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                        CornerRadius="0,10,10,10" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Ativação e Controle de Licença" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                            <TextBlock Text="Informe a chave comercial fornecida pela administração do Nexus LS. O sistema validará sua assinatura em tempo real e vinculará a autorização a este computador."
                                       Style="{StaticResource TextoApoio}" Margin="0,0,0,16" TextWrapping="Wrap" />

                            <TextBlock Text="Chave da Licença (ex.: NEXUS-XXXX-XXXX-XXXX)" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtChaveLicenca" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                         CharacterCasing="Upper" MaxLength="64" VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Content="📋 Colar Chave" Style="{StaticResource BotaoSecundario}"
                                        Padding="14,8" Click="BtnColarChave_Click" ToolTip="Colar chave da área de transferência" />
                            </Grid>

                            <WrapPanel Margin="0,0,0,14">
                                <Button x:Name="BtnAtivarChave" Style="{StaticResource BotaoPrimario}" Margin="0,0,10,10" Padding="18,10" Click="BtnAtivarChave_Click">
                                    <TextBlock Text="✓  Ativar / Validar Licença" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="BtnRevalidarLicenca" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,10" Padding="16,10" Click="BtnRevalidarLicenca_Click"
                                        ToolTip="Sincroniza novamente o status e a validade da licença atual com o servidor">
                                    <TextBlock Text="🔄  Sincronizar Status" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="BtnRemoverLicenca" Style="{StaticResource BotaoPerigo}" Margin="0,0,10,10" Padding="16,10" Click="BtnRemoverLicenca_Click"
                                        ToolTip="Remove a licença deste computador e libera a vaga no servidor">
                                    <TextBlock Text="🗑️  Desvincular deste Computador" FontWeight="SemiBold" />
                                </Button>
                            </WrapPanel>

                            <TextBlock x:Name="TxtResultadoLicenca" Text="" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14" />

                            <!-- Painel de Detalhes da Licença Vinculada -->
                            <Border Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioMedio}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="CLIENTE RESPONSÁVEL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock x:Name="TxtLicencaCliente" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="EMPRESA / ESTABELECIMENTO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock x:Name="TxtLicencaEmpresa" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="PLANO CONTRATADO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock x:Name="TxtLicencaPlano" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="VALIDADE &amp; DIAS RESTANTES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock x:Name="TxtLicencaValidade" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="DISPOSITIVOS AUTORIZADOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock x:Name="TxtLicencaDispositivos" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <TextBlock Text="ÚLTIMA VERIFICAÇÃO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CorTextoSuave}" />
                                        <TextBlock x:Name="TxtLicencaVerificacao" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ABA 2: ATUALIZAÇÕES DO NEXUS LS -->
            <TabItem Header="🔄  Atualizações do Sistema" Style="{StaticResource AbaNexus}">
                <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                        CornerRadius="0,10,10,10" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <!-- Título da Seção -->
                            <TextBlock Text="Atualização Segura do Nexus LS" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                            <TextBlock Text="Consulte novas versões oficiais com verificação de integridade SHA-256, crie backups automáticos antes de atualizar e restaure versões anteriores com um clique."
                                       Style="{StaticResource TextoApoio}" Margin="0,0,0,16" TextWrapping="Wrap" />

                            <!-- Caminho do Executável -->
                            <TextBlock Text="Caminho do Executável Principal (NexusLS.exe):" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCaminhoExe" Text="" />
                                <Button Grid.Column="2" Content="Procurar..." Style="{StaticResource BotaoSecundario}"
                                        Padding="14,7" Click="BtnSelecionarExe_Click" />
                            </Grid>

                            <!-- Painel de Novidades Encontradas -->
                            <Border x:Name="BrdNovidade" Visibility="Collapsed" Background="{StaticResource CorSelecaoSuave}"
                                    BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}"
                                    Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="TxtNovidadeTitulo" Text="Nova versão disponível!" FontWeight="Bold" FontSize="15" Foreground="{StaticResource CorPrimaria}" />
                                    <TextBlock x:Name="TxtNovidadeNotas" Text="" FontSize="13" Margin="0,6,0,12" TextWrapping="Wrap" />
                                    <Button x:Name="BtnBaixarEInstalar" Content="⬇️  Baixar e Instalar Atualização Oficial" Style="{StaticResource BotaoSucesso}"
                                            HorizontalAlignment="Left" Padding="16,8" Click="BtnBaixarEInstalar_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Ações de Atualização -->
                            <WrapPanel Margin="0,0,0,16">
                                <Button x:Name="BtnVerificarAtualizacao" Style="{StaticResource BotaoPrimario}" Margin="0,0,12,10" Padding="18,10" Click="BtnVerificarAtualizacao_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Buscar Atualizações Online" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRestaurarBackup" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,10" Padding="16,10" Click="BtnRestaurarBackup_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⏪" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Restaurar Versão Anterior (Backup)" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCopiarCompilado" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,10" Padding="16,10" Click="BtnCopiarCompilado_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Instalar Pacote Local (.exe)" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Barra de Progresso de Download -->
                            <ProgressBar x:Name="PrgAtualizacao" Height="8" Visibility="Collapsed" Margin="0,0,0,10"
                                         Foreground="{StaticResource CorPrimaria}" Background="{StaticResource CorLinhaGrade}" BorderThickness="0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ABA 3: ATUALIZAÇÕES DO BARTENDER -->
            <TabItem Header="🏷️  Atualizações BarTender" Style="{StaticResource AbaNexus}">
                <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                        CornerRadius="0,10,10,10" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Módulo Nexus BarTender (Etiquetas &amp; Códigos)" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                            <TextBlock Text="Gerencie individualmente o executável do módulo de etiquetas e códigos de barras sem afetar o sistema principal de vendas."
                                       Style="{StaticResource TextoApoio}" Margin="0,0,0,16" TextWrapping="Wrap" />

                            <TextBlock Text="Caminho do Executável do BarTender (NexusBarTender.exe):" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCaminhoBarTenderExe" FontSize="13" VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Content="Procurar..." Style="{StaticResource BotaoSecundario}"
                                        Padding="14,6" Click="BtnProcurarBarTenderExe_Click" />
                            </Grid>

                            <!-- Resumo da Versão BarTender -->
                            <Border Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioMedio}" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Status do Módulo BarTender" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CorTexto}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtStatusModuloBarTender" Text="Módulo instalado e operacional" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,2" />
                                    <TextBlock x:Name="TxtVersaoBarTenderInstalada" Text="• Versão: v1.1.0" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,2" />
                                </StackPanel>
                            </Border>

                            <!-- Painel de Novidades Encontradas do BarTender -->
                            <Border x:Name="BrdNovidadeBarTender" Visibility="Collapsed" Background="{StaticResource CorSelecaoSuave}"
                                    BorderBrush="{StaticResource CorSelecao}" BorderThickness="1" CornerRadius="{StaticResource RaioMedio}"
                                    Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="TxtNovidadeTituloBarTender" Text="Nova versão do BarTender disponível!" FontWeight="Bold" FontSize="15" Foreground="{StaticResource CorPrimaria}" />
                                    <TextBlock x:Name="TxtNovidadeNotasBarTender" Text="" FontSize="13" Margin="0,6,0,12" TextWrapping="Wrap" />
                                    <Button x:Name="BtnBaixarEInstalarBarTender" Content="⬇️  Baixar e Instalar Atualização do BarTender" Style="{StaticResource BotaoSucesso}"
                                            HorizontalAlignment="Left" Padding="16,8" Click="BtnBaixarEInstalarBarTender_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Ações do BarTender -->
                            <WrapPanel Margin="0,0,0,16">
                                <Button x:Name="BtnVerificarAtualizacaoBarTender" Style="{StaticResource BotaoPrimario}" Margin="0,0,12,10" Padding="18,10" Click="BtnVerificarAtualizacaoBarTender_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Buscar Atualizações Online" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAbrirDiretoBarTender" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,10" Padding="18,10" Click="BtnIniciarBarTender_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="▶" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Abrir Nexus BarTender" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCopiarBarTenderCompilado" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,10" Padding="16,10" Click="BtnCopiarBarTenderCompilado_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Instalar Pacote Local (.exe)" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRestaurarBarTenderBackup" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,10" Padding="16,10" Click="BtnRestaurarBarTenderBackup_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⏪" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Restaurar Versão Anterior (Backup)" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Barra de Progresso de Download do BarTender -->
                            <ProgressBar x:Name="PrgAtualizacaoBarTender" Height="8" Visibility="Collapsed" Margin="0,0,0,10"
                                         Foreground="{StaticResource CorPrimaria}" Background="{StaticResource CorLinhaGrade}" BorderThickness="0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ABA 3: DIAGNÓSTICO & AMBIENTE -->
            <TabItem Header="🛠️  Diagnóstico &amp; Suporte" Style="{StaticResource AbaNexus}">
                <Border Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                        CornerRadius="0,10,10,10" Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Diagnóstico do Terminal e Suporte Técnico" Style="{StaticResource TituloSecao}" Margin="0,0,0,4" />
                            <TextBlock Text="Verifique a conectividade com o servidor de licenças em nuvem e copie os dados técnicos deste computador caso precise acionar o suporte."
                                       Style="{StaticResource TextoApoio}" Margin="0,0,0,16" TextWrapping="Wrap" />

                            <WrapPanel Margin="0,0,0,18">
                                <Button x:Name="BtnTestarConexao" Style="{StaticResource BotaoPrimario}" Padding="18,10" Click="BtnTestarConexao_Click" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="☁️" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Testar Conexão com Servidor de Licenças" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCopiarDiagnostico" Style="{StaticResource BotaoSecundario}" Padding="16,10" Click="BtnCopiarDiagnostico_Click" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📋" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Copiar Relatório para o Suporte" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAbrirPastaDados" Style="{StaticResource BotaoSecundario}" Padding="16,10" Click="BtnAbrirPastaDados_Click" Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📂" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Abrir Pasta de Dados Locais" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Border Background="{StaticResource CorCabecalho}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
                                    CornerRadius="{StaticResource RaioMedio}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Resumo Técnico deste Computador" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CorTexto}" Margin="0,0,0,10" />
                                    <TextBlock x:Name="TxtDiagMaquina" Text="• Computador: —" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,3" />
                                    <TextBlock x:Name="TxtDiagSistema" Text="• Sistema Operacional: —" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,3" />
                                    <TextBlock x:Name="TxtDiagPastaDados" Text="• Diretório de Dados: —" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,3" />
                                    <TextBlock x:Name="TxtDiagServidor" Text="• Servidor de Licenciamento: Firebase Cloud (southamerica-east1 / nexus-ls)" FontSize="12" Foreground="{StaticResource CorTextoSuave}" Margin="0,3" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ==================== 3. BARRA DE STATUS INFERIOR ==================== -->
        <Border Grid.Row="3" Background="{StaticResource CorPainel}" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CorSelecaoSuave}" CornerRadius="10" Width="18" Height="18" Margin="0,0,8,0">
                        <TextBlock Text="ℹ️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TxtStatusGeral" Text="Pronto." FontSize="12" Foreground="{StaticResource CorTextoSuave}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="📌 Criar Atalho na Área de Trabalho" Style="{StaticResource BotaoSecundario}"
                        Padding="12,6" FontSize="12" Click="BtnCriarAtalho_Click" ToolTip="Cria o atalho direto para o Atualizador e Ativador na Área de Trabalho" />
            </Grid>
        </Border>
    </Grid>
</Window>
