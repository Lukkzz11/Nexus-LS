                                            <Path Data="{StaticResource IconeDownload}" Width="14" Height="14" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Baixar e Instalar Atualização Oficial" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Ações -->
                            <WrapPanel Margin="0,0,0,12">
                                <Button x:Name="BtnVerificarAtualizacao" Style="{StaticResource BotaoPrimario}" Margin="0,0,10,10" Padding="18,10" Click="BtnVerificarAtualizacao_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeAtualizar}" Width="14" Height="14" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Buscar Atualizações Online" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRestaurarBackup" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,10" Padding="16,10" Click="BtnRestaurarBackup_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconeBackup}" Width="14" Height="14" Fill="#334155" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Restaurar Versão Anterior" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCopiarCompilado" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,10" Padding="16,10" Click="BtnCopiarCompilado_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconePasta}" Width="14" Height="14" Fill="#334155" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
